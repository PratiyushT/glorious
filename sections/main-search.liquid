{%- comment -%}
  The reference search surface on Shopify's real search, filters, sorting and
  mixed result types. Product results use the reusable Product card; pages and
  articles remain distinct rows rather than pretending to be products.
{%- endcomment -%}

{%- liquid
  assign current_sort = search.sort_by | default: search.default_sort_by
  assign search_types = shop.search_types | join: ','
  if search.performed and search.types.size > 0
    assign search_types = search.types | join: ','
  endif
  assign quick_filter = blank
  if search.performed and section.settings.quick_links_source == 'filter'
    if section.settings.quick_filter_target == 'name' and section.settings.quick_filter_name != blank
      assign wanted_filter_name = section.settings.quick_filter_name | strip | downcase
      for filter in search.filters
        assign candidate_filter_name = filter.label | strip | downcase
        if filter.type == 'list' and candidate_filter_name == wanted_filter_name
          assign quick_filter = filter
          break
        endif
      endfor
    else
      for filter in search.filters
        if filter.type == 'list' and filter.values.size > 1
          assign quick_filter = filter
          break
        endif
      endfor
    endif
  endif

  assign quick_source = section.settings.quick_links_source
  unless search.performed
    if quick_source == 'filter'
      assign quick_source = 'collections'
    endif
  endunless

  assign encoded_terms = search.terms | url_encode
  assign encoded_types = search_types | url_encode
  assign clear_url = routes.search_url | append: '?q=' | append: encoded_terms | append: '&options%5Bprefix%5D=last&type=' | append: encoded_types
  assign featured_collection = section.settings.featured_collection
  if featured_collection == blank
    assign featured_collection = collections.all
  endif
  assign popular_terms = section.settings.popular_searches | split: ','

  assign catalog_gap = 'var(--grid-gap)'
  unless section.settings.gap == 'theme'
    if section.settings.gap == 'none'
      assign catalog_gap = '0'
    else
      assign catalog_gap = 'var(--step-' | append: section.settings.gap | append: ')'
    endif
  endunless
-%}

<section
  class="catalog-page catalog-page--search catalog-page--motion-{{ section.settings.grid_motion | default: 'reference' }}{% if section.settings.sticky_controls %} catalog-page--sticky-controls{% endif %} scheme-{{ section.settings.color_scheme }}"
  data-catalog-section="{{ section.id }}"
  data-catalog-ajax="{{ section.settings.enable_ajax }}"
  style="{% render 'section-style', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %} --catalog-columns: {{ section.settings.columns }}; --catalog-gap: {{ catalog_gap }};"
>
  <div class="catalog-sticky-bar">
    <div class="catalog-shell catalog-search-controls">
      {% render 'catalog-controls',
        results: search,
        section_id: section.id,
        section: section,
        context: 'search',
        form_action: routes.search_url,
        clear_url: clear_url,
        sort_by: current_sort,
        quick_source: quick_source,
        quick_filter: quick_filter,
        quick_links_limit: section.settings.quick_links_limit,
        show_filters: section.settings.show_filters,
        show_sort: section.settings.show_sort,
        search_terms: search.terms,
        search_types: search_types,
        include_drawer: false
      %}
    </div>
  </div>

  {%- if section.settings.show_filters and search.filters.size > 0 -%}
    {%- assign drawer_name = 'catalog-filters-' | append: section.id -%}
    {% render 'catalog-filter-drawer', results: search, section: section, context: 'search', form_action: routes.search_url, clear_url: clear_url, current_sort: current_sort, search_terms: search.terms, search_types: search_types, drawer_name: drawer_name %}
  {%- endif -%}

  <main class="catalog-main catalog-main--search">
    <div class="catalog-shell">
      {%- unless search.performed -%}
        {%- if section.settings.popular_source != 'none' -%}
          <div class="search-popular search-popular--{{ section.settings.popular_layout }}">
            <span>{{ section.settings.popular_label }}</span>
            {%- if section.settings.popular_source == 'menu' and section.settings.popular_menu != blank -%}
              {%- for link in section.settings.popular_menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
            {%- else -%}
              {%- for term in popular_terms -%}
                {%- assign clean_term = term | strip -%}
                {%- if clean_term != blank -%}<a href="{{ routes.search_url }}?q={{ clean_term | url_encode }}&options%5Bprefix%5D=last&type={{ encoded_types }}" data-catalog-link>{{ clean_term }}</a>{%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_featured_when_empty and featured_collection != blank -%}
          <div class="catalog-grid-header catalog-grid-header--featured">
            <span class="catalog-kicker">{{ section.settings.featured_label }}</span>
            {%- if section.settings.show_result_count -%}<span class="catalog-result-count">{{ 'collections.product_count' | t: count: featured_collection.products_count }}</span>{%- endif -%}
          </div>
          <div class="catalog-grid" data-catalog-grid>
            {%- for product in featured_collection.products limit: section.settings.featured_limit -%}
              <div class="catalog-grid__item" style="--catalog-item-index: {{ forloop.index0 }};">
                {% content_for 'block', type: '_product-card', id: 'featured-product-card', closest.product: product %}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- else -%}
        {%- if search.results_count > 0 -%}
          {%- paginate search.results by section.settings.results_per_page -%}
            <div class="catalog-grid-header catalog-grid-header--results">
              <span class="search-results-for">{{ 'general.search.results_for' | t: terms: search.terms }}</span>
              {%- if section.settings.show_result_count -%}<span class="catalog-result-count">{{ 'general.search.results_with_count' | t: count: search.results_count }}</span>{%- endif -%}
            </div>

            {%- assign product_result_count = 0 -%}
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {%- assign product_result_count = product_result_count | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if product_result_count > 0 -%}
              <div class="catalog-grid" data-catalog-grid>
                {%- assign product_index = 0 -%}
                {%- for item in search.results -%}
                  {%- if item.object_type == 'product' -%}
                    <div class="catalog-grid__item" style="--catalog-item-index: {{ product_index }};">
                      {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: item %}
                    </div>
                    {%- assign product_index = product_index | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- assign resource_result_count = search.results.size | minus: product_result_count -%}
            {%- if resource_result_count > 0 and section.settings.show_resource_results -%}
              <section class="search-resources search-resources--{{ section.settings.resource_style }}">
                <h2>{{ section.settings.resources_heading }}</h2>
                <div>
                  {%- for item in search.results -%}
                    {%- unless item.object_type == 'product' -%}
                      <a class="search-resource" href="{{ item.url }}">
                        {%- if item.image != blank -%}
                          {{ item.image | image_url: width: 120 | image_tag: width: 50, height: 50, loading: 'lazy', alt: '' }}
                        {%- else -%}
                          <span class="search-resource__placeholder" aria-hidden="true"><span></span></span>
                        {%- endif -%}
                        <span class="search-resource__title">{{ item.title }}</span>
                        <span class="search-resource__type">{{ item.object_type | capitalize }}</span>
                      </a>
                    {%- endunless -%}
                  {%- endfor -%}
                </div>
              </section>
            {%- endif -%}

            <div class="catalog-pagination-wrap catalog-pagination-wrap--{{ section.settings.pagination_style }}">
              {% render 'catalog-pagination', paginate: paginate %}
            </div>
          {%- endpaginate -%}
        {%- else -%}
          <div class="search-empty">
            <h1>{{ 'general.search.no_results' | t: terms: search.terms }}</h1>
            <p>{{ section.settings.no_results_text }}</p>
            <a href="{{ routes.all_products_collection_url }}">{{ section.settings.browse_label }}</a>
          </div>
        {%- endif -%}
      {%- endunless -%}
    </div>
  </main>
</section>

{% schema %}
{
  "name": "t:sections.main_search.name",
  "enabled_on": {
    "templates": ["search"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_1"
    },
    {
      "type": "text",
      "id": "popular_label",
      "label": "t:sections.main_search.popular_label.label",
      "default": "Popular"
    },
    {
      "type": "select",
      "id": "popular_source",
      "label": "t:sections.catalog.popular_source",
      "options": [
        { "value": "manual", "label": "t:sections.catalog.search_terms" },
        { "value": "menu", "label": "t:sections.catalog.menu" },
        { "value": "none", "label": "t:sections.catalog.none" }
      ],
      "default": "manual"
    },
    {
      "type": "textarea",
      "id": "popular_searches",
      "label": "t:sections.main_search.popular_searches.label",
      "info": "t:sections.main_search.popular_searches.info",
      "default": "New arrivals, Best sellers, Gifts, Sale",
      "visible_if": "{{ section.settings.popular_source == 'manual' }}"
    },
    {
      "type": "link_list",
      "id": "popular_menu",
      "label": "t:sections.catalog.popular_menu",
      "visible_if": "{{ section.settings.popular_source == 'menu' }}"
    },
    {
      "type": "select",
      "id": "popular_layout",
      "label": "t:sections.catalog.popular_layout",
      "options": [
        { "value": "inline", "label": "t:sections.catalog.inline" },
        { "value": "stacked", "label": "t:sections.catalog.stacked" }
      ],
      "default": "inline",
      "visible_if": "{{ section.settings.popular_source != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:sections.main_search.navigation.content"
    },
    {
      "type": "checkbox",
      "id": "sticky_controls",
      "label": "t:sections.catalog.sticky_controls",
      "default": true
    },
    {
      "type": "select",
      "id": "controls_style",
      "label": "t:sections.catalog.control_style",
      "options": [
        { "value": "pills", "label": "t:sections.catalog.outlined_pills" },
        { "value": "soft", "label": "t:sections.catalog.soft_pills" },
        { "value": "line", "label": "t:sections.catalog.underline" },
        { "value": "minimal", "label": "t:sections.catalog.minimal" }
      ],
      "default": "pills"
    },
    {
      "type": "select",
      "id": "controls_layout",
      "label": "t:sections.catalog.control_alignment",
      "options": [
        { "value": "spread", "label": "t:sections.catalog.spread_controls" },
        { "value": "start", "label": "t:sections.catalog.start" },
        { "value": "center", "label": "t:sections.catalog.center" }
      ],
      "default": "spread"
    },
    {
      "type": "select",
      "id": "mobile_controls_layout",
      "label": "t:sections.catalog.narrow_controls",
      "options": [
        { "value": "stacked", "label": "t:sections.catalog.stacked" },
        { "value": "row", "label": "t:sections.catalog.single_row" }
      ],
      "default": "stacked"
    },
    {
      "type": "select",
      "id": "quick_links_source",
      "label": "t:sections.main_search.quick_links_source.label",
      "info": "t:sections.main_search.quick_links_source.info",
      "options": [
        { "value": "filter", "label": "t:sections.main_search.quick_links_source.filter" },
        { "value": "collections", "label": "t:sections.main_search.quick_links_source.collections" },
        { "value": "none", "label": "t:sections.main_search.quick_links_source.none" }
      ],
      "default": "filter"
    },
    {
      "type": "select",
      "id": "quick_filter_target",
      "label": "t:sections.main_search.quick_filter_target.label",
      "visible_if": "{{ section.settings.quick_links_source == 'filter' }}",
      "options": [
        { "value": "auto", "label": "t:sections.main_search.quick_filter_target.auto" },
        { "value": "name", "label": "t:sections.main_search.quick_filter_target.name" }
      ],
      "default": "auto"
    },
    {
      "type": "text",
      "id": "quick_filter_name",
      "label": "t:sections.main_search.quick_filter_name.label",
      "info": "t:sections.main_search.quick_filter_name.info",
      "visible_if": "{{ section.settings.quick_links_source == 'filter' and section.settings.quick_filter_target == 'name' }}"
    },
    {
      "type": "select",
      "id": "quick_links_limit",
      "label": "t:sections.main_search.quick_links_limit.label",
      "options": [
        { "value": "4", "label": "4" },
        { "value": "6", "label": "6" },
        { "value": "8", "label": "8" },
        { "value": "12", "label": "12" }
      ],
      "default": "6"
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "t:sections.main_search.show_filters.label",
      "default": true
    },
    {
      "type": "text",
      "id": "filter_button_label",
      "label": "t:sections.catalog.filter_button_label",
      "default": "Filter",
      "visible_if": "{{ section.settings.show_filters }}"
    },
    {
      "type": "header",
      "content": "t:sections.catalog.filter_drawer"
    },
    {
      "type": "color_scheme",
      "id": "drawer_color_scheme",
      "label": "t:sections.catalog.drawer_color_scheme",
      "default": "scheme_1",
      "visible_if": "{{ section.settings.show_filters }}"
    },
    {
      "type": "text",
      "id": "drawer_heading",
      "label": "t:sections.catalog.drawer_heading",
      "default": "Refine",
      "visible_if": "{{ section.settings.show_filters }}"
    },
    {
      "type": "select",
      "id": "drawer_position",
      "label": "t:sections.catalog.drawer_position",
      "options": [
        { "value": "start", "label": "t:sections.catalog.left" },
        { "value": "end", "label": "t:sections.catalog.right" }
      ],
      "default": "end",
      "visible_if": "{{ section.settings.show_filters }}"
    },
    {
      "type": "select",
      "id": "drawer_width",
      "label": "t:sections.catalog.drawer_width",
      "options": [
        { "value": "narrow", "label": "t:sections.catalog.narrow" },
        { "value": "medium", "label": "t:sections.catalog.medium" },
        { "value": "wide", "label": "t:sections.catalog.wide" }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.show_filters }}"
    },
    {
      "type": "select",
      "id": "mobile_drawer_style",
      "label": "t:sections.catalog.narrow_filter",
      "options": [
        { "value": "sheet", "label": "t:sections.catalog.bottom_sheet" },
        { "value": "side", "label": "t:sections.catalog.side_drawer" }
      ],
      "default": "sheet",
      "visible_if": "{{ section.settings.show_filters }}"
    },
    {
      "type": "select",
      "id": "filter_group_style",
      "label": "t:sections.catalog.filter_groups",
      "options": [
        { "value": "expanded", "label": "t:sections.catalog.open" },
        { "value": "accordion", "label": "t:sections.catalog.collapsible" }
      ],
      "default": "expanded",
      "visible_if": "{{ section.settings.show_filters }}"
    },
    {
      "type": "checkbox",
      "id": "open_first_filter",
      "label": "t:sections.catalog.open_first_filter",
      "default": true,
      "visible_if": "{{ section.settings.show_filters and section.settings.filter_group_style == 'accordion' }}"
    },
    {
      "type": "checkbox",
      "id": "show_filter_counts",
      "label": "t:sections.catalog.show_option_counts",
      "default": true,
      "visible_if": "{{ section.settings.show_filters }}"
    },
    {
      "type": "checkbox",
      "id": "show_filter_visuals",
      "label": "t:sections.catalog.show_filter_visuals",
      "default": true,
      "visible_if": "{{ section.settings.show_filters }}"
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "t:sections.main_search.show_sort.label",
      "default": true
    },
    {
      "type": "select",
      "id": "sort_placement",
      "label": "t:sections.catalog.sort_position",
      "options": [
        { "value": "bar", "label": "t:sections.catalog.control_bar" },
        { "value": "drawer", "label": "t:sections.catalog.filter_drawer" },
        { "value": "both", "label": "t:sections.catalog.both" }
      ],
      "default": "bar",
      "visible_if": "{{ section.settings.show_sort }}"
    },
    {
      "type": "select",
      "id": "sort_style",
      "label": "t:sections.catalog.sort_control",
      "options": [
        { "value": "dropdown", "label": "t:sections.catalog.animated_dropdown" },
        { "value": "native", "label": "t:sections.catalog.native_select" }
      ],
      "default": "dropdown",
      "visible_if": "{{ section.settings.show_sort and section.settings.sort_placement != 'drawer' }}"
    },
    {
      "type": "checkbox",
      "id": "show_sort_label",
      "label": "t:sections.catalog.show_sort_label",
      "default": false,
      "visible_if": "{{ section.settings.show_sort and section.settings.sort_placement != 'drawer' }}"
    },
    {
      "type": "select",
      "id": "sort_menu_width",
      "label": "t:sections.catalog.sort_menu_width",
      "options": [
        { "value": "narrow", "label": "t:sections.catalog.narrow" },
        { "value": "medium", "label": "t:sections.catalog.medium" },
        { "value": "wide", "label": "t:sections.catalog.wide" }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.show_sort and section.settings.sort_style == 'dropdown' and section.settings.sort_placement != 'drawer' }}"
    },
    {
      "type": "select",
      "id": "sort_menu_alignment",
      "label": "t:sections.catalog.sort_menu_alignment",
      "options": [
        { "value": "start", "label": "t:sections.catalog.left" },
        { "value": "end", "label": "t:sections.catalog.right" }
      ],
      "default": "end",
      "visible_if": "{{ section.settings.show_sort and section.settings.sort_style == 'dropdown' and section.settings.sort_placement != 'drawer' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_ajax",
      "label": "t:sections.main_search.enable_ajax.label",
      "info": "t:sections.main_search.enable_ajax.info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main_search.empty_search.content"
    },
    {
      "type": "checkbox",
      "id": "show_featured_when_empty",
      "label": "t:sections.main_search.show_featured_when_empty.label",
      "default": true
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "t:sections.main_search.featured_collection.label"
    },
    {
      "type": "text",
      "id": "featured_label",
      "label": "t:sections.main_search.featured_label.label",
      "default": "Featured products"
    },
    {
      "type": "range",
      "id": "featured_limit",
      "label": "t:sections.main_search.featured_limit.label",
      "min": 4,
      "max": 50,
      "step": 2,
      "default": 8
    },
    {
      "type": "header",
      "content": "t:sections.main_search.results.content"
    },
    {
      "type": "checkbox",
      "id": "show_result_count",
      "label": "t:sections.catalog.show_result_counts",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_resource_results",
      "label": "t:sections.catalog.show_resource_results",
      "default": true
    },
    {
      "type": "select",
      "id": "resource_style",
      "label": "t:sections.catalog.resource_style",
      "options": [
        { "value": "rows", "label": "t:sections.catalog.rows" },
        { "value": "cards", "label": "t:sections.catalog.cards" },
        { "value": "minimal", "label": "t:sections.catalog.minimal_links" }
      ],
      "default": "rows",
      "visible_if": "{{ section.settings.show_resource_results }}"
    },
    {
      "type": "text",
      "id": "resources_heading",
      "label": "t:sections.main_search.resources_heading.label",
      "default": "Pages and articles"
    },
    {
      "type": "textarea",
      "id": "no_results_text",
      "label": "t:sections.main_search.no_results_text.label",
      "default": "Check the spelling or try a broader search."
    },
    {
      "type": "text",
      "id": "browse_label",
      "label": "t:sections.main_search.browse_label.label",
      "default": "Browse all products"
    },
    {
      "type": "range",
      "id": "results_per_page",
      "label": "t:sections.main_search.results_per_page.label",
      "min": 8,
      "max": 50,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.main_search.columns.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "gap",
      "label": "t:sections.catalog.card_gap",
      "info": "t:sections.catalog.card_gap_info",
      "options": [
        { "value": "theme", "label": "t:sections.catalog.theme_product_gap" },
        { "value": "none", "label": "t:blocks.all.step.none" },
        { "value": "minimal", "label": "t:blocks.all.step.minimal" },
        { "value": "tiny", "label": "t:blocks.all.step.tiny" },
        { "value": "small", "label": "t:blocks.all.step.small" },
        { "value": "medium", "label": "t:blocks.all.step.medium" },
        { "value": "large", "label": "t:blocks.all.step.large" },
        { "value": "xlarge", "label": "t:blocks.all.step.xlarge" }
      ],
      "default": "theme"
    },
    {
      "type": "select",
      "id": "grid_motion",
      "label": "t:sections.catalog.result_grid_animation",
      "options": [
        { "value": "none", "label": "t:sections.catalog.none" },
        { "value": "fade", "label": "t:sections.catalog.fade" },
        { "value": "reference", "label": "t:sections.catalog.reference_rise_stagger" }
      ],
      "default": "reference"
    },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "t:sections.catalog.pagination_style",
      "options": [
        { "value": "round", "label": "t:sections.catalog.round_pages" },
        { "value": "minimal", "label": "t:sections.catalog.minimal" }
      ],
      "default": "round"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing_header"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
