{%- comment -%}
  Navigation.

  A single <nav> that morphs rather than two elements swapping: the bar is the
  resting state and adding .nav--pill transitions width, height, offset, radius
  and padding into the centred pill. That way the transition the design
  describes actually runs, and there is one thing to keep accessible.

  The pill mode is emitted server-side rather than added by JavaScript, because
  it is a resting state, not a reaction to scrolling — the design's homepage is
  a pill from the first paint. Only the morph mode needs a scroll listener.

  Menu rows can be composed as individual blocks for the preset art direction,
  or supplied by a native Shopify menu when nested navigation is needed.
{%- endcomment -%}

{%- liquid
  assign menu_id = 'nav-menu-' | append: section.id
  assign menu_blocks = section.blocks | where: 'type', 'menu'
  assign menu_block = menu_blocks.first
  assign menu_links = menu_block.settings.menu.links
  assign cart_name = settings.cart_name | default: 'Cart'
  assign account_menu_handle = section.settings.customer_account_menu.handle

  assign cart_drawer = false
  if settings.cart_type == 'drawer'
    assign cart_drawer = true
  endif

  assign search_mode = settings.search_type | default: 'menu'
  assign search_overlay = false
  unless search_mode == 'page'
    assign search_overlay = true
  endunless

  assign menu_mode = section.settings.menu_type | default: 'menu'

  comment
    The overlay numbers every row continuously, including the two action rows,
    so the count has to follow whatever the merchant has switched on.
  endcomment
  assign n = menu_links.size
  assign cart_number = 0
  assign search_number = 0
  if section.settings.show_cart
    assign n = n | plus: 1
    assign cart_number = n
  endif
  if section.settings.show_search
    assign n = n | plus: 1
    assign search_number = n
  endif

  comment
    Overlay the first section only where a section is designed to sit under the
    nav. Elsewhere reserve the bar's height so content is not covered.
  endcomment
  comment
    The design's product page holds the nav transparent until the visitor
    scrolls: the bar's links stand over the gallery with no ground of their
    own, and the solid ground arrives with the scroll — the home hero's
    overlay arrangement on the product template, behind a checkbox. The bar
    also takes the product page's own scheme, because a noir bar over a
    porcelain gallery was nobody's decision.
  endcomment
  assign nav_transparent = false
  if template.name == 'product' and section.settings.nav_product_transparent
    assign nav_transparent = true
  endif

  assign overlay = false
  if section.settings.overlay_home and template.name == 'index'
    assign overlay = true
  endif
  if nav_transparent
    assign overlay = true
  endif

  comment
    The design gives the homepage and the inner pages different navs — a
    floating pill over the hero, a full bar everywhere else. A section group is
    shared by every template, so the two states are two settings rather than
    one, and the template picks between them.
  endcomment
  assign nav_mode = section.settings.nav_mode
  if template.name == 'index'
    assign nav_mode = section.settings.nav_mode_home
  endif
  if section.settings.header_layout == 'classic'
    assign nav_mode = 'bar'
  endif

  comment
    One scheme for the bar on every template — the solid bar a visitor sees
    on scroll is the same bar everywhere, on request. The transparent
    resting state needs no scheme of its own: base.css hands it the page's
    ink and gold brand tokens, which is what keeps its links readable over
    the light gallery without forking the navigation's colour.
  endcomment

  comment
    The pill is the resting state for both the always-pill and the morphing
    nav — morphing expands it into the bar on scroll, it does not collapse a
    bar into a pill. Emitting that resting state from Liquid rather than from
    JavaScript means the first paint is already right.
  endcomment
  assign is_pill = false
  if nav_mode == 'pill' or nav_mode == 'morph'
    assign is_pill = true
  endif
-%}

{%- capture overlay_huge_text -%}
  {% render 'huge-text', source: section.settings.huge_text_value, placement: 'header-overlay', on_dark: true, display: section.settings.brand_display, logo_side: section.settings.brand_logo_side, logo_variant: section.settings.brand_logo_variant %}
{%- endcapture -%}

<nav
  class="nav nav--{{ section.settings.header_layout | default: 'art_directed' }} scheme-{{ section.settings.color_scheme }}{% if overlay %} nav--overlay{% endif %}{% if is_pill %} nav--pill{% endif %}{% if nav_mode != 'morph' and nav_transparent == false %} is-solid{% endif %}"
  data-nav
  data-nav-mode="{{ nav_mode }}"
  {% if nav_transparent %}data-nav-transparent{% endif %}
  {% if nav_transparent and section.settings.brand_logo_swap_fade %}data-nav-logo-fade{% endif %}
  data-nav-threshold="{{ section.settings.scroll_threshold }}"
  aria-label="{{ 'accessibility.primary_navigation' | t }}"
>
  <button
    class="nav__menu-button"
    type="button"
    data-overlay-open="menu"
    aria-controls="{{ menu_id }}"
    aria-expanded="false"
    aria-label="{{ 'navigation.menu' | t | escape }}"
  >
    <span class="nav__bars" aria-hidden="true">
      <span></span>
      <span></span>
    </span>
    <span class="nav__menu-label" data-nav-text>{{ 'navigation.menu' | t }}</span>
  </button>

  <a class="nav__logo" href="{{ routes.root_url }}">
    {% render 'huge-text', source: section.settings.huge_text_value, placement: 'header', display: section.settings.brand_display, logo_side: section.settings.brand_logo_side, logo_variant: section.settings.brand_logo_variant, transparent: nav_transparent, logo_variant_transparent: section.settings.brand_logo_variant_transparent %}
  </a>

  {%- if section.settings.header_layout == 'classic' and menu_links.size > 0 -%}
    <ul class="nav__inline-menu" role="list">
      {%- for link in menu_links -%}
        <li class="nav__inline-item{% if link.links.size > 0 %} has-children{% endif %}">
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
          {%- if link.links.size > 0 -%}
            <div class="nav__inline-submenu">
              {%- for child_link in link.links -%}
                <a href="{{ child_link.url }}"{% if child_link.current %} aria-current="page"{% endif %}>{{ child_link.title }}</a>
                {%- for grandchild_link in child_link.links -%}
                  <a class="nav__inline-grandchild" href="{{ grandchild_link.url }}"{% if grandchild_link.current %} aria-current="page"{% endif %}>{{ grandchild_link.title }}</a>
                {%- endfor -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  <div class="nav__actions">
    {%- if section.settings.show_contact and section.settings.contact_link != blank -%}
      <a class="nav__action nav__action--contact" href="{{ section.settings.contact_link }}">
        {{ section.settings.contact_label | default: 'Contact' }}
      </a>
    {%- endif -%}

    {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
      <shopify-account class="nav__account-component"{% if account_menu_handle != blank %} menu="{{ account_menu_handle }}"{% endif %}>
        <span slot="signed-out-avatar" class="nav__action nav__action--account">
          {% render 'icon', icon: 'nav-account' %}
          <span class="nav__action-label">{{ 'accessibility.account' | t }}</span>
        </span>
      </shopify-account>
    {%- endif -%}

    {%- comment -%}
      Both actions stay real links. theme.js upgrades them to the overlay and
      the drawer when those are switched on, so nothing breaks without it.
    {%- endcomment -%}
    {%- if section.settings.show_search -%}
      <a
        class="nav__action"
        href="{{ routes.search_url }}"
        aria-label="{{ 'general.search.search' | t | escape }}"
        {% if search_overlay %}data-search-open{% endif %}
      >
        {% render 'icon', icon: 'nav-search' %}
        <span class="nav__action-label">{{ 'general.search.search' | t }}</span>
      </a>
    {%- endif -%}

    {%- if section.settings.show_cart -%}
      <a
        class="nav__action"
        href="{{ routes.cart_url }}"
        aria-label="{{ cart_name | escape }}"
        {% if cart_drawer %}data-drawer-open{% endif %}
      >
        {% render 'icon', icon: 'nav-bag' %}
        <span class="nav__action-label">{{ cart_name }}</span>
        <span
          class="nav__count"
          data-cart-count
          {% if cart.item_count == 0 %}hidden{% endif %}
        >{{ cart.item_count }}</span>
      </a>

      {%- comment -%}
        Adding to the bag changed the number in the corner and said nothing.
        The whole theme had two live regions and both belonged to search, so a
        screen reader user could add a piece and get no confirmation that
        anything had happened.

        It sits outside the link on purpose: a live region inside an
        interactive element announces unpredictably, and the link's own
        accessible name already ends with the count. `role="status"` carries
        `aria-live="polite"` implicitly, and the pair is stated for engines
        that map only one of them.
      {%- endcomment -%}
      <span
        class="visually-hidden"
        role="status"
        aria-live="polite"
        data-cart-status
      ></span>
    {%- endif -%}
  </div>
</nav>

{%- unless overlay -%}
  <div class="nav-spacer" aria-hidden="true"></div>
{%- endunless -%}

{% render 'nav-menu',
  section: section,
  menu_id: menu_id,
  cart_number: cart_number,
  search_number: search_number,
  cart_drawer: cart_drawer,
  search_overlay: search_overlay,
  overlay_huge_text: overlay_huge_text,
  mode: menu_mode
%}

{%- if search_overlay -%}
  {% render 'search-overlay', section: section, overlay_huge_text: overlay_huge_text, mode: search_mode %}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.header.name",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.header.style_header"
    },
    {
      "type": "select",
      "id": "header_layout",
      "label": "t:sections.header.header_layout.label",
      "info": "t:sections.header.header_layout.info",
      "options": [
        { "value": "art_directed", "label": "t:sections.header.header_layout.art_directed" },
        { "value": "classic", "label": "t:sections.header.header_layout.classic" }
      ],
      "default": "art_directed"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "info": "t:sections.header.color_scheme.info",
      "default": "scheme_2"
    },
    {
      "type": "text",
      "id": "huge_text_value",
      "label": "t:sections.header.wordmark_text.label",
      "default": "STORE NAME"
    },
    {
      "type": "select",
      "id": "brand_display",
      "label": "t:sections.all.brand_display.label",
      "info": "t:sections.all.brand_display.info",
      "options": [
        { "value": "auto", "label": "t:sections.all.brand_display.auto" },
        { "value": "wordmark", "label": "t:sections.all.brand_display.wordmark" },
        { "value": "logo", "label": "t:sections.all.brand_display.logo" },
        { "value": "both", "label": "t:sections.all.brand_display.both" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "brand_logo_side",
      "label": "t:sections.all.brand_logo_side.label",
      "options": [
        { "value": "start", "label": "t:sections.all.brand_logo_side.start" },
        { "value": "end", "label": "t:sections.all.brand_logo_side.end" }
      ],
      "default": "start",
      "visible_if": "{{ section.settings.brand_display == 'both' }}"
    },
    {
      "type": "select",
      "id": "brand_logo_variant",
      "label": "t:sections.all.brand_logo_variant.label",
      "info": "t:sections.all.brand_logo_variant.info",
      "options": [
        { "value": "auto", "label": "t:sections.all.brand_logo_variant.auto" },
        { "value": "logo", "label": "t:sections.all.brand_logo_variant.logo" },
        { "value": "inverted", "label": "t:sections.all.brand_logo_variant.inverted" }
      ],
      "default": "auto",
      "visible_if": "{{ section.settings.brand_display != 'wordmark' }}"
    },
    {
      "type": "select",
      "id": "brand_logo_variant_transparent",
      "label": "t:sections.header.brand_logo_variant_transparent.label",
      "info": "t:sections.header.brand_logo_variant_transparent.info",
      "options": [
        { "value": "match", "label": "t:sections.header.brand_logo_variant_transparent.match" },
        { "value": "logo", "label": "t:sections.all.brand_logo_variant.logo" },
        { "value": "inverted", "label": "t:sections.all.brand_logo_variant.inverted" }
      ],
      "default": "match",
      "visible_if": "{{ section.settings.nav_product_transparent and section.settings.brand_display != 'wordmark' }}"
    },
    {
      "type": "checkbox",
      "id": "brand_logo_swap_fade",
      "label": "t:sections.header.brand_logo_swap_fade.label",
      "info": "t:sections.header.brand_logo_swap_fade.info",
      "default": true,
      "visible_if": "{{ section.settings.nav_product_transparent and section.settings.brand_logo_variant_transparent != 'match' }}"
    },
    {
      "type": "header",
      "content": "t:sections.header.behavior_header"
    },
    {
      "type": "paragraph",
      "content": "t:sections.header.nav_mode.paragraph"
    },
    {
      "type": "select",
      "id": "nav_mode_home",
      "label": "t:sections.header.nav_mode.home_label",
      "options": [
        { "value": "bar", "label": "t:sections.header.nav_mode.bar" },
        { "value": "morph", "label": "t:sections.header.nav_mode.morph" },
        { "value": "pill", "label": "t:sections.header.nav_mode.pill" }
      ],
      "default": "morph"
    },
    {
      "type": "checkbox",
      "id": "overlay_home",
      "label": "t:sections.header.overlay_home.label",
      "info": "t:sections.header.overlay_home.info",
      "default": true
    },
    {
      "type": "select",
      "id": "nav_mode",
      "label": "t:sections.header.nav_mode.inner_label",
      "options": [
        { "value": "bar", "label": "t:sections.header.nav_mode.bar" },
        { "value": "morph", "label": "t:sections.header.nav_mode.morph" },
        { "value": "pill", "label": "t:sections.header.nav_mode.pill" }
      ],
      "default": "bar"
    },
    {
      "type": "checkbox",
      "id": "nav_product_transparent",
      "label": "t:sections.header.nav_product_transparent.label",
      "info": "t:sections.header.nav_product_transparent.info",
      "default": false
    },
    {
      "type": "range",
      "id": "scroll_threshold",
      "label": "t:sections.header.scroll_threshold.label",
      "info": "t:sections.header.scroll_threshold.info",
      "min": 0,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 60,
      "visible_if": "{{ section.settings.nav_mode_home == 'morph' or section.settings.nav_mode == 'morph' or section.settings.nav_product_transparent }}"
    },
    {
      "type": "header",
      "content": "t:sections.header.actions_header"
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "t:sections.header.show_contact.label",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "t:sections.header.contact_label.label",
      "default": "Contact",
      "visible_if": "{{ section.settings.show_contact }}"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "t:sections.header.contact_link.label",
      "visible_if": "{{ section.settings.show_contact }}"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "t:sections.header.show_account.label",
      "default": true
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:sections.header.customer_account_menu.label",
      "info": "t:sections.header.customer_account_menu.info",
      "default": "main-menu",
      "visible_if": "{{ section.settings.show_account }}"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:sections.header.show_search.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "t:sections.header.show_cart.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.header.search_header"
    },
    {
      "type": "paragraph",
      "content": "t:sections.header.search_paragraph"
    },
    {
      "type": "text",
      "id": "search_popular",
      "label": "t:sections.header.search_popular.label",
      "info": "t:sections.header.search_popular.info",
      "default": "New arrivals, Best sellers, Gifts, Essentials",
      "visible_if": "{{ settings.search_type != 'page' }}"
    },
    {
      "type": "collection",
      "id": "search_collection",
      "label": "t:sections.header.search_collection.label",
      "info": "t:sections.header.search_collection.info"
    },
    {
      "type": "header",
      "content": "t:sections.header.menu_header"
    },
    {
      "type": "select",
      "id": "menu_type",
      "label": "t:sections.header.menu_type.label",
      "info": "t:sections.header.menu_type.info",
      "options": [
        { "value": "menu", "label": "t:sections.header.menu_type.menu" },
        { "value": "drawer", "label": "t:sections.header.menu_type.drawer" }
      ],
      "default": "menu"
    },
    {
      "type": "color_scheme",
      "id": "menu_drawer_color_scheme",
      "label": "t:sections.header.menu_drawer_color_scheme.label",
      "default": "scheme_1",
      "visible_if": "{{ section.settings.menu_type == 'drawer' }}"
    },
    {
      "type": "paragraph",
      "content": "t:sections.header.menu_paragraph"
    },
    {
      "type": "paragraph",
      "content": "t:sections.header.menu_address_paragraph"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:sections.header.blocks.category.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.all.link_label.label",
          "default": "Rings"
        },
        {
          "type": "url",
          "id": "url",
          "label": "t:sections.all.link.label"
        }
      ]
    },
    {
      "type": "menu",
      "name": "t:sections.header.blocks.menu.name",
      "limit": 1,
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.header.blocks.menu.menu.label",
          "info": "t:sections.header.blocks.menu.menu.info",
          "default": "main-menu"
        }
      ]
    },
    {
      "type": "social",
      "name": "t:sections.footer.blocks.social.name",
      "limit": 1,
      "settings": [
        { "type": "url", "id": "instagram", "label": "t:blocks.icon.icons.instagram" },
        { "type": "url", "id": "facebook", "label": "t:blocks.icon.icons.facebook" },
        { "type": "url", "id": "pinterest", "label": "t:blocks.icon.icons.pinterest" },
        { "type": "url", "id": "tiktok", "label": "t:blocks.icon.icons.tiktok" },
        { "type": "url", "id": "youtube", "label": "t:blocks.icon.icons.youtube" },
        { "type": "url", "id": "x", "label": "t:blocks.icon.icons.x" }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
