    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.craft.video.label",
      "info": "t:sections.craft.video.info"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.all.image.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
