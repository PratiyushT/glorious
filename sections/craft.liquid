    },
    {
      "type": "checkbox",
      "id": "show_frame",
      "label": "t:sections.craft.show_frame.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing_header"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.all.space_step.none"
        },
        {
          "value": "2xs",
          "label": "t:sections.all.space_step.2xs"
        },
        {
          "value": "xs",
          "label": "t:sections.all.space_step.xs"
        },
        {
          "value": "sm",
          "label": "t:sections.all.space_step.sm"
        },
        {
          "value": "md",
          "label": "t:sections.all.space_step.md"
        },
        {
          "value": "lg",
          "label": "t:sections.all.space_step.lg"
        },
        {
          "value": "xl",
          "label": "t:sections.all.space_step.xl"
        },
        {
          "value": "max",
          "label": "t:sections.all.space_step.max"
        }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.all.space_step.none"
        },
        {
          "value": "2xs",
          "label": "t:sections.all.space_step.2xs"
        },
        {
          "value": "xs",
          "label": "t:sections.all.space_step.xs"
        },
        {
          "value": "sm",
          "label": "t:sections.all.space_step.sm"
        },
        {
          "value": "md",
          "label": "t:sections.all.space_step.md"
        },
        {
          "value": "lg",
          "label": "t:sections.all.space_step.lg"
        },
        {
          "value": "xl",
          "label": "t:sections.all.space_step.xl"
