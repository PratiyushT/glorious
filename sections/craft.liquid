{%- comment -%}
  The Craft. Framed media beside the house standards.

  Specification rows are blocks, so the merchant controls how many there are
  and what each says.
{%- endcomment -%}

{%- comment -%}
  The anchor the design gives this section — the About section's second button
  points at /#craft.
{%- endcomment -%}
<section
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handle }}"{% endif %}
  class="section scheme-{{ section.settings.color_scheme }}{% if section.settings.full_height %} section--tall{% endif %}"
  style="{% render 'section-style', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}"
>
  <div class="page-width page-width--narrow">
    <div class="split{% if section.settings.layout == 'text_first' %} split--reverse{% endif %}" style="--split-min: 21rem;">
      <div class="craft__media reveal">
        <div class="{% if section.settings.show_frame %}media-frame{% endif %}">
          <div class="media" style="aspect-ratio: {{ section.settings.image_ratio }};">
            {%- if section.settings.video != blank -%}
              {%- assign video_lqip = section.settings.video.preview_image | image_url: width: 40 -%}
              {{
                section.settings.video
                | video_tag:
                  image_size: '1200x',
                  loop: true,
                  muted: true,
                  controls: false,
                  data-video-lqip: video_lqip,
                  data-video-autoplay: true
              }}
              {% render 'video-lqip-frame', lqip: video_lqip %}
            {%- elsif section.settings.image != blank -%}
              {%- render 'responsive-image',
                  image: section.settings.image,
                  sizes: '(min-width: 60rem) 45vw, 100vw',
                  widths: '400,700,1000,1400',
                  src_width: 1200 -%}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="stack reveal" style="--reveal-delay: 120ms;">
        {%- if section.settings.subheading != blank -%}
          <span class="micro">{{ section.settings.subheading }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="rte measure">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- comment -%}

          Theme blocks. Both of this section's local types converted in one

          commit, because a section holds either its own blocks or theme

          blocks and never both.

        {%- endcomment -%}

        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.craft.name",
  "tag": "div",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_2"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.subheading.label",
      "default": "The Craft"
    },
