{%- comment -%}
  The Craft. Framed media beside the house standards.

  Specification rows are blocks, so the merchant controls how many there are
  and what each says.
{%- endcomment -%}

{%- comment -%}
  The anchor the design gives this section — the About section's second button
  points at /#craft.
{%- endcomment -%}
<section
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handle }}"{% endif %}
  class="section scheme-{{ section.settings.color_scheme }}{% if section.settings.full_height %} section--tall{% endif %}"
  style="{% render 'section-style', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}"
>
  <div class="page-width page-width--narrow">
    <div class="split{% if section.settings.layout == 'text_first' %} split--reverse{% endif %}" style="--split-min: 21rem;">
      <div class="craft__media reveal">
        <div class="{% if section.settings.show_frame %}media-frame{% endif %}">
          <div class="media" style="aspect-ratio: {{ section.settings.image_ratio }};">
            {%- if section.settings.video != blank -%}
              {%- assign video_lqip = section.settings.video.preview_image | image_url: width: 40 -%}
              {{
                section.settings.video
                | video_tag:
                  image_size: '1200x',
                  loop: true,
                  muted: true,
                  controls: false,
                  data-video-lqip: video_lqip,
                  data-video-autoplay: true
              }}
              {% render 'video-lqip-frame', lqip: video_lqip %}
            {%- elsif section.settings.image != blank -%}
              <img
                src="{{ section.settings.image | image_url: width: 1200 }}"
                data-image-lqip="{{ section.settings.image | image_url: width: 40 }}"
                srcset="{{ section.settings.image | image_url: width: 400 }} 400w, {{ section.settings.image | image_url: width: 700 }} 700w, {{ section.settings.image | image_url: width: 1000 }} 1000w, {{ section.settings.image | image_url: width: 1400 }} 1400w"
                sizes="(min-width: 60rem) 45vw, 100vw"
                alt="{{ section.settings.image.alt | escape }}"
                width="{{ section.settings.image.width }}"
                height="{{ section.settings.image.height }}"
                loading="lazy"
              >
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="stack reveal" style="--reveal-delay: 120ms;">
        {%- if section.settings.subheading != blank -%}
          <span class="micro">{{ section.settings.subheading }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="rte measure">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- assign spec_blocks = section.blocks | where: 'type', 'spec' -%}
        {%- if spec_blocks.size > 0 -%}
          <div class="measure">
            {%- for block in spec_blocks -%}
              {%- render 'spec-row',
                label: block.settings.label,
                value: block.settings.value,
                attributes: block.shopify_attributes -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'buttons' -%}
            {%- comment -%}
              A label without a link renders nothing — see about.liquid.
            {%- endcomment -%}
            <div class="btn-row" {{ block.shopify_attributes }}>
              {%- render 'button',
                label: block.settings.button_label,
                link: block.settings.button_link,
                style: block.settings.button_style,
                size: block.settings.button_size,
                radius: block.settings.button_radius -%}
              {%- render 'button',
                label: block.settings.button_label_2,
                link: block.settings.button_link_2,
                style: block.settings.button_style_2,
                size: block.settings.button_size_2,
                radius: block.settings.button_radius_2 -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
