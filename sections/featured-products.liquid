{%- comment -%}
  Featured products — the "Most Loved" row. A display heading, a micro label
  and a link out, above a grid that reflows on available width.
{%- endcomment -%}

{%- liquid
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.products_to_show

  assign view_all = section.settings.view_all_label
  if view_all == blank and collection != blank
    assign view_all = 'collections.view_all_count' | t: count: collection.all_products_count
  elsif view_all == blank
    assign view_all = 'collections.view_all' | t
  endif
-%}

<section
  class="section scheme-{{ section.settings.color_scheme }}{% if section.settings.full_height %} section--tall{% endif %}"
  style="{% render 'section-style', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="display reveal">{{ section.settings.heading }}</div>
    {%- endif -%}

    {%- if section.settings.subheading != blank or section.settings.show_view_all -%}
      <div class="section-header reveal">
        {%- if section.settings.subheading != blank -%}
          <span class="micro">{{ section.settings.subheading }}</span>
        {%- endif -%}

        {%- if section.settings.show_view_all -%}
          <a class="link-rule" href="{{ collection.url | default: routes.all_products_collection_url }}">
            {{ view_all }}&nbsp;&nbsp;&rarr;
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      --min-pct lets the track floor fall below --grid-min on narrow screens.
      At 46% two cards still fit on a phone, which is what the design does;
      at 100% the grid drops to a single column instead.
    {%- endcomment -%}
    <div
      class="grid-auto"
      style="--cols: {{ section.settings.columns }}; --gap: var(--grid-gap); --min-pct: {% if section.settings.mobile_columns == '2' %}46%{% else %}100%{% endif %};"
    >
      {%- if collection.products.size > 0 -%}
        {%- for product in collection.products limit: limit -%}
          <div class="reveal" style="--reveal-delay: {{ forloop.index0 | times: 60 }}ms;">
            {% render 'product-card', product: product %}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <div class="reveal" style="--reveal-delay: {{ forloop.index0 | times: 60 }}ms;">
            {% render 'product-card' %}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured_products.name",
  "tag": "div",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "Most Loved"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.subheading.label",
      "default": "Our most loved creations"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured_products.collection.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.featured_products.products_to_show.label",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.featured_products.columns.label",
      "info": "t:sections.featured_products.columns.info",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:sections.featured_products.mobile_columns.label",
      "info": "t:sections.featured_products.mobile_columns.info",
      "options": [
        { "value": "1", "label": "t:sections.featured_products.mobile_columns.one" },
        { "value": "2", "label": "t:sections.featured_products.mobile_columns.two" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.featured_products.show_view_all.label",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:sections.featured_products.view_all_label.label",
      "info": "t:sections.featured_products.view_all_label.info"
    },
    {
      "type": "checkbox",
      "id": "full_height",
      "label": "t:sections.all.full_height.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing_header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [{ "name": "t:sections.featured_products.name" }]
}
{% endschema %}
