{{ 'content-pages.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign content_gap = 'var(--grid-gap)'
  unless section.settings.gap == 'theme'
    if section.settings.gap == 'none'
      assign content_gap = '0'
    else
      assign content_gap = 'var(--step-' | append: section.settings.gap | append: ')'
    endif
  endunless
-%}

<section
  class="section content-surface scheme-{{ section.settings.color_scheme }}"
  style="{% render 'section-style', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %} --content-columns: {{ section.settings.columns }}; --content-grid-gap: {{ content_gap }};"
>
  <div class="page-width content-surface__inner">
    {%- paginate blog.articles by section.settings.articles_per_page -%}
      {%- if blog.articles_count > 0 -%}
        <div class="article-grid">
          {%- for article in blog.articles -%}
            {% content_for 'block', type: '_article-card', id: 'article-card', closest.article: article %}
          {%- endfor -%}
        </div>
        {% render 'catalog-pagination', paginate: paginate %}
      {%- else -%}
        <div class="content-surface__inner content-surface__inner--narrow align-center">
          <h2>{{ 'blogs.empty.title' | t }}</h2>
          <p>{{ 'blogs.empty.text' | t }}</p>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_blog.name",
  "enabled_on": { "templates": ["blog"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.color_scheme.label", "default": "scheme_1" },
    { "type": "range", "id": "articles_per_page", "label": "t:sections.main_blog.articles_per_page", "min": 3, "max": 24, "step": 3, "default": 12 },
    { "type": "range", "id": "columns", "label": "t:sections.main_blog.columns", "min": 1, "max": 4, "step": 1, "default": 3 },
    {
      "type": "select", "id": "gap", "label": "t:sections.catalog.card_gap",
      "options": [
        { "value": "theme", "label": "t:sections.catalog.theme_product_gap" },
        { "value": "none", "label": "t:blocks.all.step.none" },
        { "value": "tiny", "label": "t:blocks.all.step.tiny" },
        { "value": "small", "label": "t:blocks.all.step.small" },
        { "value": "medium", "label": "t:blocks.all.step.medium" },
        { "value": "large", "label": "t:blocks.all.step.large" },
        { "value": "xlarge", "label": "t:blocks.all.step.xlarge" }
      ],
      "default": "theme"
    },
    { "type": "header", "content": "t:sections.all.spacing_header" },
    {
      "type": "select", "id": "padding_top", "label": "t:sections.all.padding_top.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" }, { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" }, { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" }, { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" }, { "value": "max", "label": "t:sections.all.space_step.max" }
      ], "default": "lg"
    },
    {
      "type": "select", "id": "padding_bottom", "label": "t:sections.all.padding_bottom.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" }, { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" }, { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" }, { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" }, { "value": "max", "label": "t:sections.all.space_step.max" }
      ], "default": "lg"
    }
  ]
}
{% endschema %}
