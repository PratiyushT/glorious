{%- comment -%}
  Category grid — the "Our Products" panel. Each category is a block pointing
  at a collection, with title, count and image falling back to the collection's
  own data so a merchant only overrides what they want to differ.

  The row is either that grid — unchanged, and the default — or the carousel
  Most Loved offers, from the same `snippets/row-carousel.liquid`: the same two
  motions, the same arrows in the same three places, the same travelling marks.
  One component, so the two rows can never drift apart, and the cards are the
  only thing either section renders for itself.
{%- endcomment -%}

{%- liquid
  assign is_carousel = false
  if section.settings.layout == 'carousel'
    assign is_carousel = true
  endif

  assign carousel_label = section.settings.heading
  if carousel_label == blank
    assign carousel_label = 'general.carousel.label' | t
  endif
-%}

<section
  class="section scheme-{{ section.settings.color_scheme }}"
  style="{% render 'section-style', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="display reveal">{{ section.settings.heading }}</div>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <div class="section-header reveal">
        <span class="micro">{{ section.settings.subheading }}</span>
      </div>
    {%- endif -%}

    {%- comment -%}
      22.5rem is the design's 360px floor, and it is what decides when the row
      breaks. At 20rem the grid fitted an extra column roughly 120px of width
      too early at every tier.

      The carousel reads the same properties off the very same element — its
      ruler carries `.grid-auto`'s width expression and inherits these — so
      neither layout can answer the column question differently.
    {%- endcomment -%}
    {%- capture grid_vars -%}
      --cols: {{ section.settings.columns }}; --gap: var(--grid-gap); --min: 22.5rem;
    {%- endcapture -%}

    {%- comment -%}
      The cards are identical in both layouts. In the grid each carries its own
      `.reveal` and the design's 80ms stagger; in the carousel the component
      reveals as a whole and the cards' entrance is `gj-card`, staggered by
      their place in the visible page.
    {%- endcomment -%}
    {%- capture cells -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = collections[block.settings.collection]
          assign title = block.settings.title | default: collection.title
          assign image = block.settings.image | default: collection.featured_image
          assign url = collection.url | default: routes.all_products_collection_url
        -%}
        {%- if is_carousel -%}<div class="row-carousel__cell" data-row-cell>{%- endif -%}
        <a
          class="cat-card{% unless is_carousel %} reveal{% endunless %}"
          href="{{ url }}"
          {% unless is_carousel %}style="--reveal-delay: {{ forloop.index0 | times: 80 }}ms;"{% endunless %}
          {{ block.shopify_attributes }}
        >
          <span class="cat-card__head">
            {%- comment -%}
              The arrow is 0.7em in the design (`<span style="font-size:.7em">→`),
              not the heading's own size — it was set loose in the text node and
              rendered as large as the word beside it.
            {%- endcomment -%}
            <span>
              {{- title | default: 'Category' -}}
              &nbsp;&nbsp;<span class="cat-card__head-arrow">&rarr;</span>
            </span>
            {%- if section.settings.show_counts and collection != blank -%}
              <span class="cat-card__count">{{ collection.all_products_count }}</span>
            {%- endif -%}
          </span>

          <span class="cat-card__rule" aria-hidden="true"></span>

          <span class="cat-card__media" style="aspect-ratio: {{ section.settings.image_ratio }};">
            {%- if image != blank -%}
              <img
                src="{{ image | image_url: width: 900 }}"
                srcset="{{ image | image_url: width: 300 }} 300w, {{ image | image_url: width: 500 }} 500w, {{ image | image_url: width: 700 }} 700w, {{ image | image_url: width: 1000 }} 1000w"
                sizes="(min-width: 60rem) 25vw, 100vw"
                alt="{{ image.alt | default: title | escape }}"
                width="{{ image.width }}"
                height="{{ image.height }}"
                loading="lazy"
              >
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}

            {%- comment -%}
              Three elements, as the design has it: the veil, the rule that
              sits on it, and the label and the arrow as separate children of
              that rule. The label was a bare text node with only the arrow
              wrapped, which left `.cat-card__reveal span` — a *descendant*
              selector — styling the arrow as though it were the rule: its own
              border-top, its own margins and a full-width box. That is the
              second line across the photograph, and it is what pushed "View
              pieces" onto two rows.
            {%- endcomment -%}
            <span class="cat-card__reveal" aria-hidden="true">
              <span class="cat-card__reveal-row">
                <span class="cat-card__reveal-label">
                  {{- block.settings.link_label | default: 'View pieces' -}}
                </span>
                <span class="cat-card__reveal-arrow">&rarr;</span>
              </span>
            </span>
          </span>
        </a>
        {%- if is_carousel -%}</div>{%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if is_carousel -%}
      {%- render 'row-carousel',
        cells: cells,
        count: section.blocks.size,
        motion: section.settings.carousel_motion,
        arrows: section.settings.carousel_arrows,
        label: carousel_label,
        track_style: grid_vars
      -%}
    {%- else -%}
      <div class="grid-auto" style="{{ grid_vars | strip }}">
        {{ cells }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.category_grid.name",
  "tag": "div",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_3"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "Our Products"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.subheading.label"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.category_grid.columns.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.all.layout.label",
      "info": "t:sections.all.layout.info",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.all.layout.grid"
        },
        {
          "value": "carousel",
          "label": "t:sections.all.layout.carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "carousel_motion",
      "label": "t:sections.all.carousel_motion.label",
      "info": "t:sections.all.carousel_motion.info",
      "options": [
        {
          "value": "slide",
          "label": "t:sections.all.carousel_motion.slide"
        },
        {
          "value": "fade",
          "label": "t:sections.all.carousel_motion.fade"
        }
      ],
      "default": "slide",
      "visible_if": "{{ section.settings.layout == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "carousel_arrows",
      "label": "t:sections.all.carousel_arrows.label",
      "info": "t:sections.all.carousel_arrows.info",
      "options": [
        {
          "value": "bottom",
          "label": "t:sections.all.carousel_arrows.bottom"
        },
        {
          "value": "top",
          "label": "t:sections.all.carousel_arrows.top"
        },
        {
          "value": "side",
          "label": "t:sections.all.carousel_arrows.side"
        }
      ],
      "default": "bottom",
      "visible_if": "{{ section.settings.layout == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.category_grid.image_ratio.label",
      "options": [
        { "value": "1 / 1", "label": "t:settings_schema.options.square" },
        { "value": "4 / 5", "label": "t:settings_schema.options.portrait" },
        { "value": "3 / 4", "label": "t:settings_schema.options.tall_portrait" },
        { "value": "4 / 3", "label": "t:settings_schema.options.landscape" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "checkbox",
      "id": "show_counts",
      "label": "t:sections.category_grid.show_counts.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing_header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 76
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:sections.category_grid.blocks.category.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.category_grid.blocks.category.collection.label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.category_grid.blocks.category.title.label",
          "info": "t:sections.category_grid.blocks.category.title.info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.category_grid.blocks.category.image.label",
          "info": "t:sections.category_grid.blocks.category.image.info"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.category_grid.blocks.category.link_label.label",
          "default": "View pieces"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.category_grid.name",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
