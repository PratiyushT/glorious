{%- comment -%}
  The section counterpart to blocks/group.liquid.

  It owns only section concerns — colour scheme, page measure, anchor, height,
  padding, and the layout of its direct blocks. Content is entirely public
  theme blocks or app blocks. A nested Group block creates another row or
  column, which is enough to compose the former About, Craft, and Visit
  sections without three section implementations.
{%- endcomment -%}

{%- liquid
  assign width_class = 'page-width'
  case section.settings.content_width
    when 'narrow'
      assign width_class = 'page-width page-width--narrow'
    when 'reading'
      assign width_class = 'page-width page-width--reading'
    when 'full'
      assign width_class = 'page-width group-section__width--full'
    when 'edge'
      assign width_class = 'group-section__width--edge'
  endcase
-%}

<section
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handle }}"{% endif %}
  class="section group-section scheme-{{ section.settings.color_scheme }}{% if section.settings.full_height %} section--tall{% endif %}"
  style="{% render 'section-style', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %} {% render 'block-spacing', gap: section.settings.block_gap %}"
>
  <div class="{{ width_class }}">
    {%- capture section_content -%}{% content_for 'blocks' %}{%- endcapture -%}
    {% render 'layout-group', layout_settings: section.settings, content: section_content, class: 'group-section__layout' %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.group.name",
  "tag": "div",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:sections.group.content_width.label",
      "options": [
        { "value": "page", "label": "t:sections.group.content_width.page" },
        { "value": "narrow", "label": "t:sections.group.content_width.narrow" },
        { "value": "reading", "label": "t:sections.group.content_width.reading" },
        { "value": "full", "label": "t:sections.group.content_width.full" },
        { "value": "edge", "label": "t:sections.group.content_width.edge" }
      ],
      "default": "page"
    },
    {
      "type": "checkbox",
      "id": "full_height",
      "label": "t:sections.all.full_height.label",
      "default": false
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "t:sections.all.anchor.label",
      "info": "t:sections.all.anchor.info"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:sections.group.content_alignment.label",
      "info": "t:sections.group.content_alignment.info",
      "options": [
        { "value": "left", "label": "t:settings_schema.options.left" },
        { "value": "center", "label": "t:settings_schema.options.center" },
        { "value": "right", "label": "t:settings_schema.options.right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:sections.group.layout_header"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:blocks.group.direction.label",
      "info": "t:blocks.group.direction.info",
      "options": [
        { "value": "horizontal", "label": "t:blocks.group.direction.horizontal" },
        { "value": "vertical", "label": "t:blocks.group.direction.vertical" }
      ],
      "default": "horizontal"
    },
    {
      "type": "select",
      "id": "distribute",
      "label": "t:blocks.group.distribute.label",
      "info": "t:blocks.group.distribute.info",
      "options": [
        { "value": "start", "label": "t:blocks.group.distribute.start" },
        { "value": "center", "label": "t:blocks.group.distribute.center" },
        { "value": "end", "label": "t:blocks.group.distribute.end" },
        { "value": "between", "label": "t:blocks.group.distribute.between" }
      ],
      "default": "start",
      "visible_if": "{{ section.settings.direction == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "align",
      "label": "t:blocks.group.align.label_horizontal",
      "info": "t:blocks.group.align.info_horizontal",
      "options": [
        { "value": "baseline", "label": "t:blocks.group.align.text" },
        { "value": "start", "label": "t:blocks.group.align.top" },
        { "value": "center", "label": "t:blocks.group.align.middle" },
        { "value": "end", "label": "t:blocks.group.align.bottom" },
        { "value": "stretch", "label": "t:blocks.group.align.equal_height" }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.direction == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "align_vertical",
      "label": "t:blocks.group.align.label_vertical",
      "info": "t:blocks.group.align.info_vertical",
      "options": [
        { "value": "start", "label": "t:blocks.group.align.left" },
        { "value": "center", "label": "t:blocks.group.align.centre" },
        { "value": "end", "label": "t:blocks.group.align.right" },
        { "value": "stretch", "label": "t:blocks.group.align.full_width" }
      ],
      "default": "stretch",
      "visible_if": "{{ section.settings.direction == 'vertical' }}"
    },
    {
      "type": "select",
      "id": "distribute_vertical",
      "label": "t:blocks.group.distribute_vertical.label",
      "info": "t:blocks.group.distribute_vertical.info",
      "options": [
        { "value": "start", "label": "t:blocks.group.distribute_vertical.start" },
        { "value": "center", "label": "t:blocks.group.distribute_vertical.center" },
        { "value": "end", "label": "t:blocks.group.distribute_vertical.end" },
        { "value": "between", "label": "t:blocks.group.distribute_vertical.between" }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.direction == 'vertical' }}"
    },
    {
      "type": "checkbox",
      "id": "wrap",
      "label": "t:blocks.group.wrap.label",
      "info": "t:blocks.group.wrap.info",
      "default": true,
      "visible_if": "{{ section.settings.direction == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "items_width",
      "label": "t:blocks.group.items_width.label",
      "info": "t:blocks.group.items_width.info",
      "options": [
        { "value": "natural", "label": "t:blocks.group.items_width.natural" },
        { "value": "equal", "label": "t:blocks.group.items_width.equal" }
      ],
      "default": "equal",
      "visible_if": "{{ section.settings.direction == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "items_height",
      "label": "t:blocks.group.items_height.label",
      "info": "t:blocks.group.items_height.info",
      "options": [
        { "value": "natural", "label": "t:blocks.group.items_height.natural" },
        { "value": "equal", "label": "t:blocks.group.items_height.equal" }
      ],
      "default": "natural",
      "visible_if": "{{ section.settings.direction == 'vertical' }}"
    },
    {
      "type": "select",
      "id": "stack_below",
      "label": "t:blocks.group.stack_below.label",
      "info": "t:blocks.group.stack_below.info",
      "options": [
        { "value": "never", "label": "t:blocks.group.stack_below.never" },
        { "value": "tablet", "label": "t:blocks.group.stack_below.tablet" },
        { "value": "mobile", "label": "t:blocks.group.stack_below.mobile" }
      ],
      "default": "tablet",
      "visible_if": "{{ section.settings.direction == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "gap",
      "label": "t:blocks.group.gap.label",
      "info": "t:blocks.group.gap.info",
      "visible_if": "{{ section.settings.direction == 'horizontal' }}",
      "options": [
        { "value": "none", "label": "t:blocks.all.step.none" },
        { "value": "minimal", "label": "t:blocks.all.step.minimal" },
        { "value": "tiny", "label": "t:blocks.all.step.tiny" },
        { "value": "small", "label": "t:blocks.all.step.small" },
        { "value": "medium", "label": "t:blocks.all.step.medium" },
        { "value": "large", "label": "t:blocks.all.step.large" },
        { "value": "xlarge", "label": "t:blocks.all.step.xlarge" },
        { "value": "maximum", "label": "t:blocks.all.step.maximum" }
      ],
      "default": "xlarge"
    },
    {
      "type": "select",
      "id": "vertical_gap",
      "label": "t:blocks.group.vertical_gap_label",
      "info": "t:blocks.group.vertical_gap_info",
      "visible_if": "{{ section.settings.direction == 'vertical' }}",
      "options": [
        { "value": "inherit", "label": "t:blocks.group.vertical_gap_inherit" },
        { "value": "none", "label": "t:blocks.all.step.none" },
        { "value": "minimal", "label": "t:blocks.all.step.minimal" },
        { "value": "tiny", "label": "t:blocks.all.step.tiny" },
        { "value": "small", "label": "t:blocks.all.step.small" },
        { "value": "medium", "label": "t:blocks.all.step.medium" },
        { "value": "large", "label": "t:blocks.all.step.large" },
        { "value": "xlarge", "label": "t:blocks.all.step.xlarge" },
        { "value": "maximum", "label": "t:blocks.all.step.maximum" }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "content_alignment_mobile",
      "label": "t:blocks.group.content_alignment_mobile.label",
      "info": "t:blocks.group.content_alignment_mobile.info",
      "options": [
        { "value": "inherit", "label": "t:blocks.group.content_alignment_mobile.inherit" },
        { "value": "left", "label": "t:settings_schema.options.left" },
        { "value": "center", "label": "t:settings_schema.options.center" },
        { "value": "right", "label": "t:settings_schema.options.right" }
      ],
      "default": "inherit",
      "visible_if": "{{ section.settings.direction == 'horizontal' and section.settings.stack_below != 'never' }}"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing_header"
    },
    {
      "type": "select",
      "id": "block_gap",
      "label": "t:sections.group.block_gap.label",
      "info": "t:sections.group.block_gap.info",
      "options": [
        { "value": "none", "label": "t:blocks.all.step.none" },
        { "value": "minimal", "label": "t:blocks.all.step.minimal" },
        { "value": "tiny", "label": "t:blocks.all.step.tiny" },
        { "value": "small", "label": "t:blocks.all.step.small" },
        { "value": "medium", "label": "t:blocks.all.step.medium" },
        { "value": "large", "label": "t:blocks.all.step.large" },
        { "value": "xlarge", "label": "t:blocks.all.step.xlarge" }
      ],
      "default": "small"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "lg"
    }
  ],
  "presets": [
    {
      "name": "t:sections.group.name",
      "settings": {
        "content_width": "page",
        "direction": "horizontal",
        "distribute": "start",
        "align": "center",
        "wrap": true,
        "items_width": "equal",
        "items_height": "natural",
        "stack_below": "tablet",
        "gap": "xlarge",
        "vertical_gap": "inherit",
        "block_gap": "small"
      },
      "blocks": [
        { "type": "media" },
        {
          "type": "group",
          "settings": {
            "direction": "vertical",
            "align_vertical": "start"
          },
          "blocks": [
            { "type": "text", "settings": { "text": "Subheading", "style": "subheading", "layout": "eyebrow", "element": "span" } },
            { "type": "text", "settings": { "text": "Say something that matters", "style": "heading_2", "element": "h2" } },
            { "type": "rich-text" },
            { "type": "button" }
          ]
        }
      ]
    },
    {
      "name": "t:sections.group.presets.feature_grid",
      "settings": {
        "content_width": "page",
        "direction": "vertical",
        "align_vertical": "stretch",
        "vertical_gap": "large",
        "content_alignment": "left",
        "block_gap": "medium",
        "padding_top": "lg",
        "padding_bottom": "lg"
      },
      "blocks": [
        {
          "type": "group",
          "settings": {
            "direction": "vertical",
            "align_vertical": "stretch",
            "vertical_gap": "tiny"
          },
          "blocks": [
            { "type": "text", "settings": { "text": "Made with intention", "style": "subheading", "layout": "eyebrow", "element": "span" } },
            { "type": "text", "settings": { "text": "Why choose us", "style": "title", "layout": "display", "element": "h2" } }
          ]
        },
        {
          "type": "group",
          "settings": {
            "direction": "horizontal",
            "distribute": "start",
            "align": "stretch",
            "wrap": true,
            "items_width": "equal",
            "stack_below": "mobile",
            "gap": "medium"
          },
          "blocks": [
            {
              "type": "group",
              "settings": {
                "direction": "vertical",
                "align_vertical": "stretch",
                "vertical_gap": "small",
                "padding": "medium",
                "show_borders": true
              },
              "blocks": [
                { "type": "icon", "settings": { "icon": "star" } },
                { "type": "text", "settings": { "text": "Considered materials", "style": "heading_5", "element": "h3" } },
                { "type": "text", "settings": { "text": "Explain the materials, standards, or details that make the product distinct.", "style": "small", "layout": "lede" } }
              ]
            },
            {
              "type": "group",
              "settings": {
                "direction": "vertical",
                "align_vertical": "stretch",
                "vertical_gap": "small",
                "padding": "medium",
                "show_borders": true
              },
              "blocks": [
                { "type": "icon", "settings": { "icon": "support" } },
                { "type": "text", "settings": { "text": "Personal service", "style": "heading_5", "element": "h3" } },
                { "type": "text", "settings": { "text": "Tell customers how your team supports them before and after their purchase.", "style": "small", "layout": "lede" } }
              ]
            },
            {
              "type": "group",
              "settings": {
                "direction": "vertical",
                "align_vertical": "stretch",
                "vertical_gap": "small",
                "padding": "medium",
                "show_borders": true
              },
              "blocks": [
                { "type": "icon", "settings": { "icon": "shipping" } },
                { "type": "text", "settings": { "text": "Secure delivery", "style": "heading_5", "element": "h3" } },
                { "type": "text", "settings": { "text": "Set clear expectations for delivery, protection, and receiving the order.", "style": "small", "layout": "lede" } }
              ]
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
