{%- liquid
  assign heading_tag = section.settings.heading_level | default: 'h2'
  unless heading_tag == 'h1' or heading_tag == 'h2' or heading_tag == 'h3' or heading_tag == 'div'
    assign heading_tag = 'h2'
  endunless
-%}
{%- comment -%}
  Promises. Numbering is generated from block order, so reordering or removing
  a promise in the editor renumbers the set automatically — it is a CSS counter
  on `.promises__grid` now rather than `forloop`, because the card is a theme
  block and a theme block has no index. See `blocks/promise.liquid`.

  There is deliberately no column setting: the design art-directs this grid to
  a fixed shape at each tier — including centring the orphan row of five — so a
  column count would have nothing to act on. The arrangement lives in base.css.

  **The heading and the subheading stay section settings, and cannot become
  `title` and `subheading` blocks.** Merchant-added blocks render as one flat
  sibling flow, and the flow this section has to place them in is
  `.promises__grid` — so a heading block would land *inside* the grid as a
  card-shaped cell. This is `featured-products`' constraint arriving from the
  other direction: there the header cannot be blocks because two of its parts
  share one row, here because the only flow available is the grid itself.
{%- endcomment -%}

<section
  class="section scheme-{{ section.settings.color_scheme }}"
  style="{% render 'section-style', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %} {%- if section.settings.content_alignment != blank and section.settings.content_alignment != 'inherit' -%}--section-align: {{ section.settings.content_alignment }}; --section-align-jc: {% if section.settings.content_alignment == 'center' %}center{% elsif section.settings.content_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};{%- endif -%}"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <{{ heading_tag }} class="display reveal">{{ section.settings.heading }}</{{ heading_tag }}>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <div class="section-header reveal">
        <span class="micro">{{ section.settings.subheading }}</span>
      </div>
    {%- endif -%}

    {%- comment -%}
      The grid is art-directed rather than auto-fitting — see base.css. The
      wrapper exists to be the query container, because an element cannot
      query its own size.
    {%- endcomment -%}
    <div class="promises">
      <div class="promises__grid">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.promises.name",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "heading_level",
      "label": "t:sections.all.heading_level.label",
      "info": "t:sections.all.heading_level.info",
      "options": [
        { "value": "h1", "label": "t:settings_schema.heading_level.h1" },
        { "value": "h2", "label": "t:settings_schema.heading_level.h2" },
        { "value": "h3", "label": "t:settings_schema.heading_level.h3" },
        { "value": "div", "label": "t:settings_schema.heading_level.div" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:sections.all.content_alignment.label",
      "info": "t:sections.all.content_alignment.info",
      "options": [
        { "value": "left", "label": "t:settings_schema.options.left" },
        { "value": "center", "label": "t:settings_schema.options.center" },
        { "value": "right", "label": "t:settings_schema.options.right" }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "Our Promises"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.subheading.label",
      "default": "Promises of Excellence"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing_header"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "max"
    }
  ],
  "blocks": [
    {
      "type": "promise"
    }
  ],
  "presets": [
    {
      "name": "t:sections.promises.name",
      "blocks": [
        { "type": "promise" },
        { "type": "promise", "settings": { "icon": "support", "heading": "Personal Assistance", "text": "Speak with the salon directly — Tue–Sat, by phone or email." } },
        { "type": "promise", "settings": { "icon": "secure", "heading": "Secure Payment", "text": "Encrypted checkout with the payment methods you already trust." } },
        { "type": "promise", "settings": { "icon": "handcraft", "heading": "Handcrafted Design", "text": "Cut, set, and finished by hand in our own workshop." } },
        { "type": "promise", "settings": { "icon": "certified", "heading": "Certified Quality", "text": "Every stone graded and certified before it leaves the salon." } }
      ]
    }
  ]
}
{% endschema %}
