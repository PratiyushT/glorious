{
  "name": "t:sections.header.name",
  "type": "header",
  "sections": {
    "announcement": {
      "type": "announcement-header",
      "blocks": {
        "shipping": {
          "type": "message",
          "settings": {
            "text": "Complimentary insured shipping on every order",
            "link": ""
          }
        },
        "welcome": {
          "type": "message",
          "settings": {
            "text": "A private welcome offer awaits",
            "link": ""
          }
        },
        "endure": {
          "type": "message",
          "settings": {
            "text": "Designed with intention. Made to endure.",
            "link": ""
          }
        }
      },
      "block_order": [
        "shipping",
        "welcome",
        "endure"
      ],
      "settings": {
        "color_scheme": "scheme_2",
        "visibility": "everywhere",
        "content_width": "full",
        "mode": "marquee",
        "marquee_speed": "balanced",
        "auto_rotate": true,
        "animation_style": "slide",
        "interval": 6,
        "text_style": "caption",
        "override_font": "inherit",
        "override_size": "inherit",
        "text_color": "",
        "override_leading": "inherit",
        "override_case": "uppercase",
        "override_tracking": "wide",
        "alignment": "center"
      }
    },
    "header": {
      "type": "header",
      "settings": {
        "color_scheme": "scheme_2",
        "header_layout": "art_directed",
        "huge_text_value": "STORE NAME",
        "nav_mode_home": "morph",
        "nav_mode": "bar",
        "nav_product_transparent": true,
        "menu_type": "drawer",
        "menu_drawer_color_scheme": "scheme_1",
        "scroll_threshold": 60,
        "overlay_home": true,
        "show_contact": true,
        "contact_label": "Contact",
        "contact_link": "/pages/contact",
        "show_account": true,
        "show_search": true,
        "show_cart": true,
        "search_popular": "New arrivals, Best sellers, Gifts, Essentials"
      },
      "blocks": {
        "menu": {
          "type": "menu",
          "settings": { "menu": "main-menu" }
        },
        "cat-new": {
          "type": "category",
          "settings": { "label": "New arrivals", "url": "/collections/all" }
        },
        "cat-best": {
          "type": "category",
          "settings": { "label": "Best sellers", "url": "/collections/all" }
        },
        "cat-featured": {
          "type": "category",
          "settings": { "label": "Featured", "url": "/collections/all" }
        },
        "cat-all": {
          "type": "category",
          "settings": { "label": "All products", "url": "/collections/all" }
        },
        "social": {
          "type": "social",
          "settings": {}
        }
      },
      "block_order": [
        "menu",
        "cat-new",
        "cat-best",
        "cat-featured",
        "cat-all",
        "social"
      ]
    },
    "cart-drawer": {
      "type": "cart-drawer",
      "blocks": {
        "upsell": {
          "type": "cart_upsell",
          "blocks": {
            "product-card": {
              "type": "_product-card",
              "static": true,
              "blocks": {
                "media": { "type": "_product-card-media", "settings": { "image_ratio": "1/1", "image_fit": "contain" } },
                "info": {
                  "type": "_product-card-group",
                  "blocks": {
                    "kind": { "type": "text", "settings": { "text": "{{ closest.product.vendor }}", "style": "caption", "element": "span", "override_case": "uppercase", "override_tracking": "wide" } },
                    "title": { "type": "text", "settings": { "text": "{{ closest.product.title }}", "style": "small", "element": "h3" } },
                    "price": { "type": "_product-card-price", "settings": {} }
                  },
                  "block_order": ["kind", "title", "price"],
                  "settings": { "direction": "vertical", "distribute": "start", "align": "start", "wrap": false, "stack_below": "never", "gap": "tiny", "vertical_gap": "tiny" }
                }
              },
              "block_order": ["media", "info"],
              "settings": { "text_align": "left", "fixed_size": true, "show_carousel": false, "hover_next": false, "show_video": false, "quick_view_desktop": true, "quick_view_compact": true }
            }
          },
          "settings": {
            "heading": "Recommended for you",
            "collection": "featured-products-homepage",
            "products_to_show": 3,
            "padding_inline": "small",
            "padding_block": "small",
            "carousel_motion": "slide"
          }
        }
      },
      "block_order": ["upsell"],
      "settings": {
        "color_scheme": "scheme_1",
        "secondary_label": "Salon",
        "secondary_link": "/#visit"
      }
    },
    "quick-view": {
      "type": "quick-view",
      "blocks": {
        "media-gallery": { "type": "_product-media-gallery", "static": true, "settings": { "layout": "carousel", "first_media_large": true, "video_first": false, "sticky_mode": "none", "media_fit": "contain", "show_arrows": true, "show_dots": true, "video_label": "Video", "autoplay_video": false } },
        "badges": { "type": "product_badges", "settings": { "position": "top-left", "max_badges": 2 } },
        "vendor": { "type": "product_vendor", "settings": { "style": "caption", "element": "span", "override_case": "uppercase", "override_tracking": "wide" } },
        "title": { "type": "product_title", "settings": { "style": "heading_2", "element": "h2", "override_size": "4xl", "override_case": "uppercase", "link_to_product": false } },
        "price": { "type": "product_price", "settings": { "style": "heading_4", "element": "span" } },
        "variants": { "type": "product_variant_picker", "settings": { "picker_type": "automatic", "swatch_shape": "round", "show_sold_out": true, "option_gap": 8 } },
        "quantity": { "type": "product_quantity", "settings": {} },
        "buy-buttons": { "type": "product_buy_buttons", "settings": { "show_dynamic_checkout": false, "show_installments": true, "show_gift_card_recipient": false } }
      },
      "block_order": ["badges", "vendor", "title", "price", "variants", "quantity", "buy-buttons"],
      "settings": {
        "enabled": true,
        "color_scheme": "scheme_1",
        "scroll_mode": "panel"
      }
    },
    "newsletter-popup": {
      "type": "newsletter-popup",
      "blocks": {
        "newsletter": {
          "type": "_splash-newsletter",
          "settings": {
            "color_scheme": "scheme_1",
            "delay": 2,
            "panel_width": 64,
            "accessibility_label": "Newsletter signup",
            "direction": "horizontal",
            "distribute": "start",
            "align": "stretch",
            "align_vertical": "stretch",
            "content_alignment": "left",
            "wrap": false,
            "items_width": "equal",
            "items_height": "natural",
            "stack_below": "tablet",
            "content_alignment_mobile": "inherit",
            "gap": "none",
            "vertical_gap": "small",
            "padding": "none",
            "show_borders": false,
            "group_border_width": 1,
            "border_color": "",
            "border_top": true,
            "border_right": true,
            "border_bottom": true,
            "border_left": true
          },
          "blocks": {
            "media": {
              "type": "media",
              "settings": {
                "video": "",
                "image": "",
                "autoplay": true,
                "loop": true,
                "ratio": "adapt",
                "fit": "cover",
                "arch": false,
                "frame": false,
                "reveal": false,
                "reveal_delay": 0,
                "caption_left": "",
                "caption_right": "",
                "padding": "none"
              },
              "blocks": {}
            },
            "content": {
              "type": "group",
              "settings": {
                "direction": "vertical",
                "distribute": "between",
                "align": "baseline",
                "align_vertical": "stretch",
                "content_alignment": "left",
                "wrap": true,
                "items_width": "natural",
                "items_height": "natural",
                "stack_below": "mobile",
                "content_alignment_mobile": "inherit",
                "gap": "medium",
                "vertical_gap": "small",
                "padding": "xlarge",
                "show_borders": false,
                "group_border_width": 1,
                "border_color": "",
                "border_top": true,
                "border_right": true,
                "border_bottom": true,
                "border_left": true
              },
              "blocks": {
                "eyebrow": {
                  "type": "text",
                  "settings": {
                    "style": "subheading",
                    "layout": "eyebrow",
                    "element": "p",
                    "alignment": "inherit",
                    "text": "Private offer",
                    "padding": "none"
                  },
                  "blocks": {}
                },
                "heading": {
                  "type": "text",
                  "settings": {
                    "style": "heading_2",
                    "layout": "standard",
                    "element": "h2",
                    "alignment": "inherit",
                    "text": "A Welcome, Just for You",
                    "padding": "none"
                  },
                  "blocks": {}
                },
                "intro": {
                  "type": "rich-text",
                  "settings": {
                    "style": "paragraph",
                    "alignment": "inherit",
                    "text": "<p>Join the private list for early access to new collections and a welcome offer for your first order.</p>"
                  },
                  "blocks": {}
                },
                "form": {
                  "type": "email-signup",
                  "settings": {
                    "input_label": "Email address",
                    "show_label": false,
                    "placeholder": "Email address",
                    "button_label": "Join the Private List",
                    "form_layout": "stacked",
                    "success_text": "Your welcome offer is ready.",
                    "show_offer": true,
                    "offer_code": "WELCOME10",
                    "offer_destination": "/collections/all",
                    "offer_button_label": "Apply Offer & Shop",
                    "button_style": "filled",
                    "button_size": "inherit",
                    "button_radius": "inherit",
                    "button_border_width": "inherit",
                    "background_color": "",
                    "text_color": "",
                    "border_color": "",
                    "underline_color": "",
                    "arrow_color": "",
                    "hover_background_color": "",
                    "hover_text_color": "",
                    "hover_border_color": "",
                    "hover_underline_color": "",
                    "hover_arrow_color": ""
                  },
                  "blocks": {}
                },
                "dismiss": {
                  "type": "button",
                  "settings": {
                    "button_label": "Continue browsing",
                    "button_link": "#close",
                    "button_style": "link",
                    "button_size": "inherit",
                    "button_radius": "inherit",
                    "button_border_width": "inherit",
                    "background_color": "",
                    "text_color": "",
                    "border_color": "",
                    "underline_color": "",
                    "arrow_color": "",
                    "hover_background_color": "",
                    "hover_text_color": "",
                    "hover_border_color": "",
                    "hover_underline_color": "",
                    "hover_arrow_color": ""
                  },
                  "blocks": {}
                },
                "fine-print": {
                  "type": "rich-text",
                  "settings": {
                    "style": "caption",
                    "alignment": "inherit",
                    "text": "<p>By subscribing you agree to receive email from this shop. Unsubscribe anytime.</p>"
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "eyebrow",
                "heading",
                "intro",
                "form",
                "dismiss",
                "fine-print"
              ]
            }
          },
          "block_order": [
            "media",
            "content"
          ]
        }
      },
      "block_order": [
        "newsletter"
      ],
      "settings": {}
    },
    "cookie-banner": {
      "type": "cookie-banner",
      "settings": {
        "enabled": true,
        "color_scheme": "scheme_1",
        "delay": 1,
        "eyebrow": "Cookies",
        "text": "We use cookies to improve your browsing experience and analyze site traffic. See our",
        "policy_label": "Cookie Policy",
        "policy_link": "/pages/cookies",
        "decline_label": "Decline",
        "accept_label": "Accept"
      }
    }
  },
  "order": ["announcement", "header", "cart-drawer", "quick-view", "newsletter-popup", "cookie-banner"]
}
