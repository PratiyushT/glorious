{
  "name": "t:sections.header.name",
  "type": "header",
  "sections": {
    "header": {
      "type": "header",
      "settings": {
        "color_scheme": "scheme_2",
        "nav_mode_home": "morph",
        "nav_mode": "bar",
        "scroll_threshold": 60,
        "overlay_home": true,
        "show_contact": true,
        "contact_label": "Contact",
        "contact_link": "/pages/contact",
        "show_account": true,
        "show_search": true,
        "show_cart": true,
        "search_overlay": true,
        "search_popular": "New arrivals, Best sellers, Gifts, Essentials"
      },
      "blocks": {
        "link-home": {
          "type": "link",
          "settings": { "label": "Home", "url": "/" }
        },
        "link-collection": {
          "type": "link",
          "settings": { "label": "The Collection", "url": "/collections/all" }
        },
        "link-about": {
          "type": "link",
          "settings": { "label": "About Us", "url": "/pages/about" }
        },
        "link-contact": {
          "type": "link",
          "settings": { "label": "Contact", "url": "/pages/contact" }
        },
        "link-account": {
          "type": "link",
          "settings": { "label": "Account", "url": "/account" }
        },
        "cat-new": {
          "type": "category",
          "settings": { "label": "New arrivals", "url": "/collections/all" }
        },
        "cat-best": {
          "type": "category",
          "settings": { "label": "Best sellers", "url": "/collections/all" }
        },
        "cat-featured": {
          "type": "category",
          "settings": { "label": "Featured", "url": "/collections/all" }
        },
        "cat-all": {
          "type": "category",
          "settings": { "label": "All products", "url": "/collections/all" }
        },
        "social": {
          "type": "social",
          "settings": {}
        }
      },
      "block_order": [
        "link-home",
        "link-collection",
        "link-about",
        "link-contact",
        "link-account",
        "cat-new",
        "cat-best",
        "cat-featured",
        "cat-all",
        "social"
      ]
    },
    "cart-drawer": {
      "type": "cart-drawer",
      "settings": {
        "color_scheme": "scheme_1",
        "secondary_label": "Salon",
        "secondary_link": "/#visit"
      }
    },
    "newsletter-popup": {
      "type": "newsletter-popup",
      "settings": {
        "enabled": true,
        "color_scheme": "scheme_1",
        "delay": 2,
        "eyebrow": "The Store List",
        "heading": "Take 10% Off Your First Order",
        "text": "Sign up for early access to new collections, private previews, and your welcome offer.",
        "fine_print": "By subscribing you agree to receive email from this shop. Unsubscribe anytime.",
        "success_heading": "You're on the List",
        "success_text": "Enjoy 10% off your first order with the code below.",
        "offer_code": "WELCOME10"
      }
    },
    "cookie-banner": {
      "type": "cookie-banner",
      "settings": {
        "enabled": true,
        "color_scheme": "scheme_1",
        "delay": 1,
        "eyebrow": "Cookies",
        "text": "We use cookies to improve your browsing experience and analyze site traffic. See our",
        "policy_label": "Cookie Policy",
        "policy_link": "/pages/cookies",
        "decline_label": "Decline",
        "accept_label": "Accept"
      }
    }
  },
  "order": ["header", "cart-drawer", "newsletter-popup", "cookie-banner"]
}
