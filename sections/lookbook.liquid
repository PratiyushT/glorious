{%- comment -%}
  Lookbook is now a composition surface, not a bespoke scene schema.

  Every visible item is a global theme block. A look is an Interactive media
  block, its photograph/film and caption are ordinary Media/Text blocks, and
  each product point is a reusable Hotspot block. The section owns only the
  colour scheme, outer spacing, and the optional scene-tab host.
{%- endcomment -%}

<section
  class="lookbook section scheme-{{ section.settings.color_scheme }}"
  id="lookbook-{{ section.id }}"
  style="{% render 'section-style', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}"
  data-lookbook
>
  <div class="lookbook__inner">
    <div
      class="lookbook__rail"
      role="tablist"
      aria-label="{{ 'lookbook.scenes' | t }}"
      data-look-rail
      hidden
    ></div>

    {% content_for 'blocks' %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.lookbook.name",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" },
    { "type": "interactive-media" },
    { "type": "group" },
    { "type": "text" },
    { "type": "rich-text" },
    { "type": "button" }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_2"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing_header"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "xl"
    }
  ],
  "presets": [
    {
      "name": "t:sections.lookbook.name",
      "blocks": [
        {
          "type": "group",
          "settings": {
            "direction": "vertical",
            "align_vertical": "stretch",
            "vertical_gap": "tiny",
            "padding": "none"
          },
          "blocks": [
            {
              "type": "text",
              "settings": {
                "text": "Shop the look",
                "style": "subheading",
                "layout": "eyebrow",
                "element": "span"
              }
            },
            {
              "type": "text",
              "settings": {
                "text": "The Lookbook",
                "style": "title",
                "layout": "display",
                "element": "h2"
              }
            },
            {
              "type": "text",
              "settings": {
                "text": "Tap a point to see the piece it marks.",
                "style": "paragraph",
                "layout": "lede",
                "element": "p"
              }
            }
          ]
        },
        { "type": "interactive-media" }
      ]
    }
  ]
}
{% endschema %}
