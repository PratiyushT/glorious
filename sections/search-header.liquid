{%- comment -%}
  Search-page counterpart to Collection header. It uses the same global block
  canvas; the default Search form is itself a global block rather than fixed
  section markup.
{%- endcomment -%}

{%- capture header_content -%}{% content_for 'blocks' %}{%- endcapture -%}
{% render 'catalog-header', header_settings: section.settings, content: header_content, search: true %}

{% schema %}
{
  "name": "t:sections.search_header.name",
  "enabled_on": {
    "templates": ["search"]
  },
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:sections.group.content_width.label",
      "options": [
        { "value": "page", "label": "t:sections.group.content_width.page" },
        { "value": "narrow", "label": "t:sections.group.content_width.narrow" },
        { "value": "reading", "label": "t:sections.group.content_width.reading" },
        { "value": "edge", "label": "t:sections.group.content_width.edge" }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.catalog.header_height",
      "info": "t:sections.collection_header.height_info",
      "options": [
        { "value": "content", "label": "t:sections.collection_header.content_height" },
        { "value": "compact", "label": "t:sections.catalog.compact" },
        { "value": "reference", "label": "t:sections.catalog.reference" },
        { "value": "tall", "label": "t:sections.catalog.tall" }
      ],
      "default": "compact"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:sections.all.content_alignment.label",
      "options": [
        { "value": "left", "label": "t:settings_schema.options.left" },
        { "value": "center", "label": "t:settings_schema.options.center" },
        { "value": "right", "label": "t:settings_schema.options.right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:sections.collection_header.vertical_alignment",
      "visible_if": "{{ section.settings.height != 'content' }}",
      "options": [
        { "value": "start", "label": "t:blocks.group.align.top" },
        { "value": "center", "label": "t:blocks.group.align.middle" },
        { "value": "end", "label": "t:blocks.group.align.bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "block_gap",
      "label": "t:sections.collection_header.block_gap",
      "options": [
        { "value": "none", "label": "t:blocks.all.step.none" },
        { "value": "minimal", "label": "t:blocks.all.step.minimal" },
        { "value": "tiny", "label": "t:blocks.all.step.tiny" },
        { "value": "small", "label": "t:blocks.all.step.small" },
        { "value": "medium", "label": "t:blocks.all.step.medium" },
        { "value": "large", "label": "t:blocks.all.step.large" },
        { "value": "xlarge", "label": "t:blocks.all.step.xlarge" }
      ],
      "default": "tiny"
    },
    {
      "type": "select",
      "id": "motion",
      "label": "t:sections.catalog.header_animation",
      "options": [
        { "value": "none", "label": "t:sections.catalog.none" },
        { "value": "fade", "label": "t:sections.catalog.fade" },
        { "value": "reference", "label": "t:sections.catalog.reference_rise_stagger" }
      ],
      "default": "reference"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing_header"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "t:sections.search_header.name",
      "blocks": [
        { "type": "search-form" }
      ]
    }
  ]
}
{% endschema %}
