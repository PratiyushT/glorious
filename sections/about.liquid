          "value": "h1",
          "label": "t:settings_schema.heading_level.h1"
        },
        {
          "value": "h2",
          "label": "t:settings_schema.heading_level.h2"
        },
        {
          "value": "h3",
          "label": "t:settings_schema.heading_level.h3"
        },
        {
          "value": "div",
