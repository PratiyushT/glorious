{%- liquid
  assign heading_tag = section.settings.heading_level | default: 'h2'
  unless heading_tag == 'h1' or heading_tag == 'h2' or heading_tag == 'h3' or heading_tag == 'div'
    assign heading_tag = 'h2'
  endunless
-%}
{%- comment -%}
  About. Arched portrait beside the house story.

  Paragraphs are blocks so the copy can grow or shrink without leaving a gap
  where a fixed second or third paragraph used to be.
{%- endcomment -%}

<section
  class="section scheme-{{ section.settings.color_scheme }}"
  style="{% render 'section-style', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <{{ heading_tag }} class="display reveal">{{ section.settings.heading }}</{{ heading_tag }}>
    {%- endif -%}

    <div
      class="split{% if section.settings.layout == 'text_first' %} split--reverse{% endif %}"
      style="--split-min: 22rem; margin-top: var(--space-sm);"
    >
      <div class="reveal" style="--reveal-delay: 120ms;">
        <div class="media{% if section.settings.arch %} media--arch{% endif %}" style="aspect-ratio: {{ section.settings.image_ratio }};">
          {%- render 'responsive-image',
              image: section.settings.image,
              sizes: '(min-width: 60rem) 40vw, 100vw',
              widths: '400,700,1000',
              src_width: 1000,
              placeholder: 'lifestyle-2' -%}
        </div>

        {%- if section.settings.caption_left != blank or section.settings.caption_right != blank -%}
          <div class="caption-row">
            <span>{{ section.settings.caption_left }}</span>
            <span>{{ section.settings.caption_right }}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="stack reveal">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'paragraph' -%}
              <div class="rte measure" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'buttons' -%}
              {%- comment -%}
                A button needs a destination to exist. `href="#"` is a control
                that looks live and goes nowhere, so a label without a link
                renders nothing at all.
              {%- endcomment -%}
              <div class="btn-row" {{ block.shopify_attributes }}>
                {%- render 'button',
                  label: block.settings.button_label,
                  link: block.settings.button_link,
                  style: block.settings.button_style,
                  size: block.settings.button_size,
                  radius: block.settings.button_radius -%}
                {%- render 'button',
                  label: block.settings.button_label_2,
                  link: block.settings.button_link_2,
                  style: block.settings.button_style_2,
                  size: block.settings.button_size_2,
                  radius: block.settings.button_radius_2 -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.about.name",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "heading_level",
      "label": "t:sections.all.heading_level.label",
      "info": "t:sections.all.heading_level.info",
      "options": [
        { "value": "h1", "label": "t:settings_schema.heading_level.h1" },
        { "value": "h2", "label": "t:settings_schema.heading_level.h2" },
        { "value": "h3", "label": "t:settings_schema.heading_level.h3" },
        { "value": "div", "label": "t:settings_schema.heading_level.div" }
      ],
      "default": "h2"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "About Us"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.all.layout.label",
      "options": [
        { "value": "image_first", "label": "t:sections.all.image_first" },
        { "value": "text_first", "label": "t:sections.all.text_first" }
      ],
      "default": "text_first"
    },
    {
      "type": "header",
      "content": "t:sections.all.image.label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.all.image.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.all.image_ratio.label",
      "options": [
        { "value": "1 / 1", "label": "t:settings_schema.options.square" },
        { "value": "4 / 5", "label": "t:settings_schema.options.portrait" },
        { "value": "3 / 4", "label": "t:settings_schema.options.tall_portrait" },
        { "value": "4 / 3", "label": "t:settings_schema.options.landscape" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "checkbox",
      "id": "arch",
      "label": "t:sections.about.arch.label",
      "default": true
    },
    {
      "type": "text",
      "id": "caption_left",
      "label": "t:sections.about.caption_left.label",
      "default": "Who it is for"
    },
    {
      "type": "text",
      "id": "caption_right",
      "label": "t:sections.about.caption_right.label",
      "default": "Est. City, State"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing_header"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "max"
    }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "name": "t:sections.about.blocks.paragraph.name",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.all.text.label",
          "default": "<p>Tell the story behind the shop — where it began, what it makes, and why someone should care. Two or three sentences is usually enough.</p>"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "t:sections.about.blocks.buttons.name",
      "limit": 1,
      "settings": [
    {
      "type": "select",
      "id": "button_style",
      "label": "t:sections.all.button_style.label",
      "options": [
        { "value": "filled", "label": "t:settings_schema.button_style.filled" },
        { "value": "outline", "label": "t:settings_schema.button_style.outline" },
        { "value": "link", "label": "t:settings_schema.button_style.link" },
        { "value": "quiet", "label": "t:settings_schema.button_style.quiet" },
        { "value": "arrow", "label": "t:settings_schema.button_style.arrow" },
        { "value": "arrow_outline", "label": "t:settings_schema.button_style.arrow_outline" }
      ],
      "default": "filled"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "t:sections.all.button_size.label",
      "options": [
        { "value": "inherit", "label": "t:settings_schema.button_size.inherit" },
        { "value": "xs", "label": "t:settings_schema.button_size.xs" },
        { "value": "sm", "label": "t:settings_schema.button_size.sm" },
        { "value": "md", "label": "t:settings_schema.button_size.md" },
        { "value": "lg", "label": "t:settings_schema.button_size.lg" },
        { "value": "xl", "label": "t:settings_schema.button_size.xl" }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "button_radius",
      "label": "t:sections.all.button_radius.label",
      "options": [
        { "value": "inherit", "label": "t:settings_schema.button_radius.inherit" },
        { "value": "square", "label": "t:settings_schema.button_radius.square" },
        { "value": "soft", "label": "t:settings_schema.button_radius.soft" },
        { "value": "rounded", "label": "t:settings_schema.button_radius.rounded" },
        { "value": "pill", "label": "t:settings_schema.button_radius.pill" }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "button_style_2",
      "label": "t:sections.all.button_style_2.label",
      "options": [
        { "value": "filled", "label": "t:settings_schema.button_style.filled" },
        { "value": "outline", "label": "t:settings_schema.button_style.outline" },
        { "value": "link", "label": "t:settings_schema.button_style.link" },
        { "value": "quiet", "label": "t:settings_schema.button_style.quiet" },
        { "value": "arrow", "label": "t:settings_schema.button_style.arrow" },
        { "value": "arrow_outline", "label": "t:settings_schema.button_style.arrow_outline" }
      ],
      "default": "link"
    },
    {
      "type": "select",
      "id": "button_size_2",
      "label": "t:sections.all.button_size_2.label",
      "options": [
        { "value": "inherit", "label": "t:settings_schema.button_size.inherit" },
        { "value": "xs", "label": "t:settings_schema.button_size.xs" },
        { "value": "sm", "label": "t:settings_schema.button_size.sm" },
        { "value": "md", "label": "t:settings_schema.button_size.md" },
        { "value": "lg", "label": "t:settings_schema.button_size.lg" },
        { "value": "xl", "label": "t:settings_schema.button_size.xl" }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "button_radius_2",
      "label": "t:sections.all.button_radius_2.label",
      "options": [
        { "value": "inherit", "label": "t:settings_schema.button_radius.inherit" },
        { "value": "square", "label": "t:settings_schema.button_radius.square" },
        { "value": "soft", "label": "t:settings_schema.button_radius.soft" },
        { "value": "rounded", "label": "t:settings_schema.button_radius.rounded" },
        { "value": "pill", "label": "t:settings_schema.button_radius.pill" }
      ],
      "default": "inherit"
    },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.hero.blocks.buttons.button_label.label",
          "default": "Our Full Story"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.hero.blocks.buttons.button_link.label"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "t:sections.hero.blocks.buttons.button_label_2.label",
          "default": "The Craft"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "t:sections.hero.blocks.buttons.button_link_2.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.about.name",
      "blocks": [
        { "type": "paragraph" },
        { "type": "paragraph", "settings": { "text": "<p>Every piece is handcrafted by master artisans who bring decades of skill to each cut, setting, and polish. Designs are guided by heritage and made for real lives — jewelry that becomes a treasured heirloom.</p>" } },
        { "type": "buttons" }
      ]
    }
  ]
}
{% endschema %}
