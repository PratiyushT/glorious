{%- comment -%}
  Testimonials. Private, explicitly targeted testimonial items made from global Text/Rich text
  children cross-fade in place; the dots are real buttons so the
  set is reachable by keyboard. With JavaScript off, the first quote shows and
  the rest follow it in the document rather than disappearing.

  **The dots stay a Liquid loop while the quotes are theme blocks, and that is
  only possible because of what `section.blocks` still holds.** A section that
  renders theme blocks keeps a populated `section.blocks` — the real instance
  count and a real `id` — but every entry reports `type: "@theme"` and carries
  **no settings and no `shopify_attributes`**. So the section can count its
  blocks and number them and cannot read them, which is exactly and only what a
  row of dots needs. Measured, not assumed; see CLAUDE.md.

  The two loops therefore stay in step by position: `content_for 'blocks'` and
  `section.blocks` both render in `block_order`, and `initQuotes` pairs a quote
  to a dot by index.
{%- endcomment -%}

<section
  class="section scheme-{{ section.settings.color_scheme }}"
  style="{% render 'section-style', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %} {%- if section.settings.content_alignment != blank and section.settings.content_alignment != 'inherit' -%}--section-align: {{ section.settings.content_alignment }}; --section-align-jc: {% if section.settings.content_alignment == 'center' %}center{% elsif section.settings.content_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};{%- endif -%}"
>
  <div class="page-width page-width--reading align-center">
    {%- if section.settings.subheading != blank -%}
      <span class="micro reveal">{{ section.settings.subheading }}</span>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div
        class="quotes reveal"
        data-quotes
        data-autorotate="{{ section.settings.autorotate }}"
        data-interval="{{ section.settings.interval | times: 1000 }}"
        style="--reveal-delay: 100ms; margin-top: var(--space-md);"
      >
        {% content_for 'blocks' %}
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="quote-dots" role="tablist" aria-label="{{ 'testimonials.choose_quote' | t }}" data-quote-dots>
          {%- for block in section.blocks -%}
            <button
              type="button"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="{{ 'testimonials.show_quote' | t: number: forloop.index }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:sections.all.content_alignment.label",
      "info": "t:sections.all.content_alignment.info",
      "options": [
        { "value": "left", "label": "t:settings_schema.options.left" },
        { "value": "center", "label": "t:settings_schema.options.center" },
        { "value": "right", "label": "t:settings_schema.options.right" }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.subheading.label",
      "default": "Word of Mouth"
    },
    {
      "type": "checkbox",
      "id": "autorotate",
      "label": "t:sections.testimonials.autorotate.label",
      "default": true
    },
    {
      "type": "range",
      "id": "interval",
      "label": "t:sections.testimonials.interval.label",
      "min": 3,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 7
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing_header"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "max"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "sm"
    }
  ],
  "blocks": [
    {
      "type": "_testimonial"
    }
  ],
  "presets": [
    {
      "name": "t:sections.testimonials.name",
      "blocks": [
        {
          "type": "_testimonial",
          "blocks": [
            { "type": "text", "settings": { "text": "“The craftsmanship is extraordinary and the service even more so.”", "style": "paragraph", "element": "blockquote", "override_font": "accent", "override_size": "2xl", "override_leading": "normal" } },
            { "type": "text", "settings": { "text": "Manjit Kaur — Google Review", "style": "caption", "element": "figcaption", "override_case": "uppercase", "override_tracking": "wider" } }
          ]
        },
        {
          "type": "_testimonial",
          "blocks": [
            { "type": "text", "settings": { "text": "“They took the time to get every detail right. It shows.”", "style": "paragraph", "element": "blockquote", "override_font": "accent", "override_size": "2xl", "override_leading": "normal" } },
            { "type": "text", "settings": { "text": "Nisarg P — Google Review", "style": "caption", "element": "figcaption", "override_case": "uppercase", "override_tracking": "wider" } }
          ]
        },
        {
          "type": "_testimonial",
          "blocks": [
            { "type": "text", "settings": { "text": "“Beautiful pieces and genuinely warm people behind the counter.”", "style": "paragraph", "element": "blockquote", "override_font": "accent", "override_size": "2xl", "override_leading": "normal" } },
            { "type": "text", "settings": { "text": "Rahul Jogula — Google Review", "style": "caption", "element": "figcaption", "override_case": "uppercase", "override_tracking": "wider" } }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
