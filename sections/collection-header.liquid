{%- comment -%}
  Collection header is a composition surface, not a collection-title widget.
  Global theme blocks still own every visible piece; the section arranges the
  default copy and collection-image children as two columns, an image overlay,
  image only, or copy only. This keeps each child's ordinary appearance
  controls while giving the resource header one coherent layout decision.
{%- endcomment -%}

{%- capture catalog_document_title -%}
  {{- page_title -}}
  {%- if current_tags %} – {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
  {%- if current_page != 1 %} – {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} – {{ shop.name }}{% endunless -%}
{%- endcapture -%}
{%- capture header_content -%}{% content_for 'blocks', closest.collection: collection %}{%- endcapture -%}
{% render 'catalog-header',
  header_settings: section.settings,
  content: header_content,
  search: false,
  catalog_header_section: section.id,
  catalog_document_title: catalog_document_title,
  catalog_canonical_url: canonical_url,
  collection_layout: section.settings.layout,
  collection_media_position: section.settings.media_position,
  collection_overlay: section.settings.show_overlay,
  collection_overlay_color: section.settings.overlay_color,
  collection_overlay_strength: section.settings.overlay_strength
%}

{% schema %}
{
  "name": "t:sections.collection_header.name",
  "enabled_on": {
    "templates": ["collection"]
  },
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:sections.group.content_width.label",
      "options": [
        { "value": "page", "label": "t:sections.group.content_width.page" },
        { "value": "narrow", "label": "t:sections.group.content_width.narrow" },
        { "value": "reading", "label": "t:sections.group.content_width.reading" },
        { "value": "edge", "label": "t:sections.group.content_width.edge" }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.collection_header.layout.label",
      "info": "t:sections.collection_header.layout.info",
      "options": [
        { "value": "side_by_side", "label": "t:sections.collection_header.layout.side_by_side" },
        { "value": "title_over_image", "label": "t:sections.collection_header.layout.title_over_image" },
        { "value": "image_only", "label": "t:sections.collection_header.layout.image_only" },
        { "value": "title_only", "label": "t:sections.collection_header.layout.title_only" }
      ],
      "default": "side_by_side"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "t:sections.collection_header.media_position.label",
      "options": [
        { "value": "title_first", "label": "t:sections.collection_header.media_position.title_first" },
        { "value": "image_first", "label": "t:sections.collection_header.media_position.image_first" }
      ],
      "default": "title_first",
      "visible_if": "{{ section.settings.layout == 'side_by_side' }}"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "t:sections.collection_header.show_overlay.label",
      "info": "t:sections.collection_header.show_overlay.info",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'title_over_image' }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:sections.collection_header.overlay_color.label",
      "info": "t:sections.collection_header.overlay_color.info",
      "visible_if": "{{ section.settings.layout == 'title_over_image' and section.settings.show_overlay }}"
    },
    {
      "type": "range",
      "id": "overlay_strength",
      "label": "t:sections.collection_header.overlay_strength.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40,
      "visible_if": "{{ section.settings.layout == 'title_over_image' and section.settings.show_overlay }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.catalog.header_height",
      "info": "t:sections.collection_header.height_info",
      "options": [
        { "value": "content", "label": "t:sections.collection_header.content_height" },
        { "value": "compact", "label": "t:sections.catalog.compact" },
        { "value": "reference", "label": "t:sections.catalog.reference" },
        { "value": "tall", "label": "t:sections.catalog.tall" }
      ],
      "default": "reference"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:sections.all.content_alignment.label",
      "options": [
        { "value": "left", "label": "t:settings_schema.options.left" },
        { "value": "center", "label": "t:settings_schema.options.center" },
        { "value": "right", "label": "t:settings_schema.options.right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:sections.collection_header.vertical_alignment",
      "visible_if": "{{ section.settings.height != 'content' }}",
      "options": [
        { "value": "start", "label": "t:blocks.group.align.top" },
        { "value": "center", "label": "t:blocks.group.align.middle" },
        { "value": "end", "label": "t:blocks.group.align.bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "block_gap",
      "label": "t:sections.collection_header.block_gap",
      "options": [
        { "value": "none", "label": "t:blocks.all.step.none" },
        { "value": "minimal", "label": "t:blocks.all.step.minimal" },
        { "value": "tiny", "label": "t:blocks.all.step.tiny" },
        { "value": "small", "label": "t:blocks.all.step.small" },
        { "value": "medium", "label": "t:blocks.all.step.medium" },
        { "value": "large", "label": "t:blocks.all.step.large" },
        { "value": "xlarge", "label": "t:blocks.all.step.xlarge" }
      ],
      "default": "tiny"
    },
    {
      "type": "select",
      "id": "motion",
      "label": "t:sections.catalog.header_animation",
      "options": [
        { "value": "none", "label": "t:sections.catalog.none" },
        { "value": "fade", "label": "t:sections.catalog.fade" },
        { "value": "reference", "label": "t:sections.catalog.reference_rise_stagger" }
      ],
      "default": "reference"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing_header"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_header.name",
      "blocks": [
        { "type": "text", "settings": { "text": "Collection", "style": "title", "layout": "display", "element": "h1" } },
        { "type": "text", "settings": { "text": "Explore the collection", "style": "subheading", "layout": "eyebrow", "element": "span" } }
      ]
    }
  ]
}
{% endschema %}
