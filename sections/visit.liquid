{%- comment -%}
  Visit. The salon panel — arched photograph, address and hours as detail
  rows, and directions.
{%- endcomment -%}

{%- comment -%}
  The anchor the design gives this section. The bag drawer's "Salon" link and
  the Craft section's buttons both point at /#visit, so without an id on the
  element those links scroll nowhere.
{%- endcomment -%}
<section
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handle }}"{% endif %}
  class="section scheme-{{ section.settings.color_scheme }}"
  style="{% render 'section-style', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}"
>
  <div class="page-width page-width--narrow">
    {%- if section.settings.show_rule -%}
      <div class="hairline" style="margin-bottom: var(--space-xl);"></div>
    {%- endif -%}

    <div
      class="split{% if section.settings.layout == 'text_first' %} split--reverse{% endif %}"
      style="--split-min: 22rem;"
    >
      <div class="reveal" style="--reveal-delay: 130ms;">
        <div class="media{% if section.settings.arch %} media--arch{% endif %}" style="aspect-ratio: {{ section.settings.image_ratio }};">
          {%- if section.settings.image != blank -%}
            {%- render 'responsive-image',
                image: section.settings.image,
                sizes: '(min-width: 60rem) 40vw, 100vw',
                widths: '400,700,1000',
                src_width: 1000 -%}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- if section.settings.caption_left != blank or section.settings.caption_right != blank -%}
          <div class="caption-row">
            <span>{{ section.settings.caption_left }}</span>
            <span>{{ section.settings.caption_right }}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="stack reveal">
        {%- if section.settings.subheading != blank -%}
          <span class="micro">{{ section.settings.subheading }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="rte measure">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- comment -%}

          Theme blocks. Both of this section's local types converted in one

          commit, because a section holds either its own blocks or theme

          blocks and never both.

        {%- endcomment -%}

        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.visit.name",
  "tag": "div",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
