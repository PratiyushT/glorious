{%- comment -%}
  Visit. The salon panel — arched photograph, address and hours as detail
  rows, and directions.
{%- endcomment -%}

<section
  class="section scheme-{{ section.settings.color_scheme }}"
  style="{% render 'section-style', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}"
>
  <div class="page-width page-width--narrow">
    {%- if section.settings.show_rule -%}
      <div class="hairline" style="margin-bottom: var(--space-xl);"></div>
    {%- endif -%}

    <div
      class="split{% if section.settings.layout == 'text_first' %} split--reverse{% endif %}"
      style="--split-min: 22rem;"
    >
      <div class="reveal" style="--reveal-delay: 130ms;">
        <div class="media{% if section.settings.arch %} media--arch{% endif %}" style="aspect-ratio: {{ section.settings.image_ratio }};">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 1000 }}"
              srcset="{{ section.settings.image | image_url: width: 400 }} 400w, {{ section.settings.image | image_url: width: 700 }} 700w, {{ section.settings.image | image_url: width: 1000 }} 1000w"
              sizes="(min-width: 60rem) 40vw, 100vw"
              alt="{{ section.settings.image.alt | escape }}"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              loading="lazy"
            >
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- if section.settings.caption_left != blank or section.settings.caption_right != blank -%}
          <div class="caption-row">
            <span>{{ section.settings.caption_left }}</span>
            <span>{{ section.settings.caption_right }}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="stack reveal">
        {%- if section.settings.subheading != blank -%}
          <span class="micro">{{ section.settings.subheading }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="rte measure">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- assign detail_blocks = section.blocks | where: 'type', 'detail' -%}
        {%- if detail_blocks.size > 0 -%}
          <div>
            {%- for block in detail_blocks -%}
              <div class="spec-row" {{ block.shopify_attributes }}>
                <span class="spec-row__label">{{ block.settings.label }}</span>
                <span class="spec-row__value">
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}"{% if block.settings.link contains '://' %} target="_blank" rel="noopener"{% endif %}>{{ block.settings.value }}</a>
                  {%- else -%}
                    {{ block.settings.value }}
                  {%- endif -%}
                </span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'buttons' -%}
            <div class="btn-row" {{ block.shopify_attributes }}>
              {%- if block.settings.button_label != blank -%}
                <a
                  href="{{ block.settings.button_link | default: '#' }}"
                  class="btn btn--primary"
                  {% if block.settings.button_link contains '://' %}target="_blank" rel="noopener"{% endif %}
                >
                  {{ block.settings.button_label }}&nbsp;&nbsp;&rarr;
                </a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank -%}
                <a href="{{ block.settings.button_link_2 | default: '#' }}" class="btn btn--link">
                  {{ block.settings.button_label_2 }}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.visit.name",
  "tag": "div",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.subheading.label",
      "default": "Visit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "The salon in Irving."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.all.text.label",
      "default": "<p>Come in for a private viewing — sizing, bespoke consultations, and old-gold appraisals happen at the counter, unhurried.</p>"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.all.layout.label",
      "options": [
        { "value": "image_first", "label": "t:sections.all.image_first" },
        { "value": "text_first", "label": "t:sections.all.text_first" }
      ],
      "default": "image_first"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "t:sections.visit.show_rule.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.image.label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.all.image.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.category_grid.image_ratio.label",
      "options": [
        { "value": "1 / 1", "label": "t:settings_schema.options.square" },
        { "value": "4 / 5", "label": "t:settings_schema.options.portrait" },
        { "value": "3 / 4", "label": "t:settings_schema.options.tall_portrait" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "checkbox",
      "id": "arch",
      "label": "t:sections.visit.arch.label",
      "default": true
    },
    {
      "type": "text",
      "id": "caption_left",
      "label": "t:sections.visit.caption_left.label",
      "default": "The salon"
    },
    {
      "type": "text",
      "id": "caption_right",
      "label": "t:sections.visit.caption_right.label",
      "default": "By appointment or walk-in"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing_header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "t:sections.visit.blocks.detail.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.visit.blocks.detail.label.label",
          "default": "Address"
        },
        {
          "type": "text",
          "id": "value",
          "label": "t:sections.visit.blocks.detail.value.label",
          "default": "8140 N MacArthur Blvd #120, Irving, TX"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.visit.blocks.detail.link.label"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "t:sections.visit.blocks.buttons.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.hero.blocks.buttons.button_label.label",
          "default": "Get Directions"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.hero.blocks.buttons.button_link.label"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "t:sections.hero.blocks.buttons.button_label_2.label",
          "default": "Contact Us"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "t:sections.hero.blocks.buttons.button_link_2.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.visit.name",
      "blocks": [
        { "type": "detail" },
        { "type": "detail", "settings": { "label": "Hours", "value": "Tue–Sat 11–7 · Sun 11–4 · Mon closed" } },
        { "type": "buttons" }
      ]
    }
  ]
}
{% endschema %}
