      "default": "By appointment or walk-in"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing_header"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.all.space_step.none"
        },
        {
          "value": "2xs",
          "label": "t:sections.all.space_step.2xs"
        },
        {
