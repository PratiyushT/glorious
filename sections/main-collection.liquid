{%- comment -%}
  The reference collection surface, rebuilt on Shopify's native collection,
  filter, sort and pagination drops. Collection links and Search & Discovery
  values are merchant data; no industry names or facet values live here.
{%- endcomment -%}

{%- liquid
  assign current_sort = collection.sort_by | default: collection.default_sort_by
  assign quick_filter = blank
  if section.settings.quick_links_source == 'filter'
    if section.settings.quick_filter_target == 'name' and section.settings.quick_filter_name != blank
      assign wanted_filter_name = section.settings.quick_filter_name | strip | downcase
      for filter in collection.filters
        assign candidate_filter_name = filter.label | strip | downcase
        if filter.type == 'list' and candidate_filter_name == wanted_filter_name
          assign quick_filter = filter
          break
        endif
      endfor
    else
      for filter in collection.filters
        if filter.type == 'list' and filter.values.size > 1
          assign quick_filter = filter
          break
        endif
      endfor
    endif
  endif

  assign catalog_gap = 'var(--grid-gap)'
  unless section.settings.gap == 'theme'
    if section.settings.gap == 'none'
      assign catalog_gap = '0'
    else
      assign catalog_gap = 'var(--step-' | append: section.settings.gap | append: ')'
    endif
  endunless

  assign catalog_column_gap = ''
  unless section.settings.column_gap == blank or section.settings.column_gap == 'theme'
    if section.settings.column_gap == 'none'
      assign catalog_column_gap = '0'
    else
      assign catalog_column_gap = 'var(--step-' | append: section.settings.column_gap | append: ')'
    endif
  endunless
-%}

<section
  class="catalog-page catalog-page--motion-{{ section.settings.grid_motion | default: 'reference' }}{% if section.settings.sticky_controls %} catalog-page--sticky-controls{% endif %} scheme-{{ section.settings.color_scheme }}"
  data-catalog-section="{{ section.id }}"
  data-catalog-ajax="{{ section.settings.enable_ajax }}"
  style="{% render 'section-style', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %} --catalog-columns: {{ section.settings.columns }}; --catalog-gap: {{ catalog_gap }};{% if catalog_column_gap != blank %} --catalog-column-gap: {{ catalog_column_gap }};{% endif %}"
>
  <div class="catalog-sticky-bar">
    <div class="catalog-shell">
      {% render 'catalog-controls',
        results: collection,
        section_id: section.id,
        section: section,
        context: 'collection',
        form_action: collection.url,
        clear_url: collection.url,
        sort_by: current_sort,
        quick_source: section.settings.quick_links_source,
        quick_filter: quick_filter,
        quick_links_limit: section.settings.quick_links_limit,
        show_filters: section.settings.show_filters,
        show_sort: section.settings.show_sort,
        include_drawer: false
      %}
    </div>
  </div>

  {%- if section.settings.show_filters and collection.filters.size > 0 -%}
    {%- assign drawer_name = 'catalog-filters-' | append: section.id -%}
    {% render 'catalog-filter-drawer', results: collection, section: section, context: 'collection', form_action: collection.url, clear_url: collection.url, current_sort: current_sort, drawer_name: drawer_name, show_sort: section.settings.show_sort, quick_source: section.settings.quick_links_source, quick_filter: quick_filter, quick_links_limit: section.settings.quick_links_limit %}
  {%- endif -%}

  <div class="catalog-shell">
    {% render 'catalog-active-filters', results: collection, clear_url: collection.url %}
  </div>

  {%- paginate collection.products by section.settings.products_per_page -%}
    <main class="catalog-main">
      <div class="catalog-loading" data-catalog-loading hidden>
        {% render 'loader', size: 'lg' %}
      </div>
      <div class="catalog-shell">
        <div class="catalog-grid-header{% unless section.settings.show_result_count %} catalog-grid-header--search-only{% endunless %}">
          {%- if section.settings.show_search -%}
            <form class="catalog-inline-search" action="{{ routes.search_url }}" method="get" role="search" data-catalog-form>
              <input type="hidden" name="options[prefix]" value="last">
              <input type="hidden" name="type" value="product,page,article">
              {% render 'icon', icon: 'search', width: '14', height: '14' %}
              <label class="visually-hidden" for="CollectionSearch-{{ section.id }}">{{ 'general.search.search' | t }}</label>
              <input id="CollectionSearch-{{ section.id }}" type="search" name="q" placeholder="{{ section.settings.search_placeholder | escape }}">
            </form>
          {%- endif -%}

          {%- if section.settings.show_result_count -%}
            <span class="catalog-result-count" role="status" aria-live="polite">{{ 'collections.product_count' | t: count: collection.products_count }}</span>
          {%- endif -%}
        </div>

        {%- if collection.products.size > 0 -%}
          <div class="catalog-grid" data-catalog-grid>
            {%- for product in collection.products -%}
              <div class="catalog-grid__item" style="--catalog-item-index: {{ forloop.index0 }};">
                {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
              </div>
            {%- endfor -%}
          </div>

          <div class="catalog-pagination-wrap catalog-pagination-wrap--{{ section.settings.pagination_style }}">
            {% render 'catalog-pagination', paginate: paginate %}
          </div>
        {%- else -%}
          <div class="catalog-empty">
            <h2>{{ 'collections.filters.empty_heading' | t }}</h2>
            <p>{{ 'collections.filters.empty_text' | t }}</p>
            {%- assign clear_filters_label = 'collections.filters.clear' | t -%}
            {% render 'button', label: clear_filters_label, link: collection.url, attributes: 'data-catalog-link' %}
          </div>
        {%- endif -%}
      </div>
    </main>
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "t:sections.main_collection.name",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_1"
    },
    {
      "type": "header",
      "content": "t:sections.main_collection.navigation.content"
    },
    {
      "type": "checkbox",
      "id": "sticky_controls",
      "label": "t:sections.catalog.sticky_controls",
      "default": true
    },
    {
      "type": "select",
      "id": "controls_style",
      "label": "t:sections.catalog.control_style",
      "options": [
        { "value": "pills", "label": "t:sections.catalog.outlined_pills" },
        { "value": "soft", "label": "t:sections.catalog.soft_pills" },
        { "value": "line", "label": "t:sections.catalog.underline" },
        { "value": "minimal", "label": "t:sections.catalog.minimal" }
      ],
      "default": "pills"
    },
    {
      "type": "select",
      "id": "controls_layout",
      "label": "t:sections.catalog.control_alignment",
      "options": [
        { "value": "spread", "label": "t:sections.catalog.spread_controls" },
        { "value": "start", "label": "t:sections.catalog.start" },
        { "value": "center", "label": "t:sections.catalog.center" }
      ],
      "default": "spread"
    },
    {
      "type": "select",
      "id": "mobile_controls_layout",
      "label": "t:sections.catalog.narrow_controls",
      "options": [
        { "value": "stacked", "label": "t:sections.catalog.stacked" },
        { "value": "row", "label": "t:sections.catalog.single_row" }
      ],
      "default": "stacked"
    },
    {
      "type": "select",
      "id": "quick_links_source",
      "label": "t:sections.main_collection.quick_links_source.label",
      "info": "t:sections.main_collection.quick_links_source.info",
      "options": [
        { "value": "collections", "label": "t:sections.main_collection.quick_links_source.collections" },
        { "value": "filter", "label": "t:sections.main_collection.quick_links_source.filter" },
        { "value": "none", "label": "t:sections.main_collection.quick_links_source.none" }
      ],
      "default": "collections"
    },
    {
      "type": "select",
      "id": "quick_filter_target",
      "label": "t:sections.main_collection.quick_filter_target.label",
      "visible_if": "{{ section.settings.quick_links_source == 'filter' }}",
      "options": [
        { "value": "auto", "label": "t:sections.main_collection.quick_filter_target.auto" },
        { "value": "name", "label": "t:sections.main_collection.quick_filter_target.name" }
      ],
      "default": "auto"
    },
    {
      "type": "text",
      "id": "quick_filter_name",
      "label": "t:sections.main_collection.quick_filter_name.label",
      "info": "t:sections.main_collection.quick_filter_name.info",
      "visible_if": "{{ section.settings.quick_links_source == 'filter' and section.settings.quick_filter_target == 'name' }}"
    },
    {
      "type": "select",
      "id": "quick_links_limit",
      "label": "t:sections.main_collection.quick_links_limit.label",
      "visible_if": "{{ section.settings.quick_links_source == 'collections' }}",
      "options": [
        { "value": "4", "label": "4" },
        { "value": "6", "label": "6" },
        { "value": "8", "label": "8" },
        { "value": "12", "label": "12" }
      ],
      "default": "6"
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "t:sections.main_collection.show_filters.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.catalog.filter_drawer"
    },
    {
      "type": "color_scheme",
      "id": "drawer_color_scheme",
      "label": "t:sections.catalog.drawer_color_scheme",
      "default": "scheme_1",
      "visible_if": "{{ section.settings.show_filters }}"
    },
    {
      "type": "select",
      "id": "drawer_position",
      "label": "t:sections.catalog.drawer_position",
      "options": [
        { "value": "start", "label": "t:sections.catalog.left" },
        { "value": "end", "label": "t:sections.catalog.right" }
      ],
      "default": "end",
      "visible_if": "{{ section.settings.show_filters }}"
    },
    {
      "type": "select",
      "id": "drawer_width",
      "label": "t:sections.catalog.drawer_width",
      "options": [
        { "value": "narrow", "label": "t:sections.catalog.narrow" },
        { "value": "medium", "label": "t:sections.catalog.medium" },
        { "value": "wide", "label": "t:sections.catalog.wide" }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.show_filters }}"
    },
    {
      "type": "select",
      "id": "mobile_drawer_style",
      "label": "t:sections.catalog.narrow_filter",
      "options": [
        { "value": "sheet", "label": "t:sections.catalog.bottom_sheet" },
        { "value": "side", "label": "t:sections.catalog.side_drawer" }
      ],
      "default": "sheet",
      "visible_if": "{{ section.settings.show_filters }}"
    },
    {
      "type": "select",
      "id": "filter_group_style",
      "label": "t:sections.catalog.filter_groups",
      "options": [
        { "value": "expanded", "label": "t:sections.catalog.open" },
        { "value": "accordion", "label": "t:sections.catalog.collapsible" }
      ],
      "default": "expanded",
      "visible_if": "{{ section.settings.show_filters }}"
    },
    {
      "type": "checkbox",
      "id": "open_first_filter",
      "label": "t:sections.catalog.open_first_filter",
      "default": true,
      "visible_if": "{{ section.settings.show_filters and section.settings.filter_group_style == 'accordion' }}"
    },
    {
      "type": "checkbox",
      "id": "show_filter_counts",
      "label": "t:sections.catalog.show_option_counts",
      "default": true,
      "visible_if": "{{ section.settings.show_filters }}"
    },
    {
      "type": "checkbox",
      "id": "show_filter_visuals",
      "label": "t:sections.catalog.show_filter_visuals",
      "default": true,
      "visible_if": "{{ section.settings.show_filters }}"
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "t:sections.main_collection.show_sort.label",
      "default": true
    },
    {
      "type": "select",
      "id": "sort_placement",
      "label": "t:sections.catalog.sort_position",
      "options": [
        { "value": "bar", "label": "t:sections.catalog.control_bar" },
        { "value": "drawer", "label": "t:sections.catalog.filter_drawer" },
        { "value": "both", "label": "t:sections.catalog.both" }
      ],
      "default": "bar",
      "visible_if": "{{ section.settings.show_sort }}"
    },
    {
      "type": "select",
      "id": "sort_style",
      "label": "t:sections.catalog.sort_control",
      "options": [
        { "value": "dropdown", "label": "t:sections.catalog.animated_dropdown" },
        { "value": "native", "label": "t:sections.catalog.native_select" }
      ],
      "default": "dropdown",
      "visible_if": "{{ section.settings.show_sort and section.settings.sort_placement != 'drawer' }}"
    },
    {
      "type": "checkbox",
      "id": "show_sort_label",
      "label": "t:sections.catalog.show_sort_label",
      "default": false,
      "visible_if": "{{ section.settings.show_sort and section.settings.sort_placement != 'drawer' }}"
    },
    {
      "type": "select",
      "id": "sort_menu_width",
      "label": "t:sections.catalog.sort_menu_width",
      "options": [
        { "value": "narrow", "label": "t:sections.catalog.narrow" },
        { "value": "medium", "label": "t:sections.catalog.medium" },
        { "value": "wide", "label": "t:sections.catalog.wide" }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.show_sort and section.settings.sort_style == 'dropdown' and section.settings.sort_placement != 'drawer' }}"
    },
    {
      "type": "select",
      "id": "sort_menu_alignment",
      "label": "t:sections.catalog.sort_menu_alignment",
      "options": [
        { "value": "start", "label": "t:sections.catalog.left" },
        { "value": "end", "label": "t:sections.catalog.right" }
      ],
      "default": "end",
      "visible_if": "{{ section.settings.show_sort and section.settings.sort_style == 'dropdown' and section.settings.sort_placement != 'drawer' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_ajax",
      "label": "t:sections.main_collection.enable_ajax.label",
      "info": "t:sections.main_collection.enable_ajax.info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main_collection.grid.content"
    },
    {
      "type": "checkbox",
      "id": "show_result_count",
      "label": "t:sections.catalog.show_product_count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:sections.main_collection.show_search.label",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "t:sections.main_collection.search_placeholder.label",
      "default": "Search products"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:sections.main_collection.products_per_page.label",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.main_collection.columns.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "gap",
      "label": "t:sections.catalog.card_gap",
      "info": "t:sections.catalog.card_gap_info",
      "options": [
        { "value": "theme", "label": "t:sections.catalog.theme_product_gap" },
        { "value": "none", "label": "t:blocks.all.step.none" },
        { "value": "minimal", "label": "t:blocks.all.step.minimal" },
        { "value": "tiny", "label": "t:blocks.all.step.tiny" },
        { "value": "small", "label": "t:blocks.all.step.small" },
        { "value": "medium", "label": "t:blocks.all.step.medium" },
        { "value": "large", "label": "t:blocks.all.step.large" },
        { "value": "xlarge", "label": "t:blocks.all.step.xlarge" }
      ],
      "default": "theme"
    },
    {
      "type": "select",
      "id": "column_gap",
      "label": "t:sections.all.card_column_gap.label",
      "info": "t:sections.all.card_column_gap.info",
      "options": [
        { "value": "theme", "label": "t:sections.catalog.theme_product_gap" },
        { "value": "none", "label": "t:blocks.all.step.none" },
        { "value": "minimal", "label": "t:blocks.all.step.minimal" },
        { "value": "tiny", "label": "t:blocks.all.step.tiny" },
        { "value": "small", "label": "t:blocks.all.step.small" },
        { "value": "medium", "label": "t:blocks.all.step.medium" },
        { "value": "large", "label": "t:blocks.all.step.large" },
        { "value": "xlarge", "label": "t:blocks.all.step.xlarge" }
      ],
      "default": "theme"
    },
    {
      "type": "select",
      "id": "grid_motion",
      "label": "t:sections.catalog.product_grid_animation",
      "options": [
        { "value": "none", "label": "t:sections.catalog.none" },
        { "value": "fade", "label": "t:sections.catalog.fade" },
        { "value": "reference", "label": "t:sections.catalog.reference_rise_stagger" }
      ],
      "default": "reference"
    },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "t:sections.catalog.pagination_style",
      "options": [
        { "value": "round", "label": "t:sections.catalog.round_pages" },
        { "value": "minimal", "label": "t:sections.catalog.minimal" }
      ],
      "default": "round"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing_header"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "t:sections.main_collection.name",
      "blocks": [
        {
          "type": "_product-card",
          "static": true,
          "id": "product-card",
          "blocks": [
            { "type": "_product-card-media", "settings": { "image_ratio": "1/1", "image_fit": "contain" } },
            { "type": "product_badges" },
            { "type": "product_title", "settings": { "style": "small", "element": "h2", "override_case": "uppercase", "override_tracking": "wide", "wrap": "minimum_two_lines", "link_to_product": true } },
            { "type": "_product-card-option-control", "settings": { "target_by": "auto", "control": "auto", "swatch_shape": "round" } },
            { "type": "_product-card-price" },
            { "type": "_product-card-add", "settings": { "variant_action": "choose_options" } }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
