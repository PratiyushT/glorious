{{ 'product-recommendations.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-recommendations.js' | asset_url }}" defer></script>

{%- liquid
  assign recommendation_limit = section.settings.products_to_show
  assign recommendation_count = recommendations.products_count

  capture recommendations_url
    echo routes.product_recommendations_url
    echo '?section_id='
    echo section.id | url_encode
    echo '&product_id='
    echo product.id
    echo '&limit='
    echo recommendation_limit
    echo '&intent='
    echo section.settings.intent | url_encode
  endcapture
-%}

<product-recommendations
  data-section-id="{{ section.id }}"
  data-url="{{ recommendations_url | strip | escape }}"
  data-loaded="{% if recommendations.performed? %}true{% else %}false{% endif %}"
>
  {%- if recommendations.performed? and recommendation_count > 0 -%}
    <section
      class="section scheme-{{ section.settings.color_scheme }}{% if section.settings.full_height %} section--tall{% endif %}"
      style="{% render 'section-style', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %} {%- if section.settings.content_alignment != blank and section.settings.content_alignment != 'inherit' -%}--section-align: {{ section.settings.content_alignment }}; --section-align-jc: {% if section.settings.content_alignment == 'center' %}center{% elsif section.settings.content_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};{%- endif -%}"
    >
      <div
        class="page-width products-list__content"
        data-recommendations-list
        style="{% render 'block-spacing', gap: section.settings.gap %}"
      >
        {% content_for 'blocks' %}

        {%- comment -%} Columns only; the ruler reads the same pair, so the carousel follows. {%- endcomment -%}
        {%- capture grid_vars -%}
          --gap: var(--grid-gap);
          {%- unless section.settings.column_gap == blank or section.settings.column_gap == 'theme' -%}
            {%- if section.settings.column_gap == 'none' %} --column-gap: 0;
            {%- else %} --column-gap: var(--step-{{ section.settings.column_gap }});{% endif -%}
          {%- endunless -%}
        {%- endcapture -%}

        {%- capture cards -%}
          {%- for recommended_product in recommendations.products -%}
            <div class="row-carousel__cell reveal" data-row-cell style="--reveal-delay: {{ forloop.index0 | times: 60 }}ms;">
              {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: recommended_product %}
            </div>
          {%- endfor -%}
        {%- endcapture -%}

        {%- render 'row-carousel',
          cells: cards,
          count: recommendation_count,
          motion: section.settings.carousel_motion,
          arrows: section.settings.carousel_arrows,
          label: section.settings.accessibility_label,
          track_class: 'grid-auto--products',
          track_style: grid_vars,
          layout_desktop: section.settings.layout,
          layout_tablet: section.settings.layout_tablet,
          layout_mobile: section.settings.layout_mobile
        -%}
      </div>
    </section>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "t:sections.product_recommendations.name",
  "tag": "div",
  "enabled_on": {
    "templates": ["product"]
  },
  "blocks": [
    { "type": "@app" },
    { "type": "text" },
    { "type": "rich-text" },
    { "type": "group" },
    { "type": "accordion" },
    { "type": "button" },
    { "type": "custom-liquid" }
  ],
  "settings": [
    {
      "type": "select",
      "id": "intent",
      "label": "t:sections.product_recommendations.intent.label",
      "info": "t:sections.product_recommendations.intent.info",
      "options": [
        { "value": "related", "label": "t:sections.product_recommendations.intent.related" },
        { "value": "complementary", "label": "t:sections.product_recommendations.intent.complementary" }
      ],
      "default": "related"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "t:sections.product_recommendations.accessibility_label.label",
      "default": "Recommended products"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:sections.all.content_alignment.label",
      "info": "t:sections.all.content_alignment.info",
      "options": [
        { "value": "left", "label": "t:settings_schema.options.left" },
        { "value": "center", "label": "t:settings_schema.options.center" },
        { "value": "right", "label": "t:settings_schema.options.right" }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_1"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.all.layout.desktop_label",
      "info": "t:sections.all.layout.info",
      "options": [
        { "value": "grid", "label": "t:sections.all.layout.grid" },
        { "value": "carousel", "label": "t:sections.all.layout.carousel" }
      ],
      "default": "grid"
    },
    {
      "type": "select", "id": "layout_tablet", "label": "t:sections.all.layout.tablet_label",
      "options": [
        { "value": "grid", "label": "t:sections.all.layout.grid" },
        { "value": "carousel", "label": "t:sections.all.layout.carousel" }
      ], "default": "carousel"
    },
    {
      "type": "select", "id": "layout_mobile", "label": "t:sections.all.layout.mobile_label",
      "options": [
        { "value": "grid", "label": "t:sections.all.layout.grid" },
        { "value": "carousel", "label": "t:sections.all.layout.carousel" }
      ], "default": "carousel"
    },
    {
      "type": "select",
      "id": "carousel_motion",
      "label": "t:sections.all.carousel_motion.label",
      "info": "t:sections.all.carousel_motion.info",
      "options": [
        { "value": "slide", "label": "t:sections.all.carousel_motion.slide" },
        { "value": "fade", "label": "t:sections.all.carousel_motion.fade" }
      ],
      "default": "slide",
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.layout_tablet == 'carousel' or section.settings.layout_mobile == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "carousel_arrows",
      "label": "t:sections.all.carousel_arrows.label",
      "info": "t:sections.all.carousel_arrows.info",
      "options": [
        { "value": "bottom", "label": "t:sections.all.carousel_arrows.bottom" },
        { "value": "top", "label": "t:sections.all.carousel_arrows.top" },
        { "value": "side", "label": "t:sections.all.carousel_arrows.side" }
      ],
      "default": "bottom",
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.layout_tablet == 'carousel' or section.settings.layout_mobile == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.product_recommendations.products_to_show.label",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "gap",
      "label": "t:blocks.all.gap.label",
      "info": "t:blocks.all.gap.info",
      "options": [
        { "value": "none", "label": "t:blocks.all.step.none" },
        { "value": "minimal", "label": "t:blocks.all.step.minimal" },
        { "value": "tiny", "label": "t:blocks.all.step.tiny" },
        { "value": "small", "label": "t:blocks.all.step.small" },
        { "value": "medium", "label": "t:blocks.all.step.medium" },
        { "value": "large", "label": "t:blocks.all.step.large" },
        { "value": "xlarge", "label": "t:blocks.all.step.xlarge" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "column_gap",
      "label": "t:sections.all.card_column_gap.label",
      "info": "t:sections.all.card_column_gap.info",
      "options": [
        { "value": "theme", "label": "t:sections.catalog.theme_product_gap" },
        { "value": "none", "label": "t:blocks.all.step.none" },
        { "value": "minimal", "label": "t:blocks.all.step.minimal" },
        { "value": "tiny", "label": "t:blocks.all.step.tiny" },
        { "value": "small", "label": "t:blocks.all.step.small" },
        { "value": "medium", "label": "t:blocks.all.step.medium" },
        { "value": "large", "label": "t:blocks.all.step.large" },
        { "value": "xlarge", "label": "t:blocks.all.step.xlarge" }
      ],
      "default": "theme"
    },
    {
      "type": "checkbox",
      "id": "full_height",
      "label": "t:sections.all.full_height.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing_header"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "lg"
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_recommendations.name",
      "blocks": [
        {
          "type": "group",
          "blocks": [
            {
              "type": "group",
              "blocks": [
                { "type": "text", "settings": { "text": "You may also like", "style": "subheading", "layout": "eyebrow", "element": "span" } },
                { "type": "text", "settings": { "text": "While you're here.", "style": "heading_2", "element": "h2" } }
              ],
              "settings": { "direction": "vertical", "vertical_gap": "tiny", "padding": "none" }
            },
            {
              "type": "button",
              "settings": { "button_label": "View all products", "button_link": "/collections/all", "button_style": "link" }
            }
          ],
          "settings": { "direction": "horizontal", "distribute": "between", "align": "baseline", "wrap": true, "stack_below": "mobile", "gap": "medium", "padding": "none" }
        },
        {
          "type": "_product-card",
          "static": true,
          "id": "product-card",
          "blocks": [
            { "type": "_product-card-media", "settings": { "image_ratio": "1/1", "image_fit": "contain" } },
            { "type": "product_badges" },
            { "type": "text", "settings": { "text": "{{ closest.product.title }}", "style": "small", "element": "h3", "override_case": "uppercase", "override_tracking": "wide" } },
            { "type": "_product-card-option-control", "settings": { "target_by": "auto", "control": "auto", "swatch_shape": "round" } },
            { "type": "_product-card-price" },
            { "type": "_product-card-add", "settings": { "variant_action": "choose_options" } }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
