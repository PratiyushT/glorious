{{ 'main-cart.css' | asset_url | stylesheet_tag }}
<script src="{{ 'main-cart.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign cart_name = settings.cart_name | default: 'Cart'
  assign cart_title = section.settings.title
  if cart_title == blank
    assign cart_title = 'cart.title' | t: cart_name: cart_name
  endif
  assign cart_ratio = section.settings.image_ratio | replace: '/', ' / '
  assign summary_width = 24
  if section.settings.summary_width == 'narrow'
    assign summary_width = 20
  elsif section.settings.summary_width == 'wide'
    assign summary_width = 28
  endif
-%}

<main-cart>
  <section
    class="section cart-page scheme-{{ section.settings.color_scheme }}"
    style="{% render 'section-style', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %} --cart-summary-width: {{ summary_width }}rem; --cart-image-ratio: {{ cart_ratio }}; --cart-image-fit: {{ section.settings.image_fit }};"
  >
    <div class="page-width cart-page__inner">
      <h1 class="cart-page__heading" style="{% render 'text-style', preset: section.settings.title_style %}">
        <span>{{ cart_title }}</span>
        {%- if section.settings.show_count and cart.item_count > 0 -%}
          <span class="cart-page__count">{{ 'navigation.cart_count' | t: count: cart.item_count }}</span>
        {%- endif -%}
      </h1>

      {% content_for 'blocks' %}

      {%- if cart.item_count == 0 -%}
        <div class="cart-page__empty">
          <p>{{ section.settings.empty_message }}</p>
          <div>
            <a class="btn btn--primary" href="{{ settings.cart_empty_link | default: routes.all_products_collection_url }}">{{ section.settings.empty_button_label }}</a>
          </div>
        </div>
      {%- else -%}
        {%- form 'cart', cart, class: 'cart-page__layout' -%}
          <div class="cart-page__items">
            {%- for item in cart.items -%}
              <article class="cart-line" data-cart-line="{{ item.key }}">
                <a class="cart-line__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                  {%- if item.image -%}
                    {%- assign item_lqip = item.image | image_url: width: 40 -%}
                    {{ item.image | image_url: width: 480 | image_tag: widths: '160,240,320,480', sizes: '(max-width: 47rem) 6.5rem, 9rem', loading: 'lazy', alt: item.image.alt, data-image-lqip: item_lqip }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </a>

                <div class="cart-line__info">
                  {%- if section.settings.show_vendor and item.product.vendor != blank -%}<span class="cart-line__vendor">{{ item.product.vendor }}</span>{%- endif -%}
                  <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
                  {% render 'line-options', item: item, class: 'cart-line__meta' %}
                  {%- if item.selling_plan_allocation -%}<span class="cart-line__selling-plan">{{ item.selling_plan_allocation.selling_plan.name }}</span>{%- endif -%}

                  {%- unless item.properties == empty -%}
                    <dl class="cart-line__meta">
                      {%- for property in item.properties -%}
                        {%- assign property_first = property.first | slice: 0 -%}
                        {%- if property.last != blank and property_first != '_' -%}
                          <div><dt>{{ property.first }}:</dt><dd>{%- if property.last contains '/uploads/' -%}<a href="{{ property.last }}" target="_blank">{{ property.last | split: '/' | last }}</a>{%- else -%}{{ property.last }}{%- endif -%}</dd></div>
                        {%- endif -%}
                      {%- endfor -%}
                    </dl>
                  {%- endunless -%}

                  {%- if item.line_level_discount_allocations.size > 0 -%}
                    <ul class="cart-line__discounts">
                      {%- for discount in item.line_level_discount_allocations -%}<li>{{ discount.discount_application.title }} −{{ discount.amount | money }}</li>{%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>

                <div class="cart-line__aside">
                  <div class="cart-line__price">
                    {%- if item.original_line_price > item.final_line_price -%}<s class="cart-line__compare">{{ item.original_line_price | money }}</s>{%- endif -%}
                    {%- if settings.cart_unit_price -%}{{ item.final_price | money }}{%- else -%}{{ item.final_line_price | money }}{%- endif -%}
                    {% render 'unit-price', price: item.unit_price, measurement: item.unit_price_measurement, class: 'cart-line__unit-price' %}
                  </div>
                  <div class="cart-line__controls">
                    <div class="cart-quantity" data-cart-quantity>
                      <button type="button" data-cart-quantity-change="-1" aria-label="{{ 'cart.decrease' | t: title: item.product.title }}">−</button>
                      <label class="visually-hidden" for="CartQuantity-{{ item.index | plus: 1 }}">{{ 'products.quantity' | t }}</label>
                      <input id="CartQuantity-{{ item.index | plus: 1 }}" name="updates[]" type="number" min="0" value="{{ item.quantity }}" inputmode="numeric">
                      <button type="button" data-cart-quantity-change="1" aria-label="{{ 'cart.increase' | t: title: item.product.title }}">+</button>
                    </div>
                    <a class="cart-line__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
                  </div>
                </div>
              </article>
            {%- endfor -%}
          </div>

          <aside class="cart-page__summary" aria-label="{{ 'cart.summary' | t }}">
            {%- if settings.cart_note -%}
              <div class="cart-page__note">
                <label for="CartNote-{{ section.id }}">{{ 'cart.note' | t }}</label>
                <textarea class="field" id="CartNote-{{ section.id }}" name="note">{{ cart.note }}</textarea>
              </div>
            {%- endif -%}

            {%- if settings.cart_discounts and cart.cart_level_discount_applications.size > 0 -%}
              <ul class="cart-page__discounts">
                {%- for discount in cart.cart_level_discount_applications -%}<li class="cart-page__summary-row"><span>{{ discount.title }}</span><span>−{{ discount.total_allocated_amount | money }}</span></li>{%- endfor -%}
              </ul>
            {%- endif -%}

            <div class="cart-page__summary-row cart-page__summary-row--total">
              <span>{{ 'cart.subtotal' | t }}</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            <div>{% render 'tax-note' %}</div>

            <div class="cart-page__actions">
              <button type="submit" name="checkout" class="btn btn--primary">{{ 'cart.checkout' | t }}</button>
              {%- if section.settings.show_update_button -%}<button type="submit" name="update" class="btn btn--secondary">{{ 'cart.update' | t }}</button>{%- endif -%}
            </div>

            {%- if settings.cart_accelerated_checkout -%}{{ form | payment_button }}{%- endif -%}
            {%- if settings.cart_installments -%}{{ form | payment_terms }}{%- endif -%}
          </aside>
        {%- endform -%}
      {%- endif -%}
    </div>
  </section>
</main-cart>

{% schema %}
{
  "name": "t:sections.main_cart.name",
  "enabled_on": { "templates": ["cart"] },
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.color_scheme.label", "default": "scheme_1" },
    { "type": "text", "id": "title", "label": "t:sections.main_cart.title", "info": "t:sections.main_cart.title_info" },
    {
      "type": "select", "id": "title_style", "label": "t:blocks.all.text_preset.label",
      "options": [
        { "value": "title", "label": "t:settings_schema.typography.presets.title.header" }, { "value": "heading_1", "label": "t:settings_schema.typography.presets.heading_1.header" },
        { "value": "heading_2", "label": "t:settings_schema.typography.presets.heading_2.header" }, { "value": "heading_3", "label": "t:settings_schema.typography.presets.heading_3.header" }
      ], "default": "heading_2"
    },
    { "type": "checkbox", "id": "show_count", "label": "t:sections.main_cart.show_count", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "t:sections.main_cart.show_vendor", "default": true },
    { "type": "checkbox", "id": "show_update_button", "label": "t:sections.main_cart.show_update_button", "default": true },
    {
      "type": "select", "id": "summary_width", "label": "t:sections.main_cart.summary_width",
      "options": [
        { "value": "narrow", "label": "t:sections.main_cart.summary_narrow" },
        { "value": "medium", "label": "t:sections.main_cart.summary_medium" },
        { "value": "wide", "label": "t:sections.main_cart.summary_wide" }
      ], "default": "medium"
    },
    {
      "type": "select", "id": "image_ratio", "label": "t:blocks.article_card.image_ratio",
      "options": [
        { "value": "1/1", "label": "t:blocks.article_card.square" }, { "value": "4/3", "label": "t:blocks.article_card.landscape" },
        { "value": "3/4", "label": "t:blocks.article_card.portrait" }
      ], "default": "1/1"
    },
    {
      "type": "select", "id": "image_fit", "label": "t:blocks.article_card.image_fit",
      "options": [ { "value": "contain", "label": "t:blocks.article_card.fit" }, { "value": "cover", "label": "t:blocks.article_card.fill" } ], "default": "contain"
    },
    { "type": "text", "id": "empty_message", "label": "t:sections.main_cart.empty_message", "default": "Your cart is waiting for something good." },
    { "type": "text", "id": "empty_button_label", "label": "t:sections.main_cart.empty_button_label", "default": "Continue shopping" },
    { "type": "header", "content": "t:sections.all.spacing_header" },
    { "type": "select", "id": "padding_top", "label": "t:sections.all.padding_top.label", "options": [
      { "value": "none", "label": "t:sections.all.space_step.none" }, { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
      { "value": "xs", "label": "t:sections.all.space_step.xs" }, { "value": "sm", "label": "t:sections.all.space_step.sm" },
      { "value": "md", "label": "t:sections.all.space_step.md" }, { "value": "lg", "label": "t:sections.all.space_step.lg" },
      { "value": "xl", "label": "t:sections.all.space_step.xl" }, { "value": "max", "label": "t:sections.all.space_step.max" }
    ], "default": "lg" },
    { "type": "select", "id": "padding_bottom", "label": "t:sections.all.padding_bottom.label", "options": [
      { "value": "none", "label": "t:sections.all.space_step.none" }, { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
      { "value": "xs", "label": "t:sections.all.space_step.xs" }, { "value": "sm", "label": "t:sections.all.space_step.sm" },
      { "value": "md", "label": "t:sections.all.space_step.md" }, { "value": "lg", "label": "t:sections.all.space_step.lg" },
      { "value": "xl", "label": "t:sections.all.space_step.xl" }, { "value": "max", "label": "t:sections.all.space_step.max" }
    ], "default": "xl" }
  ]
}
{% endschema %}
