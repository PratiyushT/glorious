{%- comment -%}
  Hero — a 1:1 rebuild of the design's homepage hero.

  Every default below is the design's own value. The settings exist so a
  merchant can move away from it, not so the theme starts somewhere else.

  Three deliberate arrangements, not one reflow. The design art-directs the
  grid at 990px and 1100px and the areas swap rather than resize:

    narrow (<990)   b / a / c / d   portrait, copy, carousel, then the CTA
    medium (<1100)  a b / c b       copy above carousel, portrait spanning
    wide  (>=1100)  a b c           copy, portrait, carousel side by side

  clamp() cannot move a grid area, so these are media queries — the one job
  the theme's fluid scales genuinely cannot do.

  The wordmark carries data-nav-anchor: the nav expands from pill to bar as
  the bottom of it leaves, which is what the design measures against.
{%- endcomment -%}

{%- liquid
  assign wordmark_source = settings.wordmark | default: shop.name | upcase
  assign wordmark_letters = wordmark_source | split: ''

  assign tab_blocks = section.blocks | where: 'type', 'collection_tab'
  assign detail_blocks = section.blocks | where: 'type', 'hero_detail'
  assign button_block = section.blocks | where: 'type', 'hero_cta' | first
-%}

<section
  class="hero scheme-{{ section.settings.color_scheme }}"
  id="top"
  data-hero
>
  <div class="hero__glow" aria-hidden="true"></div>

  {%- if section.settings.show_arcs -%}
    {% render 'icon', icon: 'hero-arc-left' %}
    {% render 'icon', icon: 'hero-arc-right' %}
  {%- endif -%}

  {%- if section.settings.show_sparkles -%}
    <div class="hero__sparkles" aria-hidden="true">
      <span style="left: 7%;  top: 120px;   --size: 1.13rem; --dur: 3.8s; --delay: 0.4s;">{% render 'icon', icon: 'sparkle' %}</span>
      <span style="left: 38%; top: 84px;    --size: 0.69rem; --dur: 4.6s; --delay: 1.6s;">{% render 'icon', icon: 'sparkle' %}</span>
      <span style="right: 9%; top: 132px;   --size: 0.94rem; --dur: 4.2s; --delay: 2.4s;">{% render 'icon', icon: 'sparkle' %}</span>
      <span style="right: 30%; top: 66px;   --size: 0.63rem; --dur: 5s;   --delay: 3.1s;">{% render 'icon', icon: 'sparkle' %}</span>
      <span style="left: 16%; bottom: 18%;  --size: 0.75rem; --dur: 5.4s; --delay: 2s;">{% render 'icon', icon: 'sparkle' %}</span>
    </div>
  {%- endif -%}

  {%- comment -%}
    The wordmark is the page's heading, not a picture of one. It was a `div`
    carrying `role="img"`, so the homepage announced no heading at all — and a
    document whose only headings are five `h3` feature cards has a
    hierarchy that starts at level three.

    Spans rather than divs because an `h1` takes phrasing content: nesting a
    `div` in it is invalid HTML, and this theme has a store review to pass. The
    letters stay one element each — the entrance animates them 60ms apart off
    `--letter` — so the whole lockup is hidden from assistive technology and
    the accessible name is a single text node instead.
  {%- endcomment -%}
  {%- if section.settings.show_wordmark -%}
    <h1 class="hero__wordmark" data-nav-anchor>
      <span class="visually-hidden">{{ wordmark_source }}</span>
      <span class="hero__wordmark-inner" aria-hidden="true">
        <span class="hero__letters">
          {%- for letter in wordmark_letters -%}
            <span style="--letter: {{ forloop.index0 }};">{{ letter }}</span>
          {%- endfor -%}
        </span>
      </span>
    </h1>
  {%- endif -%}

  <div class="hero__fit" data-hero-fit>
    <div class="hero__grid" data-hero-grid>
      <div class="hero__copy">
        {%- if section.settings.intro != blank -%}
          <div class="hero__intro rte" style="{% render 'text-style', preset: 'paragraph' %}">
            {{ section.settings.intro }}
          </div>
        {%- endif -%}

        {%- for block in detail_blocks -%}
          {%- if block.settings.label != blank -%}
            <div class="hero__detail-label" {{ block.shopify_attributes }}>{{ block.settings.label }}</div>
            <div class="hero__detail-row">
              <span class="hero__choice is-on">
                <span class="hero__dot" aria-hidden="true"><span></span></span>
                {{ block.settings.value }}
              </span>
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%}
          Each tab changes the carousel's product pool. The selected collection
          is rendered in Liquid, so every tab remains a real catalogue source
          without relying on a client-side product feed.
        {%- endcomment -%}
        {%- if tab_blocks.size > 0 -%}
          <div class="hero__detail-label">{{ section.settings.tab_label }}</div>
          <div class="hero__detail-row" role="group" aria-label="{{ section.settings.tab_label | escape }}">
            {%- for block in tab_blocks -%}
              <button
                class="hero__choice{% if forloop.first %} is-on{% endif %}"
                type="button"
                data-hero-tab="{{ forloop.index0 }}"
                aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                {{ block.shopify_attributes }}
              >
                <span class="hero__dot" aria-hidden="true"><span></span></span>
                {{ block.settings.label }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="hero__rule" aria-hidden="true"></div>

        {%- if button_block != blank and button_block.settings.button_label != blank -%}
          <a
            class="hero__cta"
            href="{{ button_block.settings.button_link | default: routes.all_products_collection_url }}"
            {{ button_block.shopify_attributes }}
          >
            {{ button_block.settings.button_label }}
            <span aria-hidden="true">{% render 'icon', icon: 'arrow-right' %}</span>
          </a>
        {%- endif -%}
      </div>

      <div class="hero__portrait">
        <div class="hero__portrait-frame">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 1200 }}"
              data-image-lqip="{{ section.settings.image | image_url: width: 40 }}"
              srcset="{{ section.settings.image | image_url: width: 500 }} 500w, {{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 68.75rem) 44vh, (min-width: 61.875rem) 46vh, 62vw"
              alt="{{ section.settings.image.alt | escape }}"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              loading="eager"
              fetchpriority="high"
            >
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="hero__portrait-fade" aria-hidden="true"></span>
        </div>
      </div>

      {%- comment -%}
        Two pieces at a time out of the selected tab's collection. The whole
        pool is rendered and the carousel shows a window of it, so stepping
        never waits on a request and the pieces are still real links without
        any scripting.
      {%- endcomment -%}
      <div class="hero__cards">
        <div class="hero-carousel" data-hero-carousel>
          <button class="hero-carousel__arrow hero-carousel__arrow--prev" type="button" data-hero-step="-1" aria-label="{{ 'hero.previous' | t }}">
            {% render 'icon', icon: 'arrow-left' %}
          </button>

          <div class="hero-carousel__window" data-hero-window>
            {%- for block in tab_blocks -%}
              {%- assign pool = block.settings.collection -%}
              <div
                class="hero-carousel__pool"
                data-hero-pool="{{ forloop.index0 }}"
                {% unless forloop.first %}hidden{% endunless %}
              >
                {%- if pool != blank and pool.products.size > 0 -%}
                  {%- for product in pool.products limit: 12 -%}
                    <a class="hero-card" href="{{ product.url }}" data-hero-card>
                      <span class="hero-card__frame">
                        {%- if product.featured_media -%}
                          <img
                            src="{{ product.featured_media | image_url: width: 500 }}"
                            data-image-lqip="{{ product.featured_media | image_url: width: 40 }}"
                            srcset="{{ product.featured_media | image_url: width: 300 }} 300w, {{ product.featured_media | image_url: width: 500 }} 500w, {{ product.featured_media | image_url: width: 760 }} 760w"
                            sizes="15.5rem"
                            alt=""
                            width="{{ product.featured_media.width }}"
                            height="{{ product.featured_media.height }}"
                            loading="{% if forloop.index <= 2 %}eager{% else %}lazy{% endif %}"
                          >
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        {%- endif -%}
                      </span>
                      <span class="hero-card__name">{{ product.title }}</span>
                    </a>
                  {%- endfor -%}
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>

          <button class="hero-carousel__arrow hero-carousel__arrow--next" type="button" data-hero-step="1" aria-label="{{ 'hero.next' | t }}">
            {% render 'icon', icon: 'arrow-right' %}
          </button>
        </div>

        {%- comment -%}
          At the medium arrangement the portrait spans both rows and there is
          no room beside the cards, so the same two controls sit under them.
        {%- endcomment -%}
        <div class="hero-carousel__below">
          <button class="hero-carousel__arrow" type="button" data-hero-step="-1" aria-label="{{ 'hero.previous' | t }}">{% render 'icon', icon: 'arrow-left' %}</button>
          <button class="hero-carousel__arrow" type="button" data-hero-step="1" aria-label="{{ 'hero.next' | t }}">{% render 'icon', icon: 'arrow-right' %}</button>
        </div>
      </div>

      {%- if button_block != blank and button_block.settings.button_label != blank -%}
        {%- comment -%}
          The second of two render sites for one block: CSS decides which is
          visible per breakpoint. It has to carry `shopify_attributes` too, or
          below 990px — where this is the one on screen — the theme editor
          cannot select or highlight the button a merchant is looking at.
        {%- endcomment -%}
        <div class="hero__cta-row">
          <a
            class="hero__cta"
            href="{{ button_block.settings.button_link | default: routes.all_products_collection_url }}"
            {{ button_block.shopify_attributes }}
          >
            {{ button_block.settings.button_label }}
            <span aria-hidden="true">{% render 'icon', icon: 'arrow-right' %}</span>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.hero.name",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_2"
    },
    {
      "type": "header",
      "content": "t:sections.hero.wordmark_header"
    },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "t:sections.hero.show_wordmark.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sparkles",
      "label": "t:sections.hero.show_sparkles.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arcs",
      "label": "t:sections.hero.show_arcs.label",
      "default": true
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:sections.hero.intro.label",
      "default": "<p>Thoughtfully made products with distinctive character, considered materials, and lasting quality.</p>"
    },
    {
      "type": "header",
      "content": "t:sections.hero.portrait_header"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero.image.label",
      "info": "t:sections.hero.image.info"
    },
    {
      "type": "header",
      "content": "t:sections.hero.carousel_header"
    },
    {
      "type": "paragraph",
      "content": "t:sections.hero.carousel_paragraph"
    },
    {
      "type": "text",
      "id": "tab_label",
      "label": "t:sections.hero.tab_label.label",
      "default": "Collection:"
    }
  ],
  "blocks": [
    {
      "type": "hero_detail",
      "name": "t:sections.hero.blocks.hero_detail.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.hero.blocks.hero_detail.label_label",
          "default": "Featured:"
        },
        {
          "type": "text",
          "id": "value",
          "label": "t:sections.hero.blocks.hero_detail.value_label",
          "default": "New arrivals"
        }
      ]
    },
    {
      "type": "collection_tab",
      "name": "t:sections.hero.blocks.collection_tab.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.all.link_label.label",
          "default": "Featured"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.hero.blocks.collection_tab.collection.label",
          "info": "t:sections.hero.blocks.collection_tab.collection.info"
        }
      ]
    },
    {
      "type": "hero_cta",
      "name": "t:sections.hero.blocks.hero_cta.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.hero.blocks.hero_cta.button_label.label",
          "default": "Collections"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.hero.blocks.hero_cta.button_link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.name",
      "blocks": [
        { "type": "hero_detail" },
        { "type": "collection_tab" },
        { "type": "hero_cta" }
      ]
    }
  ]
}
{% endschema %}
