{%- comment -%}
  Footer — exact to the reference design.

  Social row, the letters-only wordmark, then link columns that become an
  accordion when the footer runs out of width. One set of markup serves both —
  a container query turns the column heading into a real toggle rather than
  duplicating the links into a separate mobile block.

  A column entry whose URL is #newsletter or #cookie-preferences renders as a
  button that reopens that overlay instead of navigating, which is how the
  design's "Newsletter" and "Cookie Preferences" rows behave. The convention
  works for hand-entered links and for Shopify menu items alike.
{%- endcomment -%}

{%- liquid
  assign social_blocks = section.blocks | where: 'type', 'social'
  assign social = social_blocks.first
  assign has_social_links = false
  if social != blank
    if social.settings.instagram != blank or social.settings.facebook != blank or social.settings.pinterest != blank or social.settings.tiktok != blank or social.settings.youtube != blank or social.settings.x != blank
      assign has_social_links = true
    endif
  endif
  assign column_blocks = section.blocks | where: 'type', 'menu'
  assign policy_blocks = section.blocks | where: 'type', 'policies'
  assign contact_blocks = section.blocks | where: 'type', 'contact'
-%}

<footer
  class="footer section scheme-{{ section.settings.color_scheme }}"
  style="{% render 'section-style', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}"
>
  <div class="page-width">
    {%- if has_social_links -%}
      <div class="footer__social" {{ social.shopify_attributes }}>
        {%- if social.settings.instagram != blank -%}
          <a class="footer__link" href="{{ social.settings.instagram }}" target="_blank" rel="noopener">{% render 'icon', icon: 'instagram', width: 16, height: 16 %}<span>Instagram</span></a>
        {%- endif -%}
        {%- if social.settings.facebook != blank -%}
          <a class="footer__link" href="{{ social.settings.facebook }}" target="_blank" rel="noopener">{% render 'icon', icon: 'facebook', width: 16, height: 16 %}<span>Facebook</span></a>
        {%- endif -%}
        {%- if social.settings.pinterest != blank -%}
          <a class="footer__link" href="{{ social.settings.pinterest }}" target="_blank" rel="noopener">{% render 'icon', icon: 'pinterest', width: 16, height: 16 %}<span>Pinterest</span></a>
        {%- endif -%}
        {%- if social.settings.tiktok != blank -%}
          <a class="footer__link" href="{{ social.settings.tiktok }}" target="_blank" rel="noopener">{% render 'icon', icon: 'tiktok', width: 16, height: 16 %}<span>TikTok</span></a>
        {%- endif -%}
        {%- if social.settings.youtube != blank -%}
          <a class="footer__link" href="{{ social.settings.youtube }}" target="_blank" rel="noopener">{% render 'icon', icon: 'youtube', width: 16, height: 16 %}<span>YouTube</span></a>
        {%- endif -%}
        {%- if social.settings.x != blank -%}
          <a class="footer__link" href="{{ social.settings.x }}" target="_blank" rel="noopener">{% render 'icon', icon: 'x', width: 16, height: 16 %}<span>X</span></a>
        {%- endif -%}
      </div>
      <div class="hairline"></div>
    {%- endif -%}

    {% render 'huge-text', source: section.settings.huge_text_value, placement: 'footer', on_dark: true, display: section.settings.brand_display, logo_side: section.settings.brand_logo_side, logo_variant: section.settings.brand_logo_variant %}

    {%- if column_blocks.size > 0 or policy_blocks.size > 0 or contact_blocks.size > 0 -%}
      {%- comment -%}
        The wrapper is the query container; the grid inside it is what the
        queries re-column. An element cannot query its own size.
      {%- endcomment -%}
      <div class="footer__cols">
      <div class="footer__grid" data-footer-cols>
        {%- for block in column_blocks -%}
          {%- assign panel_id = 'footer-col-' | append: block.id -%}
          <div class="footer__col" data-disclosure {{ block.shopify_attributes }}>
            <button
              class="footer__col-toggle disclosure__toggle"
              type="button"
              data-footer-toggle
              aria-controls="{{ panel_id }}"
              aria-expanded="false"
            >
              <span class="footer__heading">{{ block.settings.heading }}</span>
              <span class="footer__col-mark disclosure__mark" aria-hidden="true">
                <span class="footer__col-plus disclosure__plus">{% render 'icon', icon: 'plus' %}</span>
                <span class="footer__col-minus disclosure__minus">{% render 'icon', icon: 'minus' %}</span>
              </span>
            </button>

            {%- comment -%}
              Three levels, not two. The middle element does the clipping and
              nothing else — put the padding on it and the padding cannot be
              clipped away, so a collapsed panel still shows a sliver of its
              first row.
            {%- endcomment -%}
            <div class="footer__col-panel disclosure__panel" id="{{ panel_id }}">
              <div class="footer__col-clip disclosure__clip">
              <div class="footer__col-links">
                {%- for link in block.settings.menu.links -%}
                  {% render 'footer-entry', label: link.title, url: link.url %}
                {%- else -%}
                  <span class="footer__text">{{ 'sections.footer.menu_empty' | t }}</span>
                {%- endfor -%}
              </div>
              </div>
            </div>
          </div>
        {%- endfor -%}

        {%- for block in policy_blocks -%}
          {%- assign panel_id = 'footer-col-' | append: block.id -%}
          <div class="footer__col" data-disclosure {{ block.shopify_attributes }}>
            <button class="footer__col-toggle disclosure__toggle" type="button" data-footer-toggle aria-controls="{{ panel_id }}" aria-expanded="false">
              <span class="footer__heading">{{ block.settings.heading }}</span>
              <span class="footer__col-mark disclosure__mark" aria-hidden="true">
                <span class="footer__col-plus disclosure__plus">{% render 'icon', icon: 'plus' %}</span>
                <span class="footer__col-minus disclosure__minus">{% render 'icon', icon: 'minus' %}</span>
              </span>
            </button>
            <div class="footer__col-panel disclosure__panel" id="{{ panel_id }}">
              <div class="footer__col-clip disclosure__clip">
                <div class="footer__col-links">
                  {%- for policy in shop.policies -%}
                    {%- if policy != blank -%}{% render 'footer-entry', label: policy.title, url: policy.url %}{%- endif -%}
                  {%- else -%}
                    <span class="footer__text">{{ 'sections.footer.policies_empty' | t }}</span>
                  {%- endfor -%}
                  {%- if block.settings.show_cookie_preferences -%}
                    {%- assign cookie_preferences_label = 'sections.footer.cookie_preferences' | t -%}
                    {% render 'footer-entry', label: cookie_preferences_label, url: '#cookie-preferences' %}
                  {%- endif -%}
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}

        {%- comment -%}
          Contact details wrap and use a looser line height than short links.
        {%- endcomment -%}
        {%- for block in contact_blocks -%}
          {%- assign panel_id = 'footer-col-' | append: block.id -%}
          <div class="footer__col footer__col--contact" data-disclosure {{ block.shopify_attributes }}>
            <button
              class="footer__col-toggle disclosure__toggle"
              type="button"
              data-footer-toggle
              aria-controls="{{ panel_id }}"
              aria-expanded="false"
            >
              <span class="footer__heading">{{ block.settings.heading }}</span>
              <span class="footer__col-mark disclosure__mark" aria-hidden="true">
                <span class="footer__col-plus disclosure__plus">{% render 'icon', icon: 'plus' %}</span>
                <span class="footer__col-minus disclosure__minus">{% render 'icon', icon: 'minus' %}</span>
              </span>
            </button>

            {%- comment -%}
              Three levels, not two. The middle element does the clipping and
              nothing else — put the padding on it and the padding cannot be
              clipped away, so a collapsed panel still shows a sliver of its
              first row.
            {%- endcomment -%}
            <div class="footer__col-panel disclosure__panel" id="{{ panel_id }}">
              <div class="footer__col-clip disclosure__clip">
              {%- comment -%}
                The address, telephone and email are theme settings, not block
                settings — they are the same three facts the menu overlay and
                the Visit section state, and a shop that moves should say so
                once. Only the hours are the footer's own.
              {%- endcomment -%}
              <div class="footer__col-links">
                {%- if settings.shop_address != blank -%}
                  {%- if settings.shop_address_link != blank -%}
                    <a class="footer__link" href="{{ settings.shop_address_link }}" target="_blank" rel="noopener">
                      {{ settings.shop_address }}
                    </a>
                  {%- else -%}
                    <span class="footer__text">{{ settings.shop_address }}</span>
                  {%- endif -%}
                {%- endif -%}

                {%- if block.settings.hours != blank -%}
                  <span class="footer__text">{{ block.settings.hours }}</span>
                {%- endif -%}

                {%- if settings.shop_phone != blank -%}
                  {%- assign tel_href = settings.shop_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' -%}
                  <a class="footer__link" href="tel:{{ tel_href }}">
                    {{ settings.shop_phone }}
                  </a>
                {%- endif -%}

                {%- if settings.shop_email != blank -%}
                  <a class="footer__link" href="mailto:{{ settings.shop_email }}">{{ settings.shop_email }}</a>
                {%- endif -%}
              </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
      </div>
      <div class="hairline"></div>
    {%- endif -%}

    <div class="footer__bottom">
      {%- if section.settings.show_follow_on_shop -%}
        <div class="footer__follow-on-shop">{{ shop | login_button: action: 'follow' }}</div>
      {%- endif -%}

      <span>
        &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright | default: settings.store_display_name | default: shop.name }}
      </span>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="footer__payments" role="list" aria-label="{{ 'sections.footer.payment_methods' | t | escape }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if settings.show_country_footer or settings.show_language_footer -%}
        {% render 'localization-form', context: 'footer' %}
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "tag": "div",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_2"
    },
    {
      "type": "text",
      "id": "huge_text_value",
      "label": "t:blocks.huge_text.value",
      "default": "STORE NAME"
    },
    {
      "type": "select",
      "id": "brand_display",
      "label": "t:sections.all.brand_display.label",
      "info": "t:sections.all.brand_display.info",
      "options": [
        { "value": "auto", "label": "t:sections.all.brand_display.auto" },
        { "value": "wordmark", "label": "t:sections.all.brand_display.wordmark" },
        { "value": "logo", "label": "t:sections.all.brand_display.logo" },
        { "value": "both", "label": "t:sections.all.brand_display.both" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "brand_logo_side",
      "label": "t:sections.all.brand_logo_side.label",
      "options": [
        { "value": "start", "label": "t:sections.all.brand_logo_side.start" },
        { "value": "end", "label": "t:sections.all.brand_logo_side.end" }
      ],
      "default": "start",
      "visible_if": "{{ section.settings.brand_display == 'both' }}"
    },
    {
      "type": "select",
      "id": "brand_logo_variant",
      "label": "t:sections.all.brand_logo_variant.label",
      "info": "t:sections.all.brand_logo_variant.info",
      "options": [
        { "value": "auto", "label": "t:sections.all.brand_logo_variant.auto" },
        { "value": "logo", "label": "t:sections.all.brand_logo_variant.logo" },
        { "value": "inverted", "label": "t:sections.all.brand_logo_variant.inverted" }
      ],
      "default": "auto",
      "visible_if": "{{ section.settings.brand_display != 'wordmark' }}"
    },
    {
      "type": "checkbox",
      "id": "show_follow_on_shop",
      "label": "t:sections.footer.show_follow_on_shop.label",
      "info": "t:sections.footer.show_follow_on_shop.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:sections.footer.show_payment_icons.label",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "t:sections.footer.copyright.label",
      "info": "t:sections.footer.copyright.info",
      "default": "Store name · City, State"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing_header"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "options": [
      { "value": "none", "label": "t:sections.all.space_step.none" },
      { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
      { "value": "xs", "label": "t:sections.all.space_step.xs" },
      { "value": "sm", "label": "t:sections.all.space_step.sm" },
      { "value": "md", "label": "t:sections.all.space_step.md" },
      { "value": "lg", "label": "t:sections.all.space_step.lg" },
      { "value": "xl", "label": "t:sections.all.space_step.xl" },
      { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "sm"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "options": [
      { "value": "none", "label": "t:sections.all.space_step.none" },
      { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
      { "value": "xs", "label": "t:sections.all.space_step.xs" },
      { "value": "sm", "label": "t:sections.all.space_step.sm" },
      { "value": "md", "label": "t:sections.all.space_step.md" },
      { "value": "lg", "label": "t:sections.all.space_step.lg" },
      { "value": "xl", "label": "t:sections.all.space_step.xl" },
      { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "2xs"
    }
  ],
  "blocks": [
    {
      "type": "social",
      "name": "t:sections.footer.blocks.social.name",
      "limit": 1,
      "settings": [
        { "type": "url", "id": "instagram", "label": "t:blocks.icon.icons.instagram" },
        { "type": "url", "id": "facebook", "label": "t:blocks.icon.icons.facebook" },
        { "type": "url", "id": "pinterest", "label": "t:blocks.icon.icons.pinterest" },
        { "type": "url", "id": "tiktok", "label": "t:blocks.icon.icons.tiktok" },
        { "type": "url", "id": "youtube", "label": "t:blocks.icon.icons.youtube" },
        { "type": "url", "id": "x", "label": "t:blocks.icon.icons.x" }
      ]
    },
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.menu.heading.label",
          "default": "Navigation"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer.blocks.menu.menu.label",
          "info": "t:sections.footer.blocks.menu.menu.info",
          "default": "footer"
        }
      ]
    },
    {
      "type": "policies",
      "name": "t:sections.footer.blocks.policies.name",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.footer.blocks.menu.heading.label", "default": "Policies" },
        { "type": "checkbox", "id": "show_cookie_preferences", "label": "t:sections.footer.blocks.policies.show_cookie_preferences", "default": true }
      ]
    },
    {
      "type": "contact",
      "name": "t:sections.footer.blocks.contact.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.contact.heading.label",
          "default": "Visit us"
        },
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.contact.paragraph"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "t:sections.footer.blocks.contact.hours.label",
          "default": "Mon–Fri 9–5 · Weekend hours may vary"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
