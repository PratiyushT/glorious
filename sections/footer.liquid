{%- comment -%}
  Footer — exact to the Glorious design.

  Social row, the letters-only wordmark, then link columns that become an
  accordion when the footer runs out of width. One set of markup serves both —
  a container query turns the column heading into a real toggle rather than
  duplicating the links into a separate mobile block.

  A column entry whose URL is #newsletter or #cookie-preferences renders as a
  button that reopens that overlay instead of navigating, which is how the
  design's "Newsletter" and "Cookie Preferences" rows behave. The convention
  works for hand-entered links and for Shopify menu items alike.
{%- endcomment -%}

{%- liquid
  assign social_blocks = section.blocks | where: 'type', 'social'
  assign social = social_blocks.first
  assign column_blocks = section.blocks | where: 'type', 'menu'
  assign salon_blocks = section.blocks | where: 'type', 'salon'
-%}

<footer
  class="footer section scheme-{{ section.settings.color_scheme }}"
  style="{% render 'section-style', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}"
>
  <div class="page-width">
    {%- if social != blank -%}
      <div class="footer__social" {{ social.shopify_attributes }}>
        {%- if social.settings.instagram != blank -%}
          <a class="footer__link" href="{{ social.settings.instagram }}" target="_blank" rel="noopener">Instagram</a>
        {%- endif -%}
        {%- if social.settings.facebook != blank -%}
          <a class="footer__link" href="{{ social.settings.facebook }}" target="_blank" rel="noopener">Facebook</a>
        {%- endif -%}
        {%- if social.settings.pinterest != blank -%}
          <a class="footer__link" href="{{ social.settings.pinterest }}" target="_blank" rel="noopener">Pinterest</a>
        {%- endif -%}
        {%- if social.settings.tiktok != blank -%}
          <a class="footer__link" href="{{ social.settings.tiktok }}" target="_blank" rel="noopener">TikTok</a>
        {%- endif -%}
      </div>
      <div class="hairline"></div>
    {%- endif -%}

    {%- if section.settings.show_wordmark -%}
      <div class="footer__wordmark">
        {% render 'wordmark', variant: 'ivory' %}
      </div>
      <div class="hairline"></div>
    {%- endif -%}

    {%- if column_blocks.size > 0 or salon_blocks.size > 0 -%}
      {%- comment -%}
        The wrapper is the query container; the grid inside it is what the
        queries re-column. An element cannot query its own size.
      {%- endcomment -%}
      <div class="footer__cols">
      <div class="footer__grid" data-footer-cols>
        {%- for block in column_blocks -%}
          {%- assign panel_id = 'footer-col-' | append: block.id -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            <button
              class="footer__col-toggle"
              type="button"
              data-footer-toggle
              aria-controls="{{ panel_id }}"
              aria-expanded="false"
            >
              <span class="footer__heading">{{ block.settings.heading }}</span>
              <span class="footer__col-mark" aria-hidden="true"></span>
            </button>

            {%- comment -%}
              Three levels, not two. The middle element does the clipping and
              nothing else — put the padding on it and the padding cannot be
              clipped away, so a collapsed panel still shows a sliver of its
              first row.
            {%- endcomment -%}
            <div class="footer__col-panel" id="{{ panel_id }}">
              <div class="footer__col-clip">
              <div class="footer__col-links">
                {%- if block.settings.menu != blank -%}
                  {%- for link in block.settings.menu.links -%}
                    {% render 'footer-entry', label: link.title, url: link.url %}
                  {%- endfor -%}
                {%- else -%}
                  {%- for i in (1..8) -%}
                    {%- liquid
                      assign label_key = 'label_' | append: i
                      assign url_key = 'url_' | append: i
                      assign entry_label = block.settings[label_key]
                      assign entry_url = block.settings[url_key]
                    -%}
                    {%- if entry_label != blank -%}
                      {% render 'footer-entry', label: entry_label, url: entry_url %}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </div>
              </div>
            </div>
          </div>
        {%- endfor -%}

        {%- comment -%}
          The salon column is the only one whose entries wrap, so it is the
          only one the design gives a looser line height.
        {%- endcomment -%}
        {%- for block in salon_blocks -%}
          {%- assign panel_id = 'footer-col-' | append: block.id -%}
          <div class="footer__col footer__col--salon" {{ block.shopify_attributes }}>
            <button
              class="footer__col-toggle"
              type="button"
              data-footer-toggle
              aria-controls="{{ panel_id }}"
              aria-expanded="false"
            >
              <span class="footer__heading">{{ block.settings.heading }}</span>
              <span class="footer__col-mark" aria-hidden="true"></span>
            </button>

            {%- comment -%}
              Three levels, not two. The middle element does the clipping and
              nothing else — put the padding on it and the padding cannot be
              clipped away, so a collapsed panel still shows a sliver of its
              first row.
            {%- endcomment -%}
            <div class="footer__col-panel" id="{{ panel_id }}">
              <div class="footer__col-clip">
              <div class="footer__col-links">
                {%- if block.settings.address != blank -%}
                  {%- if block.settings.address_link != blank -%}
                    <a class="footer__link" href="{{ block.settings.address_link }}" target="_blank" rel="noopener">
                      {{ block.settings.address }}
                    </a>
                  {%- else -%}
                    <span class="footer__text">{{ block.settings.address }}</span>
                  {%- endif -%}
                {%- endif -%}

                {%- if block.settings.hours != blank -%}
                  <span class="footer__text">{{ block.settings.hours }}</span>
                {%- endif -%}

                {%- if block.settings.phone != blank -%}
                  <a class="footer__link" href="tel:{{ block.settings.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}">
                    {{ block.settings.phone }}
                  </a>
                {%- endif -%}

                {%- if block.settings.email != blank -%}
                  <a class="footer__link" href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
                {%- endif -%}
              </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
      </div>
      <div class="hairline"></div>
    {%- endif -%}

    <div class="footer__bottom">
      <span>
        &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright | default: shop.name }}
      </span>

      {%- if settings.show_country_footer or settings.show_language_footer -%}
        {% render 'localization-form', context: 'footer' %}
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "tag": "div",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_2"
    },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "t:sections.footer.show_wordmark.label",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "t:sections.footer.copyright.label",
      "info": "t:sections.footer.copyright.info",
      "default": "Glorious Jewelers · Irving, Texas"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing_header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "social",
      "name": "t:sections.footer.blocks.social.name",
      "limit": 1,
      "settings": [
        { "type": "url", "id": "instagram", "label": "Instagram" },
        { "type": "url", "id": "facebook", "label": "Facebook" },
        { "type": "url", "id": "pinterest", "label": "Pinterest" },
        { "type": "url", "id": "tiktok", "label": "TikTok" }
      ]
    },
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.menu.heading.label",
          "default": "Navigation"
        },
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.menu.actions_info"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer.blocks.menu.menu.label",
          "info": "t:sections.footer.blocks.menu.menu.info"
        },
        { "type": "text", "id": "label_1", "label": "t:sections.footer.blocks.menu.label_n.label_1" },
        { "type": "url", "id": "url_1", "label": "t:sections.footer.blocks.menu.url_n.url_1" },
        { "type": "text", "id": "label_2", "label": "t:sections.footer.blocks.menu.label_n.label_2" },
        { "type": "url", "id": "url_2", "label": "t:sections.footer.blocks.menu.url_n.url_2" },
        { "type": "text", "id": "label_3", "label": "t:sections.footer.blocks.menu.label_n.label_3" },
        { "type": "url", "id": "url_3", "label": "t:sections.footer.blocks.menu.url_n.url_3" },
        { "type": "text", "id": "label_4", "label": "t:sections.footer.blocks.menu.label_n.label_4" },
        { "type": "url", "id": "url_4", "label": "t:sections.footer.blocks.menu.url_n.url_4" },
        { "type": "text", "id": "label_5", "label": "t:sections.footer.blocks.menu.label_n.label_5" },
        { "type": "url", "id": "url_5", "label": "t:sections.footer.blocks.menu.url_n.url_5" },
        { "type": "text", "id": "label_6", "label": "t:sections.footer.blocks.menu.label_n.label_6" },
        { "type": "url", "id": "url_6", "label": "t:sections.footer.blocks.menu.url_n.url_6" },
        { "type": "text", "id": "label_7", "label": "t:sections.footer.blocks.menu.label_n.label_7" },
        { "type": "url", "id": "url_7", "label": "t:sections.footer.blocks.menu.url_n.url_7" },
        { "type": "text", "id": "label_8", "label": "t:sections.footer.blocks.menu.label_n.label_8" },
        { "type": "url", "id": "url_8", "label": "t:sections.footer.blocks.menu.url_n.url_8" }
      ]
    },
    {
      "type": "salon",
      "name": "t:sections.footer.blocks.contact.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.contact.heading.label",
          "default": "The Salon"
        },
        {
          "type": "text",
          "id": "address",
          "label": "t:sections.footer.blocks.contact.address.label",
          "default": "8140 N MacArthur Blvd #120, Irving, TX"
        },
        {
          "type": "url",
          "id": "address_link",
          "label": "t:sections.footer.blocks.contact.address_link.label"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "t:sections.footer.blocks.contact.hours.label",
          "default": "Tue–Sat 11–7 · Sun 11–4 · Mon closed"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "t:sections.footer.blocks.contact.phone.label",
          "default": "+1 469-740-2119"
        },
        {
          "type": "text",
          "id": "email",
          "label": "t:sections.footer.blocks.contact.email.label",
          "default": "care@gloriousjewelers.com"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
