{%- liquid
  assign alignment = section.settings.alignment | default: 'center'
  assign items = 'center'
  if alignment == 'left'
    assign items = 'flex-start'
  elsif alignment == 'right'
    assign items = 'flex-end'
  endif
-%}

<section
  class="password-page scheme-{{ section.settings.color_scheme }}"
  style="{% render 'section-style', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %} --password-align: {{ alignment }}; --password-items: {{ items }};"
>
  <div class="password-page__inner">
    <a class="password-page__logo" href="{{ routes.root_url }}" aria-label="{{ settings.store_display_name | default: shop.name | escape }}">
      {% content_for "block", type: "huge-text", id: "password-huge-text", placement: "header-overlay" %}
    </a>

    <div class="password-page__content">
      {% content_for 'blocks' %}
    </div>

    <div class="password-page__forms">
      {%- if section.settings.show_signup -%}
        {%- form 'customer', class: 'password-page__form' -%}
          <input type="hidden" name="contact[tags]" value="prospect,password page">
          <label for="PasswordSignup-{{ section.id }}">{{ 'password_page.email_label' | t }}</label>
          <div class="password-page__field">
            <input
              class="field"
              id="PasswordSignup-{{ section.id }}"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
            >
            {% render 'button', label: section.settings.signup_label, element: 'button', button_type: 'submit' %}
          </div>
          {%- if form.posted_successfully? -%}
            <p class="password-page__message" role="status">{{ 'password_page.signup_success' | t }}</p>
          {%- elsif form.errors -%}
            <div class="password-page__message password-page__message--error" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
        {%- endform -%}
      {%- endif -%}

      {%- form 'storefront_password', class: 'password-page__form' -%}
        <label for="StorefrontPassword-{{ section.id }}">{{ 'password_page.password_label' | t }}</label>
        <div class="password-page__field">
          <input
            class="field"
            id="StorefrontPassword-{{ section.id }}"
            type="password"
            name="password"
            autocomplete="current-password"
            required
          >
          {% render 'button', label: section.settings.enter_label, element: 'button', button_type: 'submit', style: 'outline' %}
        </div>
        {%- if form.errors -%}
          <div class="password-page__message password-page__message--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
      {%- endform -%}
    </div>

    <p class="password-page__owner">
      {{ 'password_page.store_owner' | t }}
      <a href="/admin">{{ 'password_page.log_in' | t }}</a>
    </p>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "tag": "section",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_2"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:sections.all.content_alignment.label",
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_signup",
      "label": "t:sections.main_password.show_signup.label",
      "default": true
    },
    {
      "type": "text",
      "id": "signup_label",
      "label": "t:sections.main_password.signup_label.label",
      "default": "Notify me"
    },
    {
      "type": "text",
      "id": "enter_label",
      "label": "t:sections.main_password.enter_label.label",
      "default": "Enter store"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing_header"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "lg"
    }
  ],
  "enabled_on": { "templates": ["password"] },
  "presets": [{ "name": "t:sections.main_password.name" }]
}
{% endschema %}
