{%- comment -%}
  Collection list — the "Our Products" panel.

  Its repeated private card explicitly targets the private collection-header
  layout, which is the only parent allowed to offer collection-count Text. Its
  Media and Group are likewise Collection-card-only private blocks.

  Renamed from `category-grid`, and rebuilt on theme blocks. Two things follow
  from that and neither is optional:

  **A section holds either its own blocks or theme blocks, never both.** So the
  heading and the subheading, which were section settings, are blocks now, and
  the four category blocks stored in `templates/index.json` had to migrate in
  the same change.

  **The card is one block, not one per collection.** The list of collections is
  a single section setting and `_collection-card` is a *static* block rendered
  once per collection inside the loop below, handed its collection through
  `closest.collection`. Four collections, one set of card settings — which is
  also what lets this section keep the carousel: because the section does the
  looping rather than `content_for 'blocks'`, it can still wrap each card in
  the cell the carousel needs. Merchant-added blocks can only ever render as
  one flat sibling flow, so a header block and a card could not otherwise live
  in the same section as a moving track.

  The row is either the grid — unchanged, and the default — or the carousel
  Most Loved offers, from the same `snippets/row-carousel.liquid`.
{%- endcomment -%}

{%- liquid
  assign collection_list = section.settings.collections

  comment
    A newly added section still needs to show what its card composition looks
    like before the merchant chooses collections. Use the configured column
    count as the onboarding count, then index the list in the single loop each
    layout already owns. An empty index intentionally hands the card a blank
    collection, which its media and link already handle with safe placeholders.
  endcomment
  assign card_count = collection_list.size
  if card_count == 0
    assign card_count = section.settings.columns
  endif

  comment
    The carousel's accessible name. There is no heading setting to borrow from
    any more — the heading is a block, and a section cannot read one — so it
    falls back to the theme's own label rather than guessing at the block's
    text.
  endcomment
  assign carousel_label = 'general.carousel.label' | t
-%}

<section
  class="section scheme-{{ section.settings.color_scheme }}"
  style="{% render 'section-style', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %} {%- if section.settings.content_alignment != blank and section.settings.content_alignment != 'inherit' -%}--section-align: {{ section.settings.content_alignment }}; --section-align-jc: {% if section.settings.content_alignment == 'center' %}center{% elsif section.settings.content_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};{%- endif -%}"
>
  {%- comment -%}
    **The vertical rhythm belongs to the section, not to the blocks in it.**
    One `gap` setting spaces every direct child — each header block and the row
    itself — the way Horizon's sections carry a `gap` and hand it down through
    a class. A block can then be dropped into any section without bringing its
    own idea of how far it should sit from its neighbours, which is the whole
    point of a block being reusable.

    It also retires the adjacency rule here: `.display + .grid-auto` exists
    because a display heading has no bottom gap of its own, and a flex column
    with a gap answers that directly rather than by pairing selectors. The rule
    still serves every section that is not laid out this way.
  {%- endcomment -%}
  <div class="page-width collection-list__content" style="{% render 'block-spacing', gap: section.settings.gap %}">
    {% content_for 'blocks' %}

    {%- comment -%}
      22.5rem is the design's 360px floor, and it is what decides when the row
      breaks. At 20rem the grid fitted an extra column roughly 120px of width
      too early at every tier.

      The carousel reads the same properties off the very same element — its
      ruler carries `.grid-auto`'s width expression and inherits these — so
      neither layout can answer the column question differently.
    {%- endcomment -%}
    {%- capture grid_vars -%}
      --cols: {{ section.settings.columns }}; --gap: var(--grid-gap); --min: 22.5rem;
      {%- comment -%} Columns only; the ruler reads the same pair, so the carousel follows. {%- endcomment -%}
      {%- unless section.settings.column_gap == blank or section.settings.column_gap == 'theme' -%}
        {%- if section.settings.column_gap == 'none' %} --column-gap: 0;
        {%- else %} --column-gap: var(--step-{{ section.settings.column_gap }});{% endif -%}
      {%- endunless -%}
    {%- endcapture -%}

    {%- capture cells -%}
      {%- for i in (1..card_count) -%}
        {%- liquid
          assign card_collection = blank
          assign card_index = forloop.index0
          for collection_item in collection_list offset: card_index limit: 1
            assign card_collection = collection_item
          endfor
        -%}
        <div class="row-carousel__cell reveal" data-row-cell style="--reveal-delay: {{ forloop.index0 | times: 80 }}ms;">
          {% content_for 'block', type: '_collection-card', id: 'collection-card', closest.collection: card_collection %}
        </div>
      {%- endfor -%}
    {%- endcapture -%}

    {%- render 'row-carousel',
      cells: cells,
      count: card_count,
      motion: section.settings.carousel_motion,
      arrows: section.settings.carousel_arrows,
      label: carousel_label,
      track_style: grid_vars,
      layout_desktop: section.settings.layout,
      layout_tablet: section.settings.layout_tablet,
      layout_mobile: section.settings.layout_mobile
    -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "tag": "div",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:sections.all.content_alignment.label",
      "info": "t:sections.all.content_alignment.info",
      "options": [
        { "value": "left", "label": "t:settings_schema.options.left" },
        { "value": "center", "label": "t:settings_schema.options.center" },
        { "value": "right", "label": "t:settings_schema.options.right" }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_3"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "t:sections.collection_list.collections.label",
      "info": "t:sections.collection_list.collections.info",
      "limit": 12
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.collection_list.columns.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "gap",
      "label": "t:blocks.all.gap.label",
      "info": "t:blocks.all.gap.info",
      "options": [
        { "value": "minimal", "label": "t:blocks.all.step.minimal" },
        { "value": "tiny", "label": "t:blocks.all.step.tiny" },
        { "value": "small", "label": "t:blocks.all.step.small" },
        { "value": "medium", "label": "t:blocks.all.step.medium" },
        { "value": "large", "label": "t:blocks.all.step.large" },
        { "value": "xlarge", "label": "t:blocks.all.step.xlarge" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "column_gap",
      "label": "t:sections.all.card_column_gap.label",
      "info": "t:sections.all.card_column_gap.info",
      "options": [
        { "value": "theme", "label": "t:sections.catalog.theme_product_gap" },
        { "value": "none", "label": "t:blocks.all.step.none" },
        { "value": "minimal", "label": "t:blocks.all.step.minimal" },
        { "value": "tiny", "label": "t:blocks.all.step.tiny" },
        { "value": "small", "label": "t:blocks.all.step.small" },
        { "value": "medium", "label": "t:blocks.all.step.medium" },
        { "value": "large", "label": "t:blocks.all.step.large" },
        { "value": "xlarge", "label": "t:blocks.all.step.xlarge" }
      ],
      "default": "theme"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.all.layout.desktop_label",
      "info": "t:sections.all.layout.info",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.all.layout.grid"
        },
        {
          "value": "carousel",
          "label": "t:sections.all.layout.carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select", "id": "layout_tablet", "label": "t:sections.all.layout.tablet_label",
      "options": [
        { "value": "grid", "label": "t:sections.all.layout.grid" },
        { "value": "carousel", "label": "t:sections.all.layout.carousel" }
      ], "default": "carousel"
    },
    {
      "type": "select", "id": "layout_mobile", "label": "t:sections.all.layout.mobile_label",
      "options": [
        { "value": "grid", "label": "t:sections.all.layout.grid" },
        { "value": "carousel", "label": "t:sections.all.layout.carousel" }
      ], "default": "carousel"
    },
    {
      "type": "select",
      "id": "carousel_motion",
      "label": "t:sections.all.carousel_motion.label",
      "info": "t:sections.all.carousel_motion.info",
      "options": [
        {
          "value": "slide",
          "label": "t:sections.all.carousel_motion.slide"
        },
        {
          "value": "fade",
          "label": "t:sections.all.carousel_motion.fade"
        }
      ],
      "default": "slide",
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.layout_tablet == 'carousel' or section.settings.layout_mobile == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "carousel_arrows",
      "label": "t:sections.all.carousel_arrows.label",
      "info": "t:sections.all.carousel_arrows.info",
      "options": [
        {
          "value": "bottom",
          "label": "t:sections.all.carousel_arrows.bottom"
        },
        {
          "value": "top",
          "label": "t:sections.all.carousel_arrows.top"
        },
        {
          "value": "side",
          "label": "t:sections.all.carousel_arrows.side"
        }
      ],
      "default": "bottom",
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.layout_tablet == 'carousel' or section.settings.layout_mobile == 'carousel' }}"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing_header"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "max"
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_list.presets.grid",
      "settings": {
        "layout": "grid"
      },
      "blocks": [
        {
          "type": "text",
          "settings": { "text": "Our Products", "style": "title", "layout": "display", "element": "h2" }
        },
        {
          "type": "_collection-card",
          "static": true,
          "id": "collection-card",
          "blocks": [
            {
              "type": "_collection-card-header",
              "settings": { "direction": "horizontal", "distribute": "between", "align": "baseline", "wrap": false, "items_width": "natural", "stack_below": "never", "gap": "small", "padding": "small", "show_borders": true, "border_top": false, "border_right": false, "border_bottom": true, "border_left": false },
              "blocks": [
                {
                  "type": "_collection-card-group",
                  "settings": { "direction": "horizontal", "distribute": "start", "align": "baseline", "wrap": false, "items_width": "natural", "stack_below": "never", "gap": "tiny" },
                  "blocks": [
                    { "type": "text", "settings": { "text": "{{ closest.collection.title }}", "style": "heading_4", "element": "span", "override_case": "uppercase", "override_tracking": "wider" } },
                    { "type": "icon", "settings": { "icon": "arrow-right", "icon_size": "2xs", "show_frame": false, "hover_animation": "nudge" } }
                  ]
                },
                { "type": "_collection-count-text", "settings": { "style": "caption", "element": "span", "override_tracking": "wider" } }
              ]
            },
            { "type": "_collection-card-media" }
          ]
        }
      ]
    },
    {
      "name": "t:sections.collection_list.presets.carousel",
      "settings": {
        "layout": "carousel"
      },
      "blocks": [
        {
          "type": "text",
          "settings": { "text": "Our Products", "style": "title", "layout": "display", "element": "h2" }
        },
        {
          "type": "_collection-card",
          "static": true,
          "id": "collection-card",
          "blocks": [
            {
              "type": "_collection-card-header",
              "settings": { "direction": "horizontal", "distribute": "between", "align": "baseline", "wrap": false, "items_width": "natural", "stack_below": "never", "gap": "small", "padding": "small", "show_borders": true, "border_top": false, "border_right": false, "border_bottom": true, "border_left": false },
              "blocks": [
                {
                  "type": "_collection-card-group",
                  "settings": { "direction": "horizontal", "distribute": "start", "align": "baseline", "wrap": false, "items_width": "natural", "stack_below": "never", "gap": "tiny" },
                  "blocks": [
                    { "type": "text", "settings": { "text": "{{ closest.collection.title }}", "style": "heading_4", "element": "span", "override_case": "uppercase", "override_tracking": "wider" } },
                    { "type": "icon", "settings": { "icon": "arrow-right", "icon_size": "2xs", "show_frame": false, "hover_animation": "nudge" } }
                  ]
                },
                { "type": "_collection-count-text", "settings": { "style": "caption", "element": "span", "override_tracking": "wider" } }
              ]
            },
            { "type": "_collection-card-media" }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
