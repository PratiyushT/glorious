{{ 'main-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'main-product.js' | asset_url }}" defer></script>

{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id
  assign cart_name = settings.cart_name | default: 'Cart'
  assign add_label = 'products.add_to_cart' | t: cart_name: cart_name

  assign product_columns = 'minmax(0, 3fr) minmax(24rem, 2fr)'
  if section.settings.desktop_width == 'balanced'
    assign product_columns = 'minmax(0, 1fr) minmax(24rem, 1fr)'
  elsif section.settings.desktop_width == 'details_large'
    assign product_columns = 'minmax(0, 2fr) minmax(24rem, 3fr)'
  endif
-%}

<section
  class="main-product scheme-{{ section.settings.color_scheme }}"
  data-main-product
  data-initial-variant-id="{{ selected_variant.id }}"
  style="--product-columns: {{ product_columns }}; --product-media-fit: {{ section.settings.media_fit }}; --product-details-width: {{ section.settings.details_width }}rem;"
>
  <div class="product-showcase" data-media-position="{{ section.settings.media_position }}">
    <div class="product-gallery" aria-label="{{ 'products.media_gallery' | t }}">
      <div class="product-gallery__track">
        {%- for media in product.media -%}
          {%- assign media_loading = 'lazy' -%}
          {%- if forloop.first -%}{%- assign media_loading = 'eager' -%}{%- endif -%}
          <div
            class="product-gallery__slide"
            data-product-media
            data-media-id="{{ media.id }}"
            data-media-type="{{ media.media_type }}"
            {% unless media.id == selected_variant.featured_media.id or selected_variant.featured_media == blank and forloop.first %}hidden{% endunless %}
            aria-hidden="{% if media.id == selected_variant.featured_media.id or selected_variant.featured_media == blank and forloop.first %}false{% else %}true{% endif %}"
          >
            {% render 'product-media', media: media, loading: media_loading, media_fit: section.settings.media_fit, autoplay_video: section.settings.autoplay_video %}
          </div>
        {%- else -%}
          <div class="product-gallery__slide">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        {%- endfor -%}
      </div>

      {%- if product.media.size > 1 -%}
        {%- if section.settings.show_arrows -%}
          <div class="product-gallery__controls">
            <button class="product-gallery__arrow product-gallery__arrow--previous" type="button" data-product-gallery-step="previous" aria-label="{{ 'products.previous_view' | t }}">
              {% render 'icon', icon: 'chevron-left', width: '12', height: '24' %}
            </button>
            <button class="product-gallery__arrow product-gallery__arrow--next" type="button" data-product-gallery-step="next" aria-label="{{ 'products.next_view' | t }}">
              {% render 'icon', icon: 'chevron-right', width: '12', height: '24' %}
            </button>
          </div>
        {%- endif -%}

        {%- if section.settings.show_dots -%}
          <div class="product-gallery__dots">
            {%- for media in product.media -%}
              <button
                class="product-gallery__dot{% if media.media_type contains 'video' %} product-gallery__dot--video{% endif %}{% if media.id == selected_variant.featured_media.id or selected_variant.featured_media == blank and forloop.first %} is-active{% endif %}"
                type="button"
                data-product-media-control
                data-media-id="{{ media.id }}"
                aria-current="{% if media.id == selected_variant.featured_media.id or selected_variant.featured_media == blank and forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ 'products.go_to_view' | t }} {{ forloop.index }}{% if media.media_type contains 'video' %}, {{ 'products.video_view' | t }}{% endif %}"
              >
                {%- if media.media_type contains 'video' -%}<span>{{ 'products.video_view' | t }}</span>{%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    <div class="product-details">
      <div class="product-details__inner">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}

            {%- when 'product_breadcrumbs' -%}
              <nav class="product-breadcrumbs" aria-label="{{ 'products.breadcrumbs' | t }}" {{ block.shopify_attributes }}>
                <a href="{{ routes.all_products_collection_url }}">{{ block.settings.products_label }}</a>
                {%- if product.collections.first != blank -%}
                  <span aria-hidden="true">·</span>
                  <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
                {%- endif -%}
              </nav>

            {%- when 'product_vendor' -%}
              {%- if product.vendor != blank -%}<div class="product-details__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</div>{%- endif -%}

            {%- when 'product_title' -%}
              <h1 class="product-details__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

            {%- when 'product_price' -%}
              <div class="product-price" {{ block.shopify_attributes }}>
                <s data-product-compare{% unless selected_variant.compare_at_price > selected_variant.price %} hidden{% endunless %}>
                  {%- if selected_variant.compare_at_price > selected_variant.price -%}{{ selected_variant.compare_at_price | money }}{%- endif -%}
                </s>
                <span class="product-price__figure" data-product-price>{{ selected_variant.price | money }}</span>
                <span class="product-price__unit" data-product-unit-price{% unless selected_variant.unit_price_measurement %} hidden{% endunless %}>
                  {%- if selected_variant.unit_price_measurement -%}
                    {{ selected_variant.unit_price | money }} / {%- if selected_variant.unit_price_measurement.reference_value != 1 -%}{{ selected_variant.unit_price_measurement.reference_value }}{%- endif -%}{{ selected_variant.unit_price_measurement.reference_unit }}
                  {%- endif -%}
                </span>
                {% render 'tax-note' %}
                {%- if block.settings.show_shipping_policy and shop.shipping_policy.body != blank -%}<a class="product-price__note" href="{{ shop.shipping_policy.url }}">{{ 'products.shipping_policy' | t }}</a>{%- endif -%}
              </div>

            {%- when 'product_description' -%}
              {%- if product.description != blank -%}<div class="product-description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>{%- endif -%}

            {%- when 'product_variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="product-options" {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    {%- assign option_has_swatches = false -%}
                    {%- for value in option.values -%}
                      {%- if value.swatch.color != blank or value.swatch.image != blank -%}
                        {%- assign option_has_swatches = true -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- assign picker_type = block.settings.picker_type -%}
                    {%- if picker_type == 'automatic' -%}
                      {%- if option_has_swatches -%}{%- assign picker_type = 'swatch' -%}{%- else -%}{%- assign picker_type = 'pill' -%}{%- endif -%}
                    {%- endif -%}

                    <fieldset class="product-option" data-product-option-group>
                      <legend><span>{{ option.name }}</span><span data-product-option-selected>{{ option.selected_value }}</span></legend>
                      {%- if picker_type == 'dropdown' -%}
                        <span class="product-option__select">
                          <select data-product-option aria-label="{{ option.name | escape }}">
                            {%- for value in option.values -%}
                              <option value="{{ value | escape }}" {% if value.selected %}selected{% endif %} {% unless value.available or block.settings.show_sold_out %}disabled{% endunless %}>{{ value }}</option>
                            {%- endfor -%}
                          </select>
                          {% render 'icon', icon: 'chevron-down', width: '11', height: '7' %}
                        </span>
                      {%- else -%}
                        <div class="product-option__values" style="--product-swatch-radius: {% if block.settings.swatch_shape == 'square' %}var(--radius-base, 0){% else %}50%{% endif %};">
                          {%- for value in option.values -%}
                            {%- assign option_input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
                            <label class="product-option__choice" for="{{ option_input_id }}">
                              <input
                                id="{{ option_input_id }}"
                                type="radio"
                                name="{{ section.id }}-{{ option.name | escape }}"
                                value="{{ value | escape }}"
                                data-product-option
                                {% if value.selected %}checked{% endif %}
                                {% unless value.available or block.settings.show_sold_out %}disabled{% endunless %}
                              >
                              {%- if picker_type == 'swatch' -%}
                                <span class="product-option__swatch" data-tip="{{ value | escape }}">{% render 'option-swatch', option_value: value, size: 96 %}</span>
                              {%- else -%}
                                <span class="product-option__pill">{{ value }}</span>
                              {%- endif -%}
                            </label>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                    </fieldset>
                  {%- endfor -%}
                </div>
              {%- endunless -%}

            {%- when 'product_quantity' -%}
              <label class="product-quantity" {{ block.shopify_attributes }}>
                <span>{{ 'products.quantity' | t }}</span>
                <span class="product-quantity__control">
                  <button type="button" data-quantity-step="-1" aria-label="{{ 'products.decrease_quantity' | t }}">−</button>
                  <input type="number" name="quantity" value="1" min="1" step="1" inputmode="numeric" form="{{ product_form_id }}" data-product-quantity aria-label="{{ 'products.quantity' | t }}">
                  <button type="button" data-quantity-step="1" aria-label="{{ 'products.increase_quantity' | t }}">+</button>
                </span>
              </label>

            {%- when 'product_buy_buttons' -%}
              <div class="product-buy-form" {{ block.shopify_attributes }}>
                {%- form 'product', product, id: product_form_id, class: 'product-buy-form product-buy-form--js', data-cart-add: '' -%}
                  <input type="hidden" name="id" value="{{ selected_variant.id }}" data-product-variant-id>

                  {%- if product.gift_card? and block.settings.show_gift_card_recipient -%}
                    {% render 'gift-card-recipient-form', form: form, section_id: section.id %}
                  {%- endif -%}

                  <div class="product-buy-form__buttons">
                    <button
                      class="btn btn--primary"
                      type="submit"
                      name="add"
                      data-product-submit
                      data-add-label="{{ add_label | escape }}"
                      data-sold-out-label="{{ 'products.sold_out' | t | escape }}"
                      data-unavailable-label="{{ 'products.unavailable' | t | escape }}"
                      {% unless selected_variant.available %}disabled{% endunless %}
                    >
                      {%- if selected_variant.available -%}{{ add_label }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
                    </button>
                    {%- unless product.gift_card? and block.settings.show_gift_card_recipient -%}
                      {%- if block.settings.show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
                    {%- endunless -%}
                  </div>
                  {%- if block.settings.show_installments -%}<div class="product-payment-terms">{{ form | payment_terms }}</div>{%- endif -%}
                {%- endform -%}

                <noscript>
                  {%- form 'product', product, class: 'product-buy-form product-buy-form--noscript' -%}
                    <label for="NoScriptVariant-{{ section.id }}">{{ 'products.choose' | t }}</label>
                    <select class="field" id="NoScriptVariant-{{ section.id }}" name="id">
                      {%- for variant in product.variants -%}<option value="{{ variant.id }}" {% if variant == selected_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}</option>{%- endfor -%}
                    </select>
                    <label for="NoScriptQuantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
                    <input class="field" id="NoScriptQuantity-{{ section.id }}" type="number" name="quantity" value="1" min="1">
                    <button class="btn btn--primary" type="submit" name="add">{{ add_label }}</button>
                  {%- endform -%}
                </noscript>
              </div>

            {%- when 'product_pickup' -%}
              <div
                class="pickup-availability"
                data-pickup-availability
                data-root-url="{{ routes.root_url }}"
                {{ block.shopify_attributes }}
              >
                {% render 'pickup-availability-contents', product_variant: selected_variant %}
              </div>

            {%- when 'product_sku' -%}
              <div class="product-details__sku" {{ block.shopify_attributes }}>{{ block.settings.label }} <span data-product-sku-value>{{ selected_variant.sku }}</span></div>

            {%- when 'product_inventory' -%}
              {%- if selected_variant.inventory_management and selected_variant.inventory_quantity <= block.settings.low_inventory_threshold -%}
                <div class="product-inventory" {{ block.shopify_attributes }}>{{ 'products.low_inventory' | t: count: selected_variant.inventory_quantity }}</div>
              {%- endif -%}

            {%- when 'product_text' -%}
              {%- if block.settings.text != blank -%}<div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>{%- endif -%}

            {%- when 'product_collapsible' -%}
              <details class="product-collapsible" {{ block.shopify_attributes }}>
                <summary>{{ block.settings.heading }}</summary>
                <div class="product-collapsible__content rte">{{ block.settings.content }}</div>
              </details>

            {%- when 'product_custom_liquid' -%}
              <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <script type="application/json" data-product-variants>
    [
      {%- for variant in product.variants -%}
        {%- capture unit_price -%}
          {%- if variant.unit_price_measurement -%}
            {{ variant.unit_price | money }} / {%- if variant.unit_price_measurement.reference_value != 1 -%}{{ variant.unit_price_measurement.reference_value }}{%- endif -%}{{ variant.unit_price_measurement.reference_unit }}
          {%- endif -%}
        {%- endcapture -%}
        {
          "id": {{ variant.id | json }},
          "available": {{ variant.available | json }},
          "options": {{ variant.options | json }},
          "price": {{ variant.price | money | json }},
          "compareAtPrice": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}""{% endif %},
          "unitPrice": {{ unit_price | strip | json }},
          "sku": {{ variant.sku | json }},
          "featuredMediaId": {{ variant.featured_media.id | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>

  <dialog class="product-zoom-dialog" data-product-zoom-dialog>
    <button class="product-zoom-dialog__close" type="button" data-product-zoom-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button>
    <img src="data:image/gif;base64,R0lGODlhAQABAAAAACw=" width="1600" height="1600" alt="" data-image-lqip="off">
  </dialog>
</section>

{% schema %}
{
  "name": "t:sections.main_product.name",
  "enabled_on": { "templates": ["product"] },
  "blocks": [
    { "type": "@app" },
    { "type": "product_breadcrumbs", "name": "t:sections.main_product.blocks.breadcrumbs", "limit": 1, "settings": [
      { "type": "text", "id": "products_label", "label": "t:sections.main_product.products_label.label", "default": "All products" }
    ] },
    { "type": "product_vendor", "name": "t:sections.main_product.blocks.vendor", "limit": 1, "settings": [] },
    { "type": "product_title", "name": "t:sections.main_product.blocks.title", "limit": 1, "settings": [] },
    { "type": "product_price", "name": "t:sections.main_product.blocks.price", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_shipping_policy", "label": "t:sections.main_product.show_shipping_policy.label", "default": true }
    ] },
    { "type": "product_description", "name": "t:sections.main_product.blocks.description", "limit": 1, "settings": [] },
    { "type": "product_variant_picker", "name": "t:sections.main_product.blocks.variant_picker", "limit": 1, "settings": [
      { "type": "select", "id": "picker_type", "label": "t:sections.main_product.picker_type.label", "options": [
        { "value": "automatic", "label": "t:sections.main_product.picker_type.automatic" },
        { "value": "pill", "label": "t:sections.main_product.picker_type.pill" },
        { "value": "swatch", "label": "t:sections.main_product.picker_type.swatch" },
        { "value": "dropdown", "label": "t:sections.main_product.picker_type.dropdown" }
      ], "default": "automatic" },
      { "type": "select", "id": "swatch_shape", "label": "t:sections.main_product.swatch_shape.label", "options": [
        { "value": "round", "label": "t:sections.main_product.swatch_shape.round" },
        { "value": "square", "label": "t:sections.main_product.swatch_shape.square" }
      ], "default": "round" },
      { "type": "checkbox", "id": "show_sold_out", "label": "t:sections.main_product.show_sold_out.label", "default": true }
    ] },
    { "type": "product_quantity", "name": "t:sections.main_product.blocks.quantity", "limit": 1, "settings": [] },
    { "type": "product_buy_buttons", "name": "t:sections.main_product.blocks.buy_buttons", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_dynamic_checkout", "label": "t:sections.main_product.show_dynamic_checkout.label", "default": true },
      { "type": "checkbox", "id": "show_installments", "label": "t:sections.main_product.show_installments.label", "default": true },
      { "type": "checkbox", "id": "show_gift_card_recipient", "label": "t:sections.main_product.show_gift_card_recipient.label", "default": true }
    ] },
    { "type": "product_pickup", "name": "t:sections.main_product.blocks.pickup", "limit": 1, "settings": [] },
    { "type": "product_sku", "name": "t:sections.main_product.blocks.sku", "limit": 1, "settings": [
      { "type": "text", "id": "label", "label": "t:sections.main_product.label.label", "default": "SKU" }
    ] },
    { "type": "product_inventory", "name": "t:sections.main_product.blocks.inventory", "limit": 1, "settings": [
      { "type": "range", "id": "low_inventory_threshold", "label": "t:sections.main_product.low_inventory_threshold.label", "min": 0, "max": 20, "step": 1, "default": 5 }
    ] },
    { "type": "product_text", "name": "t:sections.main_product.blocks.text", "settings": [
      { "type": "richtext", "id": "text", "label": "t:sections.main_product.text.label" }
    ] },
    { "type": "product_collapsible", "name": "t:sections.main_product.blocks.collapsible", "settings": [
      { "type": "text", "id": "heading", "label": "t:sections.main_product.heading.label", "default": "Details" },
      { "type": "richtext", "id": "content", "label": "t:sections.main_product.content.label" }
    ] },
    { "type": "product_custom_liquid", "name": "t:sections.main_product.blocks.custom_liquid", "settings": [
      { "type": "liquid", "id": "custom_liquid", "label": "t:sections.main_product.custom_liquid.label" }
    ] }
  ],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.color_scheme.label", "default": "scheme_1" },
    { "type": "header", "content": "t:sections.main_product.gallery_header" },
    { "type": "select", "id": "media_position", "label": "t:sections.main_product.media_position.label", "options": [
      { "value": "left", "label": "t:settings_schema.options.left" },
      { "value": "right", "label": "t:settings_schema.options.right" }
    ], "default": "left" },
    { "type": "select", "id": "desktop_width", "label": "t:sections.main_product.desktop_width.label", "options": [
      { "value": "media_large", "label": "t:sections.main_product.desktop_width.media_large" },
      { "value": "balanced", "label": "t:sections.main_product.desktop_width.balanced" },
      { "value": "details_large", "label": "t:sections.main_product.desktop_width.details_large" }
    ], "default": "media_large" },
    { "type": "select", "id": "media_fit", "label": "t:sections.main_product.media_fit.label", "options": [
      { "value": "contain", "label": "t:sections.main_product.media_fit.contain" },
      { "value": "cover", "label": "t:sections.main_product.media_fit.cover" }
    ], "default": "contain" },
    { "type": "checkbox", "id": "show_arrows", "label": "t:sections.main_product.show_arrows.label", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "t:sections.main_product.show_dots.label", "default": true },
    { "type": "checkbox", "id": "autoplay_video", "label": "t:sections.main_product.autoplay_video.label", "default": false },
    { "type": "range", "id": "details_width", "label": "t:sections.main_product.details_width.label", "min": 28, "max": 48, "step": 2, "unit": "rem", "default": 38 }
  ]
}
{% endschema %}
