{%- comment -%}
  Rich text. Constrained to the reading width so paragraphs never stretch past
  a comfortable line length, however wide the screen gets.

  On theme blocks. Its three local types were `heading`, `text` and `button`,
  and only one of them needed to be built:

  - `text` was a `richtext` in a `.rte`, which is exactly `prose`.
  - `button` was one button, which `buttons` already renders — and renders
    better, since it offers the design's six variants and a second button
    rather than the three styles this section knew about.
  - `heading` had no equivalent. `title` is `.display`, a different face for a
    different job, so `blocks/heading.liquid` is new.

  **`blocks/text.liquid` was the obvious name for the second one and would have
  broken the homepage.** `hero` still declares a *local* block called `text`,
  and a theme block's name is global: the moment the file existed the hero
  would have been read as a theme-block section and failed on the local types
  it has left. Mapping to `prose` avoids the name entirely. `heading` and
  `button` were safe to take only because the sole local blocks of those names
  are this section's own, and they go in this same commit.
{%- endcomment -%}

<section
  class="section scheme-{{ section.settings.color_scheme }}"
  style="{% render 'section-style', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}"
>
  <div class="page-width">
    <div class="stack measure {% if section.settings.alignment == 'center' %}measure--center align-center{% elsif section.settings.alignment == 'right' %}align-right{% endif %}">
      {% content_for 'blocks' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.rich_text.name",
  "tag": "div",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_1"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.all.content_alignment.label",
      "options": [
        { "value": "left", "label": "t:settings_schema.options.left" },
        { "value": "center", "label": "t:settings_schema.options.center" },
        { "value": "right", "label": "t:settings_schema.options.right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing_header"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "lg"
    }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "heading" },
    { "type": "prose" },
    { "type": "buttons" },
    { "type": "title" },
    { "type": "subheading" },
    { "type": "paragraph" }
  ],
  "presets": [
    {
      "name": "t:sections.rich_text.name",
      "blocks": [{ "type": "heading" }, { "type": "prose" }, { "type": "buttons" }]
    }
  ]
}
{% endschema %}
