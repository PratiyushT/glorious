{%- comment -%}
  Rich text. Constrained to the reading width so paragraphs never stretch past
  a comfortable line length, however wide the screen gets.
{%- endcomment -%}

<section
  class="section scheme-{{ section.settings.color_scheme }}"
  style="{% render 'section-style', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}"
>
  <div class="page-width">
    <div class="stack measure {% if section.settings.alignment == 'center' %}measure--center align-center{% elsif section.settings.alignment == 'right' %}align-right{% endif %}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2 class="{{ block.settings.size }}" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </h2>

          {%- when 'text' -%}
            <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when 'button' -%}
            {%- comment -%}
              A label without a link renders nothing — see about.liquid.
            {%- endcomment -%}
            {%- if block.settings.label != blank and block.settings.link != blank -%}
              <div class="btn-row" {{ block.shopify_attributes }}>
                <a href="{{ block.settings.link }}" class="btn btn--{{ block.settings.style }}">
                  {{ block.settings.label }}
                </a>
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.rich_text.name",
  "tag": "div",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_1"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.all.content_alignment.label",
      "options": [
        { "value": "left", "label": "t:settings_schema.options.left" },
        { "value": "center", "label": "t:settings_schema.options.center" },
        { "value": "right", "label": "t:settings_schema.options.right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing_header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 76
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 76
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.rich_text.blocks.heading.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "t:sections.all.heading.label",
          "default": "Say something that matters"
        },
        {
          "type": "select",
          "id": "size",
          "label": "t:sections.rich_text.blocks.heading.size.label",
          "options": [
            { "value": "h4", "label": "t:settings_schema.options.small" },
            { "value": "h3", "label": "t:settings_schema.options.medium" },
            { "value": "h2", "label": "t:settings_schema.options.large" }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.rich_text.blocks.text.name",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.all.text.label",
          "default": "<p>Use this space for the story behind the collection, the shipping promise, or whatever a first-time visitor needs to hear.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.rich_text.blocks.button.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.rich_text.blocks.button.label.label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.all.link.label"
        },
        {
          "type": "select",
          "id": "style",
          "label": "t:sections.rich_text.blocks.button.style.label",
          "options": [
            { "value": "primary", "label": "t:settings_schema.options.solid" },
            { "value": "outline", "label": "t:settings_schema.options.outline" },
            { "value": "link", "label": "t:settings_schema.options.text_link" }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.rich_text.name",
      "blocks": [{ "type": "heading" }, { "type": "text" }, { "type": "button" }]
    }
  ]
}
{% endschema %}
