{%- comment -%}
  Announcement bar is an ordinary page section. It renders exactly where the
  merchant places it and intentionally has no page-visibility setting.
{%- endcomment -%}

{% render 'announcement', section: section, is_header: false %}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "tag": "aside",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_2"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:sections.announcement_bar.content_width.label",
      "options": [
        { "value": "full", "label": "t:sections.announcement_bar.content_width.full" },
        { "value": "page", "label": "t:sections.announcement_bar.content_width.page" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "height_preset",
      "label": "t:sections.announcement_bar.height_preset.label",
      "options": [
        { "value": "compact", "label": "t:sections.announcement_bar.height_preset.compact" },
        { "value": "standard", "label": "t:sections.announcement_bar.height_preset.standard" },
        { "value": "tall", "label": "t:sections.announcement_bar.height_preset.tall" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "mode",
      "label": "t:sections.announcement_bar.mode.label",
      "options": [
        { "value": "marquee", "label": "t:sections.announcement_bar.mode.marquee" },
        { "value": "rotate", "label": "t:sections.announcement_bar.mode.rotate" }
      ],
      "default": "marquee"
    },
    {
      "type": "select",
      "id": "marquee_speed",
      "label": "t:sections.announcement_bar.marquee_speed.label",
      "options": [
        { "value": "relaxed", "label": "t:sections.announcement_bar.marquee_speed.relaxed" },
        { "value": "balanced", "label": "t:sections.announcement_bar.marquee_speed.balanced" },
        { "value": "brisk", "label": "t:sections.announcement_bar.marquee_speed.brisk" }
      ],
      "default": "balanced",
      "visible_if": "{{ section.settings.mode == 'marquee' }}"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.announcement_bar.auto_rotate.label",
      "default": true,
      "visible_if": "{{ section.settings.mode == 'rotate' }}"
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "t:sections.announcement_bar.animation_style.label",
      "options": [
        { "value": "fade", "label": "t:sections.announcement_bar.animation_style.fade" },
        { "value": "slide", "label": "t:sections.announcement_bar.animation_style.slide" }
      ],
      "default": "slide",
      "visible_if": "{{ section.settings.mode == 'rotate' }}"
    },
    {
      "type": "range",
      "id": "interval",
      "label": "t:sections.announcement_bar.interval.label",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 6,
      "visible_if": "{{ section.settings.mode == 'rotate' and section.settings.auto_rotate }}"
    },
    {
      "type": "header",
      "content": "t:blocks.all.text_header"
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "t:blocks.all.text_preset.label",
      "info": "t:blocks.all.text_preset.info",
      "options": [
        { "value": "title", "label": "t:settings_schema.typography.presets.title.header" },
        { "value": "heading_1", "label": "t:settings_schema.typography.presets.heading_1.header" },
        { "value": "heading_2", "label": "t:settings_schema.typography.presets.heading_2.header" },
        { "value": "heading_3", "label": "t:settings_schema.typography.presets.heading_3.header" },
        { "value": "heading_4", "label": "t:settings_schema.typography.presets.heading_4.header" },
        { "value": "heading_5", "label": "t:settings_schema.typography.presets.heading_5.header" },
        { "value": "subheading", "label": "t:settings_schema.typography.presets.subheading.header" },
        { "value": "paragraph", "label": "t:settings_schema.typography.presets.paragraph.header" },
        { "value": "small", "label": "t:settings_schema.typography.presets.small.header" },
        { "value": "caption", "label": "t:settings_schema.typography.presets.caption.header" }
      ],
      "default": "caption"
    },
    {
      "type": "header",
      "content": "t:blocks.all.override_header"
    },
    {
      "type": "select",
      "id": "override_font",
      "label": "t:blocks.all.override_font.label",
      "options": [
        { "value": "inherit", "label": "t:blocks.all.inherit.label" },
        { "value": "accent", "label": "t:settings_schema.typography.roles.accent" },
        { "value": "body", "label": "t:settings_schema.typography.roles.body" },
        { "value": "subheading", "label": "t:settings_schema.typography.roles.subheading" },
        { "value": "heading", "label": "t:settings_schema.typography.roles.heading" }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "override_size",
      "label": "t:blocks.all.override_size.label",
      "options": [
        { "value": "inherit", "label": "t:blocks.all.inherit.label" },
        { "value": "3xs", "label": "t:settings_schema.typography.scale.3xs" },
        { "value": "2xs", "label": "t:settings_schema.typography.scale.2xs" },
        { "value": "xs", "label": "t:settings_schema.typography.scale.xs" },
        { "value": "sm", "label": "t:settings_schema.typography.scale.sm" },
        { "value": "md", "label": "t:settings_schema.typography.scale.md" },
        { "value": "lg", "label": "t:settings_schema.typography.scale.lg" },
        { "value": "xl", "label": "t:settings_schema.typography.scale.xl" },
        { "value": "2xl", "label": "t:settings_schema.typography.scale.2xl" },
        { "value": "3xl", "label": "t:settings_schema.typography.scale.3xl" },
        { "value": "4xl", "label": "t:settings_schema.typography.scale.4xl" },
        { "value": "5xl", "label": "t:settings_schema.typography.scale.5xl" },
        { "value": "6xl", "label": "t:settings_schema.typography.scale.6xl" },
        { "value": "7xl", "label": "t:settings_schema.typography.scale.7xl" },
        { "value": "8xl", "label": "t:settings_schema.typography.scale.8xl" }
      ],
      "default": "inherit"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:blocks.all.text_color.label",
      "info": "t:blocks.all.text_color.info"
    },
    {
      "type": "select",
      "id": "override_leading",
      "label": "t:blocks.all.override_leading.label",
      "options": [
        { "value": "inherit", "label": "t:blocks.all.inherit.label" },
        { "value": "tight", "label": "t:settings_schema.typography.leading.tight" },
        { "value": "snug", "label": "t:settings_schema.typography.leading.snug" },
        { "value": "normal", "label": "t:settings_schema.typography.leading.normal" },
        { "value": "relaxed", "label": "t:settings_schema.typography.leading.relaxed" },
        { "value": "loose", "label": "t:settings_schema.typography.leading.loose" }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "override_case",
      "label": "t:blocks.all.override_case.label",
      "options": [
        { "value": "inherit", "label": "t:blocks.all.inherit.label" },
        { "value": "default", "label": "t:settings_schema.typography.case.default" },
        { "value": "uppercase", "label": "t:settings_schema.typography.case.uppercase" },
        { "value": "lowercase", "label": "t:settings_schema.typography.case.lowercase" },
        { "value": "capitalize", "label": "t:settings_schema.typography.case.capitalize" }
      ],
      "default": "uppercase"
    },
    {
      "type": "select",
      "id": "override_tracking",
      "label": "t:blocks.all.override_tracking.label",
      "options": [
        { "value": "inherit", "label": "t:blocks.all.inherit.label" },
        { "value": "tighter", "label": "t:settings_schema.typography.tracking.tighter" },
        { "value": "tight", "label": "t:settings_schema.typography.tracking.tight" },
        { "value": "normal", "label": "t:settings_schema.typography.tracking.normal" },
        { "value": "wide", "label": "t:settings_schema.typography.tracking.wide" },
        { "value": "wider", "label": "t:settings_schema.typography.tracking.wider" }
      ],
      "default": "wide"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.all.content_alignment.label",
      "info": "t:sections.all.content_alignment.info",
      "options": [
        { "value": "inherit", "label": "t:settings_schema.options.inherit" },
        { "value": "left", "label": "t:settings_schema.options.left" },
        { "value": "center", "label": "t:settings_schema.options.center" },
        { "value": "right", "label": "t:settings_schema.options.right" }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "t:sections.announcement_bar.blocks.message.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "t:sections.announcement_bar.blocks.message.text.label",
          "default": "Complimentary insured shipping on every order"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.all.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement_bar.name",
      "blocks": [
        { "type": "message", "settings": { "text": "Complimentary insured shipping on every order" } },
        { "type": "message", "settings": { "text": "A private welcome offer awaits" } },
        { "type": "message", "settings": { "text": "Designed with intention. Made to endure." } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
