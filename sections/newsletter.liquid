{%- comment -%}
  Standalone newsletter section. Posts to Shopify's customer form, so it works
  without JavaScript and without a third-party app.

  **This one had no local blocks, so nothing was collapsed — composability was
  added.** That makes it a different job from the rest of the phase, and worth
  saying out loud: `featured-products` is in the same position and is still
  *not* convertible, because its two header parts share one `space-between`
  row. This section's header is a plain vertical stack with nothing sharing a
  row, so blocks drop straight in.

  **The form stays the section's own and always comes last.** It is what the
  section is for, it is not a thing a merchant should be able to remove or
  reorder, and `content_for 'blocks'` can only render one flat flow — so the
  blocks are the copy above it and the form follows them. `button_label` stays
  a section setting for the same reason: it labels the form's submit, not a
  block.
{%- endcomment -%}

<section
  class="section scheme-{{ section.settings.color_scheme }}"
  style="{% render 'section-style', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}"
>
  <div class="page-width page-width--reading">
    <div class="stack stack--center">
      {% content_for 'blocks' %}

      {%- form 'customer', class: 'stack stack--tight stack--center' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="form-row">
          <label class="visually-hidden" for="newsletter-{{ section.id }}">
            {{ 'newsletter.email' | t }}
          </label>
          <input
            class="field"
            type="email"
            name="contact[email]"
            id="newsletter-{{ section.id }}"
            placeholder="{{ 'newsletter.email' | t }}"
            autocomplete="email"
            required
          >
          <button type="submit" class="btn btn--primary">
            {{ section.settings.button_label | default: 'Subscribe' }}
          </button>
        </div>

        {%- if form.errors -%}
          <p class="form-status form-status--error">{{ form.errors.messages['email'] }}</p>
        {%- elsif form.posted_successfully? -%}
          <p class="form-status">{{ 'newsletter.success' | t }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "div",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_1"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.newsletter.button_label.label",
      "default": "Subscribe"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing_header"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "options": [
        { "value": "none", "label": "t:sections.all.space_step.none" },
        { "value": "2xs", "label": "t:sections.all.space_step.2xs" },
        { "value": "xs", "label": "t:sections.all.space_step.xs" },
        { "value": "sm", "label": "t:sections.all.space_step.sm" },
        { "value": "md", "label": "t:sections.all.space_step.md" },
        { "value": "lg", "label": "t:sections.all.space_step.lg" },
        { "value": "xl", "label": "t:sections.all.space_step.xl" },
        { "value": "max", "label": "t:sections.all.space_step.max" }
      ],
      "default": "lg"
    }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "heading" },
    { "type": "prose" },
    { "type": "subheading" },
    { "type": "paragraph" },
    { "type": "title" }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.name",
      "blocks": [
        {
          "type": "heading",
          "settings": { "text": "Stay in touch", "size": "h2" }
        },
        {
          "type": "prose",
          "settings": { "text": "<p>Occasional email about new arrivals. No noise.</p>" }
        }
      ]
    }
  ]
}
{% endschema %}
