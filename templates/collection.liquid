<div class="page-width simple-template">
  <div class="stack">
    <h1 class="h3">{{ collection.title }}</h1>

    {%- if collection.description != blank -%}
      <div class="rte measure">{{ collection.description }}</div>
    {%- endif -%}

    {%- paginate collection.products by 24 -%}
      {%- if collection.products.size > 0 -%}
        <div class="grid-auto grid-auto--products" style="--cols: 4;">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="btn-row" style="justify-content: center;">
            {%- if paginate.previous -%}
              <a class="btn btn--secondary" href="{{ paginate.previous.url }}">
                {{ 'general.pagination.previous' | t }}
              </a>
            {%- endif -%}
            {%- if paginate.next -%}
              <a class="btn btn--secondary" href="{{ paginate.next.url }}">
                {{ 'general.pagination.next' | t }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <p class="text-muted">{{ 'collections.empty' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>
