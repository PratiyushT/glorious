<div class="page-width simple-template">
  <div class="stack">
    <h1 class="h3">{{ blog.title }}</h1>

    {%- paginate blog.articles by 12 -%}
      <div class="grid-auto" style="--cols: 3;">
        {%- for article in blog.articles -%}
          <article class="card">
            {%- if article.image -%}
              <a class="card__media media" href="{{ article.url }}" style="aspect-ratio: 4 / 3;">
                {{
                  article.image
                  | image_url: width: 1000
                  | image_tag:
                    widths: '300,500,700,1000',
                    sizes: '(min-width: 60rem) 33vw, 100vw',
                    loading: 'lazy',
                    alt: article.title
                }}
              </a>
            {%- endif -%}
            <a class="card__title" href="{{ article.url }}">{{ article.title }}</a>
            <span class="card__vendor">{{ article.published_at | date: '%B %e, %Y' }}</span>
            <p class="text-sm text-muted">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
          </article>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="btn-row" style="justify-content: center;">
          {%- if paginate.previous -%}
            <a class="btn btn--secondary" href="{{ paginate.previous.url }}">
              {{ 'general.pagination.previous' | t }}
            </a>
          {%- endif -%}
          {%- if paginate.next -%}
            <a class="btn btn--secondary" href="{{ paginate.next.url }}">
              {{ 'general.pagination.next' | t }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>
