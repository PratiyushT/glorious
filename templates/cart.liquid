<div class="page-width simple-template">
  <div class="stack">
    <h1 class="h3">{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}
      <p class="text-muted">{{ 'cart.empty' | t }}</p>
      {%- liquid
        assign pp = all_products['exquisite-round-diamond-chain-bracelet']
        assign mo = blank
        for o in pp.options_with_values
          assign od = o.name | downcase
          if od contains 'metal'
            assign mo = o
            break
          endif
        endfor
        assign target = 'White Gold'
        assign hit_plain = 'no'
        assign hit_str = 'no'
        for c in mo.values
          if c == target
            assign hit_plain = 'yes'
          endif
          assign cn = c | append: ''
          if cn == target
            assign hit_str = 'yes'
            assign found = c
          endif
        endfor
      -%}
      <span id="cmp"
        data-plain="{{ hit_plain }}"
        data-stringified="{{ hit_str }}"
        data-found-has-swatch="{% if found.swatch %}yes{% else %}no{% endif %}"
        data-found-image="{{ found.swatch.image | image_url: width: 40 }}"
      ></span>
      {%- assign sw2 = found.swatch -%}
      <span id="cmp2"
        data-assigned-image-blank="{% if sw2.image != blank %}not-blank{% else %}blank{% endif %}"
        data-assigned-color-blank="{% if sw2.color != blank %}not-blank{% else %}blank{% endif %}"
      ></span>
      <span id="direct">{% render 'metal-swatch', option_value: found, size: 80 %}</span>
      <div class="btn-row">
        <a class="btn btn--primary" href="{{ settings.cart_empty_link | default: routes.all_products_collection_url }}">
          {{ 'general.continue_shopping' | t }}
        </a>
      </div>
    {%- else -%}
      {% form 'cart', cart, class: 'stack' %}
        <div class="stack">
          {%- for item in cart.items -%}
            <div class="split" style="--split-min: 16rem; --split-align: flex-start;">
              <div class="split" style="--split-min: 8rem; --split-align: flex-start;">
                <div class="media" style="max-width: 6rem; aspect-ratio: 1 / 1;">
                  {%- if item.image -%}
                    {%- assign item_lqip = item.image | image_url: width: 40 -%}
                    {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.title, data-image-lqip: item_lqip }}
                  {%- endif -%}
                </div>
                <div class="stack stack--tight">
                  <a class="card__title" href="{{ item.url }}">{{ item.product.title }}</a>
                  {% render 'line-options', item: item, class: 'card__meta' %}
                  {%- comment -%}
                    A line never carries the note — it is said once, on the
                    subtotal below, exactly as the bag drawer says it. And the
                    figure is the price of one piece rather than price ×
                    quantity, for the reason given in the drawer.
                  {%- endcomment -%}
                  <span class="card__price">
                    {%- if settings.cart_unit_price -%}
                      {{- item.final_price | money -}}
                    {%- else -%}
                      {{- item.final_line_price | money -}}
                    {%- endif -%}
                  </span>
                </div>
              </div>

              <div class="form-row" style="max-width: 14rem;">
                <label class="visually-hidden" for="qty-{{ item.index | plus: 1 }}">
                  {{ 'products.quantity' | t }}
                </label>
                <input
                  class="field"
                  id="qty-{{ item.index | plus: 1 }}"
                  name="updates[]"
                  type="number"
                  min="0"
                  value="{{ item.quantity }}"
                >
                <a class="btn btn--link" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- comment -%}
          The Cart settings are shared with the drawer — they are alternatives,
          and a bag should not be able to do different things depending on which
          one the shop has chosen. Each of these is the same setting acting on
          the same object here as it does in `snippets/cart-drawer-contents`.
        {%- endcomment -%}
        {%- if settings.cart_note -%}
          <div class="stack stack--tight">
            <label for="cart-note">{{ 'cart.note' | t }}</label>
            <textarea id="cart-note" name="note" rows="3">{{ cart.note }}</textarea>
          </div>
        {%- endif -%}

        {%- if settings.cart_discounts and cart.cart_level_discount_applications.size > 0 -%}
          <ul class="stack stack--tight">
            {%- for discount in cart.cart_level_discount_applications -%}
              <li>{{ discount.title }} −{{ discount.total_allocated_amount | money }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="footer__bottom">
          <div class="stack stack--tight">
            <span class="h5">
              {{- 'cart.subtotal' | t }}: {{ cart.total_price | money -}}
              {% render 'tax-note' %}
            </span>
            <span class="text-xs text-muted">{{ 'cart.taxes_note' | t }}</span>
          </div>
          <div class="btn-row">
            <button type="submit" name="update" class="btn btn--secondary">{{ 'cart.update' | t }}</button>
            <button type="submit" name="checkout" class="btn btn--primary">{{ 'cart.checkout' | t }}</button>
          </div>
        </div>

        {%- if settings.cart_accelerated_checkout -%}
          {{ form | payment_button }}
        {%- endif -%}

        {%- if settings.cart_installments -%}
          {{ form | payment_terms }}
        {%- endif -%}
      {% endform %}
    {%- endif -%}
  </div>
</div>
