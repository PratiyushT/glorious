{
  "sections": {
    "header": {
      "type": "group",
      "blocks": {
        "eyebrow": { "type": "text", "settings": { "text": "Explore", "style": "subheading", "layout": "eyebrow", "element": "span" } },
        "title": { "type": "text", "settings": { "text": "Collections", "style": "title", "layout": "display", "element": "h1" } }
      },
      "block_order": ["eyebrow", "title"],
      "settings": {
        "color_scheme": "scheme_1", "content_width": "page", "direction": "vertical", "align_vertical": "stretch",
        "vertical_gap": "tiny", "content_alignment": "left", "block_gap": "tiny", "padding_top": "lg", "padding_bottom": "sm"
      }
    },
    "main": {
      "type": "main-list-collections",
      "blocks": {
        "collection-card": {
          "type": "_collection-card", "static": true,
          "blocks": {
            "media": { "type": "_collection-card-media", "settings": { "image_ratio": "4/3", "image_fit": "cover" } },
            "header": {
              "type": "_collection-card-header",
              "blocks": {
                "content": {
                  "type": "_collection-card-group",
                  "blocks": {
                    "title": { "type": "text", "settings": { "text": "{{ closest.collection.title }}", "style": "heading_5", "element": "h2" } },
                    "arrow": { "type": "icon", "settings": { "icon": "arrow-right", "icon_size": "2xs", "show_frame": false, "hover_animation": "nudge" } }
                  },
                  "block_order": ["title", "arrow"],
                  "settings": { "direction": "horizontal", "distribute": "start", "align": "baseline", "wrap": false, "items_width": "natural", "stack_below": "never", "gap": "tiny", "padding": "none" }
                },
                "count": { "type": "_collection-count-text", "settings": { "style": "caption", "element": "span", "override_tracking": "wider" } }
              },
              "block_order": ["content", "count"],
              "settings": { "direction": "horizontal", "distribute": "between", "align": "baseline", "wrap": false, "items_width": "natural", "stack_below": "never", "gap": "small", "padding": "small", "show_borders": true, "border_top": false, "border_right": false, "border_bottom": true, "border_left": false }
            }
          },
          "block_order": ["media", "header"],
          "settings": { "show_hover_reveal": true, "hover_reveal_label": "View collection" }
        }
      },
      "settings": { "color_scheme": "scheme_1", "columns": 3, "gap": "theme", "padding_top": "sm", "padding_bottom": "xl" }
    }
  },
  "order": ["header", "main"]
}
