{
  "layout": "password",
  "sections": {
    "main": {
      "type": "main-password",
      "blocks": {
        "eyebrow": {
          "type": "text",
          "settings": {
            "text": "Opening soon",
            "style": "subheading",
            "element": "span",
            "override_case": "uppercase",
            "override_tracking": "wider"
          }
        },
        "heading": {
          "type": "text",
          "settings": {
            "text": "Something considered is on the way.",
            "style": "heading_1",
            "element": "h1"
          }
        },
        "text": {
          "type": "rich-text",
          "settings": {
            "text": "<p>Join the list for launch news, or enter the storefront password below.</p>"
          }
        }
      },
      "block_order": ["eyebrow", "heading", "text"],
      "settings": {
        "color_scheme": "scheme_2",
        "alignment": "center",
        "show_signup": true,
        "signup_label": "Notify me",
        "enter_label": "Enter store",
        "padding_top": "lg",
        "padding_bottom": "lg"
      }
    }
  },
  "order": ["main"]
}
