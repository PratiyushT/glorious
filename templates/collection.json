{
  "sections": {
    "main": {
      "type": "main-collection",
      "blocks": {
        "product-card": {
          "type": "_product-card",
          "static": true,
          "blocks": {
            "media": {
              "type": "_product-card-media",
              "settings": {
                "image_ratio": "1/1",
                "image_fit": "contain"
              }
            },
            "title": {
              "type": "text",
              "settings": {
                "text": "{{ closest.product.title }}",
                "style": "small",
                "element": "h3",
                "override_case": "uppercase",
                "override_tracking": "wide"
              }
            },
            "option": {
              "type": "_product-card-option-control",
              "settings": {
                "target_by": "auto",
                "control": "auto",
                "swatch_shape": "round"
              }
            },
            "price": {
              "type": "_product-card-price",
              "settings": {}
            },
            "add": {
              "type": "_product-card-add",
              "settings": {
                "variant_action": "choose_options"
              }
            }
          },
          "block_order": [
            "media",
            "title",
            "option",
            "price",
            "add"
          ],
          "settings": {
            "text_align": "left",
            "show_carousel": true,
            "arrows_wide": "hover",
            "arrows_compact": "swipe",
            "hover_next": true,
            "show_video": true,
            "video_badge": "Video",
            "quick_view_desktop": true,
            "quick_view_compact": true
          }
        }
      },
      "settings": {
        "color_scheme": "scheme_1",
        "header_color_scheme": "scheme_1",
        "header_layout": "reference",
        "show_title": true,
        "header_title_size": "reference",
        "header_alignment": "left",
        "eyebrow": "Explore the collection",
        "show_description": true,
        "description_width": "38",
        "header_media_source": "none",
        "header_media_position": "end",
        "header_height": "reference",
        "header_image_fit": "cover",
        "header_overlay": "medium",
        "header_motion": "reference",
        "sticky_controls": true,
        "controls_style": "pills",
        "controls_layout": "spread",
        "mobile_controls_layout": "stacked",
        "quick_links_source": "collections",
        "quick_filter_target": "auto",
        "quick_links_limit": "6",
        "show_filters": true,
        "filter_button_label": "Filter",
        "drawer_color_scheme": "scheme_1",
        "drawer_heading": "Refine",
        "drawer_position": "end",
        "drawer_width": "medium",
        "mobile_drawer_style": "sheet",
        "filter_group_style": "expanded",
        "open_first_filter": true,
        "show_filter_counts": true,
        "show_filter_visuals": true,
        "show_sort": true,
        "sort_placement": "bar",
        "sort_style": "dropdown",
        "show_sort_label": false,
        "sort_menu_width": "medium",
        "sort_menu_alignment": "end",
        "enable_ajax": true,
        "show_result_count": true,
        "show_search": true,
        "search_placeholder": "Search products",
        "products_per_page": 24,
        "columns": 4,
        "gap": "large",
        "grid_motion": "reference",
        "pagination_style": "round",
        "padding_top": "none",
        "padding_bottom": "none"
      }
    }
  },
  "order": ["main"]
}
