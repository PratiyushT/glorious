{
  "sections": {
    "header": {
      "type": "collection-header",
      "blocks": {
        "content": {
          "type": "group",
          "blocks": {
            "copy": {
              "type": "group",
              "blocks": {
                "eyebrow": {
                  "type": "text",
                  "settings": {
                    "text": "Explore the collection",
                    "style": "subheading",
                    "layout": "eyebrow",
                    "element": "span"
                  }
                },
                "title": {
                  "type": "collection_title",
                  "settings": {
                    "style": "title",
                    "layout": "display",
                    "element": "h1",
                    "wrap": "balance"
                  }
                },
                "description": {
                  "type": "rich-text",
                  "settings": {
                    "text": "{{ collection.description }}",
                    "style": "paragraph"
                  }
                }
              },
              "block_order": ["eyebrow", "title", "description"],
              "settings": {
                "direction": "vertical",
                "align_vertical": "stretch",
                "vertical_gap": "small",
                "padding": "medium"
              }
            },
            "image": {
              "type": "collection_image",
              "settings": {
                "ratio": "4 / 3",
                "fit": "cover",
                "reveal": true,
                "padding": "none"
              }
            }
          },
          "block_order": ["copy", "image"],
          "settings": {
            "direction": "horizontal",
            "distribute": "start",
            "align": "stretch",
            "content_alignment": "left",
            "wrap": false,
            "items_width": "equal",
            "stack_below": "mobile",
            "gap": "large",
            "padding": "none"
          }
        }
      },
      "block_order": ["content"],
      "settings": {
        "color_scheme": "scheme_1",
        "content_width": "page",
        "layout": "side_by_side",
        "media_position": "title_first",
        "show_overlay": true,
        "overlay_strength": 40,
        "height": "reference",
        "content_alignment": "left",
        "vertical_alignment": "center",
        "block_gap": "tiny",
        "motion": "reference",
        "padding_top": "none",
        "padding_bottom": "none"
      }
    },
    "main": {
      "type": "main-collection",
      "blocks": {
        "product-card": {
          "type": "_product-card",
          "static": true,
          "blocks": {
            "media": {
              "type": "_product-card-media",
              "settings": {
                "image_ratio": "1/1",
                "image_fit": "contain"
              }
            },
            "badges": {
              "type": "product_badges",
              "settings": {}
            },
            "title": {
              "type": "product_title",
              "settings": {
                "style": "small",
                "element": "h2",
                "override_case": "uppercase",
                "override_tracking": "wide",
                "wrap": "balance",
                "link_to_product": true
              }
            },
            "option": {
              "type": "_product-card-option-control",
              "settings": {
                "target_by": "auto",
                "control": "auto",
                "swatch_shape": "round"
              }
            },
            "price": {
              "type": "_product-card-price",
              "settings": {}
            },
            "add": {
              "type": "_product-card-add",
              "settings": {
                "variant_action": "choose_options"
              }
            }
          },
          "block_order": [
            "media",
            "badges",
            "title",
            "option",
            "price",
            "add"
          ],
          "settings": {
            "text_align": "left",
            "show_carousel": true,
            "arrows_wide": "hover",
            "arrows_compact": "swipe",
            "hover_next": true,
            "show_video": true,
            "video_badge": "Video",
            "quick_view_desktop": true,
            "quick_view_compact": true
          }
        }
      },
      "settings": {
        "color_scheme": "scheme_1",
        "sticky_controls": true,
        "controls_style": "pills",
        "controls_layout": "spread",
        "mobile_controls_layout": "stacked",
        "quick_links_source": "collections",
        "quick_filter_target": "auto",
        "quick_links_limit": "6",
        "show_filters": true,
        "drawer_color_scheme": "scheme_1",
        "drawer_position": "end",
        "drawer_width": "medium",
        "mobile_drawer_style": "sheet",
        "filter_group_style": "expanded",
        "open_first_filter": true,
        "show_filter_counts": true,
        "show_filter_visuals": true,
        "show_sort": true,
        "sort_placement": "bar",
        "sort_style": "dropdown",
        "show_sort_label": false,
        "sort_menu_width": "medium",
        "sort_menu_alignment": "end",
        "enable_ajax": true,
        "show_result_count": true,
        "show_search": true,
        "search_placeholder": "Search products",
        "products_per_page": 24,
        "columns": 4,
        "gap": "theme",
        "grid_motion": "reference",
        "pagination_style": "round",
        "padding_top": "none",
        "padding_bottom": "none"
      }
    }
  },
  "order": ["header", "main"]
}
