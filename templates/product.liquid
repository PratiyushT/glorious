{%- comment -%}
  Placeholder product template. Functional (variants, add to cart) but not yet
  designed — it gets rebuilt as a section-based template once the design lands.
{%- endcomment -%}

{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign supports_engraving = product.metafields.custom.engraving_available.value
-%}

<div class="page-width simple-template">
  <div class="split" style="--split-min: 24rem; --split-align: flex-start;">
    <div class="stack" data-product-detail>
      {%- for media in product.media limit: 6 -%}
        <div class="media">
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {%- assign media_lqip = media | image_url: width: 40 -%}
              {{
                media
                | image_url: width: 1600
                | image_tag:
                  widths: '400,600,800,1200,1600',
                  sizes: '(min-width: 60rem) 50vw, 100vw',
                  loading: 'lazy',
                  alt: media.alt,
                  data-image-lqip: media_lqip
              }}
            {%- when 'video' -%}
              {%- assign video_lqip = media.preview_image | image_url: width: 40 -%}
              {{
                media
                | video_tag:
                  controls: true,
                  preload: 'metadata',
                  image_size: '1600x',
                  data-video-lqip: video_lqip
              }}
              {% render 'video-lqip-frame', lqip: video_lqip %}
            {%- when 'external_video' -%}
              {%- assign video_lqip = media.preview_image | image_url: width: 40 -%}
              {{
                media
                | external_video_tag:
                  data-video-lqip: video_lqip
              }}
              {% render 'video-lqip-frame', lqip: video_lqip %}
            {%- when 'model' -%}
              {{ media | model_viewer_tag }}
          {%- endcase -%}
        </div>
      {%- else -%}
        <div class="placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
      {%- endfor -%}
    </div>

    <div class="stack">
      {%- if product.vendor != blank -%}
        <span class="card__vendor">{{ product.vendor }}</span>
      {%- endif -%}

      <h1 class="h3">{{ product.title }}</h1>

      <p class="h5">
        {%- if selected_variant.compare_at_price > selected_variant.price -%}
          <s class="text-muted" data-product-compare>{{ selected_variant.compare_at_price | money }}</s>
        {%- else -%}
          <s class="text-muted" data-product-compare hidden></s>
        {%- endif -%}
        <span data-product-price>{{ selected_variant.price | money }}</span>
      </p>

      <div data-product-purchase>
        {% form 'product', product, class: 'stack stack--tight' %}
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign option_index = forloop.index0 -%}
              {%- assign option_name_down = option.name | downcase -%}

              {%- if option_name_down == 'metal' -%}
                <fieldset class="product-option product-option--metal">
                  <legend class="product-option__label text-sm">
                    <span>{{ option.name }}</span>
                    <span data-product-metal-selected>{{ option.selected_value }}</span>
                  </legend>

                  <div class="product-option__swatches">
                    {%- comment -%}
                      One resolution ladder for the whole theme, and it reads
                      the option value's own swatch — never a table of metal
                      names mapped to bundled assets, which is what stood here
                      and went stale the moment a metal was added or renamed.
                    {%- endcomment -%}
                    {%- for value in option.values -%}
                      {%- assign value_selected = false -%}
                      {%- if option.selected_value == value -%}
                        {%- assign value_selected = true -%}
                      {%- endif -%}
                      <button
                        class="product-option__swatch{% if value_selected %} is-selected{% endif %}"
                        type="button"
                        data-product-metal-swatch
                        data-option-index="{{ option_index }}"
                        data-option-value="{{ value | escape }}"
                        aria-label="{{ value | escape }}"
                        aria-pressed="{% if value_selected %}true{% else %}false{% endif %}"
                        title="{{ value | escape }}"
                      >
                        {% render 'metal-swatch', option_value: value %}
                      </button>
                    {%- endfor -%}
                  </div>

                  <select
                    class="visually-hidden"
                    id="option-{{ product.id }}-{{ forloop.index }}"
                    data-product-option
                    data-option-index="{{ option_index }}"
                    aria-hidden="true"
                    tabindex="-1"
                  >
                    {%- for value in option.values -%}
                      <option
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}selected{% endif %}
                      >
                        {{ value }}
                      </option>
                    {%- endfor -%}
                  </select>
                </fieldset>
              {%- else -%}
                <label class="text-sm" for="option-{{ product.id }}-{{ forloop.index }}">{{ option.name }}</label>
                <select
                  class="field"
                  id="option-{{ product.id }}-{{ forloop.index }}"
                  data-product-option
                  data-option-index="{{ option_index }}"
                >
                  {%- for value in option.values -%}
                    <option
                      value="{{ value | escape }}"
                      {% if option.selected_value == value %}selected{% endif %}
                    >
                      {{ value }}
                    </option>
                  {%- endfor -%}
                </select>
              {%- endif -%}
            {%- endfor -%}
          {%- endunless -%}

          {%- if supports_engraving -%}
            <label class="text-sm" for="engraving-{{ product.id }}">
              {{ 'products.custom_engraving' | t }}
            </label>
            <input
              class="field"
              id="engraving-{{ product.id }}"
              type="text"
              name="properties[Custom Engraving]"
              maxlength="20"
              autocomplete="off"
              placeholder="{{ 'products.custom_engraving_placeholder' | t | escape }}"
            >
            <p class="text-xs text-muted">{{ 'products.custom_engraving_hint' | t }}</p>
          {%- endif -%}

          <select name="id" class="visually-hidden" aria-hidden="true" data-product-variant-id>
            {%- for variant in product.variants -%}
              <option
                value="{{ variant.id }}"
                {% if variant == selected_variant %}selected{% endif %}
              >
                {{ variant.title }}
              </option>
            {%- endfor -%}
          </select>

          <button
            type="submit"
            name="add"
            class="btn btn--primary"
            data-product-submit
            data-add-label="{{ 'products.add_to_cart' | t | escape }}"
            data-sold-out-label="{{ 'products.sold_out' | t | escape }}"
            data-unavailable-label="{{ 'products.unavailable' | t | escape }}"
            {% unless selected_variant.available %}disabled{% endunless %}
          >
            {%- if selected_variant.available -%}
              {{ 'products.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.sold_out' | t }}
            {%- endif -%}
          </button>

          <script type="application/json" data-product-variants>
            [
              {%- for variant in product.variants -%}
                {
                  "id": {{ variant.id | json }},
                  "available": {{ variant.available | json }},
                  "options": {{ variant.options | json }},
                  "price": {{ variant.price | money | json }},
                  "compareAtPrice": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}""{% endif %}
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          </script>
        {% endform %}

        <script>
          (() => {
            const root = document.currentScript.closest('[data-product-purchase]');
            const form = root && root.querySelector('form');
            if (!form) return;

            const optionSelects = Array.from(form.querySelectorAll('[data-product-option]'));
            const variantSelect = form.querySelector('[data-product-variant-id]');
            const variantsElement = form.querySelector('[data-product-variants]');
            const submit = form.querySelector('[data-product-submit]');
            const detail = root.closest('.split') || root;
            const price = detail && detail.querySelector('[data-product-price]');
            const compare = detail && detail.querySelector('[data-product-compare]');
            const getMetalSwatches = () => Array.from(form.querySelectorAll('[data-product-metal-swatch]'));
            const metalSelected = form.querySelector('[data-product-metal-selected]');
            if (!variantSelect || !variantsElement || !submit) return;

            let variants = [];
            try {
              variants = JSON.parse(variantsElement.textContent);
            } catch (_error) {
              return;
            }

            const syncMetalSwatches = () => {
              getMetalSwatches().forEach((swatch) => {
                const select = optionSelects[Number(swatch.dataset.optionIndex)];
                const selected = Boolean(select && select.value === swatch.dataset.optionValue);
                swatch.classList.toggle('is-selected', selected);
                swatch.setAttribute('aria-pressed', selected ? 'true' : 'false');
                if (selected && metalSelected) metalSelected.textContent = swatch.dataset.optionValue;
              });
            };

            const syncVariant = () => {
              syncMetalSwatches();
              const selectedOptions = optionSelects.map((select) => select.value);
              const variant = variants.find((candidate) =>
                candidate.options.every((value, index) => value === selectedOptions[index])
              );

              if (!variant) {
                submit.disabled = true;
                submit.textContent = submit.dataset.unavailableLabel;
                return;
              }

              variantSelect.value = String(variant.id);
              submit.disabled = !variant.available;
              submit.textContent = variant.available
                ? submit.dataset.addLabel
                : submit.dataset.soldOutLabel;

              if (price) price.textContent = variant.price;
              if (compare) {
                compare.textContent = variant.compareAtPrice;
                compare.hidden = !variant.compareAtPrice;
              }

              const url = new URL(window.location.href);
              url.searchParams.set('variant', variant.id);
              window.history.replaceState({}, '', url);
            };

            form.addEventListener('click', (event) => {
              const swatch = event.target.closest('[data-product-metal-swatch]');
              if (!swatch) return;
              const select = optionSelects[Number(swatch.dataset.optionIndex)];
              if (!select || select.value === swatch.dataset.optionValue) return;
              select.value = swatch.dataset.optionValue;
              select.dispatchEvent(new Event('change', { bubbles: true }));
            });
            optionSelects.forEach((select) => select.addEventListener('change', syncVariant));
            syncVariant();
          })();
        </script>
      </div>

      <div class="rte">{{ product.description }}</div>
    </div>
  </div>
</div>
