{
  "sections": {
    "header": {
      "type": "group",
      "blocks": {
        "eyebrow": { "type": "text", "settings": { "text": "Journal", "style": "subheading", "layout": "eyebrow", "element": "span" } },
        "title": { "type": "text", "settings": { "text": "{{ blog.title }}", "style": "title", "layout": "display", "element": "h1" } }
      },
      "block_order": ["eyebrow", "title"],
      "settings": {
        "color_scheme": "scheme_1", "content_width": "page", "direction": "vertical", "align_vertical": "stretch",
        "vertical_gap": "tiny", "content_alignment": "left", "block_gap": "tiny", "padding_top": "lg", "padding_bottom": "sm"
      }
    },
    "main": {
      "type": "main-blog",
      "blocks": {
        "article-card": {
          "type": "_article-card", "static": true,
          "blocks": {
            "image": { "type": "article_image", "settings": { "ratio": "4 / 3", "fit": "cover", "reveal": true, "reveal_delay": 0, "padding": "none", "link_to_article": true } },
            "metadata": { "type": "article_metadata", "settings": { "metadata": "date", "separator": "·", "style": "caption", "element": "p", "override_case": "uppercase", "override_tracking": "wide" } },
            "title": { "type": "article_title", "settings": { "style": "heading_5", "element": "h2", "wrap": "balance", "link_to_article": true } },
            "excerpt": { "type": "article_excerpt", "settings": { "fallback_to_content": true, "truncate": true, "excerpt_words": 25, "style": "paragraph" } },
            "read-more": { "type": "button", "settings": { "button_label": "Read article", "button_link": "{{ closest.article.url }}", "button_style": "link" } }
          },
          "block_order": ["image", "metadata", "title", "excerpt", "read-more"],
          "settings": {}
        }
      },
      "settings": { "color_scheme": "scheme_1", "articles_per_page": 12, "columns": 3, "gap": "theme", "padding_top": "sm", "padding_bottom": "xl" }
    }
  },
  "order": ["header", "main"]
}
