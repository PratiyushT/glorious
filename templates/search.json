{
  "sections": {
    "header": {
      "type": "search-header",
      "blocks": {
        "search-form": {
          "type": "search-form",
          "settings": {
            "placeholder": "Search products and pages",
            "result_types": "all",
            "width": "full",
            "show_button": false,
            "button_label": "Search",
            "show_clear": true,
            "padding": "none"
          }
        }
      },
      "block_order": ["search-form"],
      "settings": {
        "color_scheme": "scheme_1",
        "content_width": "page",
        "height": "compact",
        "content_alignment": "left",
        "vertical_alignment": "center",
        "block_gap": "tiny",
        "motion": "reference",
        "padding_top": "none",
        "padding_bottom": "none"
      }
    },
    "main": {
      "type": "main-search",
      "blocks": {
        "product-card": {
          "type": "_product-card",
          "static": true,
          "blocks": {
            "media": {
              "type": "_product-card-media",
              "settings": {
                "image_ratio": "1/1",
                "image_fit": "contain"
              }
            },
            "badges": {
              "type": "product_badges",
              "settings": {}
            },
            "title": {
              "type": "product_title",
              "settings": {
                "style": "small",
                "element": "h2",
                "override_case": "uppercase",
                "override_tracking": "wide",
                "wrap": "balance",
                "link_to_product": true
              }
            },
            "option": {
              "type": "_product-card-option-control",
              "settings": {
                "target_by": "auto",
                "control": "auto",
                "swatch_shape": "round"
              }
            },
            "price": {
              "type": "_product-card-price",
              "settings": {}
            },
            "add": {
              "type": "_product-card-add",
              "settings": {
                "variant_action": "choose_options"
              }
            }
          },
          "block_order": [
            "media",
            "badges",
            "title",
            "option",
            "price",
            "add"
          ],
          "settings": {
            "text_align": "left",
            "show_carousel": true,
            "arrows_wide": "hover",
            "arrows_compact": "swipe",
            "hover_next": true,
            "show_video": true,
            "video_badge": "Video",
            "quick_view_desktop": true,
            "quick_view_compact": true
          }
        },
        "featured-product-card": {
          "type": "_product-card",
          "static": true,
          "blocks": {
            "media": {
              "type": "_product-card-media",
              "settings": {
                "image_ratio": "1/1",
                "image_fit": "contain"
              }
            },
            "badges": {
              "type": "product_badges",
              "settings": {}
            },
            "title": {
              "type": "product_title",
              "settings": {
                "style": "small",
                "element": "h2",
                "override_case": "uppercase",
                "override_tracking": "wide",
                "wrap": "balance",
                "link_to_product": true
              }
            },
            "option": {
              "type": "_product-card-option-control",
              "settings": {
                "target_by": "auto",
                "control": "auto",
                "swatch_shape": "round"
              }
            },
            "price": {
              "type": "_product-card-price",
              "settings": {}
            },
            "add": {
              "type": "_product-card-add",
              "settings": {
                "variant_action": "choose_options"
              }
            }
          },
          "block_order": [
            "media",
            "badges",
            "title",
            "option",
            "price",
            "add"
          ],
          "settings": {
            "text_align": "left",
            "show_carousel": true,
            "arrows_wide": "hover",
            "arrows_compact": "swipe",
            "hover_next": true,
            "show_video": true,
            "video_badge": "Video",
            "quick_view_desktop": true,
            "quick_view_compact": true
          }
        }
      },
      "settings": {
        "color_scheme": "scheme_1",
        "popular_label": "Popular",
        "popular_source": "manual",
        "popular_searches": "New arrivals, Best sellers, Gifts, Sale",
        "popular_layout": "inline",
        "sticky_controls": true,
        "controls_style": "pills",
        "controls_layout": "spread",
        "mobile_controls_layout": "stacked",
        "quick_links_source": "filter",
        "quick_filter_target": "auto",
        "quick_links_limit": "6",
        "show_filters": true,
        "drawer_color_scheme": "scheme_1",
        "drawer_position": "end",
        "drawer_width": "medium",
        "mobile_drawer_style": "sheet",
        "filter_group_style": "expanded",
        "open_first_filter": true,
        "show_filter_counts": true,
        "show_filter_visuals": true,
        "show_sort": true,
        "sort_placement": "bar",
        "sort_style": "dropdown",
        "show_sort_label": false,
        "sort_menu_width": "medium",
        "sort_menu_alignment": "end",
        "enable_ajax": true,
        "show_featured_when_empty": true,
        "featured_label": "Featured products",
        "featured_limit": 8,
        "show_result_count": true,
        "show_resource_results": true,
        "resource_style": "rows",
        "resources_heading": "Pages and articles",
        "no_results_text": "Check the spelling or try a broader search.",
        "browse_label": "Browse all products",
        "results_per_page": 24,
        "columns": 4,
        "gap": "theme",
        "grid_motion": "reference",
        "pagination_style": "round",
        "padding_top": "none",
        "padding_bottom": "none"
      }
    },
    "recommended": {
      "type": "featured-products",
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "Recommended for you",
            "style": "heading_2",
            "element": "h2"
          }
        },
        "product-card": {
          "type": "_product-card",
          "static": true,
          "blocks": {
            "media": { "type": "_product-card-media", "settings": { "image_ratio": "1/1", "image_fit": "contain" } },
            "badges": { "type": "product_badges", "settings": {} },
            "title": { "type": "product_title", "settings": { "style": "small", "element": "h3", "override_case": "uppercase", "override_tracking": "wide", "wrap": "balance", "link_to_product": true } },
            "option": { "type": "_product-card-option-control", "settings": { "target_by": "auto", "control": "auto", "swatch_shape": "round" } },
            "price": { "type": "_product-card-price", "settings": {} },
            "add": { "type": "_product-card-add", "settings": { "variant_action": "choose_options" } }
          },
          "block_order": ["media", "badges", "title", "option", "price", "add"],
          "settings": { "text_align": "left", "fixed_size": true, "show_carousel": true, "arrows_wide": "hover", "arrows_compact": "swipe", "hover_next": true, "show_video": true, "video_badge": "Video", "quick_view_desktop": true, "quick_view_compact": true }
        }
      },
      "block_order": ["heading"],
      "settings": {
        "content_alignment": "left",
        "color_scheme": "scheme_1",
        "collection": "featured-products-homepage",
        "layout": "grid",
        "limit_products": true,
        "products_to_show": 4,
        "gap": "large",
        "full_height": false,
        "padding_top": "lg",
        "padding_bottom": "lg"
      }
    }
  },
  "order": ["header", "main", "recommended"]
}
