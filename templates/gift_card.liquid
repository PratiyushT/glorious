{% layout none %}

{%- liquid
  assign formatted_initial_value = gift_card.initial_value | money_without_trailing_zeros
  assign formatted_initial_value_stripped = formatted_initial_value | strip_html
  assign gift_card_image_url = 'gift-card/card.jpg' | shopify_asset_url
  assign gift_card_lqip_separator = '?'
  if gift_card_image_url contains '?'
    assign gift_card_lqip_separator = '&'
  endif
  assign gift_card_lqip_url = gift_card_image_url | append: gift_card_lqip_separator | append: 'width=40'
-%}

<!DOCTYPE html>
<html>

<head>

  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="format-detection" content="telephone=no">

  <title>Here's your {{ formatted_initial_value_stripped }} gift card for {{ shop.name }}!</title>
  <meta name="description" content="Here's your gift card!">

  {{ 'gift-card.css' | shopify_asset_url | stylesheet_tag }}

  <style>
    /* Printing is an action, not a destination, so the control is a button.
       Shopify's stock markup ships it as `<a href="#" onclick="print()">`,
       which is a link to nowhere: it announces as a link, it does not answer
       the space bar, and it is the `href="#"` this theme refuses to render.
       Its own gift-card.css styles `.action-link` for an anchor, so undo the
       button chrome and let that stylesheet apply unchanged. */
    button.action-link {
      background: none;
      border: 0;
      padding: 0;
      font: inherit;
      color: inherit;
      cursor: pointer;
    }

    .gift-card-image-lqip-frame {
      position: absolute;
      z-index: 1;
      display: block;
      overflow: hidden;
      pointer-events: none;
      background-color: #fff;
      background-image: var(--gift-card-lqip-source);
      background-position: var(--gift-card-lqip-position, 50% 50%) !important;
      background-repeat: no-repeat !important;
      background-size: var(--gift-card-lqip-fit, cover) !important;
      filter: blur(18px) saturate(.72) brightness(1.12);
      will-change: opacity;
    }

    .gift-card-image-lqip-frame.is-lqip-revealing {
      animation: gift-card-lqip-fade .35s ease-out both;
    }

    @keyframes gift-card-lqip-fade {
      from { opacity: 1; }
      to { opacity: 0; }
    }

    /* These labels are later siblings of the loading facade and remain the
       readable top layer while the gift-card artwork finishes decoding. */
    #gift-card-amount,
    #gift-card-code-outer {
      z-index: 2;
    }
  </style>

  {%- comment -%}
    Shopify's stock template ships both of these through `script_tag`, which
    emits a plain parser-blocking <script src> — ThemeCheck's
    ParserBlockingScript offence.

    They need different treatment, and it was worth measuring rather than
    assuming. `defer` on Modernizr makes its bundle throw
    "Cannot read properties of undefined (reading 'documentElement')" from its
    own module init; `async` does not. Checked against the stock loading as a
    baseline: Modernizr exposes no global and sets no classes on <html> either
    way, so `async` matches the original behaviour exactly — it simply stops
    blocking the parser. (The stylesheet does reference `.svg` and
    `.no-borderradius`, so those rules have never matched on this page. Left
    as found; it is not this change's business.)

    qrcode.js takes `defer` because the QR block below needs it in order.
    Deferred scripts all run before DOMContentLoaded, so waiting on that event
    is enough to find QRCode defined.
  {%- endcomment -%}
  <script src="{{ 'modernizr.gift-card.js' | shopify_asset_url }}" async="async"></script>
  <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer="defer"></script>

  <script type='text/javascript'>
    function selectText(element) {

        var doc = document;
        var text = doc.getElementById(element);

        if (doc.body.createTextRange) { // ms
            var range = doc.body.createTextRange();
            range.moveToElementText(text);
            range.select();
        } else if (window.getSelection) { // moz, opera, webkit
            var selection = window.getSelection();
            var range = doc.createRange();
            range.selectNodeContents(text);
            selection.removeAllRanges();
            selection.addRange(range);
        }

    }
  </script>

</head>

<body>

  <div class="wrap">

    <header role="banner" id="header">
      <a href="{{ shop.url }}" class="logo">{{ shop.name }}</a>
      <a href="{{ shop.url }}" class="shop-url">{{ shop.url | remove: 'http://' }}</a>
    </header>

      <main role="main">

          <div id="gift-card-outer-container" {% if gift_card.expired or gift_card.enabled != true %}class="disabled"{% endif %}>
            <div id="gift-card-inner-container">

              <header id="gift-card-header">
                <h2>Here's your gift card!</h2>
                {% unless gift_card.enabled %}
                  <span class="tag">Disabled</span>
                {% endunless %}
                {% if gift_card.expired and gift_card.enabled %}
                   <span class="tag">Expired on {{ gift_card.expires_on | date: "%d/%m/%y" }}</span>
                {% endif %}
                {% if gift_card.expired != true and gift_card.expires_on and gift_card.enabled %}
                  <span class="tag light">Expires on {{ gift_card.expires_on | date: "%d/%m/%y" }}</span>
                {% endif %}
              </header>

              <div id="gift-card-holder">
                <div class="corner top-left"></div>
                <div class="corner bottom-right"></div>
                <div class="corner top-right"></div>
                <div class="corner bottom-left"></div>
                <div id="gift-card">
                  {%- comment -%}
                    The asset's own intrinsic size. Shopify's stock template
                    omits both, which is the ImgWidthAndHeight offence; the CSS
                    still sizes the image, these only reserve its ratio.
                  {%- endcomment -%}
                  <img
                    src="{{ gift_card_image_url }}"
                    data-image-lqip="{{ gift_card_lqip_url }}"
                    alt="Gift card illustration"
                    width="848"
                    height="565"
                  >
                  {% assign initial_value_size = formatted_initial_value | size %}
                  <div id="gift-card-amount" class="{% if initial_value_size > 6 %}medium{% endif %}">
                    {% if gift_card.balance != gift_card.initial_value %}
                      <span class="tooltip-container"><span class="tooltip-label">{{ gift_card.balance | money }} <small>left</small></span><span class="tooltip-triangle"></span></span>
                    {% endif %}
                    <strong>{{ formatted_initial_value }}</strong>
                  </div>
                  {% assign code_size = gift_card.code | format_code | size %}
                  <div id="gift-card-code-outer" class="{% if code_size <= 25 %}large{% elsif code_size > 25 and code_size <= 30 %}medium{% else %}small{% endif %}" onclick="selectText('gift-card-code-digits');">
                    <div id="gift-card-code-inner">
                      <strong id="gift-card-code-digits">{{ gift_card.code | format_code }}</strong>
                    </div>
                  </div>
                </div>
              </div>

              <div id="gift-card-instructions">
                <p>Use this code at checkout to redeem your gift card.</p>
              </div>
              <div id="qr-code"></div>
              <script>
                /* qrcode.js is deferred now, so it has not run yet at parse
                   time. Deferred scripts all execute before DOMContentLoaded,
                   which is why waiting on it is enough. */
                document.addEventListener('DOMContentLoaded', function () {
                  new QRCode(document.getElementById("qr-code"), {
                    text: "{{ gift_card.qr_identifier }}",
                    width: 120,
                    height: 120
                  });
                });
              </script>
              <div id="gift-card-actions">
                <a href="{{ shop.url }}" class="btn center" target="_blank">Start Shopping</a>
                <button type="button" class="action-link left" onclick="window.print();"><i class="ico-16 print"></i>Print</button>
              </div>
            </div>
          </div>
      </main> <!-- / Main -->

      <footer role="contentinfo">
        {% if gift_card.pass_url %}
          <a href="{{ gift_card.pass_url }}"><img id="apple-wallet-badge" src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" data-image-lqip="off" width="120" height="40" alt="Add To Apple Wallet"></a>
        {% endif %}
      </footer>

    </div>

    <script>
      (function () {
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        document.querySelectorAll('img[data-image-lqip]:not([data-image-lqip="off"])').forEach(function (image) {
          if (image.complete && image.naturalWidth > 0) return;

          var host = image.parentElement;
          if (!host) return;

          var style = window.getComputedStyle(image);
          var fit = style.objectFit || 'fill';
          var backgroundFit = fit === 'cover' || fit === 'contain'
            ? fit
            : fit === 'fill'
              ? '100% 100%'
              : fit === 'scale-down'
                ? 'contain'
                : 'auto';

          var hostPosition = host.style.getPropertyValue('position');
          var hostPositionPriority = host.style.getPropertyPriority('position');
          var ownsHostPosition = window.getComputedStyle(host).position === 'static';
          if (ownsHostPosition) host.style.setProperty('position', 'relative');

          var facade = document.createElement('span');
          facade.className = 'gift-card-image-lqip-frame';
          facade.setAttribute('aria-hidden', 'true');
          facade.style.setProperty('--gift-card-lqip-source', 'url(' + JSON.stringify(image.dataset.imageLqip) + ')');
          facade.style.setProperty('--gift-card-lqip-fit', backgroundFit);
          facade.style.setProperty('--gift-card-lqip-position', style.objectPosition || '50% 50%');
          host.insertBefore(facade, image.nextSibling);

          function sync() {
            var currentStyle = window.getComputedStyle(image);
            var width = parseFloat(currentStyle.width);
            var height = parseFloat(currentStyle.height);
            if (currentStyle.boxSizing !== 'border-box') {
              width += parseFloat(currentStyle.paddingLeft) + parseFloat(currentStyle.paddingRight) +
                parseFloat(currentStyle.borderLeftWidth) + parseFloat(currentStyle.borderRightWidth);
              height += parseFloat(currentStyle.paddingTop) + parseFloat(currentStyle.paddingBottom) +
                parseFloat(currentStyle.borderTopWidth) + parseFloat(currentStyle.borderBottomWidth);
            }
            facade.style.left = image.offsetLeft + 'px';
            facade.style.top = image.offsetTop + 'px';
            facade.style.width = (isFinite(width) ? width : image.offsetWidth) + 'px';
            facade.style.height = (isFinite(height) ? height : image.offsetHeight) + 'px';
            facade.style.borderRadius = currentStyle.borderRadius;
            facade.style.transform = currentStyle.transform === 'none' ? '' : currentStyle.transform;
            facade.style.transformOrigin = currentStyle.transformOrigin || '';
          }
          sync();

          var sizeObserver = 'ResizeObserver' in window ? new ResizeObserver(sync) : null;
          if (sizeObserver) sizeObserver.observe(image);
          else window.addEventListener('resize', sync);

          var timer = null;
          function clear() {
            if (timer) window.clearTimeout(timer);
            if (sizeObserver) sizeObserver.disconnect();
            else window.removeEventListener('resize', sync);
            if (facade.parentNode) facade.parentNode.removeChild(facade);
            if (ownsHostPosition && host.style.getPropertyValue('position') === 'relative') {
              if (hostPosition) host.style.setProperty('position', hostPosition, hostPositionPriority);
              else host.style.removeProperty('position');
            }
          }

          function reveal() {
            var decoded = typeof image.decode === 'function'
              ? image.decode().catch(function () {})
              : Promise.resolve();

            decoded.then(function () {
              if (!image.naturalWidth || reduceMotion.matches) {
                clear();
                return;
              }

              facade.classList.add('is-lqip-revealing');
              facade.addEventListener('animationend', function (event) {
                if (event.animationName === 'gift-card-lqip-fade') clear();
              }, { once: true });
              timer = window.setTimeout(clear, 700);
            });
          }

          image.addEventListener('load', reveal, { once: true });
          image.addEventListener('error', clear, { once: true });
          if (image.complete && image.naturalWidth === 0) clear();
        });
      })();
    </script>

</body>
</html>
