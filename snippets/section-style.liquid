{%- comment -%}
  Emits inline custom properties for a section's vertical padding.

  Padding is fluid: the merchant sets the wide-screen figure in the editor and
  it eases down to 60% of that on narrow screens, so a 120px desktop gap never
  becomes a 120px gap on a phone.

  Accepts:
    padding_top    - number (px). Falls back to the global default.
    padding_bottom - number (px). Falls back to the global default.

  Usage:
    <section style="{% render 'section-style', padding_top: section.settings.padding_top %}">
{%- endcomment -%}

{%- liquid
  assign vw_min = 360.0
  assign vw_max = 1440.0
  assign vw_span = vw_max | minus: vw_min
  assign root_px = 16.0
  assign narrow_factor = 0.6

  assign pt = padding_top | default: settings.section_padding_default
  assign pb = padding_bottom | default: settings.section_padding_default

  assign pt_lo = pt | times: narrow_factor
  assign pt_slope = pt | minus: pt_lo | divided_by: vw_span
  assign pt_shift = pt_slope | times: vw_min
  assign pt_int = pt_lo | minus: pt_shift

  assign pb_lo = pb | times: narrow_factor
  assign pb_slope = pb | minus: pb_lo | divided_by: vw_span
  assign pb_shift = pb_slope | times: vw_min
  assign pb_int = pb_lo | minus: pb_shift
-%}
--pad-top: clamp({{ pt_lo | divided_by: root_px | round: 4 }}rem, {{ pt_int | divided_by: root_px | round: 4 }}rem + {{ pt_slope | times: 100 | round: 4 }}vw, {{ pt | divided_by: root_px | round: 4 }}rem); --pad-bottom: clamp({{ pb_lo | divided_by: root_px | round: 4 }}rem, {{ pb_int | divided_by: root_px | round: 4 }}rem + {{ pb_slope | times: 100 | round: 4 }}vw, {{ pb | divided_by: root_px | round: 4 }}rem);
