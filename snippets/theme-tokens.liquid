{%- comment -%}
  Compiles merchant settings into CSS custom properties.

  Merchant settings are compiled here, while the named type, leading and
  tracking scales live in base.css. Components consume the resulting custom
  properties rather than reading settings independently.

  Fluid formula, per step:
    slope     = (max - min) / (viewport_max - viewport_min)
    intercept = min - (slope * viewport_min)
    value     = clamp(min, intercept + slope*100vw, max)
{%- endcomment -%}

{%- comment -%}
  The layout scales remain named steps rather than raw endpoints — see
  scale-step.liquid. The snippet prints numbers and these
  capture-and-split them, because a snippet cannot hand a value back and
  because every one of these lands in arithmetic below.

  Each falls back to `md`, the reference design's own value, if the stored
  step is not one the snippet knows.
{%- endcomment -%}
{%- capture s_gut -%}{%- render 'scale-step', scale: 'gutter', step: settings.gutter -%}{%- endcapture -%}
{%- if s_gut == blank -%}{%- capture s_gut -%}{%- render 'scale-step', scale: 'gutter', step: 'md' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_space -%}{%- render 'scale-step', scale: 'space_base', step: settings.space_base -%}{%- endcapture -%}
{%- if s_space == blank -%}{%- capture s_space -%}{%- render 'scale-step', scale: 'space_base', step: 'md' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_radius -%}{%- render 'scale-step', scale: 'radius_base', step: settings.radius_base -%}{%- endcapture -%}
{%- if s_radius == blank -%}{%- capture s_radius -%}{%- render 'scale-step', scale: 'radius_base', step: 'xs' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_arch -%}{%- render 'scale-step', scale: 'radius_arch', step: settings.radius_arch -%}{%- endcapture -%}
{%- if s_arch == blank -%}{%- capture s_arch -%}{%- render 'scale-step', scale: 'radius_arch', step: 'md' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_border -%}{%- render 'scale-step', scale: 'border_width', step: settings.border_width -%}{%- endcapture -%}
{%- if s_border == blank -%}{%- capture s_border -%}{%- render 'scale-step', scale: 'border_width', step: 'sm' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_hair -%}{%- render 'scale-step', scale: 'hairline_opacity', step: settings.hairline_opacity -%}{%- endcapture -%}
{%- if s_hair == blank -%}{%- capture s_hair -%}{%- render 'scale-step', scale: 'hairline_opacity', step: 'md' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_shadow -%}{%- render 'scale-step', scale: 'shadow_opacity', step: settings.shadow_opacity -%}{%- endcapture -%}
{%- if s_shadow == blank -%}{%- capture s_shadow -%}{%- render 'scale-step', scale: 'shadow_opacity', step: 'md' -%}{%- endcapture -%}{%- endif -%}

{%- liquid
  assign vw_min = 360.0
  assign vw_max = 1440.0
  assign root_px = 16.0
  assign vw_span = vw_max | minus: vw_min

  assign sp = s_space | split: ','
  assign sp_min = sp[0] | times: 1.0
  assign sp_max = sp[1] | times: 1.0
  if sp_max < sp_min
    assign sp_max = sp_min
  endif

  assign g = s_gut | split: ','
  assign gut_min = g[0] | times: 1.0
  assign gut_max = g[1] | times: 1.0
  if gut_max < gut_min
    assign gut_max = gut_min
  endif

  assign sp_names = '3xs,2xs,xs,sm,md,lg,xl,2xl,3xl' | split: ','
  assign sp_mults = '0.25,0.5,0.75,1,1.5,2,3,4,6' | split: ','
-%}

<style>
  :root {
    /* ---- Fluid spacing scale ---------------------------------------- */
    {%- for name in sp_names -%}
      {%- liquid
        assign mult = sp_mults[forloop.index0] | times: 1.0
        assign lo = sp_min | times: mult
        assign hi = sp_max | times: mult
        assign slope = hi | minus: lo | divided_by: vw_span
        assign shift = slope | times: vw_min
        assign intercept = lo | minus: shift
      -%}
    --space-{{ name }}: clamp({{ lo | divided_by: root_px | round: 4 }}rem, {{ intercept | divided_by: root_px | round: 4 }}rem + {{ slope | times: 100 | round: 4 }}vw, {{ hi | divided_by: root_px | round: 4 }}rem);
    {%- endfor %}

    /* ---- Layout ------------------------------------------------------ */
    {%- liquid
      assign slope = gut_max | minus: gut_min | divided_by: vw_span
      assign shift = slope | times: vw_min
      assign intercept = gut_min | minus: shift
    -%}
    --gutter: clamp({{ gut_min | divided_by: root_px | round: 4 }}rem, {{ intercept | divided_by: root_px | round: 4 }}rem + {{ slope | times: 100 | round: 4 }}vw, {{ gut_max | divided_by: root_px | round: 4 }}rem);
    {%- comment -%}
      The gap between cards in the three product grids. One value, because the
      design uses one for Most Loved, Our Products and Our Promises alike —
      keeping them on the same token is what keeps the three reading as a set.
      Deliberately the design's own curve rather than the 360→1440 spacing
      scale, which would land half again too wide.
    {%- endcomment -%}
    --grid-gap: clamp(0.75rem, 2vw, 1.375rem);
    --page-width: {{ settings.page_width }}px;
    --page-width-narrow: {{ settings.page_width_narrow }}px;
    --content-width: {{ settings.content_width }}px;
    --grid-min: {{ settings.grid_min_column }}px;

    /* ---- Typography -------------------------------------------------- */
    {%- comment -%}
      Four merchant-selected font styles feed ten semantic text presets. A
      block chooses a preset and may override only these same four roles, so a
      local exception cannot introduce an untracked fifth font.
    {%- endcomment -%}
    {%- assign font_roles = 'accent,body,subheading,heading' | split: ',' -%}
    {%- for role in font_roles -%}
      {%- assign font_key = 'font_' | append: role -%}
    --font-{{ role }}: {{ settings[font_key].family }}, {{ settings[font_key].fallback_families }};
    --font-{{ role }}-weight: {{ settings[font_key].weight }};
    --font-{{ role }}-style: {{ settings[font_key].style }};
    {%- endfor %}

    {%- assign preset_keys = 'title,heading_1,heading_2,heading_3,heading_4,heading_5,subheading,paragraph,small,caption' | split: ',' -%}
    {%- for p in preset_keys -%}
      {%- assign k_font = 'text_' | append: p | append: '_font' -%}
      {%- assign k_size = 'text_' | append: p | append: '_size' -%}
      {%- assign k_lead = 'text_' | append: p | append: '_leading' -%}
      {%- assign k_track = 'text_' | append: p | append: '_tracking' -%}
      {%- assign k_case = 'text_' | append: p | append: '_case' -%}
      {%- assign preset_font_role = settings[k_font] -%}
      {%- assign case_value = settings[k_case] -%}
      {%- if case_value == 'default' -%}{%- assign case_value = 'none' -%}{%- endif %}
    --text-{{ p }}-font: var(--font-{{ preset_font_role }});
    --text-{{ p }}-weight: var(--font-{{ preset_font_role }}-weight);
    --text-{{ p }}-style: var(--font-{{ preset_font_role }}-style);
    --text-{{ p }}-size: var(--type-{{ settings[k_size] }});
    --text-{{ p }}-leading: var(--lead-{{ settings[k_lead] }});
    --text-{{ p }}-tracking: var(--track-{{ settings[k_track] }});
    --text-{{ p }}-case: {{ case_value }};
    {%- endfor %}

    {%- comment -%}
      Compatibility aliases keep the existing home-page components on the same
      system while their markup is progressively converted to text presets.
    {%- endcomment -%}
    --font-display: var(--font-heading);
    --font-display-style: var(--font-heading-style);
    --display-weight: var(--font-heading-weight);
    --font-price: var(--font-body);
    --fs-xs: var(--type-xs);
    --fs-sm: var(--type-sm);
    --fs-base: var(--text-paragraph-size);
    --fs-md: var(--type-lg);
    --fs-lg: var(--type-xl);
    --fs-xl: var(--type-2xl);
    --fs-2xl: var(--type-3xl);
    --fs-3xl: var(--type-4xl);
    --fs-4xl: var(--type-5xl);
    --fs-display: var(--text-title-size);
    --fs-section: var(--text-heading_2-size);
    --display-leading: var(--text-title-leading);
    --display-tracking: var(--text-title-tracking);
    --display-transform: var(--text-title-case);
    --heading-leading: var(--text-heading_2-leading);
    --heading-tracking: var(--text-heading_2-tracking);
    --body-leading: var(--text-paragraph-leading);
    --micro-size: var(--text-caption-size);
    --micro-tracking: var(--text-caption-tracking);

    /* ---- Icons -------------------------------------------------------
       The merchant picks one responsive rung globally. Icon blocks inherit
       this alias unless they select the same scale locally.               */
    --icon-size-global: var(--icon-size-{{ settings.icon_size | default: 'md' }});

    /* ---- Shape ------------------------------------------------------- */
    --radius: {{ s_radius }}px;
    --radius-sm: {{ s_radius | times: 1.0 | divided_by: 2.0 | round: 2 }}px;
    --radius-arch: clamp({{ s_arch | times: 0.55 | round: 0 }}px, 15vw, {{ s_arch }}px);
    --border-width: {{ s_border }}px;
    --hairline: {{ s_hair }}%;
    --shadow-strength: {{ s_shadow }}%;

    /* ---- Buttons ----------------------------------------------------- */
    {%- comment -%}
      Shopify caps a range at 101 steps, so the slider tops out at 50px rather
      than a literal pill value. At the maximum, emit a radius large enough to
      round any button fully — which is what the design specifies.
    {%- endcomment -%}
    {%- render 'button-theme-style', style: 'filled', default_motion: 'lift' %}
    {%- render 'button-theme-style', style: 'outline', default_motion: 'fade' %}
    {%- render 'button-theme-style', style: 'link', default_motion: 'fade' %}
    {%- render 'button-theme-style', style: 'quiet', default_motion: 'fade' %}
    {%- render 'button-theme-style', style: 'arrow', default_motion: 'slide' %}
    {%- render 'button-theme-style', style: 'arrow_outline', default_motion: 'slide' %}

    {%- comment -%}
      Compatibility aliases for non-Button controls that consume the original
      global tokens. Their visual register is the filled button by default.
    {%- endcomment -%}
    --button-radius: var(--button-filled-radius);
    --button-padding-x: var(--button-filled-padding-x);
    --button-padding-y: var(--button-filled-padding-y);
    --button-size: var(--button-filled-size);
    --button-tracking: var(--button-filled-tracking);
    --button-border-width: var(--button-filled-border-width);
    --button-transform: var(--button-filled-transform);


    /* ---- Cart ---------------------------------------------------------
       A cart line's photograph is framed like a card's, from the same kind
       of pair. The shape is per line (it can adapt), so it is emitted on
       the thumbnail itself; only the fit is global.                     */
    --cart-thumb-fit: {{ settings.cart_image_fit | default: 'cover' }};

    /* ---- Brand palette ------------------------------------------------
       The seven constants the design names — porcelain, ink, noir, ivory,
       champagne, deep gold — as tokens rather than as literals in base.css.

       They are NOT a seventh colour picker. Each is read out of a scheme the
       merchant already controls: the light three from the page scheme, the
       dark four from whichever scheme is nominated as the dark one. So a
       merchant who restyles a scheme restyles every surface built from it,
       and the theme still has one place each colour is defined.

       This exists because the components that most define the theme's look —
       the lookbook stage, the collection card's hover band, the menu and
       search overlays, the bag drawer's checkout button — were painted with
       hex literals, so no colour setting reached them at all. `--c-ivory` was
       already being declared twice as a component-scoped literal, which is
       the same idea arrived at by hand.

       A dark surface cannot simply use `var(--c-bg)`: it sits inside a
       section whose scheme may be light, and it is dark regardless. That is
       why these are named for the colour rather than for the role.          */
    {%- liquid
      assign light = settings.color_schemes[settings.page_scheme.id] | default: settings.color_schemes.scheme_1
      assign dark = settings.color_schemes[settings.dark_scheme.id] | default: settings.color_schemes.scheme_2
    -%}
    --c-porcelain: {{ light.settings.background }};
    --c-ink: {{ light.settings.text }};
    --c-gold: {{ light.settings.accent | default: light.settings.text }};
    --c-noir: {{ dark.settings.background }};
    --c-noir-surface: {{ dark.settings.surface | default: dark.settings.background }};
    --c-ivory: {{ dark.settings.text }};
    --c-champagne: {{ dark.settings.accent | default: dark.settings.text }};
    {%- comment -%}
      The deepest overlay ground is the merchant's nominated dark background.
      A separate literal black would stop following that scheme, and mixing in
      another scheme's text can lighten rather than deepen a custom palette.
    {%- endcomment -%}
    --c-noir-deep: var(--c-noir);

    /* ---- Motion ------------------------------------------------------
       The merchant picks a named step; motion-step.liquid resolves it to a
       bare number and the unit is appended here, because --duration is read
       inside calc() and a keyword there would drop the declaration. An
       unrecognised step falls back to the design's own commonest transition
       rather than emitting `--duration: ms`.                              */
    {%- capture motion_ms -%}{%- render 'motion-step', step: settings.motion_duration -%}{%- endcapture -%}
    {%- if motion_ms == blank -%}{%- assign motion_ms = 350 -%}{%- endif -%}
    --duration: {% if settings.motion_enabled %}{{ motion_ms }}ms{% else %}0ms{% endif %};
    {%- comment -%}
      Two registers, because the design has two. Interaction — a hover, a
      focus, a colour changing — is plain `ease` in all 25 of its pages, and
      never carries a curve of its own. `--ease` is the entrance curve, spent
      on things arriving: reveals, modals, the nav morph, a carousel page.
      Handing hovers the entrance curve is what this theme did everywhere.
    {%- endcomment -%}
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --ease-ui: ease;
    {%- comment -%}
      The design's second curve, and its second-commonest overall at 54 uses:
      a long ease-out. It carries its keyframe animations and the arrow
      button's travel — anything that should leave quickly and arrive slowly.
    {%- endcomment -%}
    --ease-out: cubic-bezier(0.19, 1, 0.22, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    :root {
      --duration: 0ms;
    }
  }

  /* ---- Color schemes -------------------------------------------------
     One class per merchant-defined scheme. Sections adopt a scheme and
     everything inside inherits through the same variables.               */
  {%- for scheme in settings.color_schemes %}
  .scheme-{{ scheme.id }},
  [data-color-scheme='{{ scheme.id }}'] {
    --c-bg: {{ scheme.settings.background }};
    --c-text: {{ scheme.settings.text }};
    --c-heading: {{ scheme.settings.heading | default: scheme.settings.text }};
    --c-muted: {{ scheme.settings.muted | default: scheme.settings.text }};
    --c-accent: {{ scheme.settings.accent | default: scheme.settings.text }};
    --c-border: {{ scheme.settings.border | default: scheme.settings.text }};
    --c-surface: {{ scheme.settings.surface | default: scheme.settings.background }};
    --c-button: {{ scheme.settings.filled_background | default: scheme.settings.text }};
    --c-button-label: {{ scheme.settings.filled_text | default: scheme.settings.background }};
    --c-button-border: {{ scheme.settings.filled_background | default: scheme.settings.text }};
    --c-button-hover: {{ scheme.settings.filled_hover_background | default: scheme.settings.accent }};
    --c-button-label-hover: {{ scheme.settings.filled_hover_text | default: scheme.settings.background }};
    --c-button-border-hover: {{ scheme.settings.filled_hover_background | default: scheme.settings.accent }};
    --c-outline-bg: {{ scheme.settings.outline_background | default: 'transparent' }};
    --c-outline-text: {{ scheme.settings.outline_text | default: scheme.settings.text }};
    --c-outline-border: {{ scheme.settings.outline_border | default: scheme.settings.border | default: scheme.settings.accent }};
    --c-outline-bg-hover: {{ scheme.settings.outline_hover_background | default: scheme.settings.text }};
    --c-outline-text-hover: {{ scheme.settings.outline_hover_text | default: scheme.settings.background }};
    --c-outline-border-hover: {{ scheme.settings.outline_hover_border | default: scheme.settings.text }};
    --c-link-button-text: {{ scheme.settings.link_button_text | default: scheme.settings.link | default: scheme.settings.text }};
    --c-link-button-rule: {{ scheme.settings.link_button_underline | default: scheme.settings.accent }};
    --c-link-button-text-hover: {{ scheme.settings.link_button_hover_text | default: scheme.settings.accent }};
    --c-link-button-rule-hover: {{ scheme.settings.link_button_hover_underline | default: scheme.settings.accent }};
    --c-quiet-button-text: {{ scheme.settings.quiet_button_text | default: scheme.settings.muted | default: scheme.settings.text }};
    --c-quiet-button-rule: {{ scheme.settings.quiet_button_underline | default: scheme.settings.border | default: scheme.settings.text }};
    --c-quiet-button-text-hover: {{ scheme.settings.quiet_button_hover_text | default: scheme.settings.text }};
    --c-quiet-button-rule-hover: {{ scheme.settings.quiet_button_hover_underline | default: scheme.settings.text }};
    --c-arrow-button-text: {{ scheme.settings.arrow_button_text | default: scheme.settings.text }};
    --c-arrow-button-arrow: {{ scheme.settings.arrow_button_arrow | default: scheme.settings.accent }};
    --c-arrow-button-text-hover: {{ scheme.settings.arrow_button_hover_text | default: scheme.settings.accent }};
    --c-arrow-button-arrow-hover: {{ scheme.settings.arrow_button_hover_arrow | default: scheme.settings.accent }};
    --c-arrow-outline-bg: {{ scheme.settings.arrow_outline_background | default: 'transparent' }};
    --c-arrow-outline-text: {{ scheme.settings.arrow_outline_text | default: scheme.settings.text }};
    --c-arrow-outline-border: {{ scheme.settings.arrow_outline_border | default: scheme.settings.border | default: scheme.settings.accent }};
    --c-arrow-outline-arrow: {{ scheme.settings.arrow_outline_text | default: scheme.settings.text }};
    --c-arrow-outline-bg-hover: {{ scheme.settings.arrow_outline_hover_background | default: scheme.settings.text }};
    --c-arrow-outline-text-hover: {{ scheme.settings.arrow_outline_hover_text | default: scheme.settings.background }};
    --c-arrow-outline-border-hover: {{ scheme.settings.arrow_outline_hover_border | default: scheme.settings.text }};
    --c-arrow-outline-arrow-hover: {{ scheme.settings.arrow_outline_hover_text | default: scheme.settings.background }};
    --c-link: {{ scheme.settings.link_button_text | default: scheme.settings.text }};
    --c-focus: {{ scheme.settings.focus | default: scheme.settings.accent | default: scheme.settings.text }};
    --c-selection-bg: {{ scheme.settings.focus | default: scheme.settings.accent | default: scheme.settings.text }};
    --c-selection-text: {{ scheme.settings.background }};
    --c-success: {{ scheme.settings.success | default: scheme.settings.accent }};
    --c-warning: {{ scheme.settings.accent | default: scheme.settings.text }};
    --c-error: {{ scheme.settings.error | default: scheme.settings.accent }};
    --loader-ink: {{ scheme.settings.loader | default: scheme.settings.accent }};
    --veil-tint: {{ scheme.settings.veil | default: dark.settings.background }};
    --scrollbar-thumb: {{ scheme.settings.scrollbar | default: scheme.settings.muted }};
    --scrollbar-thumb-hover: {{ scheme.settings.scrollbar_hover | default: scheme.settings.text }};
    --badge-sale-bg: {{ scheme.settings.badge_sale_background | default: scheme.settings.filled_background }};
    --badge-sale-text: {{ scheme.settings.badge_sale_text | default: scheme.settings.filled_text }};
    --badge-sold-bg: {{ scheme.settings.badge_sold_background | default: scheme.settings.muted }};
    --badge-sold-text: {{ scheme.settings.badge_sold_text | default: scheme.settings.background }};
    --badge-new-bg: {{ scheme.settings.badge_new_background | default: scheme.settings.accent }};
    --badge-new-text: {{ scheme.settings.badge_new_text | default: scheme.settings.background }};
    --badge-custom-bg: {{ scheme.settings.badge_custom_background | default: scheme.settings.surface }};
    --badge-custom-text: {{ scheme.settings.badge_custom_text | default: scheme.settings.text }};
    --gallery-bg: {{ scheme.settings.gallery_background | default: scheme.settings.surface }};

    {%- comment -%}
      Derived from the scheme's own literal colours rather than var(--c-text),
      so each scheme computes its own value instead of inheriting :root's.
    {%- endcomment -%}
    --c-hairline: color-mix(in srgb, {{ scheme.settings.text }} var(--hairline), transparent);
    --c-shadow: color-mix(in srgb, {{ scheme.settings.text }} var(--shadow-strength), transparent);
    --c-veil: color-mix(in srgb, {{ scheme.settings.text }} 6%, transparent);

  }

  .scheme-{{ scheme.id }} {
    color: var(--c-text);
    background-color: var(--c-bg);
    {%- if scheme.settings.background_gradient != blank %}
    background-image: {{ scheme.settings.background_gradient }};
    {%- endif %}
  }
  {%- endfor %}
</style>
