{%- comment -%}
  Compiles merchant settings into CSS custom properties.

  Defaults come from the reference design, but nothing here is hardcoded — the
  whole visual system is a function of config/settings_schema.json. base.css
  consumes these variables and declares no literal size, colour or breakpoint.

  Fluid formula, per step:
    slope     = (max - min) / (viewport_max - viewport_min)
    intercept = min - (slope * viewport_min)
    value     = clamp(min, intercept + slope*100vw, max)
{%- endcomment -%}

{%- comment -%}
  Five fluid scales, each a named step rather than its two or three raw
  endpoints — see scale-step.liquid. The snippet prints numbers and these
  capture-and-split them, because a snippet cannot hand a value back and
  because every one of these lands in arithmetic below.

  Each falls back to `md`, the reference design's own value, if the stored
  step is not one the snippet knows.
{%- endcomment -%}
{%- capture s_type -%}{%- render 'scale-step', scale: 'type_base', step: settings.type_base -%}{%- endcapture -%}
{%- if s_type == blank -%}{%- capture s_type -%}{%- render 'scale-step', scale: 'type_base', step: 'md' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_gut -%}{%- render 'scale-step', scale: 'gutter', step: settings.gutter -%}{%- endcapture -%}
{%- if s_gut == blank -%}{%- capture s_gut -%}{%- render 'scale-step', scale: 'gutter', step: 'md' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_space -%}{%- render 'scale-step', scale: 'space_base', step: settings.space_base -%}{%- endcapture -%}
{%- if s_space == blank -%}{%- capture s_space -%}{%- render 'scale-step', scale: 'space_base', step: 'md' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_disp -%}{%- render 'scale-step', scale: 'display', step: settings.display_size -%}{%- endcapture -%}
{%- if s_disp == blank -%}{%- capture s_disp -%}{%- render 'scale-step', scale: 'display', step: 'md' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_head -%}{%- render 'scale-step', scale: 'section_heading', step: settings.section_heading_size -%}{%- endcapture -%}
{%- if s_head == blank -%}{%- capture s_head -%}{%- render 'scale-step', scale: 'section_heading', step: 'md' -%}{%- endcapture -%}{%- endif -%}

{%- capture s_bleading -%}{%- render 'scale-step', scale: 'body_leading', step: settings.body_leading -%}{%- endcapture -%}
{%- if s_bleading == blank -%}{%- capture s_bleading -%}{%- render 'scale-step', scale: 'body_leading', step: 'md' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_dleading -%}{%- render 'scale-step', scale: 'display_leading', step: settings.display_leading -%}{%- endcapture -%}
{%- if s_dleading == blank -%}{%- capture s_dleading -%}{%- render 'scale-step', scale: 'display_leading', step: 'md' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_dtrack -%}{%- render 'scale-step', scale: 'display_tracking', step: settings.display_tracking -%}{%- endcapture -%}
{%- if s_dtrack == blank -%}{%- capture s_dtrack -%}{%- render 'scale-step', scale: 'display_tracking', step: 'md' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_hleading -%}{%- render 'scale-step', scale: 'heading_leading', step: settings.heading_leading -%}{%- endcapture -%}
{%- if s_hleading == blank -%}{%- capture s_hleading -%}{%- render 'scale-step', scale: 'heading_leading', step: 'md' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_htrack -%}{%- render 'scale-step', scale: 'heading_tracking', step: settings.heading_tracking -%}{%- endcapture -%}
{%- if s_htrack == blank -%}{%- capture s_htrack -%}{%- render 'scale-step', scale: 'heading_tracking', step: 'md' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_micro -%}{%- render 'scale-step', scale: 'micro', step: settings.micro -%}{%- endcapture -%}
{%- if s_micro == blank -%}{%- capture s_micro -%}{%- render 'scale-step', scale: 'micro', step: 'md' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_radius -%}{%- render 'scale-step', scale: 'radius_base', step: settings.radius_base -%}{%- endcapture -%}
{%- if s_radius == blank -%}{%- capture s_radius -%}{%- render 'scale-step', scale: 'radius_base', step: 'xs' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_arch -%}{%- render 'scale-step', scale: 'radius_arch', step: settings.radius_arch -%}{%- endcapture -%}
{%- if s_arch == blank -%}{%- capture s_arch -%}{%- render 'scale-step', scale: 'radius_arch', step: 'md' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_border -%}{%- render 'scale-step', scale: 'border_width', step: settings.border_width -%}{%- endcapture -%}
{%- if s_border == blank -%}{%- capture s_border -%}{%- render 'scale-step', scale: 'border_width', step: 'sm' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_hair -%}{%- render 'scale-step', scale: 'hairline_opacity', step: settings.hairline_opacity -%}{%- endcapture -%}
{%- if s_hair == blank -%}{%- capture s_hair -%}{%- render 'scale-step', scale: 'hairline_opacity', step: 'md' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_shadow -%}{%- render 'scale-step', scale: 'shadow_opacity', step: settings.shadow_opacity -%}{%- endcapture -%}
{%- if s_shadow == blank -%}{%- capture s_shadow -%}{%- render 'scale-step', scale: 'shadow_opacity', step: 'md' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_btnsize -%}{%- render 'scale-step', scale: 'button_size', step: settings.button_size -%}{%- endcapture -%}
{%- if s_btnsize == blank -%}{%- capture s_btnsize -%}{%- render 'scale-step', scale: 'button_size', step: 'md' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_btntrack -%}{%- render 'scale-step', scale: 'button_tracking', step: settings.button_tracking -%}{%- endcapture -%}
{%- if s_btntrack == blank -%}{%- capture s_btntrack -%}{%- render 'scale-step', scale: 'button_tracking', step: 'md' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_btnborder -%}{%- render 'scale-step', scale: 'button_border_width', step: settings.button_border_width -%}{%- endcapture -%}
{%- if s_btnborder == blank -%}{%- capture s_btnborder -%}{%- render 'scale-step', scale: 'button_border_width', step: 'sm' -%}{%- endcapture -%}{%- endif -%}
{%- capture s_btnradius -%}{%- render 'scale-step', scale: 'button_radius', step: settings.button_radius -%}{%- endcapture -%}
{%- if s_btnradius == blank -%}{%- capture s_btnradius -%}{%- render 'scale-step', scale: 'button_radius', step: 'pill' -%}{%- endcapture -%}{%- endif -%}

{%- liquid
  assign vw_min = 360.0
  assign vw_max = 1440.0
  assign root_px = 16.0
  assign vw_span = vw_max | minus: vw_min

  assign t = s_type | split: ','
  assign fs_min = t[0] | times: 1.0
  assign fs_max = t[1] | times: 1.0
  if fs_max < fs_min
    assign fs_max = fs_min
  endif

  assign ratio_min = settings.type_ratio_min | times: 1.0
  assign ratio_max = settings.type_ratio_max | times: 1.0

  assign sp = s_space | split: ','
  assign sp_min = sp[0] | times: 1.0
  assign sp_max = sp[1] | times: 1.0
  if sp_max < sp_min
    assign sp_max = sp_min
  endif

  assign g = s_gut | split: ','
  assign gut_min = g[0] | times: 1.0
  assign gut_max = g[1] | times: 1.0
  if gut_max < gut_min
    assign gut_max = gut_min
  endif

  assign dsp = s_disp | split: ','
  assign disp_min = dsp[0] | times: 1.0
  assign disp_grow = dsp[1] | times: 1.0
  assign disp_max = dsp[2] | times: 1.0

  assign mic = s_micro | split: ','
  assign btn = s_btnsize | split: ','

  assign shd = s_head | split: ','
  assign head_min = shd[0] | times: 1.0
  assign head_grow = shd[1] | times: 1.0
  assign head_max = shd[2] | times: 1.0

  assign fs_names = 'xs,sm,base,md,lg,xl,2xl,3xl,4xl' | split: ','
  assign sp_names = '3xs,2xs,xs,sm,md,lg,xl,2xl,3xl' | split: ','
  assign sp_mults = '0.25,0.5,0.75,1,1.5,2,3,4,6' | split: ','
-%}

<style>
  {%- if settings.use_bundled_fonts -%}
  @font-face {
    font-family: 'Italiana';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ 'italiana-400-latin.woff2' | asset_url }}) format('woff2');
  }
  @font-face {
    font-family: 'Karla';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ 'karla-400-latin.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Karla';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ 'karla-400-latin-ext.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: 'Karla';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url({{ 'karla-400-latin.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  {%- comment -%}
    Metric-matched fallbacks. size-adjust keeps the substituted face on the same
    footprint as the webfont, so swapping in does not shift the layout.
  {%- endcomment -%}
  @font-face {
    font-family: 'Italiana Fallback';
    src: local('Times New Roman'), local('Times'), local('Liberation Serif');
    size-adjust: 100.4%;
  }
  @font-face {
    font-family: 'Karla Fallback';
    src: local('Arial'), local('Helvetica'), local('Liberation Sans');
    size-adjust: 101.1%;
  }
  {%- endif -%}

  :root {
    /* ---- Fluid type scale ------------------------------------------- */
    {%- for name in fs_names -%}
      {%- liquid
        assign exp = forloop.index0 | minus: 2
        assign lo = fs_min
        assign hi = fs_max

        if exp > 0
          for i in (1..exp)
            assign lo = lo | times: ratio_min
            assign hi = hi | times: ratio_max
          endfor
        elsif exp < 0
          assign steps_down = 0 | minus: exp
          for i in (1..steps_down)
            assign lo = lo | divided_by: ratio_min
            assign hi = hi | divided_by: ratio_max
          endfor
        endif

        comment
          A larger wide-screen ratio than narrow-screen ratio inverts the
          negative steps: the mobile value ends up above the desktop one and
          clamp() collapses to a constant with a nonsense negative vw term.
          Flatten it deliberately instead of emitting that.
        endcomment
        if hi < lo
          assign hi = lo
        endif

        assign slope = hi | minus: lo | divided_by: vw_span
        assign shift = slope | times: vw_min
        assign intercept = lo | minus: shift
      -%}
    --fs-{{ name }}: clamp({{ lo | divided_by: root_px | round: 4 }}rem, {{ intercept | divided_by: root_px | round: 4 }}rem + {{ slope | times: 100 | round: 4 }}vw, {{ hi | divided_by: root_px | round: 4 }}rem);
    {%- endfor %}

    /* ---- Fluid spacing scale ---------------------------------------- */
    {%- for name in sp_names -%}
      {%- liquid
        assign mult = sp_mults[forloop.index0] | times: 1.0
        assign lo = sp_min | times: mult
        assign hi = sp_max | times: mult
        assign slope = hi | minus: lo | divided_by: vw_span
        assign shift = slope | times: vw_min
        assign intercept = lo | minus: shift
      -%}
    --space-{{ name }}: clamp({{ lo | divided_by: root_px | round: 4 }}rem, {{ intercept | divided_by: root_px | round: 4 }}rem + {{ slope | times: 100 | round: 4 }}vw, {{ hi | divided_by: root_px | round: 4 }}rem);
    {%- endfor %}

    /* ---- Display headings -------------------------------------------
       Sized directly against the viewport so the wordmark-style titles
       hold their edge-to-edge proportion at every width.                */
    --fs-display: clamp({{ disp_min | divided_by: root_px | round: 4 }}rem, {{ disp_grow | divided_by: 10.0 }}vw, {{ disp_max | divided_by: root_px | round: 4 }}rem);
    --display-leading: {{ s_dleading | times: 1.0 | divided_by: 100.0 }};
    --display-tracking: {{ s_dtrack | times: 1.0 | divided_by: 1000.0 }}em;
    --display-transform: {% if settings.display_uppercase %}uppercase{% else %}none{% endif %};

    /* Section headings — the sentence-case titles inside sections. */
    --fs-section: clamp({{ head_min | divided_by: root_px | round: 4 }}rem, {{ head_grow | divided_by: 10.0 }}vw, {{ head_max | divided_by: root_px | round: 4 }}rem);

    /* ---- Layout ------------------------------------------------------ */
    {%- liquid
      assign slope = gut_max | minus: gut_min | divided_by: vw_span
      assign shift = slope | times: vw_min
      assign intercept = gut_min | minus: shift
    -%}
    --gutter: clamp({{ gut_min | divided_by: root_px | round: 4 }}rem, {{ intercept | divided_by: root_px | round: 4 }}rem + {{ slope | times: 100 | round: 4 }}vw, {{ gut_max | divided_by: root_px | round: 4 }}rem);
    {%- comment -%}
      The gap between cards in the three product grids. One value, because the
      design uses one for Most Loved, Our Products and Our Promises alike —
      keeping them on the same token is what keeps the three reading as a set.
      Deliberately the design's own curve rather than the 360→1440 spacing
      scale, which would land half again too wide.
    {%- endcomment -%}
    --grid-gap: clamp(0.75rem, 2vw, 1.375rem);
    --page-width: {{ settings.page_width }}px;
    --page-width-narrow: {{ settings.page_width_narrow }}px;
    --content-width: {{ settings.content_width }}px;
    --grid-min: {{ settings.grid_min_column }}px;

    /* ---- Typography -------------------------------------------------- */
    {%- comment -%}
      **Five font roles.** Heading and Body are the two this theme has always
      had; Subheading, Accent and Price are new, and a shop that wants two faces
      simply points several roles at the same one — which is exactly what the
      bundled pair does.

      `--font-heading` is the canonical name and `--font-display` is kept as an
      alias, because `base.css` has said `--font-display` throughout since the
      port and renaming it across the stylesheet would be a sweep with nothing
      to show for it. The alias is not cosmetic: two blocks already asked for
      `var(--font-heading)`, which was defined nowhere — so "Heading" on a text
      block was invalid at computed-value time, the declaration was dropped, and
      the setting silently did nothing.
    {%- endcomment -%}
    {%- if settings.use_bundled_fonts -%}
    --font-heading: 'Italiana', 'Italiana Fallback', Georgia, serif;
    --font-accent: 'Italiana', 'Italiana Fallback', Georgia, serif;
    --font-body: 'Karla', 'Karla Fallback', system-ui, sans-serif;
    --font-subheading: 'Karla', 'Karla Fallback', system-ui, sans-serif;
    --font-price: 'Karla', 'Karla Fallback', system-ui, sans-serif;
    --font-body-weight: 400;
    --font-body-style: normal;
    --font-display-style: normal;
    --display-weight: 400;
    {%- else -%}
    --font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
    --font-accent: {{ settings.font_accent.family }}, {{ settings.font_accent.fallback_families }};
    --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
    --font-subheading: {{ settings.font_subheading.family }}, {{ settings.font_subheading.fallback_families }};
    --font-price: {{ settings.font_price.family }}, {{ settings.font_price.fallback_families }};
    --font-body-weight: {{ settings.font_body.weight }};
    --font-body-style: {{ settings.font_body.style }};
    --font-display-style: {{ settings.font_heading.style }};
    --display-weight: {{ settings.font_heading.weight }};
    {%- endif %}
    --font-display: var(--font-heading);

    {%- comment -%}
      **The text presets.** Seven of them — Heading 1 to 6 and Paragraph — each
      naming a font role, a rung of the type ladder, and how the letters sit.

      Every one of the four resolves to a token rather than to a literal, so
      this loop prints `var(--…)` and never a number: which faces exist is
      `--font-*` above, which sizes exist is `--type-*` in `base.css`, and the
      leading and tracking rungs are `--lead-*` and `--track-*` beside them.
      That keeps the rungs in one place and makes an unrecognised stored value
      fail loudly as an unresolved token rather than quietly as a wrong number.

      `settings['h1_size']` is how a loop reaches a setting whose id it has
      built, which is what lets seven presets share five lines instead of
      thirty-five.
    {%- endcomment -%}
    {%- assign preset_keys = 'h1,h2,h3,h4,h5,h6' | split: ',' -%}
    {%- for p in preset_keys -%}
      {%- assign k_font = p | append: '_font' -%}
      {%- assign k_size = p | append: '_size' -%}
      {%- assign k_lead = p | append: '_leading' -%}
      {%- assign k_track = p | append: '_tracking' -%}
      {%- assign k_case = p | append: '_case' -%}
      {%- assign case_value = settings[k_case] -%}
      {%- if case_value == 'default' -%}{%- assign case_value = 'none' -%}{%- endif %}
    --{{ p }}-font: var(--font-{{ settings[k_font] }});
    --{{ p }}-size: var(--type-{{ settings[k_size] }});
    --{{ p }}-leading: var(--lead-{{ settings[k_lead] }});
    --{{ p }}-tracking: var(--track-{{ settings[k_track] }});
    --{{ p }}-case: {{ case_value }};
    {%- endfor %}
    --paragraph-size: var(--type-{{ settings.paragraph_size }});
    --paragraph-leading: var(--lead-{{ settings.paragraph_leading }});
    --heading-leading: {{ s_hleading | times: 1.0 | divided_by: 100.0 }};
    --heading-tracking: {{ s_htrack | times: 1.0 | divided_by: 1000.0 }}em;
    --body-leading: {{ s_bleading | times: 1.0 | divided_by: 100.0 }};
    --micro-size: {{ mic[0] }}px;
    --micro-tracking: {{ mic[1] | times: 1.0 | divided_by: 1000.0 }}em;

    /* ---- Shape ------------------------------------------------------- */
    --radius: {{ s_radius }}px;
    --radius-sm: {{ s_radius | times: 1.0 | divided_by: 2.0 | round: 2 }}px;
    --radius-arch: clamp({{ s_arch | times: 0.55 | round: 0 }}px, 15vw, {{ s_arch }}px);
    --border-width: {{ s_border }}px;
    --hairline: {{ s_hair }}%;
    --shadow-strength: {{ s_shadow }}%;

    /* ---- Buttons ----------------------------------------------------- */
    {%- comment -%}
      Shopify caps a range at 101 steps, so the slider tops out at 50px rather
      than a literal pill value. At the maximum, emit a radius large enough to
      round any button fully — which is what the design specifies.
    {%- endcomment -%}
    --button-radius: {{ s_btnradius }}px;
    --button-padding-x: {{ btn[0] }}px;
    --button-padding-y: {{ btn[1] }}px;
    --button-size: {{ btn[2] }}px;
    --button-tracking: {{ s_btntrack | times: 1.0 | divided_by: 1000.0 }}em;
    --button-border-width: {{ s_btnborder }}px;
    --button-transform: {% if settings.button_uppercase %}uppercase{% else %}none{% endif %};


    /* ---- Cart ---------------------------------------------------------
       A cart line's photograph is framed like a card's, from the same kind
       of pair. The shape is per line (it can adapt), so it is emitted on
       the thumbnail itself; only the fit is global.                     */
    --cart-thumb-fit: {{ settings.cart_image_fit | default: 'cover' }};

    /* ---- Brand palette ------------------------------------------------
       The seven constants the design names — porcelain, ink, noir, ivory,
       champagne, deep gold — as tokens rather than as literals in base.css.

       They are NOT a seventh colour picker. Each is read out of a scheme the
       merchant already controls: the light three from the page scheme, the
       dark four from whichever scheme is nominated as the dark one. So a
       merchant who restyles a scheme restyles every surface built from it,
       and the theme still has one place each colour is defined.

       This exists because the components that most define the theme's look —
       the lookbook stage, the collection card's hover band, the menu and
       search overlays, the bag drawer's checkout button — were painted with
       hex literals, so no colour setting reached them at all. `--c-ivory` was
       already being declared twice as a component-scoped literal, which is
       the same idea arrived at by hand.

       A dark surface cannot simply use `var(--c-bg)`: it sits inside a
       section whose scheme may be light, and it is dark regardless. That is
       why these are named for the colour rather than for the role.          */
    {%- liquid
      assign light = settings.color_schemes[settings.page_scheme.id] | default: settings.color_schemes.scheme_1
      assign dark = settings.color_schemes[settings.dark_scheme.id] | default: settings.color_schemes.scheme_2
    -%}
    --c-porcelain: {{ light.settings.background | default: '#F4F0E8' }};
    --c-ink: {{ light.settings.text | default: '#191510' }};
    --c-gold: {{ light.settings.accent | default: '#9A7836' }};
    --c-noir: {{ dark.settings.background | default: '#0D0C0A' }};
    --c-noir-surface: {{ dark.settings.surface | default: '#14110D' }};
    --c-ivory: {{ dark.settings.text | default: '#EFE9DC' }};
    --c-champagne: {{ dark.settings.accent | default: '#C7A15C' }};
    {%- comment -%}
      A shade under the noir, for the veils that sit behind a dark panel. The
      design states #0B0A08 against its #0D0C0A; derived rather than stored so
      it follows the merchant's noir instead of drifting away from it.
    {%- endcomment -%}
    --c-noir-deep: color-mix(in srgb, var(--c-noir) 88%, #000);

    /* ---- Status ------------------------------------------------------
       One colour, not per-scheme: an error reads the same everywhere.   */
    --c-error: {{ settings.color_error | default: '#A2422C' }};

    /* ---- Scrollbars ---------------------------------------------------
       Settings, but deliberately NOT per-scheme. The design serves its noir
       home page and its porcelain inner pages from one file and paints the
       identical thumb on both — a warm mid grey chosen to read against
       either end. Splitting it per scheme would also split one design colour
       in two on the panels that carry a scheme class and also scroll.      */
    --scrollbar-thumb: {{ settings.scrollbar_thumb | default: '#8A8072' }};
    --scrollbar-thumb-hover: {{ settings.scrollbar_thumb_hover | default: '#6E6558' }};

    /* ---- Motion ------------------------------------------------------
       The merchant picks a named step; motion-step.liquid resolves it to a
       bare number and the unit is appended here, because --duration is read
       inside calc() and a keyword there would drop the declaration. An
       unrecognised step falls back to the design's own commonest transition
       rather than emitting `--duration: ms`.                              */
    {%- capture motion_ms -%}{%- render 'motion-step', step: settings.motion_duration -%}{%- endcapture -%}
    {%- if motion_ms == blank -%}{%- assign motion_ms = 350 -%}{%- endif -%}
    --duration: {% if settings.motion_enabled %}{{ motion_ms }}ms{% else %}0ms{% endif %};
    {%- comment -%}
      Two registers, because the design has two. Interaction — a hover, a
      focus, a colour changing — is plain `ease` in all 25 of its pages, and
      never carries a curve of its own. `--ease` is the entrance curve, spent
      on things arriving: reveals, modals, the nav morph, a carousel page.
      Handing hovers the entrance curve is what this theme did everywhere.
    {%- endcomment -%}
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --ease-ui: ease;
    {%- comment -%}
      The design's second curve, and its second-commonest overall at 54 uses:
      a long ease-out. It carries its keyframe animations and the arrow
      button's travel — anything that should leave quickly and arrive slowly.
    {%- endcomment -%}
    --ease-out: cubic-bezier(0.19, 1, 0.22, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    :root {
      --duration: 0ms;
    }
  }

  /* ---- Color schemes -------------------------------------------------
     One class per merchant-defined scheme. Sections adopt a scheme and
     everything inside inherits through the same variables.               */
  {%- for scheme in settings.color_schemes %}
  .scheme-{{ scheme.id }} {
    --c-bg: {{ scheme.settings.background }};
    --c-text: {{ scheme.settings.text }};
    --c-heading: {{ scheme.settings.heading | default: scheme.settings.text }};
    --c-muted: {{ scheme.settings.muted | default: scheme.settings.text }};
    --c-accent: {{ scheme.settings.accent | default: scheme.settings.text }};
    --c-border: {{ scheme.settings.border | default: scheme.settings.text }};
    --c-surface: {{ scheme.settings.surface | default: scheme.settings.background }};
    --c-button: {{ scheme.settings.button }};
    --c-button-label: {{ scheme.settings.button_label }};
    --c-button-hover: {{ scheme.settings.button_hover | default: scheme.settings.button }};
    --c-button-secondary-label: {{ scheme.settings.secondary_button_label | default: scheme.settings.text }};
    --c-link: {{ scheme.settings.link | default: scheme.settings.text }};

    {%- comment -%}
      Derived from the scheme's own literal colours rather than var(--c-text),
      so each scheme computes its own value instead of inheriting :root's.
    {%- endcomment -%}
    --c-hairline: color-mix(in srgb, {{ scheme.settings.text }} var(--hairline), transparent);
    --c-shadow: color-mix(in srgb, {{ scheme.settings.text }} var(--shadow-strength), transparent);
    --c-veil: color-mix(in srgb, {{ scheme.settings.text }} 6%, transparent);

    color: var(--c-text);
    background-color: var(--c-bg);
    {%- if scheme.settings.background_gradient != blank %}
    background-image: {{ scheme.settings.background_gradient }};
    {%- endif %}
  }
  {%- endfor %}
</style>
