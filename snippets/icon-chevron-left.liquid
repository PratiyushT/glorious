{%- assign icon_width = width | default: 10 -%}
{%- assign icon_height = height | default: 20 -%}
{%- assign icon_stroke = stroke_width | default: 1.4 -%}
<svg class="icon-svg{% if class != blank %} {{ class }}{% endif %}" width="{{ icon_width }}" height="{{ icon_height }}" viewBox="0 0 12 24" fill="none" stroke="currentColor" stroke-width="{{ icon_stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 2L2 12l8 10" /></svg>
