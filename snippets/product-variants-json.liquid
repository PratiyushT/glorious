{%- comment -%}
  One serialized variant contract for every full product-information surface.
  Money remains formatted by Liquid; main-product.js only synchronizes the
  already-authoritative strings and native variant ids.
{%- endcomment -%}

<script type="application/json" data-product-variants>
  [
    {%- for variant in product.variants -%}
      {%- capture unit_price -%}
        {%- if variant.unit_price_measurement -%}
          {{ variant.unit_price | money }} / {%- if variant.unit_price_measurement.reference_value != 1 -%}{{ variant.unit_price_measurement.reference_value }}{%- endif -%}{{ variant.unit_price_measurement.reference_unit }}
        {%- endif -%}
      {%- endcapture -%}
      {
        "id": {{ variant.id | json }},
        "available": {{ variant.available | json }},
        "options": {{ variant.options | json }},
        "price": {{ variant.price | money | json }},
        "compareAtPrice": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}""{% endif %},
        "unitPrice": {{ unit_price | strip | json }},
        "sku": {{ variant.sku | json }},
        "featuredMediaId": {{ variant.featured_media.id | json }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
</script>
