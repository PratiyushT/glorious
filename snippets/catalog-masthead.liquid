{%- comment -%}
  Shared collection/search masthead. The owning section supplies Shopify data
  and the same set of layout settings, so the reference typography can remain
  the default without making every catalogue page use one fixed composition.

  Accepts:
    section       owning collection or search section
    title         optional heading
    eyebrow       optional micro heading
    description   optional rich text/html
    media         optional Shopify image object
    body           optional captured markup, used by the search form
{%- endcomment -%}

{%- liquid
  assign layout = section.settings.header_layout | default: 'reference'
  assign has_media = false
  if media != blank and layout != 'reference'
    assign has_media = true
  endif
  assign motion = section.settings.header_motion | default: 'reference'
-%}

<header
  class="catalog-masthead catalog-masthead--{{ layout }} catalog-masthead--{{ section.settings.header_height | default: 'reference' }} catalog-masthead--align-{{ section.settings.header_alignment | default: 'left' }} catalog-masthead--media-{{ section.settings.header_media_position | default: 'end' }} catalog-masthead--overlay-{{ section.settings.header_overlay | default: 'medium' }} catalog-masthead--motion-{{ motion }} scheme-{{ section.settings.header_color_scheme | default: section.settings.color_scheme }}{% if has_media %} has-media{% endif %}"
  data-catalog-masthead
>
  {%- if has_media and layout == 'overlay' -%}
    <div class="catalog-masthead__media catalog-masthead__media--background" aria-hidden="true">
      {{ media | image_url: width: 2400 | image_tag: widths: '480, 750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'catalog-masthead__image', style: 'object-fit: var(--catalog-header-image-fit);' }}
    </div>
  {%- endif -%}

  <div class="catalog-shell catalog-masthead__shell">
    <div class="catalog-masthead__inner">
      {%- if has_media and layout != 'overlay' -%}
        <div class="catalog-masthead__media">
          {{ media | image_url: width: 1800 | image_tag: widths: '360, 540, 750, 1000, 1400, 1800', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high', class: 'catalog-masthead__image', style: 'object-fit: var(--catalog-header-image-fit);' }}
        </div>
      {%- endif -%}

      <div class="catalog-masthead__content">
        {%- if title != blank -%}
          <h1
            class="catalog-masthead__title catalog-masthead__title--{{ section.settings.header_title_size | default: 'reference' }}"
            {% if motion == 'reference' %}data-catalog-title data-catalog-title-text="{{ title | escape }}"{% endif %}
          >{{ title }}</h1>
        {%- endif -%}

        {%- if eyebrow != blank or description != blank -%}
          <div class="catalog-masthead__meta">
            {%- if eyebrow != blank -%}
              <span class="catalog-kicker">{{ eyebrow }}</span>
            {%- endif -%}
            {%- if description != blank -%}
              <div class="catalog-masthead__description rte">{{ description }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {{ body }}
      </div>
    </div>
  </div>
</header>
