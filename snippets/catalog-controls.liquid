{%- comment -%}
  Shared collection/search navigation, filter trigger, sort control, and filter
  drawer. Shopify remains authoritative for every facet and sort option.

  Accepts: results, section_id, section, context, form_action, clear_url,
  sort_by, quick_source, quick_filter, quick_links_limit, quick_button_style,
  show_filters, show_sort, search_terms, search_types, include_drawer.
{%- endcomment -%}

{%- liquid
  assign active_filter_count = 0
  for filter in results.filters
    assign active_filter_count = active_filter_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign active_filter_count = active_filter_count | plus: 1
      endif
    endif
  endfor

  assign current_sort = sort_by | default: results.default_sort_by
  assign drawer_name = 'catalog-filters-' | append: section_id
  assign quick_links_limit_number = quick_links_limit | default: 6 | plus: 0
  assign all_filter_label = 'collections.all' | t

  comment
    One word for the whole catalog control system — Theme settings → Catalog.
    The last-resort fallback routes through the locale file rather than a
    literal, so a blank setting still translates.
  endcomment
  assign filter_word_fallback = 'collections.filters.label' | t
  assign filter_word = settings.catalog_filter_word | default: filter_word_fallback

  comment
    Collections the shop hides from automatic enumeration — merchandising
    groupings rather than browsing destinations. `contains` cannot compare
    drops, so the list is projected to handles first.
  endcomment
  assign hidden_handles = settings.hidden_collections | map: 'handle'
  assign sort_in_bar = false
  if show_sort and section.settings.sort_placement != 'drawer'
    assign sort_in_bar = true
  endif
-%}

<div
  class="catalog-controls catalog-controls--{{ section.settings.controls_layout | default: 'spread' }} catalog-controls--style-{{ section.settings.controls_style | default: 'pills' }} catalog-controls--mobile-{{ section.settings.mobile_controls_layout | default: 'stacked' }}"
  data-catalog-controls
>
  {%- if quick_source != 'none' -%}
    <div class="catalog-controls__rail" data-catalog-rail>
      {%- if quick_source == 'collections' -%}
        {%- liquid
          assign all_collection_is_active = false
          if context == 'collection' and results.handle == 'all'
            assign all_collection_is_active = true
          endif
        -%}
        {%- if quick_button_style != blank -%}
          {% render 'catalog-filter-button', label: all_filter_label, link: routes.all_products_collection_url, style: quick_button_style, active: all_collection_is_active, collection_link: true %}
        {%- else -%}
          <a class="catalog-pill{% if context == 'collection' and results.handle == 'all' %} is-active{% endif %}" href="{{ routes.all_products_collection_url }}" data-catalog-link data-catalog-collection-link>{{ all_filter_label }}</a>
        {%- endif -%}

        {%- assign rendered_links = 0 -%}
        {%- for quick_collection in collections -%}
          {%- unless quick_collection.handle == 'all' or hidden_handles contains quick_collection.handle -%}
            {%- if rendered_links < quick_links_limit_number -%}
              {%- assign quick_collection_is_active = false -%}
              {%- if context == 'collection' and quick_collection.handle == results.handle -%}
                {%- assign quick_collection_is_active = true -%}
              {%- endif -%}
              {%- if quick_button_style != blank -%}
                {% render 'catalog-filter-button', label: quick_collection.title, link: quick_collection.url, style: quick_button_style, active: quick_collection_is_active, collection_link: true %}
              {%- else -%}
                <a class="catalog-pill{% if context == 'collection' and quick_collection.handle == results.handle %} is-active{% endif %}" href="{{ quick_collection.url }}" data-catalog-link data-catalog-collection-link>{{ quick_collection.title }}</a>
              {%- endif -%}
              {%- assign rendered_links = rendered_links | plus: 1 -%}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      {%- elsif quick_source == 'filter' and quick_filter != blank -%}
        {%- assign all_filter_is_active = false -%}
        {%- if quick_filter.active_values.size == 0 -%}
          {%- assign all_filter_is_active = true -%}
        {%- endif -%}
        {%- if quick_button_style != blank -%}
          {% render 'catalog-filter-button', label: all_filter_label, link: clear_url, style: quick_button_style, active: all_filter_is_active, clear_param: quick_filter.param_name %}
        {%- else -%}
          <a class="catalog-pill{% if quick_filter.active_values.size == 0 %} is-active{% endif %}" href="{{ clear_url }}" data-catalog-link data-catalog-clear-param="{{ quick_filter.param_name | escape }}">{{ all_filter_label }}</a>
        {%- endif -%}

        {%- for value in quick_filter.values -%}
          {%- liquid
            assign value_link = value.url_to_add
            if value.active
              assign value_link = value.url_to_remove
            endif
            assign value_disabled = false
            if value.count == 0 and value.active == false
              assign value_disabled = true
            endif
          -%}
          {%- if quick_button_style != blank -%}
            {%- capture value_button_label -%}{{ value.label }}<span class="visually-hidden"> ({{ value.count }})</span>{%- endcapture -%}
            {% render 'catalog-filter-button', label: value_button_label, link: value_link, style: quick_button_style, active: value.active, disabled: value_disabled %}
          {%- else -%}
            <a class="catalog-pill{% if value.active %} is-active{% endif %}{% if value_disabled %} is-disabled{% endif %}" href="{{ value_link }}" data-catalog-link {% if value_disabled %}aria-disabled="true"{% endif %}>
              {{- value.label -}}<span class="visually-hidden"> ({{ value.count }})</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="catalog-controls__actions">
    {%- if show_filters and results.filters.size > 0 -%}
      <button class="catalog-control-button" type="button" data-overlay-open="{{ drawer_name }}" aria-haspopup="dialog" aria-controls="CatalogFilters-{{ section_id }}" aria-expanded="false">
        {{- filter_word -}}
        {%- if active_filter_count > 0 -%}<span class="catalog-control-button__count">{{ active_filter_count }}</span>{%- endif -%}
      </button>
    {%- endif -%}

    {%- if sort_in_bar and results.sort_options.size > 0 -%}
      {% render 'catalog-sort', results: results, current_sort: current_sort, form_action: form_action, context: context, search_terms: search_terms, search_types: search_types, section: section, placement: 'bar' %}
    {%- endif -%}
  </div>
</div>

{%- if show_filters and results.filters.size > 0 and include_drawer != false -%}
  <div id="CatalogFilters-{{ section_id }}">
    {% render 'catalog-filter-drawer', results: results, section: section, context: context, form_action: form_action, clear_url: clear_url, current_sort: current_sort, search_terms: search_terms, search_types: search_types, drawer_name: drawer_name %}
  </div>
{%- endif -%}
