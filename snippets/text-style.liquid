{%- comment -%}
  Resolves one typography preset and its optional block-level overrides into
  inline declarations. Inline output deliberately wins over a component's
  fallback class without creating a stylesheet-order contract.

  Accepts:
    preset         - title, heading_1…heading_5, subheading, paragraph, small,
                     or caption. `style` is accepted as a legacy alias.
    font_style     - inherit, accent, body, subheading, or heading.
    font_size      - inherit, 3xs…8xl.
    color          - a colour, or blank to inherit.
    line_height    - inherit, tight, snug, normal, relaxed, or loose.
    text_case      - inherit, default (as typed), uppercase, lowercase, or
                     capitalize.
    letter_spacing - inherit, tighter, tight, normal, wide, or wider.

  Every value is guarded. A stale or unknown stored value is ignored rather
  than producing an unresolved custom property.
{%- endcomment -%}

{%- liquid
  assign resolved_preset = preset | default: style

  comment
    Preserve blocks saved under the previous seven-style system. The schema
    now writes only the ten current values; this mapping is read compatibility.
  endcomment
  case resolved_preset
    when 'display'
      assign resolved_preset = 'title'
    when 'subtitle'
      assign resolved_preset = 'subheading'
    when 'lead', 'body'
      assign resolved_preset = 'paragraph'
  endcase

  assign known_presets = 'title,heading_1,heading_2,heading_3,heading_4,heading_5,subheading,paragraph,small,caption' | split: ','
  assign known_fonts = 'accent,body,subheading,heading' | split: ','
  assign known_sizes = '3xs,2xs,xs,sm,md,lg,xl,2xl,3xl,4xl,5xl,6xl,7xl,8xl' | split: ','
  assign known_leading = 'tight,snug,normal,relaxed,loose' | split: ','
  assign known_tracking = 'tighter,tight,normal,wide,wider' | split: ','
  assign known_case = 'default,uppercase,lowercase,capitalize' | split: ','
  assign out = ''

  if known_presets contains resolved_preset
    assign out = out | append: 'font-family:var(--text-' | append: resolved_preset | append: '-font);'
    assign out = out | append: 'font-weight:var(--text-' | append: resolved_preset | append: '-weight);'
    assign out = out | append: 'font-style:var(--text-' | append: resolved_preset | append: '-style);'
    assign out = out | append: 'font-size:var(--text-' | append: resolved_preset | append: '-size);'
    assign out = out | append: 'line-height:var(--text-' | append: resolved_preset | append: '-leading);'
    assign out = out | append: 'letter-spacing:var(--text-' | append: resolved_preset | append: '-tracking);'
    assign out = out | append: 'text-transform:var(--text-' | append: resolved_preset | append: '-case);'
  endif

  if known_fonts contains font_style
    assign out = out | append: 'font-family:var(--font-' | append: font_style | append: ');'
    assign out = out | append: 'font-weight:var(--font-' | append: font_style | append: '-weight);'
    assign out = out | append: 'font-style:var(--font-' | append: font_style | append: '-style);'
  endif

  if known_sizes contains font_size
    assign out = out | append: 'font-size:var(--type-' | append: font_size | append: ');'
  endif

  if color != blank
    assign out = out | append: 'color:' | append: color | append: ';'
  endif

  if known_leading contains line_height
    assign out = out | append: 'line-height:var(--lead-' | append: line_height | append: ');'
  endif

  if known_case contains text_case
    if text_case == 'default'
      assign out = out | append: 'text-transform:none;'
    else
      assign out = out | append: 'text-transform:' | append: text_case | append: ';'
    endif
  endif

  if known_tracking contains letter_spacing
    assign out = out | append: 'letter-spacing:var(--track-' | append: letter_spacing | append: ');'
  endif
-%}
{{- out -}}
