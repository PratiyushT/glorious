{% doc %}
  Renders one SVG from the theme's centralized icon library.

  Every SVG implementation lives beside this dispatcher as icon-*.liquid
  because Shopify themes do not support a snippets/icons subdirectory.

  @param {string} icon - Icon name.
  @param {string} [uid] - Unique token required by icons that declare SVG ids.
  @param {string} [class] - Extra class passed to the SVG.
  @param {string} [width] - Optional rendered width.
  @param {string} [height] - Optional rendered height.
  @param {number} [stroke_width] - Optional stroke width for gallery chevrons.

  @example
  {% render 'icon', icon: 'cart' %}
{% enddoc %}

{%- case icon -%}
  {%- when 'menu' -%}{% render 'icon-menu', class: class, width: width, height: height %}
  {%- when 'close' -%}{% render 'icon-close', class: class, width: width, height: height %}
  {%- when 'search' -%}{% render 'icon-search', class: class, width: width, height: height %}
  {%- when 'cart' -%}{% render 'icon-cart', class: class, width: width, height: height %}
  {%- when 'account' -%}{% render 'icon-account', class: class, width: width, height: height %}
  {%- when 'arrow-left' -%}{% render 'icon-arrow-left', class: class, width: width, height: height %}
  {%- when 'arrow-right' -%}{% render 'icon-arrow-right', class: class, width: width, height: height %}
  {%- when 'chevron-left' -%}{% render 'icon-chevron-left', class: class, width: width, height: height, stroke_width: stroke_width %}
  {%- when 'chevron-right' -%}{% render 'icon-chevron-right', class: class, width: width, height: height, stroke_width: stroke_width %}
  {%- when 'chevron-down' -%}{% render 'icon-chevron-down', class: class, width: width, height: height %}
  {%- when 'nav-account' -%}{% render 'icon-nav-account', class: class %}
