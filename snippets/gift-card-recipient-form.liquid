{%- liquid
  assign recipient_open = false
  if form.email != blank or form.name != blank or form.message != blank or form.send_on != blank or form.errors
    assign recipient_open = true
  endif
  assign recipient_error_id = 'Recipient-errors-' | append: section_id
-%}

<div class="gift-recipient">
  <label class="gift-recipient__toggle" for="Recipient-toggle-{{ section_id }}">
    <input
      id="Recipient-toggle-{{ section_id }}"
      type="checkbox"
      name="properties[__shopify_send_gift_card_to_recipient]"
      value="if_present"
      data-recipient-toggle
      aria-controls="Recipient-fields-{{ section_id }}"
      {% if recipient_open %}checked{% endif %}
    >
    <span>{{ 'products.recipient.checkbox' | t }}</span>
  </label>

  {%- if form.errors -%}
    <div id="{{ recipient_error_id }}" class="gift-recipient__errors" role="alert">
      {{ form.errors | default_errors }}
    </div>
  {%- endif -%}

  <div id="Recipient-fields-{{ section_id }}" class="gift-recipient__fields" data-recipient-fields {% unless recipient_open %}hidden{% endunless %}>
    <label for="Recipient-email-{{ section_id }}">{{ 'products.recipient.email' | t }}</label>
    <input
      class="field"
      id="Recipient-email-{{ section_id }}"
      type="email"
      name="properties[Recipient email]"
      value="{{ form.email }}"
      autocomplete="email"
      maxlength="255"
      data-recipient-email
      {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="{{ recipient_error_id }}"{% endif %}
    >

    <label for="Recipient-name-{{ section_id }}">{{ 'products.recipient.name' | t }}</label>
    <input
      class="field"
      id="Recipient-name-{{ section_id }}"
      type="text"
      name="properties[Recipient name]"
      value="{{ form.name }}"
      autocomplete="name"
      maxlength="255"
      {% if form.errors contains 'name' %}aria-invalid="true" aria-describedby="{{ recipient_error_id }}"{% endif %}
    >

    <label for="Recipient-message-{{ section_id }}">{{ 'products.recipient.message' | t }}</label>
    <textarea
      class="field"
      id="Recipient-message-{{ section_id }}"
      name="properties[Message]"
      maxlength="200"
      {% if form.errors contains 'message' %}aria-invalid="true" aria-describedby="{{ recipient_error_id }}"{% endif %}
    >{{ form.message }}</textarea>

    <label for="Recipient-send-on-{{ section_id }}">{{ 'products.recipient.send_on' | t }}</label>
    <input
      class="field"
      id="Recipient-send-on-{{ section_id }}"
      type="date"
      name="properties[Send on]"
      value="{{ form.send_on }}"
      autocomplete="send_on"
      pattern="\d{4}-\d{2}-\d{2}"
      {% if form.errors contains 'send_on' %}aria-invalid="true" aria-describedby="{{ recipient_error_id }}"{% endif %}
    >

    <input type="hidden" name="properties[__shopify_offset]" value="" data-recipient-offset>
  </div>
</div>
