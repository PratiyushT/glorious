{%- comment -%}
  Search, in the shop's chosen presentation — Theme settings → Search.

  `menu` is the full-screen noir room. `drawer` is the cart drawer's shell to
  the letter: the same `drawer` root, veil, sliding `drawer__panel` with a
  merchant scheme, and `drawer__head` with the title and the close pill — a
  visitor should read it as the same furniture as the bag. The search markup
  inside is one capture shared by both modes, so the field, the popular terms,
  the resting state, and every `data-search-*` hook cannot drift between them,
  and `theme.js` needs no mode awareness at all.

  A real GET form to the search route, so it works with JavaScript switched off
  and submitting always lands on the search page. With JavaScript on, typing
  fetches sections/predictive-search.liquid and swaps the rendered rows in;
  the form is never the thing that renders results.

  The resting state — the design's "Browse" and "Featured pieces" — is rendered
  server-side, so opening shows something immediately rather than waiting on a
  request.

  Accepts:
    section            - the header section, for its blocks and settings.
    overlay_huge_text  - Header's Huge Text block markup.
    mode               - 'menu' or 'drawer'.
{%- endcomment -%}

{%- liquid
  assign cat_blocks = section.blocks | where: 'type', 'category'
  assign featured = section.settings.search_collection
  assign popular = section.settings.search_popular | split: ','
-%}

{%- capture search_body -%}
      <div class="search-overlay__top" style="--row: 1;">
        <form
          class="search-overlay__form"
          action="{{ routes.search_url }}"
          method="get"
          role="search"
          data-search-form
        >
          <input type="hidden" name="options[prefix]" value="last">
          <label class="visually-hidden" for="search-overlay-input">
            {{ 'general.search.search' | t }}
          </label>
          <input
            class="search-overlay__field"
            id="search-overlay-input"
            type="search"
            name="q"
            placeholder="{{ 'general.search.overlay_placeholder' | t }}"
            autocomplete="off"
            spellcheck="false"
            data-search-input
          >

          {%- comment -%}
            The wait sits in the field rather than in the results, so nothing a
            visitor is already reading moves while the next query flies. It is
            hidden until there is a query in flight — see `initSearch`.
          {%- endcomment -%}
          {%- assign search_loading = 'general.search.loading' | t -%}
          <span class="search-overlay__wait" data-search-loading hidden>
            {% render 'loader', label: search_loading, size: 'sm' %}
          </span>
        </form>

        <div class="search-overlay__meta">
          {%- if popular.size > 0 -%}
            <div class="search-overlay__popular" data-search-popular>
              <span class="search-overlay__popular-label">
                {{ 'general.search.popular' | t }}
              </span>
              {%- for term in popular -%}
                {%- assign trimmed = term | strip -%}
                {%- if trimmed != blank -%}
                  <button class="search-overlay__term" type="button" data-search-term="{{ trimmed | escape }}">
                    {{ trimmed }}
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          <span class="search-overlay__count" data-search-count hidden></span>

          <span class="search-overlay__hint">{{ 'general.search.keyboard_hint' | t }}</span>
        </div>
      </div>

      {%- comment -%}
        A plain region of links, not a combobox listbox: every row has to stay
        a real link so it works without scripting, and arrow-key selection is
        announced with aria-current rather than a listbox role the markup
        could not honestly support.
      {%- endcomment -%}
      <div
        class="search-overlay__results"
        id="search-overlay-results"
        style="--row: 2;"
        aria-live="polite"
        aria-label="{{ 'general.search.results_label' | t }}"
        data-search-scroller
      >
        {%- comment -%} The resting state: shown until a query returns rows. {%- endcomment -%}
        <div class="search-results" data-search-resting>
          {%- if cat_blocks.size > 0 -%}
            <div class="search-group">
              <div class="search-group__label">{{ 'general.search.group_browse' | t }}</div>
              {%- assign label_collection = 'general.search.kind_collection' | t -%}
              {%- for block in cat_blocks -%}
                {%- if block.settings.label != blank -%}
                  {%- liquid
                    assign row_url = block.settings.url | default: routes.all_products_collection_url
                    assign row_title = block.settings.label | escape
                  -%}
                  {% render 'search-row',
                    url: row_url,
                    title: row_title,
                    meta: label_collection
                  %}
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if featured != blank and featured.products.size > 0 -%}
            <div class="search-group">
              <div class="search-group__label">{{ 'general.search.group_featured' | t }}</div>
              {%- for product in featured.products limit: 8 -%}
                {%- liquid
                  assign kind = product.type | default: product.vendor
                  if product.price_varies
                    assign price_from = product.price_min | money
                    assign price_label = 'products.from_price' | t: price: price_from
                  elsif product.compare_at_price > product.price
                    capture price_label
                      if settings.price_compare_position == 'after'
                        echo product.price | money
                        echo ' <s>'
                        echo product.compare_at_price | money
                        echo '</s>'
                      else
                        echo '<s>'
                        echo product.compare_at_price | money
                        echo '</s> '
                        echo product.price | money
                      endif
                    endcapture
                  else
                    assign price_label = product.price | money
                  endif
                  if kind != blank
                    assign row_meta = kind | append: ' · ' | append: price_label
                  else
                    assign row_meta = price_label
                  endif
                  assign row_title = product.title | escape
                -%}
                {% render 'search-row',
                  url: product.url,
                  title: row_title,
                  meta: row_meta,
                  image: product.featured_media
                %}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} Live predictive results land here. {%- endcomment -%}
        <div data-search-live hidden></div>
      </div>
{%- endcapture -%}

{%- if mode == 'drawer' -%}
  <div
    class="drawer search-drawer"
    data-overlay="search"
    data-overlay-modal
    data-color-scheme="{{ settings.search_drawer_color_scheme | default: 'scheme_1' }}"
    hidden
  >
    <div class="overlay__veil" data-overlay-close="search"></div>

    <aside
      class="drawer__panel scheme-{{ settings.search_drawer_color_scheme | default: 'scheme_1' }}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'general.search.search' | t }}"
    >
      <div class="drawer__inner">
        <header class="drawer__head">
          <span class="drawer__title">{{ 'general.search.search' | t }}</span>
          {%- capture close_attributes -%}data-overlay-close="search"{%- endcapture -%}
          {% render 'overlay-close', class: 'drawer__close', attributes: close_attributes %}
        </header>
        {{ search_body }}
      </div>
    </aside>
  </div>
{%- else -%}
  <div
    class="search-overlay search-overlay--menu"
    data-overlay="search"
    data-overlay-modal
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'general.search.search' | t }}"
    hidden
  >
    <div class="search-overlay__panel">
      {% render 'overlay-head', close_action: 'search', row: 0, huge_text: overlay_huge_text %}

      <div class="search-overlay__body">
        <div class="search-overlay__inner">
          {{ search_body }}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}
