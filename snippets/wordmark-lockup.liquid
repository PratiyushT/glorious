{%- comment -%}
  Inline wordmark — the brand letters on one line. Used in the nav bar, the
  nav pill and the menu overlay header.

  Letters only. There is no emblem and no letter substitution: a mark standing
  in for a letter of the merchant's own wordmark was removed outright rather
  than left as a latent branch, and the theme owns no monogram.

  Accepts:
    source  - the Huge Text value.
    size    - 'sm' (nav), 'md' (default), 'lg' (menu overlay).
{%- endcomment -%}

{%- liquid
  assign source = source | strip | upcase
  assign letters = source | split: ''
  assign scale = size | default: 'md'
-%}

<span class="lockup lockup--{{ scale }}" role="img" aria-label="{{ source }}">
  {%- for letter in letters -%}
    <span class="lockup__letter" aria-hidden="true">{{ letter }}</span>
  {%- endfor -%}
</span>
