{%- comment -%}
  The navigation menu, in the shop's chosen presentation.

  Theme settings → Navigation picks the shell, exactly as Search does: the
  design's full-screen noir overlay (the default), or the cart drawer's shell
  sliding from the start edge. One capture holds the rows, categories, and
  foot, so the two presentations cannot drift.

  Rows are numbered continuously across links and the two action rows, matching
  the design, and the numbering is generated from block order so adding or
  removing an item renumbers the set.

  Each row carries its rank as --row, and the container carries the total as
  --rows. That pair is what lets the close animation run the design's reverse
  cascade — the last row leaves first — without hardcoding a row count. The
  drawer shell declares its own smaller step and lead, so the same markup
  cascades at panel scale.

  A row with children is the theme's shared disclosure — the footer's
  three-layer 0fr/1fr panel and plus/minus mark, dressed in the menu's own
  type, indent, and champagne hairline. Grandchildren render flat inside their
  child's group rather than as a third disclosure level: one fold is a menu,
  two is a tree. Without JavaScript every panel stands open and the toggle is
  inert, so no link is ever unreachable.

  Rendered inert (hidden, not focusable) until opened, so the links never
  appear in the tab order behind the page.

  Accepts:
    section, menu_id, cart_number, search_number, cart_drawer,
    search_overlay, overlay_huge_text, mode
{%- endcomment -%}

{%- liquid
  assign cart_name = settings.cart_name | default: 'Cart'
  assign cat_blocks = section.blocks | where: 'type', 'category'
  assign menu_blocks = section.blocks | where: 'type', 'menu'
  assign menu_block = menu_blocks.first
  assign menu_links = menu_block.settings.menu.links
  assign social_blocks = section.blocks | where: 'type', 'social'
  assign social = social_blocks.first
  assign has_social_links = false
  if social != blank
    if social.settings.instagram != blank or social.settings.facebook != blank or social.settings.pinterest != blank or social.settings.tiktok != blank or social.settings.youtube != blank or social.settings.x != blank
      assign has_social_links = true
    endif
  endif

  comment
    One rank past the last numbered row: the design animates the category
    shortcuts and the footer together, after everything else.
  endcomment
  assign tail_row = menu_links.size
  if cart_number > tail_row
    assign tail_row = cart_number
  endif
  if search_number > tail_row
    assign tail_row = search_number
  endif
  assign total_rows = tail_row | plus: 1
-%}

{%- capture menu_inner -%}
  <div class="nav-menu__body">
    <ul class="nav-menu__list" data-nav-branches>
      {%- for link in menu_links -%}
        {%- assign row_number = forloop.index -%}
        <li class="nav-menu__item" style="--row: {{ row_number | minus: 1 }};" {{ menu_block.shopify_attributes }}>
          {%- if link.links.size > 0 -%}
            {%- assign branch_id = menu_id | append: '-branch-' | append: row_number -%}
            <div class="nav-menu__branch" data-nav-branch>
              <button
                class="nav-menu__link nav-menu__branch-toggle disclosure__toggle"
                type="button"
                data-nav-branch-toggle
                aria-controls="{{ branch_id }}"
                aria-expanded="false"
              >
                <span class="nav-menu__num" aria-hidden="true">{{ row_number | prepend: '0' | slice: -2, 2 }}</span>
                <span>{{ link.title }}</span>
                <span class="nav-menu__branch-mark disclosure__mark" aria-hidden="true">
                  <span class="disclosure__plus">{% render 'icon', icon: 'plus' %}</span>
                  <span class="disclosure__minus">{% render 'icon', icon: 'minus' %}</span>
                </span>
              </button>
              <div class="disclosure__panel" id="{{ branch_id }}">
                <div class="disclosure__clip">
                  <div class="nav-menu__submenu">
                    <a href="{{ link.url }}">{{ 'navigation.view_all' | t: title: link.title }}</a>
                    {%- for child_link in link.links -%}
                      {%- if child_link.links.size > 0 -%}
                        <div class="nav-menu__subgroup">
                          <a href="{{ child_link.url }}">{{ child_link.title }}</a>
                          <div class="nav-menu__subgroup-links">
                            {%- for grandchild_link in child_link.links -%}<a href="{{ grandchild_link.url }}">{{ grandchild_link.title }}</a>{%- endfor -%}
                          </div>
                        </div>
                      {%- else -%}
                        <a href="{{ child_link.url }}">{{ child_link.title }}</a>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>
              </div>
            </div>
          {%- else -%}
            <a class="nav-menu__link" href="{{ link.url }}">
              <span class="nav-menu__num" aria-hidden="true">{{ row_number | prepend: '0' | slice: -2, 2 }}</span>
              {{ link.title }}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}

      {%- comment -%}
        Both action rows stay real links to real pages. With the drawer or the
        overlay switched on, theme.js intercepts the click and opens it in
        place instead — so the row still goes somewhere useful when scripting
        is unavailable.
      {%- endcomment -%}
      {%- if cart_number > 0 -%}
        <li class="nav-menu__item" style="--row: {{ cart_number | minus: 1 }};">
          <a
            class="nav-menu__link"
            href="{{ routes.cart_url }}"
            {% if cart_drawer %}data-drawer-open data-from-menu{% endif %}
          >
            <span class="nav-menu__num" aria-hidden="true">
              {{ cart_number | prepend: '0' | slice: -2, 2 }}
            </span>
            {{ 'navigation.your_cart' | t: cart_name: cart_name }}
            <span class="nav-menu__aside">
              {%- if cart.item_count > 0 -%}
                {{ 'navigation.cart_count' | t: count: cart.item_count }}
              {%- else -%}
                {{ 'navigation.cart_empty' | t }}
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endif -%}

      {%- if search_number > 0 -%}
        <li class="nav-menu__item" style="--row: {{ search_number | minus: 1 }};">
          <a
            class="nav-menu__link"
            href="{{ routes.search_url }}"
            {% if search_overlay %}data-search-open data-from-menu{% endif %}
          >
            <span class="nav-menu__num" aria-hidden="true">
              {{ search_number | prepend: '0' | slice: -2, 2 }}
            </span>
            {{ 'general.search.search' | t }}
          </a>
        </li>
      {%- endif -%}
    </ul>

    {%- if cat_blocks.size > 0 -%}
      <div class="nav-menu__categories" style="--row: {{ tail_row }};">
        {%- for block in cat_blocks -%}
          {%- if block.settings.label != blank -%}
            <a
              class="nav-menu__category"
              href="{{ block.settings.url | default: routes.all_products_collection_url }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label }}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="nav-menu__foot" style="--row: {{ tail_row }};">
    {%- if has_social_links -%}
      <div class="nav-menu__social">
        {%- if social.settings.instagram != blank -%}
          <a href="{{ social.settings.instagram }}" target="_blank" rel="noopener">{% render 'icon', icon: 'instagram', width: 16, height: 16 %}<span>Instagram</span></a>
        {%- endif -%}
        {%- if social.settings.facebook != blank -%}
          <a href="{{ social.settings.facebook }}" target="_blank" rel="noopener">{% render 'icon', icon: 'facebook', width: 16, height: 16 %}<span>Facebook</span></a>
        {%- endif -%}
        {%- if social.settings.pinterest != blank -%}
          <a href="{{ social.settings.pinterest }}" target="_blank" rel="noopener">{% render 'icon', icon: 'pinterest', width: 16, height: 16 %}<span>Pinterest</span></a>
        {%- endif -%}
        {%- if social.settings.tiktok != blank -%}
          <a href="{{ social.settings.tiktok }}" target="_blank" rel="noopener">{% render 'icon', icon: 'tiktok', width: 16, height: 16 %}<span>TikTok</span></a>
        {%- endif -%}
        {%- if social.settings.youtube != blank -%}
          <a href="{{ social.settings.youtube }}" target="_blank" rel="noopener">{% render 'icon', icon: 'youtube', width: 16, height: 16 %}<span>YouTube</span></a>
        {%- endif -%}
        {%- if social.settings.x != blank -%}
          <a href="{{ social.settings.x }}" target="_blank" rel="noopener">{% render 'icon', icon: 'x', width: 16, height: 16 %}<span>X</span></a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      The shop's address, from the theme settings rather than the header's —
      the footer and the Visit section state the same one.
    {%- endcomment -%}
    {%- if settings.shop_address != blank -%}
      {%- if settings.shop_address_link != blank -%}
        <a
          class="nav-menu__address"
          href="{{ settings.shop_address_link }}"
          target="_blank"
          rel="noopener"
        >
          {{ settings.shop_address }}
        </a>
      {%- else -%}
        <span class="nav-menu__address">{{ settings.shop_address }}</span>
      {%- endif -%}
    {%- endif -%}
  </div>
{%- endcapture -%}

{%- if mode == 'drawer' -%}
  <div
    class="drawer nav-drawer"
    id="{{ menu_id }}"
    data-overlay="menu"
    data-overlay-modal
    hidden
  >
    <div class="overlay__veil" data-overlay-close="menu"></div>

    <aside
      class="drawer__panel scheme-{{ settings.menu_drawer_color_scheme | default: 'scheme_1' }}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'accessibility.menu' | t }}"
      style="--rows: {{ total_rows }};"
    >
      <div class="drawer__inner">
        <header class="drawer__head">
          <span class="drawer__title">{{ 'accessibility.menu' | t }}</span>
          {%- capture close_attributes -%}data-overlay-close="menu"{%- endcapture -%}
          {% render 'overlay-close', class: 'drawer__close', attributes: close_attributes %}
        </header>
        {{ menu_inner }}
      </div>
    </aside>
  </div>
{%- else -%}
  <div
    class="nav-menu"
    id="{{ menu_id }}"
    data-overlay="menu"
    data-overlay-modal
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'accessibility.menu' | t }}"
    style="--rows: {{ total_rows }};"
    hidden
  >
    {% render 'overlay-head', close_action: 'menu', row: 0, huge_text: overlay_huge_text %}
    {{ menu_inner }}
  </div>
{%- endif -%}
