{%- comment -%}
  Country/currency and language selectors.

  Rendered only when the shop actually publishes more than one option, so the
  markup disappears on single-market stores instead of showing a dead control.
  Submits on change with a no-JS fallback button.

  Accepts:
    context - 'header' or 'footer'. Used to keep input ids unique.
{%- endcomment -%}

{%- liquid
  assign ctx = context | default: 'footer'

  assign show_country = false
  assign show_language = false

  if ctx == 'header'
    assign show_country = settings.show_country_header
    assign show_language = settings.show_language_header
  else
    assign show_country = settings.show_country_footer
    assign show_language = settings.show_language_footer
  endif
-%}

{%- if show_country and localization.available_countries.size > 1 -%}
  {%- comment -%}
    Do not put a filter in the form tag's arguments — Liquid mis-parses it and
    reads the trailing variable as the form type. Precompute into a variable if
    an attribute ever needs one.
  {%- endcomment -%}
  {%- form 'localization', class: 'localization' -%}
    <input type="hidden" name="_method" value="put">
    <label class="visually-hidden" for="country-{{ ctx }}">
      {{ 'localization.country_label' | t }}
    </label>
    <select id="country-{{ ctx }}" name="country_code" data-localization-select>
      {%- for country in localization.available_countries -%}
        <option
          value="{{ country.iso_code }}"
          {%- if country.iso_code == localization.country.iso_code %} selected{% endif %}
        >
          {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
        </option>
      {%- endfor -%}
    </select>
    <noscript>
      <button type="submit" class="btn btn--square">{{ 'localization.update' | t }}</button>
    </noscript>
  {%- endform -%}
{%- endif -%}

{%- if show_language and localization.available_languages.size > 1 -%}
  {%- form 'localization', class: 'localization' -%}
    <input type="hidden" name="_method" value="put">
    <label class="visually-hidden" for="language-{{ ctx }}">
      {{ 'localization.language_label' | t }}
    </label>
    <select id="language-{{ ctx }}" name="locale_code" data-localization-select>
      {%- for language in localization.available_languages -%}
        <option
          value="{{ language.iso_code }}"
          lang="{{ language.iso_code }}"
          {%- if language.iso_code == localization.language.iso_code %} selected{% endif %}
        >
          {{ language.endonym_name | capitalize }}
        </option>
      {%- endfor -%}
    </select>
    <noscript>
      <button type="submit" class="btn btn--square">{{ 'localization.update' | t }}</button>
    </noscript>
  {%- endform -%}
{%- endif -%}
