{%- comment -%}
  The single runtime renderer for Group and every contextual Group extension.
  Shopify requires each block to own its schema, but their markup, responsive
  attributes, borders, and alignment translation do not need to be copied.

  Accepts:
    layout_settings - block.settings or section.settings implementing Group
    content         - captured child blocks
    attributes      - Shopify editor attributes from the owning block
    class           - optional additional root class
{%- endcomment -%}

{%- liquid
  assign content_alignment_css = ''
  assign rendered_items_size = layout_settings.items_width
  if layout_settings.direction == 'vertical'
    assign rendered_items_size = layout_settings.items_height | default: 'natural'
  endif
  if layout_settings.content_alignment == 'left'
    assign content_alignment_css = '--group-content-align: left; --group-content-items: flex-start; --section-align: left; --section-align-jc: flex-start;'
  elsif layout_settings.content_alignment == 'center'
    assign content_alignment_css = '--group-content-align: center; --group-content-items: center; --section-align: center; --section-align-jc: center;'
  elsif layout_settings.content_alignment == 'right'
    assign content_alignment_css = '--group-content-align: right; --group-content-items: flex-end; --section-align: right; --section-align-jc: flex-end;'
  endif
-%}

<div
  class="layout-group{% if layout_settings.show_borders %} layout-group--bordered{% endif %}{% if class != blank %} {{ class }}{% endif %}"
  data-direction="{{ layout_settings.direction }}"
  data-stack="{% if layout_settings.direction == 'horizontal' %}{{ layout_settings.stack_below }}{% else %}never{% endif %}"
  data-mobile-align="{{ layout_settings.content_alignment_mobile | default: 'inherit' }}"
  data-items="{{ rendered_items_size }}"
  data-wrap="{{ layout_settings.wrap }}"
  {% if layout_settings.show_borders %}
    style="--group-border-width: {{ layout_settings.group_border_width }}px; --group-border-color: {% if layout_settings.border_color != blank %}{{ layout_settings.border_color }}{% else %}var(--c-hairline){% endif %}; --group-border-top: {% if layout_settings.border_top %}var(--group-border-width){% else %}0px{% endif %}; --group-border-right: {% if layout_settings.border_right %}var(--group-border-width){% else %}0px{% endif %}; --group-border-bottom: {% if layout_settings.border_bottom %}var(--group-border-width){% else %}0px{% endif %}; --group-border-left: {% if layout_settings.border_left %}var(--group-border-width){% else %}0px{% endif %};"
  {% endif %}
  {% if attributes != blank %}{{ attributes }}{% endif %}
>
  <div
    class="layout-group__inner"
    style="{% render 'layout-group-style', layout_settings: layout_settings %}{{ content_alignment_css }}"
  >
    {{- content -}}
  </div>
</div>
