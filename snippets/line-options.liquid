{%- comment -%}
  A cart line's variant, written one choice per
  row, rather than Shopify's " / "-joined `variant.title`.

  `gj-variants.js` builds the label and then re-splits it —
  `label(id, v).split(' · ').join('\n')` — so every part lands on its own line,
  and revision 13's bag drawer renders the result in a **single span** with
  `white-space: pre-line`. That whole revision was this one change: the span
  gained `white-space:pre-line` and `line-height:1.55`.

  So this is one span too, not one per value. The line breaks are data, and
  `pre-line` is what turns them into rows — splitting them into separate
  elements would look the same today and stop matching the moment the design
  changes how it joins them.

  Every merchant-defined option is listed in its native order. The theme never
  combines, renames, or reorders axes based on option names.

  Line item properties come after the options, quoted as the design quotes
  engraving — `parts.push(v.text ? '“' + v.text + '”' : 'Engraved')`. Shopify's
  underscore-prefixed properties are private by convention and stay hidden.

  Accepts:
    item  - a line_item.
    class - the caption class for the surrounding context.
{%- endcomment -%}

{%- capture nl %}
{% endcapture -%}

{%- liquid
  assign parts = ''

  unless item.product.has_only_default_variant
    for option in item.options_with_values
      assign option_value = option.value
      if option_value == blank
        continue
      endif

      if parts == blank
        assign parts = option_value
      else
        assign parts = parts | append: nl | append: option_value
      endif
    endfor
  endunless

  for property in item.properties
    assign property_value = property.last
    if property_value == blank
      continue
    endif

    assign property_first = property.first | slice: 0
    if property_first == '_'
      continue
    endif

    assign quoted = '“' | append: property_value | append: '”'
    if parts == blank
      assign parts = quoted
    else
      assign parts = parts | append: nl | append: quoted
    endif
  endfor

  if item.selling_plan_allocation
    assign plan_name = item.selling_plan_allocation.selling_plan.name
    if plan_name != blank
      if parts == blank
        assign parts = plan_name
      else
        assign parts = parts | append: nl | append: plan_name
      endif
    endif
  endif
-%}

{%- if parts != blank -%}
  <span class="line-options {{ class }}">{{ parts }}</span>
{%- endif -%}
