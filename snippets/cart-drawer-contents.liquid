{%- comment -%}
  Everything inside the bag drawer panel.

  Kept apart from the section shell because this is the part that gets replaced
  after a quantity change: theme.js asks Shopify to re-render the section and
  swaps this subtree in, leaving the panel — and its open state and animation —
  untouched.

  Accepts:
    section - the cart-drawer section, for its settings.
{%- endcomment -%}

{%- comment -%}
  The item count rides along on the markup so the nav badge can be updated
  from whatever the section just rendered, rather than from a second request
  or arithmetic done in the browser.
{%- endcomment -%}
{%- liquid
  comment
    A line's photograph is framed the way a product card's is, from the same
    kind of pair of settings — Theme settings → Cart. The design's thumbnail is
    square; this theme shipped 3:4 on request, because a pendant or a drop
    earring sat small in a square, and that stays the default.
  endcomment
  assign thumb_ratio = settings.cart_image_ratio | default: '3/4'
  assign thumb_rw = 0
  assign thumb_rh = 0
  unless thumb_ratio == 'adapt'
    assign ratio_parts = thumb_ratio | split: '/'
    assign thumb_rw = ratio_parts[0] | strip | plus: 0
    assign thumb_rh = ratio_parts[1] | strip | plus: 0
  endunless
-%}

{%- comment -%}
  The count, and the sentence that announces it. Both come from the markup
  Shopify has just re-rendered, so neither the number nor its pluralisation is
  worked out in JavaScript — the same rule the product card's Add to Bag
  labels follow.
{%- endcomment -%}
<div
  class="drawer__count-source"
  data-cart-count-value="{{ cart.item_count }}"
  data-cart-announce="{{ 'navigation.bag_count' | t: count: cart.item_count }}"
  hidden
></div>

<div class="drawer__head">
  <span class="drawer__title">
    {{ 'cart.title_bag' | t }}
    {%- if cart.item_count > 0 -%}
      <span class="drawer__count">{{ cart.item_count }}</span>
    {%- endif -%}
  </span>

  <button class="overlay-head__close drawer__close" type="button" data-overlay-close="cart">
    {{ 'navigation.close' | t }}
  </button>
</div>

<div class="drawer__body" data-drawer-scroller>
  {%- if cart.item_count == 0 -%}
    <div class="drawer-empty">
      <p class="drawer-empty__title">{{ 'cart.empty' | t }}</p>
      <p class="drawer-empty__text">{{ 'cart.empty_text' | t }}</p>
      {%- comment -%}
        Where an empty bag sends a shopper is the merchant's, and it falls back
        to all products rather than to a fragment — this theme does not ship a
        control that looks live and goes nowhere.
      {%- endcomment -%}
      <a class="btn btn--primary" href="{{ settings.cart_empty_link | default: routes.all_products_collection_url }}">
        {{ 'cart.browse' | t }}
      </a>
    </div>
  {%- else -%}
    <ul class="drawer-lines">
      {%- for item in cart.items -%}
        <li class="drawer-row" data-cart-line="{{ forloop.index }}">
          <div class="drawer-row__collapse">
            <div class="drawer-row__clip">
              <div class="drawer-row__body">
                {%- liquid
                  assign thumb_w = 64
                  if thumb_rw > 0
                    assign thumb_h = 64 | times: thumb_rh | divided_by: thumb_rw
                    assign thumb_crop_h = 128 | times: thumb_rh | divided_by: thumb_rw
                    assign thumb_lqip_h = 40 | times: thumb_rh | divided_by: thumb_rw
                    assign thumb_ar = thumb_rw | append: ' / ' | append: thumb_rh
                  else
                    comment
                      Adapt: the frame is this photograph's own shape, so there
                      is nothing to crop to and nothing fixed to declare.
                    endcomment
                    assign thumb_crop_h = 0
                    assign thumb_lqip_h = 0
                    assign thumb_h = 64 | times: item.image.height | divided_by: item.image.width
                    assign thumb_ar = item.image.width | append: ' / ' | append: item.image.height
                  endif
                -%}
                <a
                  class="drawer-row__thumb"
                  href="{{ item.url }}"
                  style="--drawer-thumb-ratio: {{ thumb_ar }};"
                  tabindex="-1"
                  aria-hidden="true"
                >
                  {%- if item.image -%}
                    {%- comment -%}
                      Requested cropped to the frame's own shape rather than to
                      a square, so Shopify centres the piece in the box instead
                      of the browser cropping one down to fit. At twice the
                      rendered size, for density. `adapt` asks for no crop at
                      all — there is nothing to crop to.
                    {%- endcomment -%}
                    <img
                      {%- if thumb_crop_h > 0 %}
                        src="{{ item.image | image_url: width: 128, height: thumb_crop_h, crop: 'center' }}"
                        data-image-lqip="{{ item.image | image_url: width: 40, height: thumb_lqip_h, crop: 'center' }}"
                      {%- else %}
                        src="{{ item.image | image_url: width: 128 }}"
                        data-image-lqip="{{ item.image | image_url: width: 40 }}"
                      {%- endif %}
                      alt=""
                      width="{{ thumb_w }}"
                      height="{{ thumb_h }}"
                      loading="lazy"
                    >
                  {%- endif -%}
                </a>

                <div class="drawer-row__info">
                  <a class="drawer-row__name" href="{{ item.url }}">{{ item.product.title }}</a>

                  {%- comment -%}
                    One row per choice, as revision 13 has it. The old
                    `contains 'Default'` test was guessing at Shopify's
                    "Default Title" from the string; has_only_default_variant
                    answers the same question outright, and does not misfire on
                    a real variant that happens to be called "Default".
                  {%- endcomment -%}
                  {% render 'line-options', item: item, class: 'drawer-row__meta' %}

                  <div class="drawer-qty">
                    <button
                      class="drawer-qty__btn"
                      type="button"
                      data-cart-step="-1"
                      aria-label="{{ 'cart.decrease' | t: title: item.product.title | escape }}"
                    >
                      {% render 'icon', icon: 'minus' %}
                    </button>
                    <span class="drawer-qty__value" data-cart-qty>{{ item.quantity }}</span>
                    <button
                      class="drawer-qty__btn"
                      type="button"
                      data-cart-step="1"
                      aria-label="{{ 'cart.increase' | t: title: item.product.title | escape }}"
                    >
                      {% render 'icon', icon: 'plus' %}
                    </button>
                  </div>
                </div>

                <div class="drawer-row__aside">
                  {%- comment -%}
                    A line never carries the note. The design puts it once, on
                    the subtotal, and repeating it down a bag of five pieces
                    says the same thing five times in the smallest type on the
                    panel. The line is the money and nothing else.
                  {%- endcomment -%}
                  {%- comment -%}
                    The price of one piece, not price × quantity. The quantity
                    is stated on its own directly beside this, so multiplying
                    it into the figure says the same thing twice and makes a
                    line of three read as a piece that costs three times what
                    the card said. `settings.cart_unit_price` turns it back
                    into the line total, here and on the cart page alike.
                  {%- endcomment -%}
                  <span class="drawer-row__price">
                    {%- if settings.cart_unit_price -%}
                      {{- item.final_price | money -}}
                    {%- else -%}
                      {{- item.final_line_price | money -}}
                    {%- endif -%}
                  </span>
                  <button
                    class="drawer-row__remove"
                    type="button"
                    data-cart-remove
                    aria-label="{{ 'cart.remove_title' | t: title: item.product.title | escape }}"
                  >
                    {{ 'cart.remove' | t }}
                  </button>
                </div>
              </div>
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{%- if cart.item_count > 0 -%}
  {%- liquid
    comment
      The footer's copy follows the one tax-note switch, because revision 14's
      reassurance is a claim about the figure above it — "every tax and fee
      already included" is only true where the note is shown. With the note off
      the shop is not pricing tax-inclusively, and the drawer says the other
      thing instead.
    endcomment
    assign tax_note_on = settings.show_tax_note
  -%}

  <div class="drawer__foot">
    {%- comment -%}
      Cart-level discounts, which are the shop's own — an automatic discount or
      a code already applied. They are stated above the subtotal because the
      subtotal is what they have already come off.
    {%- endcomment -%}
    {%- if settings.cart_discounts and cart.cart_level_discount_applications.size > 0 -%}
      <ul class="drawer__discounts">
        {%- for discount in cart.cart_level_discount_applications -%}
          <li class="drawer__discount">
            <span>{{ discount.title }}</span>
            <span>−{{ discount.total_allocated_amount | money }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="drawer__subtotal">
      {%- comment -%}
        Revision 14 moved the note off the figure and into the label —
        "Subtotal inc. all taxes and fees" — where it is lighter, untracked and
        not uppercased, so it reads as a qualifier rather than a second label.
        The figure beside it is left as nothing but the money.
      {%- endcomment -%}
      <span class="drawer__subtotal-label">
        {{- 'cart.subtotal' | t -}}
        {% render 'tax-note' %}
      </span>
      <span class="drawer__subtotal-value" data-drawer-subtotal>{{ cart.total_price | money }}</span>
    </div>

    {%- comment -%}
      Revision 14's own block: a gold micro-label over a sentence, in place of
      the single paragraph revision 13 carried.

      **Turning the tax note off changes the words and nothing else.** The
      block, its label, its colours, its sizes and its spacing are the design's
      in both states — only the sentence swaps, because "every tax and fee
      already included" is a claim about the figure above it and is untrue
      where the shop is not pricing tax-inclusively. Rendering the off state as
      a differently-styled paragraph made the whole footer change appearance,
      which is not what the switch is for.
    {%- endcomment -%}
    {%- liquid
      assign promise_text = section.settings.promise_text
      unless tax_note_on
        assign promise_text = section.settings.note
      endunless
    -%}

    {%- if section.settings.promise_label != blank or promise_text != blank -%}
      <div class="drawer__promise">
        {%- if section.settings.promise_label != blank -%}
          <p class="drawer__promise-label">{{ section.settings.promise_label }}</p>
        {%- endif -%}
        {%- if promise_text != blank -%}
          <p class="drawer__promise-text">{{ promise_text }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      **`{% form 'cart' %}` rather than a hand-written `<form>`**, and that is
      what makes three of the Cart settings possible at all: `payment_terms` and
      `payment_button` are filters *on a form object*, so a form Liquid did not
      build cannot have them. The action, method and hidden fields Shopify emits
      are the same ones that were written out by hand here.

      The three features are the cart page's too — they are settings under
      Theme settings → Cart, and the drawer and the page are alternatives that
      should not disagree about what a bag can do.
    {%- endcomment -%}
    {%- form 'cart', cart, class: 'drawer__actions' -%}
      {%- if settings.cart_note -%}
        <label class="drawer__note-label" for="drawer-cart-note">{{ 'cart.note' | t }}</label>
        <textarea
          class="drawer__note"
          id="drawer-cart-note"
          name="note"
          rows="2"
          data-cart-note
        >{{ cart.note }}</textarea>
      {%- endif -%}

      <button class="btn btn--primary drawer__checkout" type="submit" name="checkout">
        {{ 'cart.checkout' | t }}
      </button>

      {%- comment -%}
        Shopify renders these two itself and renders nothing when the shop has
        not enabled them, so the settings decide whether to *offer* them rather
        than whether they appear.
      {%- endcomment -%}
      {%- if settings.cart_accelerated_checkout -%}
        <div class="drawer__accelerated">{{ form | payment_button }}</div>
      {%- endif -%}

      {%- if settings.cart_installments -%}
        <div class="drawer__installments">{{ form | payment_terms }}</div>
      {%- endif -%}

      {%- if section.settings.secondary_label != blank -%}
        <a class="btn btn--outline drawer__secondary" href="{{ section.settings.secondary_link | default: routes.root_url }}">
          {{ section.settings.secondary_label }}
        </a>
      {%- endif -%}
    {%- endform -%}
  </div>
{%- endif -%}
