{%- comment -%}
  A promise card: an emblem, an ordinal, a hairline, a title and a line of text.

  **The ordinal and the entrance stagger are the stylesheet's now, and that is
  what converting this block cost.** A theme block cannot know its place among
  its siblings — `forloop` exists only out in the section, and
  `{% content_for 'blocks' %}` renders the set as one flat flow with no index
  at all. The section used to print `{{ forloop.index }}` into the number and
  `forloop.index0 | times: 80` into `--reveal-delay`; both come from
  `.promises__grid` in base.css now, as a CSS counter and a short nth-child
  ladder. Reordering or removing a promise in the editor still renumbers the
  set, which is the behaviour that had to survive the move.

  So `.promise-card__num` is deliberately empty — the Promises grid supplies
  its text. Outside that grid the public block remains a complete card without
  an invented ordinal. Do not "fix" it by putting a number back in the markup:
  a block has no way to know which number it is.

  `"tag": null` because the card *is* the grid item. A generated wrapper would
  take `.promises__grid > *`'s column span, and the card inside it would size
  to its own content rather than stretching — so a row of cards would stop
  being level, which is the whole reason the grid is spelled out.
{%- endcomment -%}

<div class="promise-card reveal" {{ block.shopify_attributes }}>
  <div class="promise-card__top">
    {%- if block.settings.icon != 'none' -%}
      <span class="promise-card__emblem">
        {% render 'icon', icon: block.settings.icon %}
      </span>
    {%- endif -%}
    <span class="promise-card__num"></span>
  </div>

  <span class="promise-card__rule" aria-hidden="true"></span>

  {%- if block.settings.heading != blank -%}
    <h3 class="promise-card__title">{{ block.settings.heading }}</h3>
  {%- endif -%}

  {%- if block.settings.text != blank -%}
    <p class="promise-card__text">{{ block.settings.text }}</p>
  {%- endif -%}

  <span class="promise-card__corner" aria-hidden="true"></span>
</div>

{% schema %}
{
  "name": "t:blocks.promise.name",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:blocks.promise.icon.label",
      "options": [
        { "value": "shipping", "label": "t:blocks.promise.icons.shipping" },
        { "value": "support", "label": "t:blocks.promise.icons.support" },
        { "value": "secure", "label": "t:blocks.promise.icons.secure" },
        { "value": "handcraft", "label": "t:blocks.promise.icons.handcraft" },
        { "value": "certified", "label": "t:blocks.promise.icons.certified" },
        { "value": "none", "label": "t:blocks.promise.icons.none" }
      ],
      "default": "shipping"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks.promise.heading.label",
      "default": "Insured Shipping"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:blocks.promise.text.label",
      "default": "Every order travels fully insured, door to door, at no cost to you."
    }
  ],
  "presets": [
    {
      "name": "t:blocks.promise.name",
      "settings": {
        "icon": "shipping",
        "heading": "Insured Shipping",
        "text": "Every order travels fully insured, door to door, at no cost to you."
      }
    }
  ]
}
{% endschema %}
