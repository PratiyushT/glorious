{%- comment -%}
  Reusable feature media: a Shopify-hosted video, or an image when no video is
  selected, with the frame, arch, fit, ratio, and caption choices that used to
  be repeated across About, Craft, and Visit.

  Video takes precedence without deleting the image. That lets a merchant
  publish a still first, add motion later, and return to the still without
  choosing the image again. Both paths keep the theme's LQIP contract.
{%- endcomment -%}

{%- liquid
  assign image = block.settings.image
  assign video = block.settings.video

  assign ratio = block.settings.ratio | default: '4 / 5'
  if ratio == 'adapt'
    assign ratio = '4 / 5'
    if video != blank and video.preview_image.aspect_ratio != blank
      assign ratio = video.preview_image.aspect_ratio
    elsif image != blank and image.aspect_ratio != blank
      assign ratio = image.aspect_ratio
    endif
  endif

  assign position = '50% 50%'
  if image != blank and image.presentation.focal_point != blank
    assign position = image.presentation.focal_point
  elsif video != blank and video.preview_image.presentation.focal_point != blank
    assign position = video.preview_image.presentation.focal_point
  endif
-%}

<div
  class="media-block{% if block.settings.reveal %} reveal{% endif %}"
  style="{% render 'block-spacing', padding: block.settings.padding %}{% if block.settings.reveal and block.settings.reveal_delay > 0 %} --reveal-delay: {{ block.settings.reveal_delay }}ms;{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="{% if block.settings.frame %}media-frame{% endif %}">
    <div
      class="media{% if block.settings.arch %} media--arch{% endif %}{% if block.settings.fit == 'contain' %} media--contain{% endif %}"
      style="aspect-ratio: {{ ratio }}; --media-position: {{ position }};"
    >
      {%- if video != blank -%}
        {%- assign video_lqip = video.preview_image | image_url: width: 40 -%}
        {%- if block.settings.autoplay -%}
          {{
            video
            | video_tag:
              image_size: '1400x',
              loop: block.settings.loop,
              muted: true,
              controls: false,
              data-video-lqip: video_lqip,
              data-video-autoplay: true
          }}
        {%- else -%}
          {{
            video
            | video_tag:
              image_size: '1400x',
              loop: block.settings.loop,
              muted: false,
              controls: true,
              data-video-lqip: video_lqip
          }}
        {%- endif -%}
        {% render 'video-lqip-frame', lqip: video_lqip %}
      {%- elsif image != blank -%}
        {%- render 'responsive-image',
            image: image,
            sizes: '(min-width: 60rem) 50vw, 100vw',
            widths: '400,700,1000,1400',
            src_width: 1200 -%}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>

  {%- if block.settings.caption_left != blank or block.settings.caption_right != blank -%}
    <div class="caption-row">
      <span>{{ block.settings.caption_left }}</span>
      <span>{{ block.settings.caption_right }}</span>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:blocks.media.name",
  "tag": null,
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "t:blocks.media.video.label",
      "info": "t:blocks.media.video.info"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.all.image.label",
      "info": "t:blocks.media.image.info"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:blocks.media.autoplay.label",
      "info": "t:blocks.media.autoplay.info",
      "default": true,
      "visible_if": "{{ block.settings.video != blank }}"
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "t:blocks.media.loop.label",
      "default": true,
      "visible_if": "{{ block.settings.video != blank }}"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "t:sections.all.image_ratio.label",
      "options": [
        { "value": "adapt", "label": "t:settings_schema.options.adapt" },
        { "value": "1 / 1", "label": "t:settings_schema.options.square" },
        { "value": "4 / 5", "label": "t:settings_schema.options.portrait" },
        { "value": "3 / 4", "label": "t:settings_schema.options.tall_portrait" },
        { "value": "4 / 3", "label": "t:settings_schema.options.landscape" },
        { "value": "16 / 9", "label": "t:settings_schema.options.wide" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "fit",
      "label": "t:blocks.media.fit.label",
      "options": [
        { "value": "cover", "label": "t:settings_schema.options.cover" },
        { "value": "contain", "label": "t:settings_schema.options.contain" }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "arch",
      "label": "t:blocks.media.arch.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "frame",
      "label": "t:blocks.media.frame.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "t:blocks.media.reveal.label",
      "default": true
    },
    {
      "type": "range",
      "id": "reveal_delay",
      "label": "t:blocks.media.reveal_delay.label",
      "info": "t:blocks.media.reveal_delay.info",
      "min": 0,
      "max": 1000,
      "step": 10,
      "unit": "ms",
      "default": 0,
      "visible_if": "{{ block.settings.reveal }}"
    },
    {
      "type": "text",
      "id": "caption_left",
      "label": "t:blocks.media.caption_left.label"
    },
    {
      "type": "text",
      "id": "caption_right",
      "label": "t:blocks.media.caption_right.label"
    },
    {
      "type": "header",
      "content": "t:blocks.all.spacing_header"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "t:blocks.all.padding.label",
      "options": [
        { "value": "none", "label": "t:blocks.all.step.none" },
        { "value": "minimal", "label": "t:blocks.all.step.minimal" },
        { "value": "tiny", "label": "t:blocks.all.step.tiny" },
        { "value": "small", "label": "t:blocks.all.step.small" },
        { "value": "medium", "label": "t:blocks.all.step.medium" },
        { "value": "large", "label": "t:blocks.all.step.large" },
        { "value": "xlarge", "label": "t:blocks.all.step.xlarge" }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.media.name",
      "settings": {
        "ratio": "4 / 5",
        "fit": "cover",
        "autoplay": true,
        "loop": true,
        "reveal": true,
        "reveal_delay": 0,
        "padding": "none"
      }
    }
  ]
}
{% endschema %}
