{%- comment -%}
  Reusable feature media: a Shopify-hosted video, or an image when no video is
  selected, with the frame, arch, fit, ratio, and caption choices that used to
  be repeated across About, Craft, and Visit.

  Video takes precedence without deleting the image. That lets a merchant
  publish a still first, add motion later, and return to the still without
  choosing the image again. Both paths keep the theme's LQIP contract.
{%- endcomment -%}

{% render 'media-block', block: block, image: block.settings.image, video: block.settings.video %}

{% schema %}
{
  "name": "t:blocks.media.name",
  "tag": null,
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "t:blocks.media.video.label",
      "info": "t:blocks.media.video.info"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.all.image.label",
      "info": "t:blocks.media.image.info"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:blocks.media.autoplay.label",
      "info": "t:blocks.media.autoplay.info",
      "default": true,
      "visible_if": "{{ block.settings.video != blank }}"
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "t:blocks.media.loop.label",
      "default": true,
      "visible_if": "{{ block.settings.video != blank }}"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "t:sections.all.image_ratio.label",
      "options": [
        { "value": "adapt", "label": "t:settings_schema.options.adapt" },
        { "value": "1 / 1", "label": "t:settings_schema.options.square" },
        { "value": "4 / 5", "label": "t:settings_schema.options.portrait" },
        { "value": "3 / 4", "label": "t:settings_schema.options.tall_portrait" },
        { "value": "2 / 3", "label": "t:settings_schema.options.extra_tall_portrait" },
        { "value": "5 / 4", "label": "t:settings_schema.options.soft_landscape" },
        { "value": "4 / 3", "label": "t:settings_schema.options.landscape" },
        { "value": "3 / 2", "label": "t:settings_schema.options.editorial_landscape" },
        { "value": "16 / 9", "label": "t:settings_schema.options.wide" },
        { "value": "21 / 9", "label": "t:settings_schema.options.panoramic" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "fit",
      "label": "t:blocks.media.fit.label",
      "options": [
        { "value": "cover", "label": "t:settings_schema.options.cover" },
        { "value": "contain", "label": "t:settings_schema.options.contain" }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "arch",
      "label": "t:blocks.media.arch.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "frame",
      "label": "t:blocks.media.frame.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "t:blocks.media.reveal.label",
      "default": true
    },
    {
      "type": "range",
      "id": "reveal_delay",
      "label": "t:blocks.media.reveal_delay.label",
      "info": "t:blocks.media.reveal_delay.info",
      "min": 0,
      "max": 1000,
      "step": 10,
      "unit": "ms",
      "default": 0,
      "visible_if": "{{ block.settings.reveal }}"
    },
    {
      "type": "text",
      "id": "caption_left",
      "label": "t:blocks.media.caption_left.label"
    },
    {
      "type": "text",
      "id": "caption_right",
      "label": "t:blocks.media.caption_right.label"
    },
    {
      "type": "header",
      "content": "t:blocks.all.spacing_header"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "t:blocks.all.padding.label",
      "options": [
        { "value": "none", "label": "t:blocks.all.step.none" },
        { "value": "minimal", "label": "t:blocks.all.step.minimal" },
        { "value": "tiny", "label": "t:blocks.all.step.tiny" },
        { "value": "small", "label": "t:blocks.all.step.small" },
        { "value": "medium", "label": "t:blocks.all.step.medium" },
        { "value": "large", "label": "t:blocks.all.step.large" },
        { "value": "xlarge", "label": "t:blocks.all.step.xlarge" }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.media.name",
      "settings": {
        "ratio": "4 / 5",
        "fit": "cover",
        "autoplay": true,
        "loop": true,
        "reveal": true,
        "reveal_delay": 0,
        "padding": "none"
      }
    }
  ]
}
{% endschema %}
