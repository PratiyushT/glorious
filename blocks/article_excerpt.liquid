{%- comment -%}
  Contextual Rich text whose value is the closest article excerpt. Cards may
  opt into a word limit and content fallback; the Article header keeps the
  merchant's authored excerpt intact.
{%- endcomment -%}

{%- liquid
  assign source_article = closest.article
  if source_article == blank and request.page_type == 'article'
    assign source_article = article
  endif
  assign excerpt = source_article.excerpt
  if excerpt == blank and block.settings.fallback_to_content
    assign excerpt = source_article.content
  endif
  if excerpt == blank and request.design_mode
    assign excerpt = 'onboarding.article_excerpt' | t
  endif
-%}
{%- if block.settings.truncate and excerpt != blank -%}
  {%- assign excerpt_text = excerpt | strip_html | truncatewords: block.settings.excerpt_words -%}
  {%- capture excerpt_content -%}<p>{{ excerpt_text | escape }}</p>{%- endcapture -%}
{%- else -%}
  {%- assign excerpt_content = excerpt -%}
{%- endif -%}
{% render 'rich-text-block', block: block, content: excerpt_content, class: 'article-excerpt' %}

{% schema %}
{
  "name": "t:blocks.article_excerpt.name",
  "tag": null,
  "settings": [
    { "type": "checkbox", "id": "fallback_to_content", "label": "t:blocks.article_excerpt.fallback_to_content", "info": "t:blocks.article_excerpt.fallback_info", "default": false },
    { "type": "checkbox", "id": "truncate", "label": "t:blocks.article_excerpt.truncate", "default": false },
    { "type": "range", "id": "excerpt_words", "label": "t:blocks.article_excerpt.excerpt_words", "min": 10, "max": 50, "step": 5, "default": 25, "visible_if": "{{ block.settings.truncate }}" },
    { "type": "header", "content": "t:blocks.all.text_header" },
