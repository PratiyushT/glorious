{%- comment -%}
  Collection list — a paragraph under the heading.

  The lookbook's lede, offered here as a block: `.lookbook__intro` is the
  theme's one body paragraph that sits under a display heading, capped at 520px
  and set in ink at 62%. It is reused rather than copied so the two read as the
  same voice; if a second caller ever needs to differ, rename the class then
  rather than forking the numbers now.
{%- endcomment -%}

{%- if block.settings.text != blank -%}
  <p class="lookbook__intro reveal" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.collection_list_paragraph.name",
  "tag": null,
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.all.text.label"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.collection_list_paragraph.name"
    }
  ]
}
{% endschema %}
