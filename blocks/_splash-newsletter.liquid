{%- comment -%}
  A newsletter-aware Splash shell, composed exactly like Group. The shell owns
  modal timing, persistence, accessibility, and registration as the target of
  #newsletter links. Its children own every visible part. The Email signup
  child is the only specialized piece because it owns Shopify's customer-form
  state and the post-subscription discount hand-off.
{%- endcomment -%}

{%- assign overlay_name = 'splash-newsletter-' | append: block.id -%}
{%- capture newsletter_content -%}{% content_for 'blocks' %}{%- endcapture -%}

<div
  class="overlay overlay--modal overlay--splash"
  data-overlay="{{ overlay_name }}"
  data-overlay-modal
  data-splash-screen
  data-splash-newsletter
  data-delay="{{ block.settings.delay | times: 1000 }}"
  data-storage-key="veylin-splash-{{ block.id }}"
  {{ block.shopify_attributes }}
  hidden
>
  <button class="overlay__veil" type="button" data-overlay-close="{{ overlay_name }}">
    <span class="visually-hidden">{{ 'navigation.close' | t }}</span>
  </button>

  <div
    class="modal modal--splash modal--splash-composed modal--splash-newsletter scheme-{{ block.settings.color_scheme }}"
    style="--splash-width: {{ block.settings.panel_width }}rem;"
    role="dialog"
    aria-modal="true"
    aria-label="{{ block.settings.accessibility_label | escape }}"
  >
    {%- capture close_attributes -%}data-overlay-close="{{ overlay_name }}"{%- endcapture -%}
    {% render 'overlay-close', class: 'modal__close', attributes: close_attributes %}

    <div class="modal__body modal__body--composed">
      {% render 'layout-group', layout_settings: block.settings, content: newsletter_content, class: 'splash-composition splash-newsletter-composition' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:blocks.splash_newsletter.name",
  "tag": null,
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme_1"
    },
    {
      "type": "range",
      "id": "delay",
      "label": "t:sections.newsletter_popup.delay.label",
      "info": "t:sections.newsletter_popup.delay.info",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 2
    },
    {
      "type": "range",
      "id": "panel_width",
      "label": "t:sections.newsletter_popup.panel_width.label",
      "min": 30,
      "max": 64,
      "step": 2,
      "unit": "rem",
      "default": 64
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "t:sections.newsletter_popup.accessibility_label.label",
      "info": "t:sections.newsletter_popup.accessibility_label.info",
      "default": "Newsletter signup"
    },
    {
      "type": "header",
      "content": "t:sections.group.layout_header"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:blocks.group.direction.label",
      "info": "t:blocks.group.direction.info",
      "options": [
        { "value": "horizontal", "label": "t:blocks.group.direction.horizontal" },
        { "value": "vertical", "label": "t:blocks.group.direction.vertical" }
      ],
      "default": "horizontal"
    },
    {
      "type": "select",
      "id": "distribute",
      "label": "t:blocks.group.distribute.label",
      "info": "t:blocks.group.distribute.info",
      "options": [
        { "value": "start", "label": "t:blocks.group.distribute.start" },
        { "value": "center", "label": "t:blocks.group.distribute.center" },
        { "value": "end", "label": "t:blocks.group.distribute.end" },
        { "value": "between", "label": "t:blocks.group.distribute.between" }
      ],
      "default": "between",
      "visible_if": "{{ block.settings.direction == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "align",
      "label": "t:blocks.group.align.label_horizontal",
      "info": "t:blocks.group.align.info_horizontal",
      "options": [
        { "value": "baseline", "label": "t:blocks.group.align.text" },
        { "value": "start", "label": "t:blocks.group.align.top" },
        { "value": "center", "label": "t:blocks.group.align.middle" },
        { "value": "end", "label": "t:blocks.group.align.bottom" },
        { "value": "stretch", "label": "t:blocks.group.align.equal_height" }
      ],
      "default": "baseline",
      "visible_if": "{{ block.settings.direction == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "align_vertical",
      "label": "t:blocks.group.align.label_vertical",
      "info": "t:blocks.group.align.info_vertical",
      "options": [
        { "value": "start", "label": "t:blocks.group.align.left" },
        { "value": "center", "label": "t:blocks.group.align.centre" },
        { "value": "end", "label": "t:blocks.group.align.right" },
        { "value": "stretch", "label": "t:blocks.group.align.full_width" }
      ],
      "default": "stretch",
      "visible_if": "{{ block.settings.direction == 'vertical' }}"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:blocks.group.content_alignment.label",
      "info": "t:blocks.group.content_alignment.info",
      "options": [
        { "value": "inherit", "label": "t:blocks.group.content_alignment.inherit" },
        { "value": "left", "label": "t:settings_schema.options.left" },
        { "value": "center", "label": "t:settings_schema.options.center" },
        { "value": "right", "label": "t:settings_schema.options.right" }
      ],
      "default": "left",
      "visible_if": "{{ block.settings.direction == 'vertical' and block.settings.align_vertical == 'stretch' or block.settings.direction == 'horizontal' and block.settings.items_width == 'equal' }}"
    },
    {
      "type": "checkbox",
      "id": "wrap",
      "label": "t:blocks.group.wrap.label",
      "info": "t:blocks.group.wrap.info",
      "default": true,
      "visible_if": "{{ block.settings.direction == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "items_width",
      "label": "t:blocks.group.items_width.label",
      "info": "t:blocks.group.items_width.info",
      "options": [
        { "value": "natural", "label": "t:blocks.group.items_width.natural" },
        { "value": "equal", "label": "t:blocks.group.items_width.equal" }
      ],
      "default": "natural",
      "visible_if": "{{ block.settings.direction == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "items_height",
      "label": "t:blocks.group.items_height.label",
      "info": "t:blocks.group.items_height.info",
      "options": [
        { "value": "natural", "label": "t:blocks.group.items_height.natural" },
        { "value": "equal", "label": "t:blocks.group.items_height.equal" }
      ],
      "default": "natural",
      "visible_if": "{{ block.settings.direction == 'vertical' }}"
    },
    {
      "type": "select",
      "id": "stack_below",
      "label": "t:blocks.group.stack_below.label",
      "info": "t:blocks.group.stack_below.info",
      "options": [
        { "value": "never", "label": "t:blocks.group.stack_below.never" },
        { "value": "tablet", "label": "t:blocks.group.stack_below.tablet" },
        { "value": "mobile", "label": "t:blocks.group.stack_below.mobile" }
      ],
      "default": "mobile",
      "visible_if": "{{ block.settings.direction == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "content_alignment_mobile",
      "label": "t:blocks.group.content_alignment_mobile.label",
      "info": "t:blocks.group.content_alignment_mobile.info",
      "options": [
        { "value": "inherit", "label": "t:blocks.group.content_alignment_mobile.inherit" },
        { "value": "left", "label": "t:settings_schema.options.left" },
        { "value": "center", "label": "t:settings_schema.options.center" },
        { "value": "right", "label": "t:settings_schema.options.right" }
      ],
      "default": "inherit",
      "visible_if": "{{ block.settings.direction == 'horizontal' and block.settings.stack_below != 'never' }}"
    },
    {
      "type": "header",
      "content": "t:blocks.all.spacing_header"
    },
    {
      "type": "select",
      "id": "gap",
      "label": "t:blocks.group.gap.label",
      "info": "t:blocks.group.gap.info",
      "visible_if": "{{ block.settings.direction == 'horizontal' }}",
      "options": [
        { "value": "none", "label": "t:blocks.all.step.none" },
        { "value": "minimal", "label": "t:blocks.all.step.minimal" },
        { "value": "tiny", "label": "t:blocks.all.step.tiny" },
        { "value": "small", "label": "t:blocks.all.step.small" },
        { "value": "medium", "label": "t:blocks.all.step.medium" },
        { "value": "large", "label": "t:blocks.all.step.large" },
        { "value": "xlarge", "label": "t:blocks.all.step.xlarge" },
        { "value": "maximum", "label": "t:blocks.all.step.maximum" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "vertical_gap",
      "label": "t:blocks.group.vertical_gap_label",
      "info": "t:blocks.group.vertical_gap_info",
      "visible_if": "{{ block.settings.direction == 'vertical' }}",
      "options": [
        { "value": "inherit", "label": "t:blocks.group.vertical_gap_inherit" },
        { "value": "none", "label": "t:blocks.all.step.none" },
        { "value": "minimal", "label": "t:blocks.all.step.minimal" },
        { "value": "tiny", "label": "t:blocks.all.step.tiny" },
        { "value": "small", "label": "t:blocks.all.step.small" },
        { "value": "medium", "label": "t:blocks.all.step.medium" },
        { "value": "large", "label": "t:blocks.all.step.large" },
        { "value": "xlarge", "label": "t:blocks.all.step.xlarge" },
        { "value": "maximum", "label": "t:blocks.all.step.maximum" }
      ],
      "default": "small"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "t:blocks.group.padding.label",
      "info": "t:blocks.group.padding.info",
      "options": [
        { "value": "none", "label": "t:blocks.all.step.none" },
        { "value": "minimal", "label": "t:blocks.all.step.minimal" },
        { "value": "tiny", "label": "t:blocks.all.step.tiny" },
        { "value": "small", "label": "t:blocks.all.step.small" },
        { "value": "medium", "label": "t:blocks.all.step.medium" },
        { "value": "large", "label": "t:blocks.all.step.large" },
        { "value": "xlarge", "label": "t:blocks.all.step.xlarge" },
        { "value": "maximum", "label": "t:blocks.all.step.maximum" }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "show_borders",
      "label": "t:blocks.group.show_borders_label",
      "info": "t:blocks.group.show_borders_info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:blocks.group.border_settings_header",
      "visible_if": "{{ block.settings.show_borders }}"
    },
    {
      "type": "range",
      "id": "group_border_width",
      "label": "t:blocks.group.border_width_label",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.show_borders }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:blocks.group.border_color_label",
      "info": "t:blocks.group.border_color_info",
      "visible_if": "{{ block.settings.show_borders }}"
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "t:blocks.group.border_top_label",
      "default": true,
      "visible_if": "{{ block.settings.show_borders }}"
    },
    {
      "type": "checkbox",
      "id": "border_right",
      "label": "t:blocks.group.border_right_label",
      "default": true,
      "visible_if": "{{ block.settings.show_borders }}"
    },
    {
      "type": "checkbox",
      "id": "border_bottom",
      "label": "t:blocks.group.border_bottom_label",
      "default": true,
      "visible_if": "{{ block.settings.show_borders }}"
    },
    {
      "type": "checkbox",
      "id": "border_left",
      "label": "t:blocks.group.border_left_label",
      "default": true,
      "visible_if": "{{ block.settings.show_borders }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.splash_newsletter.name",
      "settings": {
        "color_scheme": "scheme_1",
        "delay": 2,
        "panel_width": 64,
        "accessibility_label": "Newsletter signup",
        "direction": "horizontal",
        "distribute": "start",
        "align": "stretch",
        "content_alignment": "left",
        "wrap": false,
        "items_width": "equal",
        "stack_below": "tablet",
        "content_alignment_mobile": "inherit",
        "gap": "none",
        "padding": "none",
        "show_borders": false
      },
      "blocks": [
        {
          "type": "media",
          "settings": {
            "ratio": "adapt",
            "fit": "cover",
            "reveal": false,
            "padding": "none"
          }
        },
        {
          "type": "group",
          "settings": {
            "direction": "vertical",
            "align_vertical": "stretch",
            "content_alignment": "inherit",
            "items_height": "natural",
            "vertical_gap": "small",
            "padding": "xlarge",
            "show_borders": false
          },
          "blocks": [
            {
              "type": "text",
              "settings": {
                "text": "Private offer",
                "style": "subheading",
                "layout": "eyebrow",
                "element": "p",
                "alignment": "inherit",
                "padding": "none"
              }
            },
            {
              "type": "text",
              "settings": {
                "text": "A Welcome, Just for You",
                "style": "heading_2",
                "layout": "standard",
                "element": "h2",
                "alignment": "inherit",
                "padding": "none"
              }
            },
            {
              "type": "rich-text",
              "settings": {
                "text": "<p>Join the private list for early access to new collections and a welcome offer for your first order.</p>",
                "style": "paragraph",
                "alignment": "inherit"
              }
            },
            {
              "type": "email-signup",
              "settings": {
                "input_label": "Email address",
                "show_label": false,
                "placeholder": "Email address",
                "button_label": "Join the Private List",
                "form_layout": "stacked",
                "success_text": "Your welcome offer is ready.",
                "show_offer": true,
                "offer_code": "WELCOME10",
                "offer_button_label": "Apply Offer & Shop",
                "button_style": "filled",
                "button_size": "inherit",
                "button_radius": "inherit",
                "button_border_width": "inherit"
              }
            },
            {
              "type": "button",
              "settings": {
                "button_label": "Continue browsing",
                "button_link": "#close",
                "button_style": "link",
                "button_size": "inherit"
              }
            },
            {
              "type": "rich-text",
              "settings": {
                "text": "<p>By subscribing you agree to receive email from this shop. Unsubscribe anytime.</p>",
                "style": "caption",
                "alignment": "inherit"
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
