{%- comment -%}Responsive whitespace primitive; decorative and screen-reader inert.{%- endcomment -%}
<div
  class="spacer-block"
  style="--spacer-desktop: {{ block.settings.height }}px; --spacer-mobile: {{ block.settings.height_mobile }}px;"
  aria-hidden="true"
  {{ block.shopify_attributes }}
></div>

{% schema %}
{
  "name": "Spacer",
  "tag": null,
  "settings": [
    { "type": "range", "id": "height", "label": "Desktop height", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "height_mobile", "label": "Mobile height", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 20 }
  ],
  "presets": [{ "name": "Spacer" }]
}
{% endschema %}
