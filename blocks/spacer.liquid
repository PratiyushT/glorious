{%- comment -%}Responsive whitespace primitive; decorative and screen-reader inert.{%- endcomment -%}
<div
  class="spacer-block{% if block.settings.full_container_width %} spacer-block--full-container{% endif %}"
  style="--spacer-desktop: {{ block.settings.height }}px; --spacer-mobile: {{ block.settings.height_mobile }}px;"
  aria-hidden="true"
  {{ block.shopify_attributes }}
></div>

{% schema %}
{
  "name": "t:blocks.spacer.name",
  "tag": null,
  "settings": [
    { "type": "range", "id": "height", "label": "t:blocks.spacer.height", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "height_mobile", "label": "t:blocks.spacer.height_mobile", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 20 },
    { "type": "checkbox", "id": "full_container_width", "label": "t:blocks.spacer.full_container_width.label", "info": "t:blocks.spacer.full_container_width.info", "default": false }
  ],
  "presets": [
    { "name": "t:blocks.spacer.name" },
    { "name": "t:blocks.spacer.line_break", "settings": { "height": 0, "height_mobile": 0, "full_container_width": true } }
  ]
}
{% endschema %}
