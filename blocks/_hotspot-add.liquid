{%- comment -%}
  Private to Hotspot; explicitly targeted there and nowhere else.

  Product card — add to cart.

  A plain product form, so adding works without scripting. `theme.js`
  intercepts it when the cart drawer is on, posts it in the background and
  slides the drawer out.

  **What it posts is `snippets/card-option.liquid`'s answer**, the same variant
  quoted by the price block: Shopify's selected or first available variant.

  `data-card-add-id` is the hook an option pick moves, and `.card__add` is the
  element whose label and disabled state it swaps — both read from the
  `[data-card]` root, so this block can sit anywhere in the card.

  **Both labels ride on the button, not on the card root**, and that follows
  from the label being this block's setting. An option can be sold out while the
  one Liquid rendered was not, so `theme.js` has to swap between them without a
  translation string of its own — and it used to read them off the root, which
  was correct only while the words came from a theme setting both could see. A
  block cannot hand its setting to its parent, so the attributes moved to where
  the setting is. `theme.js` prefers the button's and falls back to the root's,
  which keeps the shared card behavior consistent.

  **The form carries an id of its own.** Shopify derives one from the product,
  so a page rendering the same piece twice — this card and a collection row,
  say — would put two elements with the same id in the document, which is both
  a scored accessibility failure and a real defect. The lookbook already had to
  pass one for exactly this reason; see "Duplicate ids" in CLAUDE.md.
{%- endcomment -%}

{%- liquid
  assign product = closest.product
  assign cart_name = settings.cart_name | default: 'Cart'
  assign label = 'products.add_to_cart' | t: cart_name: cart_name
  assign sold_out_label = 'products.sold_out' | t
  if block.settings.add_label != blank
    assign label = block.settings.add_label
  endif
  if block.settings.sold_out_label != blank
    assign sold_out_label = block.settings.sold_out_label
  endif

  assign chosen = blank
  if product != blank
    capture card_option_raw
      render 'card-option', product: product
    endcapture
    assign card_option = card_option_raw | strip | split: '||'
    assign chosen_id = card_option | last | plus: 0
    for variant in product.variants
      if variant.id == chosen_id
        assign chosen = variant
        break
      endif
    endfor
  endif

  assign form_id = 'card_form_' | append: product.id | append: '_' | append: block.id
-%}

{%- if product == blank -%}
  {%- render 'button', label: label, element: 'span', disabled: true, appearance: block.settings, class: 'card__add', icon: 'plus', icon_class: 'lookbook-card__add-icon', attributes: block.shopify_attributes -%}
{%- elsif product.available -%}
  {%- form 'product', product, id: form_id, class: 'card__add-form', data-cart-add: '' -%}
    <input type="hidden" name="id" value="{{ chosen.id }}" data-card-add-id>
    {%- capture add_attributes -%}data-add-label="{{ label | escape }}" data-sold-out-label="{{ sold_out_label | escape }}" {{ block.shopify_attributes }}{%- endcapture -%}
    {%- render 'button', label: label, element: 'button', button_type: 'submit', button_name: 'add', mutable_label: true, appearance: block.settings, class: 'card__add', icon: 'plus', icon_class: 'lookbook-card__add-icon', attributes: add_attributes -%}
  {%- endform -%}
{%- else -%}
  {%- render 'button', label: sold_out_label, element: 'span', disabled: true, appearance: block.settings, class: 'card__add', icon: 'plus', icon_class: 'lookbook-card__add-icon', attributes: block.shopify_attributes -%}
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product_card_add.name",
  "tag": null,
  "settings": [
    { "type": "text", "id": "add_label", "label": "t:blocks.product_card_add.add_label.label", "info": "t:blocks.product_card_add.add_label.info" },
    { "type": "text", "id": "sold_out_label", "label": "t:blocks.product_card_add.sold_out_label.label", "info": "t:blocks.product_card_add.sold_out_label.info" },
    { "type": "header", "content": "t:blocks.button.appearance_header" },
    { "type": "select", "id": "button_style", "label": "t:sections.all.button_style.label", "options": [
      { "value": "filled", "label": "t:settings_schema.button_style.filled" }, { "value": "outline", "label": "t:settings_schema.button_style.outline" },
      { "value": "link", "label": "t:settings_schema.button_style.link" }, { "value": "quiet", "label": "t:settings_schema.button_style.quiet" },
      { "value": "arrow", "label": "t:settings_schema.button_style.arrow" }, { "value": "arrow_outline", "label": "t:settings_schema.button_style.arrow_outline" }
    ], "default": "outline" },
    { "type": "select", "id": "button_size", "label": "t:sections.all.button_size.label", "options": [
      { "value": "inherit", "label": "t:settings_schema.button_size.inherit" }, { "value": "xs", "label": "t:settings_schema.button_size.xs" },
      { "value": "sm", "label": "t:settings_schema.button_size.sm" }, { "value": "md", "label": "t:settings_schema.button_size.md" },
      { "value": "lg", "label": "t:settings_schema.button_size.lg" }, { "value": "xl", "label": "t:settings_schema.button_size.xl" }
    ], "default": "inherit" },
    { "type": "select", "id": "button_radius", "label": "t:sections.all.button_radius.label", "options": [
      { "value": "inherit", "label": "t:settings_schema.button_radius.inherit" }, { "value": "square", "label": "t:settings_schema.button_radius.square" },
      { "value": "soft", "label": "t:settings_schema.button_radius.soft" }, { "value": "rounded", "label": "t:settings_schema.button_radius.rounded" },
      { "value": "pill", "label": "t:settings_schema.button_radius.pill" }
    ], "default": "inherit", "visible_if": "{{ block.settings.button_style == 'filled' or block.settings.button_style == 'outline' or block.settings.button_style == 'arrow_outline' }}" },
    { "type": "select", "id": "button_border_width", "label": "t:blocks.button.border_width.label", "options": [
      { "value": "inherit", "label": "t:blocks.button.inherit" }, { "value": "xs", "label": "t:settings_schema.buttons.button_border_width.options__xs" },
      { "value": "sm", "label": "t:settings_schema.buttons.button_border_width.options__sm" }, { "value": "md", "label": "t:settings_schema.buttons.button_border_width.options__md" },
      { "value": "lg", "label": "t:settings_schema.buttons.button_border_width.options__lg" }, { "value": "xl", "label": "t:settings_schema.buttons.button_border_width.options__xl" }
    ], "default": "inherit", "visible_if": "{{ block.settings.button_style == 'outline' or block.settings.button_style == 'arrow_outline' }}" },
    { "type": "color", "id": "background_color", "label": "t:blocks.button.background_color.label", "info": "t:blocks.button.color_info", "visible_if": "{{ block.settings.button_style == 'filled' }}" },
    { "type": "color", "id": "text_color", "label": "t:blocks.button.text_color.label", "info": "t:blocks.button.color_info" },
    { "type": "color", "id": "border_color", "label": "t:blocks.button.border_color.label", "info": "t:blocks.button.color_info", "visible_if": "{{ block.settings.button_style == 'outline' or block.settings.button_style == 'arrow_outline' }}" },
    { "type": "color", "id": "underline_color", "label": "t:blocks.button.underline_color.label", "info": "t:blocks.button.color_info", "visible_if": "{{ block.settings.button_style == 'link' or block.settings.button_style == 'quiet' }}" },
    { "type": "color", "id": "arrow_color", "label": "t:blocks.button.arrow_color.label", "info": "t:blocks.button.color_info", "visible_if": "{{ block.settings.button_style == 'arrow' }}" },
    { "type": "header", "content": "t:blocks.button.hover_header" },
    { "type": "color", "id": "hover_background_color", "label": "t:blocks.button.hover_background_color.label", "info": "t:blocks.button.color_info", "visible_if": "{{ block.settings.button_style == 'filled' or block.settings.button_style == 'outline' or block.settings.button_style == 'arrow_outline' }}" },
    { "type": "color", "id": "hover_text_color", "label": "t:blocks.button.hover_text_color.label", "info": "t:blocks.button.color_info" },
    { "type": "color", "id": "hover_border_color", "label": "t:blocks.button.hover_border_color.label", "info": "t:blocks.button.color_info", "visible_if": "{{ block.settings.button_style == 'outline' or block.settings.button_style == 'arrow_outline' }}" },
    { "type": "color", "id": "hover_underline_color", "label": "t:blocks.button.hover_underline_color.label", "info": "t:blocks.button.color_info", "visible_if": "{{ block.settings.button_style == 'link' or block.settings.button_style == 'quiet' }}" },
    { "type": "color", "id": "hover_arrow_color", "label": "t:blocks.button.hover_arrow_color.label", "info": "t:blocks.button.color_info", "visible_if": "{{ block.settings.button_style == 'arrow' }}" }
  ],
  "presets": [
    {
      "name": "t:blocks.product_card_add.name"
    }
  ]
}
{% endschema %}
