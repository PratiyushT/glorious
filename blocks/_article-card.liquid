{%- comment -%}
  Article card — one private composition rendered for every article in the
  Blog section. The section supplies `closest.article`; the card owns only the
  semantic shell and its merchant-reorderable children own content.

  Article title, image, metadata and excerpt are contextual extensions of the
  global Text, Media and Rich text contracts. Ordinary Text, Rich text,
  Button, Icon, Border, Group and Accordion remain available for editorial
  additions without adding another article-specific presentation system.
{%- endcomment -%}

<article class="article-card" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</article>

{% schema %}
{
  "name": "t:blocks.article_card.name",
  "tag": null,
  "blocks": [
    { "type": "article_image" },
    { "type": "article_metadata" },
    { "type": "article_title" },
    { "type": "article_excerpt" },
    { "type": "text" },
    { "type": "rich-text" },
    { "type": "button" },
    { "type": "icon" },
    { "type": "border" },
    { "type": "group" },
    { "type": "accordion" }
  ]
}
{% endschema %}
