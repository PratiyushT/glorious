{%- comment -%}
  A micro eyebrow, as a block.

  **Named for what it is, not for where it first appeared.** Any section can
  list `subheading` in its `blocks` array and get this; it reads nothing from
  its parent and emits no class belonging to one. Same rule the row carousel is
  written to — a shared thing named after one of its callers is how the next
  reader is misled.

  `.section-eyebrow` rather than `.section-header`: that one is the row Most
  Loved uses to carry a micro label *and* a "view all" link, and it is spaced
  for a row with a link in it. On its own the label wants far less air — see
  base.css for the numbers and what they replaced.

  **The default text is not decoration.** A block that renders nothing until it
  is filled in is invisible the moment it is added: nothing appears in the
  preview and the editor has no element to select or highlight, so it reads as
  "the block does not work". Both the setting and the preset carry text for
  that reason — the preset is what a merchant's "Add block" actually seeds
  from.
{%- endcomment -%}


{%- liquid
  assign align_class = ''
  if block.settings.alignment != blank and block.settings.alignment != 'inherit'
    assign align_class = ' align-' | append: block.settings.alignment
  endif

  comment
    A guard rather than interpolating whatever is stored: an unknown value would
    print as a tag name and Liquid would emit `<foo>`. Same shape as the level
    guard on `blocks/title.liquid`.
  endcomment
  assign tags = 'span,p,h1,h2,h3,h4,h5,h6' | split: ','
  assign tag = 'span'
  if tags contains block.settings.element
    assign tag = block.settings.element
  endif
-%}
{%- if block.settings.text != blank -%}
  <div
    class="section-eyebrow reveal{{ align_class }}"
    style="{% render 'block-spacing', padding: block.settings.padding %}"
    {{ block.shopify_attributes }}
  >
    <{{ tag }} class="micro" style="{% render 'text-style', style: block.settings.style, color: block.settings.color %}">{{ block.settings.text }}</{{ tag }}>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.subheading.name",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:blocks.all.text_header"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:blocks.all.text_style.label",
      "info": "t:blocks.all.text_style.info",
      "options": [
        { "value": "inherit", "label": "t:blocks.all.inherit.label" },
        { "value": "display", "label": "t:settings_schema.text_styles.display.header" },
        { "value": "title", "label": "t:settings_schema.text_styles.title.header" },
        { "value": "subtitle", "label": "t:settings_schema.text_styles.subtitle.header" },
        { "value": "lead", "label": "t:settings_schema.text_styles.lead.header" },
        { "value": "body", "label": "t:settings_schema.text_styles.body.header" },
        { "value": "small", "label": "t:settings_schema.text_styles.small.header" },
        { "value": "caption", "label": "t:settings_schema.text_styles.caption.header" }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "element",
      "label": "t:blocks.all.text_element.label",
      "info": "t:blocks.all.text_element.info",
      "options": [
        { "value": "span", "label": "t:blocks.all.text_element.span" },
        { "value": "p", "label": "t:blocks.all.text_element.p" },
        { "value": "h1", "label": "t:blocks.all.text_element.h1" },
        { "value": "h2", "label": "t:blocks.all.text_element.h2" },
        { "value": "h3", "label": "t:blocks.all.text_element.h3" },
        { "value": "h4", "label": "t:blocks.all.text_element.h4" },
        { "value": "h5", "label": "t:blocks.all.text_element.h5" },
        { "value": "h6", "label": "t:blocks.all.text_element.h6" }
      ],
      "default": "span"
    },
    {
      "type": "color",
      "id": "color",
      "label": "t:blocks.all.text_color.label",
      "info": "t:blocks.all.text_color.info"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.all.content_alignment.label",
      "info": "t:sections.all.content_alignment.info",
      "options": [
        { "value": "inherit", "label": "t:settings_schema.options.inherit" },
        { "value": "left", "label": "t:settings_schema.options.left" },
        { "value": "center", "label": "t:settings_schema.options.center" },
        { "value": "right", "label": "t:settings_schema.options.right" }
      ],
      "default": "inherit"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.all.subheading.label",
      "default": "Subheading"
    },
    {
      "type": "header",
      "content": "t:blocks.all.spacing_header"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "t:blocks.all.padding.label",
      "options": [
        { "value": "none", "label": "t:blocks.all.step.none" },
        { "value": "minimal", "label": "t:blocks.all.step.minimal" },
        { "value": "tiny", "label": "t:blocks.all.step.tiny" },
        { "value": "small", "label": "t:blocks.all.step.small" },
        { "value": "medium", "label": "t:blocks.all.step.medium" },
        { "value": "large", "label": "t:blocks.all.step.large" },
        { "value": "xlarge", "label": "t:blocks.all.step.xlarge" }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.subheading.name",
      "settings": {
        "text": "Subheading",
        "padding": "none"
      }
    }
  ]
}
{% endschema %}
