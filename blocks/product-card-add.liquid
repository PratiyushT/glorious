{%- comment -%}
  Product card — Add to Bag.

  A plain product form, so adding works without scripting. `theme.js`
  intercepts it when the bag drawer is on, posts it in the background and
  slides the drawer out.

  **What it posts is `snippets/card-option.liquid`'s answer**, the same one the
  price block quotes — the dearest available variant in the metal the card
  stands on. The card offers no karat or size control, so adding has to choose
  on the customer's behalf; dearest *available*, because a sold-out variant
  cannot be bought. Where the whole metal is sold out the dearest overall
  stands in and the button says Sold out.

  `data-card-add-id` is the hook a metal pick moves, and `.card__add` is the
  element whose label and disabled state it swaps — both read from the
  `[data-card]` root, so this block can sit anywhere in the card.

  **Both labels ride on the button, not on the card root**, and that follows
  from the label being this block's setting. A metal can be sold out while the
  one Liquid rendered was not, so `theme.js` has to swap between them without a
  translation string of its own — and it used to read them off the root, which
  was correct only while the words came from a theme setting both could see. A
  block cannot hand its setting to its parent, so the attributes moved to where
  the setting is. `theme.js` prefers the button's and falls back to the root's,
  which is what keeps `snippets/product-card.liquid` working unchanged.

  **The form carries an id of its own.** Shopify derives one from the product,
  so a page rendering the same piece twice — this card and a collection row,
  say — would put two elements with the same id in the document, which is both
  a scored accessibility failure and a real defect. The lookbook already had to
  pass one for exactly this reason; see "Duplicate ids" in CLAUDE.md.
{%- endcomment -%}

{%- liquid
  assign product = block.settings.product | default: closest.product
  assign label = block.settings.label | default: 'Add to Bag'
  assign sold_out_label = 'products.sold_out' | t

  assign chosen = blank
  if product != blank
    capture card_option_raw
      render 'card-option', product: product
    endcapture
    assign card_option = card_option_raw | strip | split: '||'
    assign chosen_id = card_option | last | plus: 0
    for variant in product.variants
      if variant.id == chosen_id
        assign chosen = variant
        break
      endif
    endfor
  endif

  assign form_id = 'card_form_' | append: product.id | append: '_' | append: block.id
-%}

{%- if product == blank -%}
  <span class="btn btn--square card__add" aria-disabled="true" {{ block.shopify_attributes }}>
    {{- label -}}
  </span>
{%- elsif product.available -%}
  {%- form 'product', product, id: form_id, class: 'card__add-form', data-cart-add: '' -%}
    <input type="hidden" name="id" value="{{ chosen.id }}" data-card-add-id>
    <button
      type="submit"
      name="add"
      class="btn btn--square card__add"
      data-add-label="{{ label | escape }}"
      data-sold-out-label="{{ sold_out_label | escape }}"
      {{ block.shopify_attributes }}
    >
      {{- label -}}
    </button>
  {%- endform -%}
{%- else -%}
  <span class="btn btn--square card__add" aria-disabled="true" {{ block.shopify_attributes }}>
    {{- sold_out_label -}}
  </span>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product_card_add.name",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:blocks.all.content_source_header"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:blocks.all.product_source.label",
      "info": "t:blocks.all.product_source.info"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:blocks.product_card_add.label.label",
      "default": "Add to Bag"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.product_card_add.name",
      "settings": {
        "product": "{{ closest.product }}"
      }
    }
  ]
}
{% endschema %}
