      "info": "t:blocks.all.text_preset.info",
      "options": [
        { "value": "title", "label": "t:settings_schema.typography.presets.title.header" },
        { "value": "heading_1", "label": "t:settings_schema.typography.presets.heading_1.header" },
        { "value": "heading_2", "label": "t:settings_schema.typography.presets.heading_2.header" },
        { "value": "heading_3", "label": "t:settings_schema.typography.presets.heading_3.header" },
        { "value": "heading_4", "label": "t:settings_schema.typography.presets.heading_4.header" },
        { "value": "heading_5", "label": "t:settings_schema.typography.presets.heading_5.header" },
        { "value": "subheading", "label": "t:settings_schema.typography.presets.subheading.header" },
