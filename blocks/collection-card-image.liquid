{%- comment -%}
  Collection card — the photograph.

  The card is one *static* block that the section renders once per collection,
  so this renders once per collection too and reads the one it was handed
  through `closest.collection`. That is also why there is no image picker here:
  a picker on a shared template would set the same photograph on every card.
  The collection's own featured image is the only sensible source, which is
  what the old per-category block fell back to anyway.

  `image_ratio` lives on this block rather than on the section because the
  frame belongs to the photograph, and every card shares the one template, so
  the row still cannot end up with mismatched frames.

  Every raster image in this theme carries `data-image-lqip` — a ~40px
  rendition of this exact source. See "Not ported" in CLAUDE.md.
{%- endcomment -%}

{%- liquid
  assign collection = block.settings.collection | default: closest.collection
  assign image = collection.featured_image
  assign alt = image.alt | default: collection.title | escape
-%}

<span
  class="cat-card__media"
  style="aspect-ratio: {{ block.settings.image_ratio }};"
  {{ block.shopify_attributes }}
>
  {%- if image != blank -%}
    <img
      src="{{ image | image_url: width: 900 }}"
      data-image-lqip="{{ image | image_url: width: 40 }}"
      srcset="{{ image | image_url: width: 300 }} 300w, {{ image | image_url: width: 500 }} 500w, {{ image | image_url: width: 700 }} 700w, {{ image | image_url: width: 1000 }} 1000w"
      sizes="(min-width: 60rem) 25vw, 100vw"
      alt="{{ alt }}"
      width="{{ image.width }}"
      height="{{ image.height }}"
      loading="lazy"
    >
  {%- else -%}
    {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
  {%- endif -%}
</span>

{% schema %}
{
  "name": "t:blocks.collection_card_image.name",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:blocks.all.content_source_header"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:blocks.all.collection_source.label",
      "info": "t:blocks.all.collection_source.info"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.all.image_ratio.label",
      "options": [
        { "value": "1 / 1", "label": "t:settings_schema.options.square" },
        { "value": "4 / 5", "label": "t:settings_schema.options.portrait" },
        { "value": "3 / 4", "label": "t:settings_schema.options.tall_portrait" },
        { "value": "4 / 3", "label": "t:settings_schema.options.landscape" }
      ],
      "default": "4 / 5"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.collection_card_image.name",
      "settings": {
        "collection": "{{ closest.collection }}"
      }
    }
  ]
}
{% endschema %}
