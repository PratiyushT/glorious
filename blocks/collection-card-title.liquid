{%- comment -%}
  Collection card — the name of the collection.

  The arrow is 0.7em in the design (`<span style="font-size:.7em">→`), not the
  heading's own size: set loose in the text node it renders as large as the
  word beside it.

  No text override, for the reason the image has no picker — one template
  serves every card, so an override here would rename all of them at once. The
  collection's own title is the source.
{%- endcomment -%}

{%- liquid
  assign collection = closest.collection
  if block.settings.collection != blank
    assign collection = block.settings.collection
  endif
-%}

<span class="cat-card__title" {{ block.shopify_attributes }}>
  {{- collection.title | default: block.settings.fallback -}}
  &nbsp;&nbsp;<span class="cat-card__head-arrow">&rarr;</span>
</span>

{% schema %}
{
  "name": "t:blocks.collection_card_title.name",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:blocks.all.content_source_header"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:blocks.all.collection_source.label",
      "info": "t:blocks.all.collection_source.info"
    },
    {
      "type": "text",
      "id": "fallback",
      "label": "t:blocks.collection_card_title.fallback.label",
      "info": "t:blocks.collection_card_title.fallback.info",
      "default": "Category"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.collection_card_title.name",
      "settings": {
        "collection": "{{ closest.collection }}"
      }
    }
  ]
}
{% endschema %}
