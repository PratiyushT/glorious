{%- comment -%}Contextual Rich text whose locked value is the closest product description.{%- endcomment -%}
{%- assign description = closest.product.description -%}
{%- if description == blank and request.design_mode -%}{%- assign description = 'onboarding.product_description' | t -%}{%- endif -%}
{% render 'rich-text-block', block: block, content: description, class: 'product-description' %}

{% schema %}
{
  "name": "t:sections.main_product.blocks.description", "tag": null,
  "settings": [
    { "type": "header", "content": "t:blocks.all.text_header" },
    { "type": "select", "id": "style", "label": "t:blocks.all.text_preset.label", "info": "t:blocks.all.text_preset.info", "options": [
      { "value": "title", "label": "t:settings_schema.typography.presets.title.header" }, { "value": "heading_1", "label": "t:settings_schema.typography.presets.heading_1.header" },
      { "value": "heading_2", "label": "t:settings_schema.typography.presets.heading_2.header" }, { "value": "heading_3", "label": "t:settings_schema.typography.presets.heading_3.header" },
      { "value": "heading_4", "label": "t:settings_schema.typography.presets.heading_4.header" }, { "value": "heading_5", "label": "t:settings_schema.typography.presets.heading_5.header" },
      { "value": "subheading", "label": "t:settings_schema.typography.presets.subheading.header" }, { "value": "paragraph", "label": "t:settings_schema.typography.presets.paragraph.header" },
      { "value": "small", "label": "t:settings_schema.typography.presets.small.header" }, { "value": "caption", "label": "t:settings_schema.typography.presets.caption.header" }
    ], "default": "paragraph" },
    { "type": "header", "content": "t:blocks.all.override_header" },
    { "type": "select", "id": "override_font", "label": "t:blocks.all.override_font.label", "options": [
      { "value": "inherit", "label": "t:blocks.all.inherit.label" }, { "value": "accent", "label": "t:settings_schema.typography.roles.accent" },
      { "value": "body", "label": "t:settings_schema.typography.roles.body" }, { "value": "subheading", "label": "t:settings_schema.typography.roles.subheading" },
      { "value": "heading", "label": "t:settings_schema.typography.roles.heading" }
    ], "default": "inherit" },
    { "type": "select", "id": "override_size", "label": "t:blocks.all.override_size.label", "options": [
      { "value": "inherit", "label": "t:blocks.all.inherit.label" }, { "value": "3xs", "label": "t:settings_schema.typography.scale.3xs" },
      { "value": "2xs", "label": "t:settings_schema.typography.scale.2xs" }, { "value": "xs", "label": "t:settings_schema.typography.scale.xs" },
      { "value": "sm", "label": "t:settings_schema.typography.scale.sm" }, { "value": "md", "label": "t:settings_schema.typography.scale.md" },
      { "value": "lg", "label": "t:settings_schema.typography.scale.lg" }, { "value": "xl", "label": "t:settings_schema.typography.scale.xl" },
      { "value": "2xl", "label": "t:settings_schema.typography.scale.2xl" }, { "value": "3xl", "label": "t:settings_schema.typography.scale.3xl" },
      { "value": "4xl", "label": "t:settings_schema.typography.scale.4xl" }, { "value": "5xl", "label": "t:settings_schema.typography.scale.5xl" },
      { "value": "6xl", "label": "t:settings_schema.typography.scale.6xl" }, { "value": "7xl", "label": "t:settings_schema.typography.scale.7xl" },
      { "value": "8xl", "label": "t:settings_schema.typography.scale.8xl" }
    ], "default": "inherit" },
    { "type": "color", "id": "color", "label": "t:blocks.all.text_color.label", "info": "t:blocks.all.text_color.info" },
