      { "value": "relaxed", "label": "t:settings_schema.typography.leading.relaxed" }, { "value": "loose", "label": "t:settings_schema.typography.leading.loose" }
    ], "default": "inherit" },
    { "type": "select", "id": "override_case", "label": "t:blocks.all.override_case.label", "options": [
      { "value": "inherit", "label": "t:blocks.all.inherit.label" }, { "value": "default", "label": "t:settings_schema.typography.case.default" },
      { "value": "uppercase", "label": "t:settings_schema.typography.case.uppercase" }, { "value": "lowercase", "label": "t:settings_schema.typography.case.lowercase" },
      { "value": "capitalize", "label": "t:settings_schema.typography.case.capitalize" }
    ], "default": "inherit" },
    { "type": "select", "id": "override_tracking", "label": "t:blocks.all.override_tracking.label", "options": [
      { "value": "inherit", "label": "t:blocks.all.inherit.label" }, { "value": "tighter", "label": "t:settings_schema.typography.tracking.tighter" },
      { "value": "tight", "label": "t:settings_schema.typography.tracking.tight" }, { "value": "normal", "label": "t:settings_schema.typography.tracking.normal" },
      { "value": "wide", "label": "t:settings_schema.typography.tracking.wide" }, { "value": "wider", "label": "t:settings_schema.typography.tracking.wider" }
    ], "default": "inherit" },
    { "type": "select", "id": "alignment", "label": "t:sections.all.content_alignment.label", "info": "t:sections.all.content_alignment.info", "options": [
      { "value": "inherit", "label": "t:settings_schema.options.inherit" }, { "value": "left", "label": "t:settings_schema.options.left" },
      { "value": "center", "label": "t:settings_schema.options.center" }, { "value": "right", "label": "t:settings_schema.options.right" }
    ], "default": "inherit" }
  ],
  "presets": [{ "name": "t:sections.main_product.blocks.description", "settings": { "style": "paragraph" } }]
}
