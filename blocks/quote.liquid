{%- comment -%}
  One testimonial: the quotation and who said it.

  **The block cannot know it is the first, and the first is the one that shows.**
  The section used to write `is-active` onto it with `forloop.first`, so the
  opening quote was visible at first paint and stayed visible for a visitor
  without scripting. A theme block has no index, so that moved into `base.css`
  as `.quotes:not(:has(.quote.is-active)) .quote:first-child` — the first quote
  shows exactly while *no* quote is active, which is true before `theme.js`
  takes over and never true after it. `initQuotes` needed no change at all.

  That guard also covers a case Liquid used to carry by accident: with a single
  quote the script returns early and sets `is-active` on nothing, so the lone
  quote would have been left at opacity 0.

  `"tag": null` because the figure has to *be* the grid item. `.quotes` stacks
  every quote in `grid-area: 1 / 1` and cross-fades between them; a generated
  wrapper would take that cell and the quotes inside would stack vertically
  instead of overlapping.
{%- endcomment -%}

<figure class="quote" data-quote {{ block.shopify_attributes }}>
  <blockquote class="quote__text">&ldquo;{{ block.settings.text }}&rdquo;</blockquote>
  {%- if block.settings.author != blank -%}
    <figcaption class="quote__author">{{ block.settings.author }}</figcaption>
  {%- endif -%}
</figure>

{% schema %}
{
  "name": "t:blocks.quote.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:blocks.quote.text.label",
      "default": "The craftsmanship is extraordinary and the service even more so."
    },
    {
      "type": "text",
      "id": "author",
      "label": "t:blocks.quote.author.label",
      "default": "Manjit Kaur — Google Review"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.quote.name",
      "settings": {
        "text": "The craftsmanship is extraordinary and the service even more so.",
        "author": "Manjit Kaur — Google Review"
      }
    }
  ]
}
{% endschema %}
