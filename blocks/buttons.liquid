{%- comment -%}
  A row of up to two buttons.

  This is the collapse the whole component pass was aiming at. about, craft and
  visit each carried a local `buttons` block with the same ten settings, and
  the markup was already shared through `snippets/button.liquid` — but a schema
  cannot be shared between sections, so the settings stayed duplicated three
  times. As a theme block they are declared once and every section lists the
  type.

  **The type name is deliberately unchanged.** A block type is a data contract:
  every stored instance in `templates/index.json` says `"type": "buttons"`, and
  keeping the name is what lets those instances carry over rather than being
  discarded as unknown. See the note under "Things that cost time once".

  Two buttons rather than a block apiece, because they are a *pair*: the design
  puts a primary beside a secondary on one row, `.btn-row` is what spaces them,
  and two independent blocks could be dragged apart into two rows.

  A button with no label or no link renders nothing at all — `button.liquid`
  enforces that, so a half-filled block leaves no empty row behind.
{%- endcomment -%}

<div class="btn-row" {{ block.shopify_attributes }}>
  {%- render 'button',
    label: block.settings.button_label,
    link: block.settings.button_link,
    style: block.settings.button_style,
    size: block.settings.button_size,
    radius: block.settings.button_radius -%}
  {%- render 'button',
    label: block.settings.button_label_2,
    link: block.settings.button_link_2,
    style: block.settings.button_style_2,
    size: block.settings.button_size_2,
    radius: block.settings.button_radius_2 -%}
</div>

{% schema %}
{
  "name": "t:blocks.buttons.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.all.link_label.label",
      "default": "Our Full Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.all.link.label"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:sections.all.button_style.label",
      "options": [
        { "value": "filled", "label": "t:settings_schema.button_style.filled" },
        { "value": "outline", "label": "t:settings_schema.button_style.outline" },
        { "value": "link", "label": "t:settings_schema.button_style.link" },
        { "value": "quiet", "label": "t:settings_schema.button_style.quiet" },
        { "value": "arrow", "label": "t:settings_schema.button_style.arrow" },
        { "value": "arrow_outline", "label": "t:settings_schema.button_style.arrow_outline" }
      ],
      "default": "filled"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "t:sections.all.button_size.label",
      "options": [
        { "value": "inherit", "label": "t:settings_schema.button_size.inherit" },
        { "value": "xs", "label": "t:settings_schema.button_size.xs" },
        { "value": "sm", "label": "t:settings_schema.button_size.sm" },
        { "value": "md", "label": "t:settings_schema.button_size.md" },
        { "value": "lg", "label": "t:settings_schema.button_size.lg" },
        { "value": "xl", "label": "t:settings_schema.button_size.xl" }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "button_radius",
      "label": "t:sections.all.button_radius.label",
      "options": [
        { "value": "inherit", "label": "t:settings_schema.button_radius.inherit" },
        { "value": "square", "label": "t:settings_schema.button_radius.square" },
        { "value": "soft", "label": "t:settings_schema.button_radius.soft" },
        { "value": "rounded", "label": "t:settings_schema.button_radius.rounded" },
        { "value": "pill", "label": "t:settings_schema.button_radius.pill" }
      ],
      "default": "inherit"
    },
    {
      "type": "header",
      "content": "t:blocks.buttons.second_header"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "t:sections.all.link_label.label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "t:sections.all.link.label"
    },
    {
      "type": "select",
      "id": "button_style_2",
      "label": "t:sections.all.button_style.label",
      "options": [
        { "value": "filled", "label": "t:settings_schema.button_style.filled" },
        { "value": "outline", "label": "t:settings_schema.button_style.outline" },
        { "value": "link", "label": "t:settings_schema.button_style.link" },
        { "value": "quiet", "label": "t:settings_schema.button_style.quiet" },
        { "value": "arrow", "label": "t:settings_schema.button_style.arrow" },
        { "value": "arrow_outline", "label": "t:settings_schema.button_style.arrow_outline" }
      ],
      "default": "link"
    },
    {
      "type": "select",
      "id": "button_size_2",
      "label": "t:sections.all.button_size.label",
      "options": [
        { "value": "inherit", "label": "t:settings_schema.button_size.inherit" },
        { "value": "xs", "label": "t:settings_schema.button_size.xs" },
        { "value": "sm", "label": "t:settings_schema.button_size.sm" },
        { "value": "md", "label": "t:settings_schema.button_size.md" },
        { "value": "lg", "label": "t:settings_schema.button_size.lg" },
        { "value": "xl", "label": "t:settings_schema.button_size.xl" }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "button_radius_2",
      "label": "t:sections.all.button_radius.label",
      "options": [
        { "value": "inherit", "label": "t:settings_schema.button_radius.inherit" },
        { "value": "square", "label": "t:settings_schema.button_radius.square" },
        { "value": "soft", "label": "t:settings_schema.button_radius.soft" },
        { "value": "rounded", "label": "t:settings_schema.button_radius.rounded" },
        { "value": "pill", "label": "t:settings_schema.button_radius.pill" }
      ],
      "default": "inherit"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.buttons.name",
      "settings": {
        "button_label": "Our Full Story",
        "button_style": "filled",
        "button_style_2": "link"
      }
    }
  ]
}
{% endschema %}
