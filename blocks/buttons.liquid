{%- comment -%}
  A row of up to two buttons.

  This is the collapse the whole component pass was aiming at. about, craft and
  visit each carried a local `buttons` block with the same ten settings, and
  the markup was already shared through `snippets/button.liquid` — but a schema
  cannot be shared between sections, so the settings stayed duplicated three
  times. As a theme block they are declared once and every section lists the
  type.

  **The type name is deliberately unchanged.** A block type is a data contract:
  every stored instance in `templates/index.json` says `"type": "buttons"`, and
  keeping the name is what lets those instances carry over rather than being
  discarded as unknown. See the note under "Things that cost time once".

  Two buttons rather than a block apiece, because they are a *pair*: the design
  puts a primary beside a secondary on one row, `.btn-row` is what spaces them,
  and two independent blocks could be dragged apart into two rows.

  A button with no label or no link renders nothing at all — `button.liquid`
  enforces that, so a half-filled block leaves no empty row behind.
{%- endcomment -%}

{%- liquid
  comment
    A button may point at one of the shop's own facts rather than at a URL the
    merchant retypes. The shop states its address, telephone and email once, as
    theme settings, and this is how a button reaches them — the same `source`
    idea the detail block uses, and the reason templates/index.json stores no
    map URL for Visit's "Get Directions".

    It is a fallback, not an override: an explicit link always wins, so a
    merchant can point the button anywhere without first changing the source.
  endcomment
  assign link_1 = block.settings.button_link
  assign link_2 = block.settings.button_link_2

  comment
    "This section's collection" is how a row's own link out is built — the
    "View All" beside a products list. It reads `section.settings.collection`,
    which a theme block *can* do (measured: section.settings, section.id and
    section.blocks.size all resolve inside a block; section.type does not).

    That is a deliberate exception to the rule that a block reads nothing from
    its parent. It is safe because it degrades rather than breaks: a section
    with no `collection` setting falls through to all products, so the button
    still has a real destination and never becomes the `href="#"` this theme
    refuses to ship.
  endcomment
  assign row_collection_url = collections[section.settings.collection].url | default: routes.all_products_collection_url

  case block.settings.button_link_source
    when 'collection'
      assign link_1 = link_1 | default: row_collection_url
    when 'address'
      assign link_1 = link_1 | default: settings.shop_address_link
    when 'email'
      if link_1 == blank and settings.shop_email != blank
        assign link_1 = settings.shop_email | prepend: 'mailto:'
      endif
    when 'phone'
      if link_1 == blank and settings.shop_phone != blank
        assign link_1 = settings.shop_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | prepend: 'tel:'
      endif
  endcase

  case block.settings.button_link_source_2
    when 'collection'
      assign link_2 = link_2 | default: row_collection_url
    when 'address'
      assign link_2 = link_2 | default: settings.shop_address_link
    when 'email'
      if link_2 == blank and settings.shop_email != blank
        assign link_2 = settings.shop_email | prepend: 'mailto:'
      endif
    when 'phone'
      if link_2 == blank and settings.shop_phone != blank
        assign link_2 = settings.shop_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | prepend: 'tel:'
      endif
  endcase

  assign ext_1 = false
  if link_1 contains '://'
    assign ext_1 = true
  endif
  assign ext_2 = false
  if link_2 contains '://'
    assign ext_2 = true
  endif
-%}

<div class="btn-row" {{ block.shopify_attributes }}>
  {%- render 'button',
    label: block.settings.button_label,
    link: link_1,
    new_tab: ext_1,
    style: block.settings.button_style,
    size: block.settings.button_size,
    radius: block.settings.button_radius -%}
  {%- render 'button',
    label: block.settings.button_label_2,
    link: link_2,
    new_tab: ext_2,
    style: block.settings.button_style_2,
    size: block.settings.button_size_2,
    radius: block.settings.button_radius_2 -%}
</div>

{% schema %}
{
  "name": "t:blocks.buttons.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.all.link_label.label",
      "default": "Our Full Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.all.link.label"
    },
    {
      "type": "select",
      "id": "button_link_source",
      "label": "t:blocks.buttons.link_source.label",
      "info": "t:blocks.buttons.link_source.info",
      "options": [
        { "value": "custom", "label": "t:blocks.detail.source.custom" },
        { "value": "collection", "label": "t:blocks.buttons.link_source.collection" },
        { "value": "address", "label": "t:blocks.detail.source.address" },
        { "value": "phone", "label": "t:blocks.detail.source.phone" },
        { "value": "email", "label": "t:blocks.detail.source.email" }
      ],
      "default": "custom"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:sections.all.button_style.label",
      "options": [
        { "value": "filled", "label": "t:settings_schema.button_style.filled" },
        { "value": "outline", "label": "t:settings_schema.button_style.outline" },
        { "value": "link", "label": "t:settings_schema.button_style.link" },
        { "value": "quiet", "label": "t:settings_schema.button_style.quiet" },
        { "value": "arrow", "label": "t:settings_schema.button_style.arrow" },
        { "value": "arrow_outline", "label": "t:settings_schema.button_style.arrow_outline" }
      ],
      "default": "filled"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "t:sections.all.button_size.label",
      "options": [
        { "value": "inherit", "label": "t:settings_schema.button_size.inherit" },
        { "value": "xs", "label": "t:settings_schema.button_size.xs" },
        { "value": "sm", "label": "t:settings_schema.button_size.sm" },
        { "value": "md", "label": "t:settings_schema.button_size.md" },
        { "value": "lg", "label": "t:settings_schema.button_size.lg" },
        { "value": "xl", "label": "t:settings_schema.button_size.xl" }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "button_radius",
      "label": "t:sections.all.button_radius.label",
      "options": [
        { "value": "inherit", "label": "t:settings_schema.button_radius.inherit" },
        { "value": "square", "label": "t:settings_schema.button_radius.square" },
        { "value": "soft", "label": "t:settings_schema.button_radius.soft" },
        { "value": "rounded", "label": "t:settings_schema.button_radius.rounded" },
        { "value": "pill", "label": "t:settings_schema.button_radius.pill" }
      ],
      "default": "inherit"
    },
    {
      "type": "header",
      "content": "t:blocks.buttons.second_header"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "t:sections.all.link_label.label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "t:sections.all.link.label"
    },
    {
      "type": "select",
      "id": "button_link_source_2",
      "label": "t:blocks.buttons.link_source.label",
      "info": "t:blocks.buttons.link_source.info",
      "options": [
        { "value": "custom", "label": "t:blocks.detail.source.custom" },
        { "value": "collection", "label": "t:blocks.buttons.link_source.collection" },
        { "value": "address", "label": "t:blocks.detail.source.address" },
        { "value": "phone", "label": "t:blocks.detail.source.phone" },
        { "value": "email", "label": "t:blocks.detail.source.email" }
      ],
      "default": "custom"
    },
    {
      "type": "select",
      "id": "button_style_2",
      "label": "t:sections.all.button_style.label",
      "options": [
        { "value": "filled", "label": "t:settings_schema.button_style.filled" },
        { "value": "outline", "label": "t:settings_schema.button_style.outline" },
        { "value": "link", "label": "t:settings_schema.button_style.link" },
        { "value": "quiet", "label": "t:settings_schema.button_style.quiet" },
        { "value": "arrow", "label": "t:settings_schema.button_style.arrow" },
        { "value": "arrow_outline", "label": "t:settings_schema.button_style.arrow_outline" }
      ],
      "default": "link"
    },
    {
      "type": "select",
      "id": "button_size_2",
