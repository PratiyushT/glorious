{%- comment -%}
  A body paragraph under a heading, as a block.

  **Named for what it is, not for where it first appeared.** The class was
  `.lookbook__intro` — the theme's one lede, but named after the single section
  that happened to own it. It is `.section-lede` now, and the lookbook uses that
  too, so a second caller does not have to choose between an odd class name and
  forking the numbers.

  Carries default text for the reason the subheading does: a block that renders
  nothing until it is filled in is invisible the moment it is added, with no
  element for the editor to select, which reads as a broken block rather than
  an empty one.
{%- endcomment -%}


{%- liquid
  assign align_class = ''
  if block.settings.alignment != blank and block.settings.alignment != 'inherit'
    assign align_class = ' align-' | append: block.settings.alignment
  endif
-%}
{%- if block.settings.text != blank -%}
  <p
    class="section-lede reveal{{ align_class }}"
    style="{% render 'block-spacing', padding: block.settings.padding %}"
    {{ block.shopify_attributes }}
  >{{ block.settings.text }}</p>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.paragraph.name",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.all.content_alignment.label",
      "info": "t:sections.all.content_alignment.info",
      "options": [
        { "value": "inherit", "label": "t:settings_schema.options.inherit" },
        { "value": "left", "label": "t:settings_schema.options.left" },
        { "value": "center", "label": "t:settings_schema.options.center" },
        { "value": "right", "label": "t:settings_schema.options.right" }
      ],
      "default": "inherit"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.all.text.label",
      "default": "Share a sentence or two about what this collection is for."
    },
    {
      "type": "header",
      "content": "t:blocks.all.spacing_header"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "t:blocks.all.padding.label",
      "options": [
        { "value": "none", "label": "t:blocks.all.step.none" },
        { "value": "tiny", "label": "t:blocks.all.step.tiny" },
        { "value": "small", "label": "t:blocks.all.step.small" },
        { "value": "medium", "label": "t:blocks.all.step.medium" },
        { "value": "large", "label": "t:blocks.all.step.large" },
        { "value": "xlarge", "label": "t:blocks.all.step.xlarge" }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.paragraph.name",
      "settings": {
        "text": "Share a sentence or two about what this collection is for.",
        "padding": "none"
      }
    }
  ]
}
{% endschema %}
