{%- comment -%}
  The editable layout of one Hotspot card.

  This private wrapper uses the global Group renderer and complete Group setting
  contract, but its targeted children exist only inside Hotspot.
{%- endcomment -%}

{%- capture group_content -%}{% content_for 'blocks' %}{%- endcapture -%}
{% render 'layout-group', layout_settings: block.settings, content: group_content, attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "t:blocks.hotspot_card.name",
  "tag": null,
  "blocks": [{ "type": "group" }, { "type": "_hotspot-actions" }],
  "settings": [
    {
      "type": "select",
      "id": "direction",
      "label": "t:blocks.group.direction.label",
      "info": "t:blocks.group.direction.info",
      "options": [
        { "value": "horizontal", "label": "t:blocks.group.direction.horizontal" },
        { "value": "vertical", "label": "t:blocks.group.direction.vertical" }
      ],
      "default": "horizontal"
    },
    {
      "type": "select",
      "id": "distribute",
      "label": "t:blocks.group.distribute.label",
      "info": "t:blocks.group.distribute.info",
      "options": [
        { "value": "start", "label": "t:blocks.group.distribute.start" },
        { "value": "center", "label": "t:blocks.group.distribute.center" },
        { "value": "end", "label": "t:blocks.group.distribute.end" },
        { "value": "between", "label": "t:blocks.group.distribute.between" }
      ],
      "default": "between",
      "visible_if": "{{ block.settings.direction == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "align",
      "label": "t:blocks.group.align.label_horizontal",
      "info": "t:blocks.group.align.info_horizontal",
      "options": [
        { "value": "baseline", "label": "t:blocks.group.align.text" },
        { "value": "start", "label": "t:blocks.group.align.top" },
        { "value": "center", "label": "t:blocks.group.align.middle" },
        { "value": "end", "label": "t:blocks.group.align.bottom" },
        { "value": "stretch", "label": "t:blocks.group.align.equal_height" }
      ],
      "default": "baseline",
      "visible_if": "{{ block.settings.direction == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "align_vertical",
      "label": "t:blocks.group.align.label_vertical",
      "info": "t:blocks.group.align.info_vertical",
      "options": [
        { "value": "start", "label": "t:blocks.group.align.left" },
        { "value": "center", "label": "t:blocks.group.align.centre" },
        { "value": "end", "label": "t:blocks.group.align.right" },
        { "value": "stretch", "label": "t:blocks.group.align.full_width" }
      ],
      "default": "start",
      "visible_if": "{{ block.settings.direction == 'vertical' }}"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:blocks.group.content_alignment.label",
      "info": "t:blocks.group.content_alignment.info",
      "options": [
        { "value": "inherit", "label": "t:blocks.group.content_alignment.inherit" },
        { "value": "left", "label": "t:settings_schema.options.left" },
        { "value": "center", "label": "t:settings_schema.options.center" },
        { "value": "right", "label": "t:settings_schema.options.right" }
      ],
      "default": "inherit",
      "visible_if": "{{ block.settings.direction == 'vertical' and block.settings.align_vertical == 'stretch' or block.settings.direction == 'horizontal' and block.settings.items_width == 'equal' }}"
    },
    {
      "type": "checkbox",
      "id": "wrap",
      "label": "t:blocks.group.wrap.label",
      "info": "t:blocks.group.wrap.info",
      "default": true,
      "visible_if": "{{ block.settings.direction == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "items_width",
      "label": "t:blocks.group.items_width.label",
      "info": "t:blocks.group.items_width.info",
      "options": [
        { "value": "natural", "label": "t:blocks.group.items_width.natural" },
        { "value": "equal", "label": "t:blocks.group.items_width.equal" }
      ],
      "default": "natural",
      "visible_if": "{{ block.settings.direction == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "items_height",
      "label": "t:blocks.group.items_height.label",
      "info": "t:blocks.group.items_height.info",
      "options": [
        { "value": "natural", "label": "t:blocks.group.items_height.natural" },
        { "value": "equal", "label": "t:blocks.group.items_height.equal" }
      ],
      "default": "natural",
      "visible_if": "{{ block.settings.direction == 'vertical' }}"
    },
   {
      "type": "select",
      "id": "stack_below",
      "label": "t:blocks.group.stack_below.label",
      "info": "t:blocks.group.stack_below.info",
      "options": [
        { "value": "never", "label": "t:blocks.group.stack_below.never" },
        { "value": "tablet", "label": "t:blocks.group.stack_below.tablet" },
        { "value": "mobile", "label": "t:blocks.group.stack_below.mobile" }
      ],
      "default": "mobile",
      "visible_if": "{{ block.settings.direction == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "content_alignment_mobile",
      "label": "t:blocks.group.content_alignment_mobile.label",
      "info": "t:blocks.group.content_alignment_mobile.info",
      "options": [
        { "value": "inherit", "label": "t:blocks.group.content_alignment_mobile.inherit" },
        { "value": "left", "label": "t:settings_schema.options.left" },
        { "value": "center", "label": "t:settings_schema.options.center" },
        { "value": "right", "label": "t:settings_schema.options.right" }
      ],
      "default": "inherit",
      "visible_if": "{{ block.settings.direction == 'horizontal' and block.settings.stack_below != 'never' }}"
    },
    {
      "type": "header",
      "content": "t:blocks.all.spacing_header",
      "visible_if": "{{ block.settings.direction == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "gap",
      "label": "t:blocks.group.gap.label",
      "info": "t:blocks.group.gap.info",
      "visible_if": "{{ block.settings.direction == 'horizontal' }}",
      "options": [
        { "value": "none", "label": "t:blocks.all.step.none" },
        { "value": "minimal", "label": "t:blocks.all.step.minimal" },
        { "value": "tiny", "label": "t:blocks.all.step.tiny" },
        { "value": "small", "label": "t:blocks.all.step.small" },
        { "value": "medium", "label": "t:blocks.all.step.medium" },
        { "value": "large", "label": "t:blocks.all.step.large" },
        { "value": "xlarge", "label": "t:blocks.all.step.xlarge" },
        { "value": "maximum", "label": "t:blocks.all.step.maximum" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "vertical_gap",
      "label": "t:blocks.group.vertical_gap_label",
      "info": "t:blocks.group.vertical_gap_info",
      "visible_if": "{{ block.settings.direction == 'vertical' }}",
      "options": [
        { "value": "inherit", "label": "t:blocks.group.vertical_gap_inherit" },
        { "value": "none", "label": "t:blocks.all.step.none" },
        { "value": "minimal", "label": "t:blocks.all.step.minimal" },
        { "value": "tiny", "label": "t:blocks.all.step.tiny" },
        { "value": "small", "label": "t:blocks.all.step.small" },
        { "value": "medium", "label": "t:blocks.all.step.medium" },
        { "value": "large", "label": "t:blocks.all.step.large" },
        { "value": "xlarge", "label": "t:blocks.all.step.xlarge" },
        { "value": "maximum", "label": "t:blocks.all.step.maximum" }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "t:blocks.group.padding.label",
      "info": "t:blocks.group.padding.info",
      "options": [
        { "value": "none", "label": "t:blocks.all.step.none" },
        { "value": "minimal", "label": "t:blocks.all.step.minimal" },
        { "value": "tiny", "label": "t:blocks.all.step.tiny" },
        { "value": "small", "label": "t:blocks.all.step.small" },
        { "value": "medium", "label": "t:blocks.all.step.medium" },
        { "value": "large", "label": "t:blocks.all.step.large" },
        { "value": "xlarge", "label": "t:blocks.all.step.xlarge" },
        { "value": "maximum", "label": "t:blocks.all.step.maximum" }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "show_borders",
      "label": "t:blocks.group.show_borders_label",
      "info": "t:blocks.group.show_borders_info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:blocks.group.border_settings_header",
      "visible_if": "{{ block.settings.show_borders }}"
    },
    {
      "type": "range",
      "id": "group_border_width",
      "label": "t:blocks.group.border_width_label",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.show_borders }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:blocks.group.border_color_label",
      "info": "t:blocks.group.border_color_info",
      "visible_if": "{{ block.settings.show_borders }}"
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "t:blocks.group.border_top_label",
      "default": true,
      "visible_if": "{{ block.settings.show_borders }}"
    },
    {
      "type": "checkbox",
      "id": "border_right",
      "label": "t:blocks.group.border_right_label",
      "default": true,
      "visible_if": "{{ block.settings.show_borders }}"
    },
    {
      "type": "checkbox",
      "id": "border_bottom",
      "label": "t:blocks.group.border_bottom_label",
      "default": true,
      "visible_if": "{{ block.settings.show_borders }}"
    },
    {
      "type": "checkbox",
      "id": "border_left",
      "label": "t:blocks.group.border_left_label",
      "default": true,
      "visible_if": "{{ block.settings.show_borders }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.hotspot_card.name",
      "settings": {
        "direction": "vertical",
        "distribute": "between",
        "align": "baseline",
        "wrap": true,
        "items_width": "natural",
        "stack_below": "mobile",
        "content_alignment": "inherit",
        "content_alignment_mobile": "inherit",
        "gap": "medium",
        "vertical_gap": "small",
        "padding": "none",
        "show_borders": false,
        "group_border_width": 1,
        "border_top": true,
        "border_right": true,
        "border_bottom": true,
        "border_left": true
      }
    }
  ]
}
{% endschema %}
