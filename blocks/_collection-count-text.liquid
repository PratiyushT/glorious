{%- comment -%}
  Collection-only Text value. It is private so it can be offered only by
  collection-aware parents, while the shared renderer keeps every Text
  typography, element, alignment, layout, and spacing control.
{%- endcomment -%}

{%- liquid
  assign source_collection = closest.collection
  if source_collection == blank and section.settings.collection != blank
    assign source_collection = collections[section.settings.collection]
  endif
-%}

{%- if source_collection != blank -%}
  {% render 'text-block',
    block: block,
    content: source_collection.all_products_count,
    marker: 'data-collection-count-text'
  %}
{%- endif -%}

