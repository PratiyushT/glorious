{%- comment -%}
  A display heading, as a block.

  **Named for what it is, not for where it first appeared** — any section can
  list `title` in its `blocks` array and get this. It reads nothing from its
  parent, so it carries no assumption about which section it is in.

  `"tag": null` because the block owns its element: `.display` is the theme's
  own edge-to-edge heading and a generated wrapper would put a box between it
  and whatever follows, which is what the `.display + *` gap rule depends on.
{%- endcomment -%}


{%- liquid
  assign align_class = ''
  if block.settings.alignment != blank and block.settings.alignment != 'inherit'
    assign align_class = ' align-' | append: block.settings.alignment
  endif
-%}
{%- comment -%}
  The element is the merchant's choice, because a section title is a heading
  and a document needs its levels in order. It was always a `div`, so a page
  built from these blocks announced no headings at all.

  `"tag": null` still holds and matters more than ever: the block owns its one
  element, and a generated wrapper would break the `.display + .grid-auto`
  adjacency the gap rule depends on. Changing the tag keeps that — it is still
  a single element, and the rule matches on the class.
{%- endcomment -%}
{%- liquid
  assign heading_tag = block.settings.heading_level | default: 'h2'
  unless heading_tag == 'h1' or heading_tag == 'h2' or heading_tag == 'h3' or heading_tag == 'div'
    assign heading_tag = 'h2'
  endunless
-%}
{%- if block.settings.text != blank -%}
  <{{ heading_tag }} class="display reveal{{ align_class }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</{{ heading_tag }}>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.title.name",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "heading_level",
      "label": "t:sections.all.heading_level.label",
      "info": "t:sections.all.heading_level.info",
      "options": [
        { "value": "h1", "label": "t:settings_schema.heading_level.h1" },
        { "value": "h2", "label": "t:settings_schema.heading_level.h2" },
        { "value": "h3", "label": "t:settings_schema.heading_level.h3" },
        { "value": "div", "label": "t:settings_schema.heading_level.div" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.all.content_alignment.label",
      "info": "t:sections.all.content_alignment.info",
      "options": [
        { "value": "inherit", "label": "t:settings_schema.options.inherit" },
        { "value": "left", "label": "t:settings_schema.options.left" },
        { "value": "center", "label": "t:settings_schema.options.center" },
        { "value": "right", "label": "t:settings_schema.options.right" }
      ],
      "default": "inherit"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.all.heading.label",
      "default": "Our Products"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.title.name",
      "settings": {
        "text": "Our Products"
      }
    }
  ]
}
{% endschema %}
