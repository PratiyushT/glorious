{%- comment -%}
  Collection card — the band that wipes across the photograph on hover.

  Three elements, as the design has them: the veil, the rule that sits on it,
  and the label and the arrow as separate children of that rule. Each is styled
  by its own class rather than by `.cat-card__reveal span` — a *descendant*
  selector, which dressed the arrow as a second rule across the photograph and
  pushed the label onto two lines.

  It shares the media grid area with the image block, so it covers the
  photograph exactly without being nested inside it — which is what lets both
  be blocks a merchant can add and remove independently.

  `aria-hidden`, as before: the whole card is one link and its accessible name
  is the collection's, so this band would only repeat it.
{%- endcomment -%}

<span class="cat-card__reveal" aria-hidden="true" {{ block.shopify_attributes }}>
  <span class="cat-card__reveal-row">
    <span class="cat-card__reveal-label">{{ block.settings.label }}</span>
    <span class="cat-card__reveal-arrow">&rarr;</span>
  </span>
</span>

{% schema %}
{
  "name": "t:blocks.collection_card_reveal.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:blocks.collection_card_reveal.label.label",
      "default": "View pieces"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.collection_card_reveal.name"
    }
  ]
}
{% endschema %}
