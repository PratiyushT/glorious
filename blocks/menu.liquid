{%- comment -%}Reusable Shopify navigation menu for any composable section.{%- endcomment -%}
{%- assign menu_id = 'MenuBlock-' | append: block.id -%}
<nav class="menu-block" aria-label="{{ block.settings.heading | default: block.settings.menu.title | escape }}" {{ block.shopify_attributes }}>
  {%- if block.settings.heading != blank -%}
    <p class="menu-block__heading" style="{% render 'text-style', preset: block.settings.heading_style %}">{{ block.settings.heading }}</p>
  {%- endif -%}
  <ul class="menu-block__list menu-block__list--{{ block.settings.layout }}" id="{{ menu_id }}" role="list">
    {%- for link in block.settings.menu.links -%}
      <li>
        <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- if block.settings.show_nested and link.links.size > 0 -%}
          <ul class="menu-block__children" role="list">
            {%- for child_link in link.links -%}
              <li><a href="{{ child_link.url }}"{% if child_link.current %} aria-current="page"{% endif %}>{{ child_link.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>

{% schema %}
{
  "name": "t:blocks.menu.name",
  "tag": null,
  "settings": [
    { "type": "link_list", "id": "menu", "label": "t:blocks.menu.menu.label", "default": "main-menu" },
    { "type": "inline_richtext", "id": "heading", "label": "t:blocks.menu.heading.label" },
    {
      "type": "select", "id": "heading_style", "label": "t:blocks.menu.heading_style.label",
      "options": [
        { "value": "heading_3", "label": "t:settings_schema.typography.presets.heading_3.header" },
        { "value": "heading_4", "label": "t:settings_schema.typography.presets.heading_4.header" },
        { "value": "heading_5", "label": "t:settings_schema.typography.presets.heading_5.header" },
        { "value": "subheading", "label": "t:settings_schema.typography.presets.subheading.header" },
        { "value": "caption", "label": "t:settings_schema.typography.presets.caption.header" }
      ], "default": "subheading", "visible_if": "{{ block.settings.heading != blank }}"
    },
    {
      "type": "select", "id": "layout", "label": "t:blocks.menu.layout.label",
      "options": [
        { "value": "vertical", "label": "t:blocks.menu.layout.vertical" },
        { "value": "horizontal", "label": "t:blocks.menu.layout.horizontal" }
      ], "default": "vertical"
    },
    { "type": "checkbox", "id": "show_nested", "label": "t:blocks.menu.show_nested.label", "default": true }
  ],
  "presets": [{ "name": "t:blocks.menu.name" }]
}
{% endschema %}
