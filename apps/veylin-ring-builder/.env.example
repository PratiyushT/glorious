SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
# Add read_orders on the production host only after Shopify approves protected order data.
SCOPES=read_content,read_online_store_navigation,read_products,read_publications,write_app_proxy,write_content,write_online_store_navigation,write_products,write_publications

NIVODA_API_URL=https://intg-customer-staging.nivodaapi.net/api/diamonds
NIVODA_USERNAME=
NIVODA_PASSWORD=
NIVODA_DESTINATION_ID=
NIVODA_ORDER_MODE=disabled
# Complete-ring ordering uses a separately approved HTTPS adapter contract.
# Keep disabled unless Nivoda (or another approved supplier) provides that endpoint.
NIVODA_RING_ORDER_MODE=disabled
NIVODA_RING_ORDER_URL=
NIVODA_RING_ORDER_SECRET=
# Required by the authenticated background worker route in production.
# Use independent random secrets of at least 32 characters for both values.
SUPPLIER_ORDER_WORKER_SECRET=

RING_BUILDER_PROVIDER_MODE=fixture
RING_BUILDER_CACHE_SECONDS=30
RING_BUILDER_VARIANT_TTL_MINUTES=15
RING_BUILDER_RETAIL_MARKUP_PERCENT=25
RING_BUILDER_PRICE_DIVISOR=100
RING_BUILDER_SEARCH_PRICE_MODE=retail
RING_BUILDER_ALLOWED_SHOP=
