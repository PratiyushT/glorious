<script src="{{ 'ring-builder.js' | asset_url }}" defer="defer"></script>

{%- capture builder_loader_markup -%}
  <span class="loader loader--lg" role="status">
    {%- case settings.loader_style -%}
      {%- when 'ring' -%}
        <svg class="icon-svg loader__mark" viewBox="0 0 96 84" fill="none" aria-hidden="true" focusable="false"><path class="loader__line" style="--n: 0; --exit: gj-loader-exit-outline;" pathLength="100" d="M48 26a26 26 0 1 0 0 52a26 26 0 1 0 0-52z"/><path class="loader__line" style="--n: 2; --exit: gj-loader-exit-girdle;" pathLength="100" d="M48 4L58 14L48 24L38 14z"/><path class="loader__line" style="--n: 3; --exit: gj-loader-exit-inner-3;" pathLength="100" d="M38 14h20"/></svg>
      {%- when 'orbit' -%}
        <svg class="icon-svg loader__mark" viewBox="0 0 96 84" fill="none" aria-hidden="true" focusable="false"><path class="loader__line" style="--n: 0; --exit: gj-loader-exit-outline;" pathLength="100" d="M14 42a34 34 0 0 1 34-34"/><path class="loader__line" style="--n: 0; --exit: gj-loader-exit-outline;" pathLength="100" d="M82 42a34 34 0 0 1-34 34"/><path class="loader__line" style="--n: 2; --exit: gj-loader-exit-inner-2;" pathLength="100" d="M48 32L57 42L48 52L39 42z"/><path class="loader__line" style="--n: 3; --exit: gj-loader-exit-girdle;" pathLength="100" d="M39 42h18"/></svg>
      {%- else -%}
        <svg class="icon-svg loader__mark" viewBox="2 10 96 84" fill="none" aria-hidden="true" focusable="false"><path class="loader__line" style="--n: 0; --exit: gj-loader-exit-outline;" pathLength="100" d="M30 12h40l26 26-46 54-46-54z"/><path class="loader__line" style="--n: 1; --exit: gj-loader-exit-girdle;" pathLength="100" d="M4 38h92"/><path class="loader__line" style="--n: 2; --exit: gj-loader-exit-inner-2;" pathLength="100" d="M30 12L50 38"/><path class="loader__line" style="--n: 2; --exit: gj-loader-exit-inner-2;" pathLength="100" d="M70 12L50 38"/><path class="loader__line" style="--n: 3; --exit: gj-loader-exit-inner-3;" pathLength="100" d="M30 12L26 38"/><path class="loader__line" style="--n: 3; --exit: gj-loader-exit-inner-3;" pathLength="100" d="M70 12L74 38"/><path class="loader__line" style="--n: 4; --exit: gj-loader-exit-inner-4;" pathLength="100" d="M50 38L50 92"/><path class="loader__line" style="--n: 5; --exit: gj-loader-exit-inner-5;" pathLength="100" d="M26 38L50 92"/><path class="loader__line" style="--n: 5; --exit: gj-loader-exit-inner-5;" pathLength="100" d="M74 38L50 92"/></svg>
    {%- endcase -%}
    <span class="visually-hidden">{{ 'ring_builder.loading' | t }}</span>
  </span>
{%- endcapture -%}

<div
  class="ring-builder"
  data-ring-builder
  data-proxy-path="/apps/veylin-ring-builder"
  data-initial-step="settings"
  data-results-per-page="24"
  data-currency="{{ cart.currency.iso_code | default: localization.country.currency.iso_code | default: 'USD' }}"
  data-sticky-summary
  data-card-text-align="{{ block.settings.card_text_align }}"
  data-card-image-ratio="{{ block.settings.card_image_ratio }}"
  data-card-image-fit="{{ block.settings.card_image_fit }}"
  data-card-animation="{{ block.settings.card_animation }}"
  data-show-card-media="{{ block.settings.show_card_media }}"
  data-show-card-badges="{{ block.settings.show_card_badges }}"
  data-show-card-vendor="{{ block.settings.show_card_vendor }}"
  data-show-card-title="{{ block.settings.show_card_title }}"
  data-show-card-options="{{ block.settings.show_card_options }}"
  data-show-card-price="{{ block.settings.show_card_price }}"
  data-show-card-action="{{ block.settings.show_card_action }}"
  data-quick-view-desktop="{{ block.settings.quick_view_desktop }}"
  data-quick-view-compact="{{ block.settings.quick_view_compact }}"
  data-show-quick-media="{{ block.settings.show_quick_media }}"
  data-quick-media-controls="{{ block.settings.quick_media_controls }}"
  data-show-quick-badges="{{ block.settings.show_quick_badges }}"
  data-show-quick-vendor="{{ block.settings.show_quick_vendor }}"
  data-show-quick-title="{{ block.settings.show_quick_title }}"
  data-show-quick-price="{{ block.settings.show_quick_price }}"
  data-show-quick-options="{{ block.settings.show_quick_options }}"
  data-show-quick-description="{{ block.settings.show_quick_description }}"
  data-show-quick-specs="{{ block.settings.show_quick_specs }}"
  data-show-quick-action="{{ block.settings.show_quick_action }}"
>
  <header class="ring-builder__header ring-builder__header--center">
    <p class="ring-builder__eyebrow">{{ 'ring_builder.eyebrow' | t }}</p>
    <h1 class="ring-builder__title">{{ 'ring_builder.heading' | t }}</h1>
    <p class="ring-builder__introduction">{{ 'ring_builder.introduction' | t }}</p>
    <div class="ring-builder__test-banner" data-fixture-banner hidden>
      <strong>{{ 'ring_builder.test_heading' | t }}</strong>
      <span>{{ 'ring_builder.test_text' | t }}</span>
    </div>
    <div class="ring-builder__test-banner" data-staging-banner hidden>
      <strong>{{ 'ring_builder.staging_heading' | t }}</strong>
      <span>{{ 'ring_builder.staging_text' | t }}</span>
    </div>
  </header>

  <div class="ring-builder__progress" role="tablist" aria-label="{{ 'ring_builder.steps.label' | t }}">
    <button class="ring-builder__step" type="button" role="tab" data-builder-tab="settings">
      <span aria-hidden="true">01</span>
      {{- 'ring_builder.steps.setting' | t -}}
    </button>
    <button class="ring-builder__step" type="button" role="tab" data-builder-tab="diamonds">
      <span aria-hidden="true">02</span>
      {{- 'ring_builder.steps.diamond' | t -}}
    </button>
    <button class="ring-builder__step" type="button" role="tab" data-builder-tab="review" disabled>
      <span aria-hidden="true">03</span>
      {{- 'ring_builder.steps.review' | t -}}
    </button>
  </div>

  <div class="ring-builder__shell">
    <div class="ring-builder__workspace">
      <div class="ring-builder__notice" data-builder-notice hidden>
        <p data-builder-notice-text></p>
        <button class="btn btn--outline" type="button" data-builder-retry hidden>
          {{ 'ring_builder.actions.retry' | t }}
        </button>
      </div>

      <div class="ring-builder__panel" role="tabpanel" data-builder-panel="settings">
        <div class="ring-builder__panel-head">
          <div>
            <p class="ring-builder__eyebrow">{{ 'ring_builder.steps.setting' | t }}</p>
            <h2>{{ 'ring_builder.setting_heading' | t }}</h2>
          </div>
          <p>{{ 'ring_builder.setting_help' | t }}</p>
        </div>
        <div class="ring-builder__loader" data-settings-loader aria-live="polite">
          {{ builder_loader_markup }}
        </div>
        <div class="ring-builder__settings-grid" data-setting-results></div>
        <div class="ring-builder__empty" data-settings-empty hidden>
          <h3>{{ 'ring_builder.empty_settings_heading' | t }}</h3>
          <p>{{ 'ring_builder.empty_settings_text' | t }}</p>
        </div>
      </div>

      <div class="ring-builder__panel" role="tabpanel" data-builder-panel="diamonds" hidden>
        <div class="ring-builder__panel-head">
          <div>
            <p class="ring-builder__eyebrow">{{ 'ring_builder.steps.diamond' | t }}</p>
            <h2>{{ 'ring_builder.diamond_heading' | t }}</h2>
          </div>
          <p>{{ 'ring_builder.diamond_help' | t }}</p>
        </div>

        <form class="ring-builder__filters" data-diamond-filters>
          <label>
            <span>{{ 'ring_builder.filters.origin' | t }}</span>
            <select class="ring-builder__field" name="source">
              <option value="both">{{ 'ring_builder.filters.both' | t }}</option>
              <option value="natural">{{ 'ring_builder.filters.natural' | t }}</option>
              <option value="lab">{{ 'ring_builder.filters.lab' | t }}</option>
            </select>
          </label>
          <fieldset class="ring-builder__shape-filter">
            <legend>{{ 'ring_builder.filters.shape' | t }}</legend>
            <div>
              {%- assign shapes = 'ROUND,OVAL,PRINCESS,CUSHION,EMERALD,PEAR,HEART,MARQUISE,RADIANT,ASSCHER' | split: ',' -%}
              {%- for shape in shapes -%}
                <label>
                  <input type="checkbox" name="shapes" value="{{ shape }}">
                  <span>{{ shape | capitalize }}</span>
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
          <div class="ring-builder__filter-grid">
            <label>
              <span>{{ 'ring_builder.filters.carat_from' | t }}</span>
              <input class="ring-builder__field" name="minCarat" type="number" min="0.001" max="30" step="0.01" value="0.5">
            </label>
            <label>
              <span>{{ 'ring_builder.filters.carat_to' | t }}</span>
              <input class="ring-builder__field" name="maxCarat" type="number" min="0.001" max="30" step="0.01" value="3">
            </label>
            <label>
              <span>{{ 'ring_builder.filters.price_from' | t }}</span>
              <input class="ring-builder__field" name="minPrice" type="number" min="0" step="100" value="0">
            </label>
            <label>
              <span>{{ 'ring_builder.filters.price_to' | t }}</span>
              <input class="ring-builder__field" name="maxPrice" type="number" min="0" step="100" value="20000">
            </label>
            <label>
              <span>{{ 'ring_builder.filters.sort' | t }}</span>
              <select class="ring-builder__field" name="sort">
                <option value="price_asc">{{ 'ring_builder.filters.price_low' | t }}</option>
                <option value="price_desc">{{ 'ring_builder.filters.price_high' | t }}</option>
                <option value="size_asc">{{ 'ring_builder.filters.carat_low' | t }}</option>
                <option value="size_desc">{{ 'ring_builder.filters.carat_high' | t }}</option>
              </select>
            </label>
          </div>
          <button class="btn btn--primary" type="submit">
            {{ 'ring_builder.actions.search' | t }}
          </button>
        </form>

        <div class="ring-builder__results-head">
          <p data-results-count aria-live="polite"></p>
          <div data-results-loader></div>
        </div>
        <div class="ring-builder__diamonds-grid" data-diamond-results></div>
        <nav class="ring-builder__pagination" aria-label="{{ 'ring_builder.pagination' | t }}" data-diamond-pagination hidden>
          <button class="btn btn--outline" type="button" data-diamond-previous>
            {{ 'ring_builder.actions.previous' | t }}
          </button>
          <span data-diamond-page></span>
          <button class="btn btn--outline" type="button" data-diamond-next>
            {{ 'ring_builder.actions.next' | t }}
          </button>
        </nav>
      </div>

      <div class="ring-builder__panel" role="tabpanel" data-builder-panel="review" hidden>
        <div class="ring-builder__panel-head">
          <div>
            <p class="ring-builder__eyebrow">{{ 'ring_builder.steps.review' | t }}</p>
            <h2>{{ 'ring_builder.review_heading' | t }}</h2>
          </div>
          <p>{{ 'ring_builder.review_help' | t }}</p>
        </div>
        <div class="ring-builder__review" data-builder-review></div>
        <button class="btn btn--primary ring-builder__add" type="button" data-ring-add disabled>
          <span data-button-label>{{ 'ring_builder.actions.add_ring' | t }}</span>
        </button>
      </div>
    </div>

    <aside class="ring-builder__summary" aria-label="{{ 'ring_builder.summary.label' | t }}">
      <p class="ring-builder__eyebrow">{{ 'ring_builder.summary.label' | t }}</p>
      <div class="ring-builder__summary-row">
        <span>{{ 'ring_builder.summary.setting' | t }}</span>
        <strong data-summary-setting>{{ 'ring_builder.summary.not_selected' | t }}</strong>
      </div>
      <div class="ring-builder__summary-row">
        <span>{{ 'ring_builder.summary.diamond' | t }}</span>
        <strong data-summary-diamond>{{ 'ring_builder.summary.not_selected' | t }}</strong>
      </div>
      <div class="ring-builder__summary-row ring-builder__summary-total">
        <span>{{ 'ring_builder.summary.total' | t }}</span>
        <strong data-summary-total>—</strong>
      </div>
      <button class="ring-builder__summary-link" type="button" data-summary-edit="settings" hidden>{{ 'ring_builder.actions.edit_setting' | t }}</button>
      <button class="ring-builder__summary-link" type="button" data-summary-edit="diamonds" hidden>{{ 'ring_builder.actions.edit_diamond' | t }}</button>
    </aside>
  </div>

  <dialog class="ring-builder__quick-view-dialog" data-builder-quick-view-dialog aria-label="{{ 'ring_builder.quick_view.label' | t }}">
    <button class="ring-builder__quick-view-veil" type="button" data-builder-quick-view-close aria-label="{{ 'ring_builder.quick_view.close' | t }}"></button>
    <div class="quick-view ring-builder__quick-view-panel" data-builder-quick-view-panel>
      {%- if settings.close_style == 'icon' -%}
        <button class="overlay-close--icon quick-view__close" type="button" data-builder-quick-view-close>
          <span class="visually-hidden">{{ 'ring_builder.quick_view.close' | t }}</span>
          <svg class="icon-svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      {%- else -%}
        <button class="overlay-head__close quick-view__close" type="button" data-builder-quick-view-close>{{ 'ring_builder.quick_view.close' | t }}</button>
      {%- endif -%}
      <div class="quick-view__contents" data-builder-quick-view-contents></div>
    </div>
  </dialog>

  <template data-builder-loader>
    {{ builder_loader_markup }}
  </template>
  <template data-builder-eye>
    <svg class="icon-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M2.5 12S6 6.5 12 6.5 21.5 12 21.5 12 18 17.5 12 17.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="2.6"/></svg>
  </template>
  <template data-builder-chevron-previous>
    <svg class="icon-svg" width="12" height="24" viewBox="0 0 12 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 2L2 12l8 10" /></svg>
  </template>
  <template data-builder-chevron-next>
    <svg class="icon-svg" width="12" height="24" viewBox="0 0 12 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 2l8 10-8 10" /></svg>
  </template>
  <script type="application/json" data-builder-translations>
    {
      "results": {{ 'ring_builder.results' | t | json }},
      "fixtureResults": {{ 'ring_builder.fixture_results' | t | json }},
      "stagingResults": {{ 'ring_builder.staging_results' | t | json }},
      "noResults": {{ 'ring_builder.no_results' | t | json }},
      "select": {{ 'ring_builder.actions.choose_diamond' | t | json }},
      "chooseSetting": {{ 'ring_builder.actions.choose_setting' | t | json }},
      "settingOptions": {{ 'ring_builder.setting_options' | t | json }},
      "selected": {{ 'ring_builder.actions.selected' | t | json }},
      "imageUnavailable": {{ 'ring_builder.image_unavailable' | t | json }},
      "page": {{ 'ring_builder.page' | t | json }},
      "setting": {{ 'ring_builder.summary.setting' | t | json }},
      "diamond": {{ 'ring_builder.summary.diamond' | t | json }},
      "adding": {{ 'ring_builder.adding' | t | json }},
      "added": {{ 'ring_builder.added' | t | json }},
      "priceUpdated": {{ 'ring_builder.price_updated' | t | json }},
      "cartError": {{ 'ring_builder.cart_error' | t | json }},
      "connectionError": {{ 'ring_builder.connection_error' | t | json }},
      "settingsError": {{ 'ring_builder.settings_error' | t | json }},
      "stillLoading": {{ 'ring_builder.still_loading' | t | json }}
      ,"quickView": {{ 'ring_builder.quick_view.label' | t | json }}
      ,"closeQuickView": {{ 'ring_builder.quick_view.close' | t | json }}
      ,"settingDetails": {{ 'ring_builder.quick_view.setting_details' | t | json }}
      ,"diamondDetails": {{ 'ring_builder.quick_view.diamond_details' | t | json }}
      ,"description": {{ 'ring_builder.quick_view.description' | t | json }}
      ,"specifications": {{ 'ring_builder.quick_view.specifications' | t | json }}
      ,"video": {{ 'ring_builder.quick_view.video' | t | json }}
      ,"productMedia": {{ 'ring_builder.quick_view.product_media' | t | json }}
      ,"goToView": {{ 'ring_builder.quick_view.go_to_view' | t | json }}
      ,"previousMedia": {{ 'ring_builder.quick_view.previous_media' | t | json }}
      ,"nextMedia": {{ 'ring_builder.quick_view.next_media' | t | json }}
    }
  </script>
</div>

{% schema %}
{
  "name": "t:ring_builder.editor.name",
  "target": "section",
  "stylesheet": "ring-builder.css",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "header", "content": "t:ring_builder.editor.product_cards" },
    { "type": "select", "id": "card_text_align", "label": "t:ring_builder.editor.text_alignment", "options": [{ "value": "left", "label": "t:ring_builder.editor.left" }, { "value": "center", "label": "t:ring_builder.editor.center" }], "default": "left" },
    { "type": "select", "id": "card_image_ratio", "label": "t:ring_builder.editor.media_ratio", "options": [{ "value": "1 / 1", "label": "t:ring_builder.editor.square" }, { "value": "3 / 4", "label": "t:ring_builder.editor.portrait" }, { "value": "4 / 3", "label": "t:ring_builder.editor.landscape" }], "default": "1 / 1" },
    { "type": "select", "id": "card_image_fit", "label": "t:ring_builder.editor.media_fit", "options": [{ "value": "contain", "label": "t:ring_builder.editor.contain" }, { "value": "cover", "label": "t:ring_builder.editor.cover" }], "default": "contain" },
    { "type": "checkbox", "id": "card_animation", "label": "t:ring_builder.editor.animate_cards", "default": true },
    { "type": "checkbox", "id": "show_card_media", "label": "t:ring_builder.editor.show_media", "default": true },
    { "type": "checkbox", "id": "show_card_badges", "label": "t:ring_builder.editor.show_badges", "default": false },
    { "type": "checkbox", "id": "show_card_vendor", "label": "t:ring_builder.editor.show_vendor", "default": false },
    { "type": "checkbox", "id": "show_card_title", "label": "t:ring_builder.editor.show_title", "default": true },
    { "type": "checkbox", "id": "show_card_options", "label": "t:ring_builder.editor.show_option_controls", "default": true },
    { "type": "checkbox", "id": "show_card_price", "label": "t:ring_builder.editor.show_price", "default": true },
    { "type": "checkbox", "id": "show_card_action", "label": "t:ring_builder.editor.show_selection_action", "default": true },
    { "type": "checkbox", "id": "quick_view_desktop", "label": "t:ring_builder.editor.quick_view_desktop", "default": true },
    { "type": "checkbox", "id": "quick_view_compact", "label": "t:ring_builder.editor.quick_view_mobile", "default": true },
    { "type": "header", "content": "t:ring_builder.editor.quick_view_blocks" },
    { "type": "checkbox", "id": "show_quick_media", "label": "t:ring_builder.editor.media_gallery", "default": true },
    { "type": "select", "id": "quick_media_controls", "label": "t:ring_builder.editor.media_controls", "options": [{ "value": "arrows_dots", "label": "t:ring_builder.editor.arrows_dots" }, { "value": "arrows", "label": "t:ring_builder.editor.arrows" }, { "value": "dots", "label": "t:ring_builder.editor.dots" }, { "value": "none", "label": "t:ring_builder.editor.none" }], "default": "arrows_dots" },
    { "type": "checkbox", "id": "show_quick_badges", "label": "t:ring_builder.editor.badges", "default": false },
    { "type": "checkbox", "id": "show_quick_vendor", "label": "t:ring_builder.editor.vendor", "default": true },
    { "type": "checkbox", "id": "show_quick_title", "label": "t:ring_builder.editor.title", "default": true },
    { "type": "checkbox", "id": "show_quick_price", "label": "t:ring_builder.editor.price", "default": true },
    { "type": "checkbox", "id": "show_quick_options", "label": "t:ring_builder.editor.options", "default": true },
    { "type": "checkbox", "id": "show_quick_description", "label": "t:ring_builder.editor.description", "default": false },
    { "type": "checkbox", "id": "show_quick_specs", "label": "t:ring_builder.editor.specifications", "default": true },
    { "type": "checkbox", "id": "show_quick_action", "label": "t:ring_builder.editor.selection_action", "default": true }
  ]
}
{% endschema %}
