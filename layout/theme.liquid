<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>

    {%- comment -%}
      Four global font styles. Text presets point to these roles, and block
      overrides may switch between the same four without introducing another
      font request. Load the regular, bold, italic, and bold-italic faces that
      Shopify requires for every merchant-selected font.
    {%- endcomment -%}
    {%- liquid
      assign accent_bold = settings.font_accent | font_modify: 'weight', 'bold'
      assign accent_italic = settings.font_accent | font_modify: 'style', 'italic'
      assign accent_bold_italic = accent_bold | font_modify: 'style', 'italic'
      assign body_bold = settings.font_body | font_modify: 'weight', 'bold'
      assign body_italic = settings.font_body | font_modify: 'style', 'italic'
      assign body_bold_italic = body_bold | font_modify: 'style', 'italic'
      assign subheading_bold = settings.font_subheading | font_modify: 'weight', 'bold'
      assign subheading_italic = settings.font_subheading | font_modify: 'style', 'italic'
      assign subheading_bold_italic = subheading_bold | font_modify: 'style', 'italic'
      assign heading_bold = settings.font_heading | font_modify: 'weight', 'bold'
      assign heading_italic = settings.font_heading | font_modify: 'style', 'italic'
      assign heading_bold_italic = heading_bold | font_modify: 'style', 'italic'
      assign accent_signature = settings.font_accent.family | append: '|' | append: settings.font_accent.weight | append: '|' | append: settings.font_accent.style
      assign body_signature = settings.font_body.family | append: '|' | append: settings.font_body.weight | append: '|' | append: settings.font_body.style
      assign subheading_signature = settings.font_subheading.family | append: '|' | append: settings.font_subheading.weight | append: '|' | append: settings.font_subheading.style
      assign heading_signature = settings.font_heading.family | append: '|' | append: settings.font_heading.weight | append: '|' | append: settings.font_heading.style
    -%}
    {% style %}
      {{ settings.font_accent | font_face: font_display: 'swap' }}
      {{ accent_bold | font_face: font_display: 'swap' }}
      {{ accent_italic | font_face: font_display: 'swap' }}
      {{ accent_bold_italic | font_face: font_display: 'swap' }}
      {%- unless body_signature == accent_signature %}
        {{ settings.font_body | font_face: font_display: 'swap' }}
        {{ body_bold | font_face: font_display: 'swap' }}
        {{ body_italic | font_face: font_display: 'swap' }}
        {{ body_bold_italic | font_face: font_display: 'swap' }}
      {%- endunless %}
      {%- unless subheading_signature == accent_signature or subheading_signature == body_signature %}
        {{ settings.font_subheading | font_face: font_display: 'swap' }}
        {{ subheading_bold | font_face: font_display: 'swap' }}
        {{ subheading_italic | font_face: font_display: 'swap' }}
        {{ subheading_bold_italic | font_face: font_display: 'swap' }}
      {%- endunless %}
      {%- unless heading_signature == accent_signature or heading_signature == body_signature or heading_signature == subheading_signature %}
        {{ settings.font_heading | font_face: font_display: 'swap' }}
        {{ heading_bold | font_face: font_display: 'swap' }}
        {{ heading_italic | font_face: font_display: 'swap' }}
        {{ heading_bold_italic | font_face: font_display: 'swap' }}
      {%- endunless %}
    {% endstyle %}

    {% render 'theme-tokens' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  {%- comment -%}
    The page's own scheme is a setting. It was hardcoded to `scheme_1`, so a
    merchant could define four schemes and never choose which one the page
    itself used — every section could be restyled and the ground under them
    could not.
  {%- endcomment -%}
  <body class="scheme-{{ settings.page_scheme.id | default: 'scheme_1' }} template-{{ template.name | handle }}">
    <a class="skip-link" href="#main">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
