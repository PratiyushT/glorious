<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- assign meta_description = page_description | default: shop.description | default: shop.name -%}
    <meta name="description" content="{{ meta_description | escape }}">
    {% render 'social-meta-tags', description: meta_description %}

    {%- if request.page_type == 'product' -%}
      <script type="application/ld+json">
        {{ product | structured_data }}
      </script>
    {%- elsif request.page_type == 'article' -%}
      <script type="application/ld+json">
        {{ article | structured_data }}
      </script>
    {%- endif -%}

    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>

    {%- comment -%}
      Four global font styles. Text presets point to these roles, and block
      overrides may switch between the same four without introducing another
      font request. Load the regular, bold, italic, and bold-italic faces that
      Shopify requires for every merchant-selected font.
    {%- endcomment -%}
    {%- liquid
      assign accent_bold = settings.font_accent | font_modify: 'weight', 'bold'
      assign accent_italic = settings.font_accent | font_modify: 'style', 'italic'
      assign accent_bold_italic = accent_bold | font_modify: 'style', 'italic'
      assign body_bold = settings.font_body | font_modify: 'weight', 'bold'
      assign body_italic = settings.font_body | font_modify: 'style', 'italic'
      assign body_bold_italic = body_bold | font_modify: 'style', 'italic'
      assign subheading_bold = settings.font_subheading | font_modify: 'weight', 'bold'
      assign subheading_italic = settings.font_subheading | font_modify: 'style', 'italic'
      assign subheading_bold_italic = subheading_bold | font_modify: 'style', 'italic'
      assign heading_bold = settings.font_heading | font_modify: 'weight', 'bold'
      assign heading_italic = settings.font_heading | font_modify: 'style', 'italic'
      assign heading_bold_italic = heading_bold | font_modify: 'style', 'italic'
      assign accent_signature = settings.font_accent.family | append: '|' | append: settings.font_accent.weight | append: '|' | append: settings.font_accent.style
      assign body_signature = settings.font_body.family | append: '|' | append: settings.font_body.weight | append: '|' | append: settings.font_body.style
      assign subheading_signature = settings.font_subheading.family | append: '|' | append: settings.font_subheading.weight | append: '|' | append: settings.font_subheading.style
      assign heading_signature = settings.font_heading.family | append: '|' | append: settings.font_heading.weight | append: '|' | append: settings.font_heading.style
    -%}
    {% style %}
      {{ settings.font_accent | font_face: font_display: 'swap' }}
      {{ accent_bold | font_face: font_display: 'swap' }}
      {{ accent_italic | font_face: font_display: 'swap' }}
      {{ accent_bold_italic | font_face: font_display: 'swap' }}
      {%- unless body_signature == accent_signature %}
        {{ settings.font_body | font_face: font_display: 'swap' }}
        {{ body_bold | font_face: font_display: 'swap' }}
        {{ body_italic | font_face: font_display: 'swap' }}
        {{ body_bold_italic | font_face: font_display: 'swap' }}
      {%- endunless %}
      {%- unless subheading_signature == accent_signature or subheading_signature == body_signature %}
        {{ settings.font_subheading | font_face: font_display: 'swap' }}
        {{ subheading_bold | font_face: font_display: 'swap' }}
        {{ subheading_italic | font_face: font_display: 'swap' }}
        {{ subheading_bold_italic | font_face: font_display: 'swap' }}
      {%- endunless %}
      {%- unless heading_signature == accent_signature or heading_signature == body_signature or heading_signature == subheading_signature %}
        {{ settings.font_heading | font_face: font_display: 'swap' }}
        {{ heading_bold | font_face: font_display: 'swap' }}
        {{ heading_italic | font_face: font_display: 'swap' }}
        {{ heading_bold_italic | font_face: font_display: 'swap' }}
      {%- endunless %}
    {% endstyle %}

    {% render 'theme-tokens' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'main-product.css' | asset_url | stylesheet_tag }}
    {%- if request.path contains '/policies/' -%}
      {{ 'content-pages.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'main-product.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  {%- comment -%}
    The page's own scheme is a setting. It was hardcoded to `scheme_1`, so a
    merchant could define four schemes and never choose which one the page
    itself used — every section could be restyled and the ground under them
    could not.
  {%- endcomment -%}
  <body class="scheme-{{ settings.page_scheme.id | default: 'scheme_1' }} template-{{ template.name | handle }}"{% if settings.video_pause_offscreen %} data-video-offscreen-pause{% endif %}{% if settings.price_compare_position == 'after' %} data-price-compare="after"{% endif %}>
    <a class="skip-link" href="#main">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="main">
      {%- if request.path contains '/policies/' -%}
        {%- liquid
          comment
            Shopify has no policy template type: the platform renders the
            policy markup itself through content_for_layout, and this wrap
            is the one hook a theme has. The scaffold is the design's
            legal-page system — its Terms, Privacy, Cookies, Disclaimer,
            and Returns pages all share it. Liquid looks the current
            policy up by URL so the hero can state its title; only when
            that lookup succeeds does CSS hide the platform's own title,
            so an unmatched route still shows a heading.
          endcomment
          assign current_policy = blank
          for shop_policy in shop.policies
            if shop_policy != blank and request.path == shop_policy.url
              assign current_policy = shop_policy
            endif
          endfor
          assign policy_shop_name = settings.store_display_name | default: shop.name
        -%}
        <article class="content-surface policy-shell{% if current_policy != blank %} policy-shell--own-title{% endif %}">
          <header class="policy-hero">
            <div class="policy-hero__inner">
              <span class="policy-hero__eyebrow">{{ 'policies.eyebrow' | t }}</span>
              {%- if current_policy != blank -%}
                <h1 class="policy-hero__title">{{ current_policy.title }}</h1>
              {%- endif -%}
              {%- comment -%}
                The design's meta row states the shop and its city; both
                come from data the platform already holds. Its "Last
                updated" date has no native source — the policy drop
                carries no date — so the theme does not invent one.
              {%- endcomment -%}
              <div class="policy-hero__meta">
                <span>
                  {{- policy_shop_name -}}
                  {%- if shop.address.city != blank %} · {{ shop.address.city }}{% if shop.address.province != blank %}, {{ shop.address.province }}{% endif %}{% endif -%}
                </span>
              </div>
            </div>
          </header>
          <section class="policy-page">
            <div class="policy-page__inner">
              {%- comment -%}
                The rail's "On this page" head and divider render hidden:
                initPolicyToc builds that list from the merchant's own h2s
                and unhides them, so without scripting the rail holds only
                the server-rendered links to the other policies.
              {%- endcomment -%}
              <aside class="policy-rail" data-policy-rail aria-label="{{ 'sections.main_policy.navigation' | t | escape }}">
                <span class="policy-rail__head" data-policy-toc-head hidden>{{ 'policies.on_this_page' | t }}</span>
                <span class="policy-rail__divider" data-policy-divider hidden></span>
                {%- liquid
                  assign related_count = 0
                  for shop_policy in shop.policies
                    if shop_policy != blank and shop_policy.url != request.path
                      assign related_count = related_count | plus: 1
                    endif
                  endfor
                -%}
                {%- if related_count > 0 -%}
                  <span class="policy-rail__head">{{ 'policies.related' | t }}</span>
                  {%- for shop_policy in shop.policies -%}
                    {%- if shop_policy != blank and shop_policy.url != request.path -%}
                      <a class="policy-rail__link" href="{{ shop_policy.url }}">{{ shop_policy.title }}</a>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </aside>
              <div class="policy-content">
                {{ content_for_layout }}
                {%- if shop.policies.size > 0 -%}
                  <nav class="policy-all" aria-label="{{ 'policies.all' | t | escape }}">
                    <span class="policy-all__head">{{ 'policies.all' | t }}</span>
                    {%- for shop_policy in shop.policies -%}
                      {%- if shop_policy != blank -%}
                        <a class="policy-all__link" href="{{ shop_policy.url }}"{% if request.path == shop_policy.url %} aria-current="page"{% endif %}>{{ shop_policy.title }}</a>
                      {%- endif -%}
                    {%- endfor -%}
                  </nav>
                {%- endif -%}
              </div>
            </div>
          </section>
        </article>
      {%- else -%}
        {{ content_for_layout }}
      {%- endif -%}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
